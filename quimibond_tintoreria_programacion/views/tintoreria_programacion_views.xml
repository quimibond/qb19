<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tintoreria_programacion_list_view" model="ir.ui.view">
        <field name="name">tintoreria.programacion.list</field>
        <field name="model">tintoreria.programacion</field>
        <field name="arch" type="xml">
            <list string="Programaciones de Tintorería" create="0" delete="0">
                <field name="name"/>
                <field name="product_id"/>
                <field name="workcenter_id"/>
                <field name="kg_total"/>
                <field name="rendimiento"/>
                <field name="banda"/>
                <field name="n_banos"/>
                <field name="kg_bano"/>
                <field name="user_id" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'programada'"
                       decoration-muted="state == 'cancelada'"/>
            </list>
        </field>
    </record>

    <record id="tintoreria_programacion_form_view" model="ir.ui.view">
        <field name="name">tintoreria.programacion.form</field>
        <field name="model">tintoreria.programacion</field>
        <field name="arch" type="xml">
            <form string="Programación de Tintorería" create="0" delete="0" edit="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Programación">
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="workcenter_id"/>
                            <field name="user_id"/>
                            <field name="fecha"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Tamaño de baño">
                            <field name="kg_total"/>
                            <field name="rendimiento"/>
                            <field name="banda"/>
                            <field name="capacidad_kg"/>
                            <field name="n_banos"/>
                            <field name="kg_bano"/>
                        </group>
                    </group>
                    <field name="production_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="product_qty" string="kg"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_tintoreria_programacion" model="ir.actions.act_window">
        <field name="name">Programaciones de Tintorería</field>
        <field name="res_model">tintoreria.programacion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
