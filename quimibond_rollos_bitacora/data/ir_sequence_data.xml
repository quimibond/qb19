<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 3.5.0 (Dirección, 2026-11-05): número de baño. Empieza en 30001, lejos de los folios de las tarjetas viajeras
         (serie del 21 mil), para que se distinga la fase nueva. Se puede cambiar el siguiente número en
         Ajustes → Técnico → Secuencias. -->
    <record id="seq_numero_bano" model="ir.sequence">
        <field name="name">Número de baño (rollos)</field>
        <field name="code">quimibond_rollos_bitacora.numero_bano</field>
        <field name="padding">5</field>
        <field name="number_next">30001</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
