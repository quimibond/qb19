<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_inspeccion_restriccion_list" model="ir.ui.view">
        <field name="name">mrp.inspeccion.restriccion.list</field>
        <field name="model">mrp.inspeccion.restriccion</field>
        <field name="arch" type="xml">
            <list string="Restricciones de Inspección" editable="bottom">
                <header>
                    <button name="action_cargar_iniciales" type="object" string="Cargar restricciones iniciales"
                            display="always"/>
                </header>
                <field name="workcenter_id" options="{'no_create': True}"
                       domain="[('ft_tipo_id.name', '=', 'Inspección')]"/>
                <field name="prefijos_excluidos"/>
                <field name="codigos_exclusivos"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_mrp_inspeccion_restriccion" model="ir.actions.act_window">
        <field name="name">Restricciones de Inspección</field>
        <field name="res_model">mrp.inspeccion.restriccion</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
