<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_tara_producto_list" model="ir.ui.view">
        <field name="name">mrp.tara.producto.list</field>
        <field name="model">mrp.tara.producto</field>
        <field name="arch" type="xml">
            <list string="Taras por producto y operación" editable="bottom">
                <header>
                    <button name="action_cargar_iniciales" type="object" string="Cargar taras iniciales"
                            display="always" groups="mrp.group_mrp_manager"/>
                </header>
                <field name="product_tmpl_id"/>
                <field name="default_code"/>
                <field name="operacion"/>
                <field name="tara_kg"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_tara_producto_search" model="ir.ui.view">
        <field name="name">mrp.tara.producto.search</field>
        <field name="model">mrp.tara.producto</field>
        <field name="arch" type="xml">
            <search string="Taras por producto">
                <field name="product_tmpl_id"/>
                <field name="default_code"/>
                <filter string="Rama" name="rama" domain="[('operacion', '=', 'rama')]"/>
                <filter string="Clasificación final" name="clasificacion_final"
                        domain="[('operacion', '=', 'clasificacion_final')]"/>
                <group>
                    <filter string="Operación" name="group_operacion" context="{'group_by': 'operacion'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_tara_producto" model="ir.actions.act_window">
        <field name="name">Taras por producto</field>
        <field name="res_model">mrp.tara.producto</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
