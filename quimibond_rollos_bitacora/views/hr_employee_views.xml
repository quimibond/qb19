<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Siglas del operador de Inspección (se imprimen en la etiqueta final). Lista editable propia para no
         depender de la estructura de la ficha del empleado. -->
    <record id="view_hr_employee_siglas_list" model="ir.ui.view">
        <field name="name">hr.employee.siglas.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Siglas de operadores" editable="bottom" create="0" delete="0">
                <header>
                    <button name="action_cargar_siglas_iniciales" type="object" string="Cargar siglas iniciales"
                            display="always"/>
                </header>
                <field name="name" readonly="1"/>
                <field name="siglas"/>
            </list>
        </field>
    </record>

    <record id="action_hr_employee_siglas" model="ir.actions.act_window">
        <field name="name">Siglas de operadores</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_hr_employee_siglas_list')})]"/>
    </record>
</odoo>
