<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inspección como estación única (diseño 2026-11-03): un rollo final por registro. -->
    <record id="view_rollo_inspeccion_estacion_wizard_form" model="ir.ui.view">
        <field name="name">rollo.inspeccion.estacion.wizard.form</field>
        <field name="model">rollo.inspeccion.estacion.wizard</field>
        <field name="arch" type="xml">
            <form string="Inspeccionar rollo">
                <sheet>
                    <field name="scale_read_url" invisible="1"/>
                    <field name="tara_faltante" invisible="1"/>
                    <field name="codigos_error" invisible="1"/>
                    <field name="bitacora_ids" invisible="1"/>
                    <group>
                        <field name="empleado_numero" password="True" default_focus="1"
                               readonly="empleado_numero != False" force_save="1"/>
                        <field name="empleado_nombre" readonly="1" invisible="not empleado_numero"/>
                    </group>
                    <div invisible="not empleado_numero">
                        <div class="alert alert-info" role="status" groups="mrp.group_mrp_manager">
                            <group col="4">
                                <field name="weighing_mode" widget="radio" options="{'horizontal': true}"/>
                                <field name="iot_device_id" invisible="weighing_mode != 'iot'"
                                       required="weighing_mode == 'iot'"/>
                            </group>
                        </div>
                        <group>
                            <group>
                                <field name="production_id"/>
                                <field name="orden_m_id"/>
                                <field name="product_id"/>
                            </group>
                            <group>
                                <field name="workcenter_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="pendientes"/>
                                <field name="lote_name" style="font-weight: bold;"/>
                            </group>
                        </group>
                        <group>
                            <field name="rollo_codigos" placeholder="Escanea la etiqueta de Rama (varias para juntar)"
                                   style="font-size: 1.5em; font-weight: bold;"/>
                            <field name="termina_rollo"/>
                        </group>
                        <div class="alert alert-danger" role="alert" invisible="not codigos_error">
                            No existe el rollo de Rama <field name="codigos_error" readonly="1" class="oe_inline"/>.
                        </div>
                        <div class="alert alert-danger" role="alert" invisible="not tara_faltante">
                            No hay tara de Inspección para este artículo. Captúrala en Manufactura → Configuración →
                            Taras por producto antes de pesar.
                        </div>
                        <div class="text-center mt-3 mb-3 p-4 border rounded bg-light">
                            <div class="row">
                                <div class="col-4">
                                    <label for="kg_bruto" string="PESO BRUTO"/><br/>
                                    <field name="kg_bruto" widget="peso_bascula" options="{'digits': [12, 4]}"
                                           readonly="weighing_mode == 'iot'" force_save="1"
                                           style="font-size: 2.5em; font-weight: bold; text-align: center;"/>
                                </div>
                                <div class="col-4">
                                    <label for="tara_kg" string="TARA DE INSPECCIÓN"/><br/>
                                    <field name="tara_kg" readonly="1"
                                           style="font-size: 2.5em; font-weight: bold; text-align: center;"/>
                                </div>
                                <div class="col-4">
                                    <label for="kg_neto" string="PESO NETO"/><br/>
                                    <field name="kg_neto" readonly="1"
                                           style="font-size: 3em; font-weight: bold; text-align: center;"/>
                                </div>
                            </div>
                            <span style="font-size: 1.6em; font-weight: bold;">KG</span>
                        </div>
                        <group>
                            <group>
                                <field name="motivo_manual" invisible="weighing_mode != 'manual'"
                                       required="weighing_mode == 'manual'"/>
                                <field name="metros"/>
                                <field name="no_empalmes"/>
                                <field name="clasificacion" widget="radio" options="{'horizontal': true}"/>
                            </group>
                            <group>
                                <field name="defecto_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="kg_rama"/>
                                <field name="kg_ya_cortados"/>
                                <field name="merma_kg"/>
                                <field name="merma_pct"/>
                            </group>
                        </group>
                        <div class="alert alert-warning" role="alert" invisible="not alertas">
                            <field name="alertas" readonly="1"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirmar" type="object" string="REGISTRAR E IMPRIMIR ETIQUETA"
                            class="btn-primary btn-lg"
                            invisible="not empleado_numero or tara_faltante or not bitacora_ids"/>
                    <button string="CANCELAR" class="btn-secondary btn-lg" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
