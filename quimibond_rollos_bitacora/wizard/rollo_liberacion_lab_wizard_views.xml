<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 3.20.0: laboratorio libera la orden en metros para Empaque con su número de empleado (como en los pesajes). -->
    <record id="view_rollo_liberacion_lab_wizard_form" model="ir.ui.view">
        <field name="name">rollo.liberacion.lab.wizard.form</field>
        <field name="model">rollo.liberacion.lab.wizard</field>
        <field name="arch" type="xml">
            <form string="Liberar para Empaque">
                <sheet>
                    <group>
                        <field name="production_domain_ids" invisible="1"/>
                        <field name="production_id" default_focus="1" readonly="empleado_numero != False"
                               force_save="1" options="{'no_create': True, 'no_open': True}"
                               domain="[('id', 'in', production_domain_ids)]"/>
                    </group>
                    <div invisible="not production_id">
                        <group>
                            <field name="workorder_id" invisible="1"/>
                            <field name="empleado_numero" password="True"
                                   readonly="empleado_numero != False" force_save="1"/>
                            <field name="empleado_nombre" readonly="1" invisible="not empleado_numero"/>
                        </group>
                        <field name="linea_ids" nolabel="1" readonly="not empleado_numero">
                            <list editable="bottom" create="0" delete="0">
                                <field name="rollo_id"/>
                                <field name="clasificacion_insp"/>
                                <field name="metros"/>
                                <field name="clasificacion"/>
                                <field name="defecto_ids" widget="many2many_tags" options="{'no_create': True}"
                                       required="clasificacion != 'PQ'" readonly="clasificacion == 'PQ'"/>
                                <field name="motivo" required="clasificacion != 'PQ'" readonly="clasificacion == 'PQ'"
                                       placeholder="Por qué cambia de PQ"/>
                            </list>
                        </field>
                        <div class="alert alert-info" role="status">
                            Al liberar confirmas que laboratorio revisó los rollos PQ de esta orden en el libro de
                            Inspección y registras la calidad final de cada uno. Si cambia a FE o Segunda, captura los
                            defectos y la causa. Empaque la verá ya capturada.
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirmar" type="object" string="LIBERAR PARA EMPAQUE"
                            class="btn-primary btn-lg" invisible="not empleado_numero"/>
                    <button string="CANCELAR" class="btn-secondary btn-lg" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
