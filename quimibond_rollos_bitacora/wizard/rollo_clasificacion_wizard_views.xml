<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollo_clasificacion_wizard_form" model="ir.ui.view">
        <field name="name">rollo.clasificacion.wizard.form</field>
        <field name="model">rollo.clasificacion.wizard</field>
        <field name="arch" type="xml">
            <form string="Clasificar rollo (Clasificación final)">
                <sheet>
                    <!-- Campo puente del widget Owl 'peso_bascula' (scale.wizard.mixin, iot_scale_common) -->
                    <field name="scale_read_url" invisible="1"/>
                    <field name="tara_faltante" invisible="1"/>
                    <field name="rollo_id" invisible="1"/>
                    <field name="rollo_estado" invisible="1"/>
                    <group>
                        <field name="empleado_numero" password="True" default_focus="1"
                               readonly="empleado_numero != False" force_save="1"/>
                        <field name="empleado_nombre" readonly="1" invisible="not empleado_numero"/>
                    </group>
                    <div invisible="not empleado_numero">
                        <div class="alert alert-info" role="status" groups="mrp.group_mrp_manager">
                            <group col="4">
                                <field name="weighing_mode" widget="radio" options="{'horizontal': true}"/>
                                <field name="iot_device_id" invisible="weighing_mode != 'iot'"
                                       required="weighing_mode == 'iot'"/>
                            </group>
                        </div>
                        <group>
                            <group>
                                <field name="production_id"/>
                                <field name="workorder_id"/>
                                <field name="product_id"/>
                            </group>
                            <group>
                                <field name="rollo_codigo" placeholder="Escanea la etiqueta del rollo"
                                       style="font-size: 1.5em; font-weight: bold;"/>
                            </group>
                        </group>
                        <div class="alert alert-danger" role="alert" invisible="rollo_estado != 'no_encontrado'">
                            Ese código no corresponde a un rollo del Producto A de esta orden.
                        </div>
                        <div class="alert alert-danger" role="alert" invisible="rollo_estado != 'sin_inspeccion'">
                            El rollo no ha sido inspeccionado.
                        </div>
                        <div class="alert alert-danger" role="alert" invisible="rollo_estado != 'clasificado'">
                            El rollo ya fue clasificado.
                        </div>
                        <div class="alert alert-danger" role="alert" invisible="not tara_faltante">
                            No hay tara de Clasificación final para este artículo. Captúrala en Manufactura →
                            Configuración → Taras por producto antes de pesar.
                        </div>
                        <div invisible="rollo_estado != 'ok'">
                            <group>
                                <group string="Referencia">
                                    <field name="kg_rama"/>
                                    <field name="metros_insp"/>
                                    <field name="clasificacion_inicial"/>
                                </group>
                                <group string="Clasificación">
                                    <field name="metros"/>
                                    <field name="motivo_ajuste_metros"/>
                                    <field name="clasificacion" widget="radio" options="{'horizontal': true}"/>
                                    <field name="defecto_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert" invisible="not alertas">
                                <field name="alertas" readonly="1" nolabel="1"/>
                            </div>
                            <div class="text-center mt-3 mb-3 p-4 border rounded bg-light">
                                <div class="row">
                                    <div class="col-4">
                                        <label for="kg_bruto" string="PESO BRUTO"/><br/>
                                        <field name="kg_bruto" widget="peso_bascula" options="{'digits': [12, 4]}"
                                               readonly="weighing_mode == 'iot'" force_save="1"
                                               style="font-size: 2.5em; font-weight: bold; text-align: center;"/>
                                    </div>
                                    <div class="col-4">
                                        <label for="tara_kg" string="TARA"/><br/>
                                        <field name="tara_kg" readonly="1"
                                               style="font-size: 2.5em; font-weight: bold; text-align: center;"/>
                                    </div>
                                    <div class="col-4">
                                        <label for="kg_neto" string="PESO NETO"/><br/>
                                        <field name="kg_neto" readonly="1"
                                               style="font-size: 3em; font-weight: bold; text-align: center;"/>
                                    </div>
                                </div>
                                <span style="font-size: 1.6em; font-weight: bold;">KG</span>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirmar" type="object" string="REGISTRAR E IMPRIMIR ETIQUETA"
                            class="btn-primary btn-lg"
                            invisible="not empleado_numero or rollo_estado != 'ok' or tara_faltante"/>
                    <button string="CANCELAR" class="btn-secondary btn-lg" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
