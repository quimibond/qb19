<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_etiqueta_rama" model="ir.actions.report">
        <field name="name">Etiqueta de Rama (lote-serie)</field>
        <field name="model">mrp.rollo.bitacora</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">quimibond_rollos_bitacora.report_etiqueta_rama</field>
    </record>

    <template id="report_etiqueta_rama">
        <t t-foreach="docs" t-as="o">
            <t t-out="o.zpl_etiqueta_rama"/>
        </t>
    </template>

    <record id="action_report_etiqueta_preliminar" model="ir.actions.report">
        <field name="name">Etiqueta preliminar de Inspección</field>
        <field name="model">mrp.rollo.bitacora</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">quimibond_rollos_bitacora.report_etiqueta_preliminar</field>
    </record>

    <template id="report_etiqueta_preliminar">
        <t t-foreach="docs" t-as="o">
            <t t-out="o.zpl_etiqueta_preliminar"/>
        </t>
    </template>

    <record id="action_report_etiqueta_rollo_final" model="ir.actions.report">
        <field name="name">Etiqueta final del rollo (Inspección)</field>
        <field name="model">mrp.rollo.final</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">quimibond_rollos_bitacora.report_etiqueta_rollo_final</field>
        <field name="binding_model_id" ref="model_mrp_rollo_final"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_etiqueta_rollo_final">
        <t t-foreach="docs" t-as="o">
            <t t-out="o.zpl_etiqueta"/>
        </t>
    </template>

    <record id="action_report_etiqueta_rollo_preliminar" model="ir.actions.report">
        <field name="name">Etiqueta preliminar del rollo (Inspección)</field>
        <field name="model">mrp.rollo.final</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">quimibond_rollos_bitacora.report_etiqueta_rollo_preliminar</field>
        <field name="binding_model_id" ref="model_mrp_rollo_final"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_etiqueta_rollo_preliminar">
        <t t-foreach="docs" t-as="o">
            <t t-out="o.zpl_etiqueta_preliminar or o._zpl_etiqueta_preliminar()"/>
        </t>
    </template>

    <record id="action_report_etiqueta_desperdicio_empaque" model="ir.actions.report">
        <field name="name">Etiqueta del desperdicio de Empaque</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">quimibond_rollos_bitacora.report_etiqueta_desperdicio_empaque</field>
    </record>

    <record id="action_report_etiqueta_desperdicio_rama" model="ir.actions.report">
        <field name="name">Etiqueta del desperdicio de Rama</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">quimibond_rollos_bitacora.report_etiqueta_desperdicio_rama</field>
    </record>

    <template id="report_etiqueta_desperdicio_rama">
        <t t-foreach="docs" t-as="o">
            <t t-out="o._zpl_etiqueta_desperdicio_rama()"/>
        </t>
    </template>

    <template id="report_etiqueta_desperdicio_empaque">
        <t t-foreach="docs" t-as="o">
            <t t-out="o._zpl_etiqueta_desperdicio_empaque()"/>
        </t>
    </template>
</odoo>
