<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Se usa <function> con lógica de "buscar antes de crear" (ver
        _load_default_data en el modelo) en vez de <record> directos.
        Esto evita el error de "duplicate key value violates unique
        constraint ...workcenter_uniq" que puede ocurrir si esta carga
        se ejecuta más de una vez sobre datos que ya traían esas
        configuraciones vinculadas (por ejemplo, tras una migración
        previa, o si el módulo se reinstala en una base de datos que ya
        tenía estos registros).

        Requiere que los centros de trabajo "TINTORERIA 1".."TINTORERIA 5"
        (códigos HTJ1-HTJ5) ya existan en Manufactura > Configuración >
        Centros de Trabajo — si no existen, esas filas simplemente se
        omiten sin error.
    -->
    <function model="tintoreria.capacidad.rendimiento" name="_load_default_data" eval="[]"/>
</odoo>
