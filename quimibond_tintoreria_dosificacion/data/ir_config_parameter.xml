<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Categorías que determinan el tipo de componente (las subcategorías también cuentan). -->
    <record id="param_categoria_quimico" model="ir.config_parameter">
        <field name="key">quimibond_tintoreria_dosificacion.categoria_quimico</field>
        <field name="value">Materia Prima / Químico</field>
    </record>
    <record id="param_categoria_colorante" model="ir.config_parameter">
        <field name="key">quimibond_tintoreria_dosificacion.categoria_colorante</field>
        <field name="value">Materia Prima / Colorante</field>
    </record>
</odoo>
