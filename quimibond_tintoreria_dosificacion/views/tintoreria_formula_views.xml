<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tintoreria_formula_view_list" model="ir.ui.view">
        <field name="name">tintoreria.formula.list</field>
        <field name="model">tintoreria.formula</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="bom_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="tintoreria_formula_view_form" model="ir.ui.view">
        <field name="name">tintoreria.formula.form</field>
        <field name="model">tintoreria.formula</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_boms" type="object" class="oe_stat_button" icon="fa-list-alt"
                                invisible="not bom_count">
                            <field name="bom_count" widget="statinfo" string="BoMs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="product_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ingredientes" name="ingredientes">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="tipo_componente"/>
                                    <field name="gramos_por_litro" readonly="tipo_componente == 'colorante'"/>
                                    <field name="porcentaje_colorante" readonly="tipo_componente == 'quimico'"/>
                                    <field name="nota"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notas">
                            <field name="notas" placeholder="Observaciones de proceso (temperaturas, tiempos, etc.)"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tintoreria_formula_view_search" model="ir.ui.view">
        <field name="name">tintoreria.formula.search</field>
        <field name="model">tintoreria.formula</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Fórmula"
                       filter_domain="['|', ('name', 'ilike', self), ('line_ids.product_id', 'ilike', self)]"/>
                <field name="product_id"/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="tintoreria_formula_action" model="ir.actions.act_window">
        <field name="name">Fórmulas de tintorería</field>
        <field name="res_model">tintoreria.formula</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera fórmula de tintorería</p>
            <p>Cada fórmula agrupa los químicos (g/L) y colorantes (%) de un color o proceso.
               Después se liga a la BoM del producto con el botón «Cargar desde fórmula».</p>
        </field>
    </record>

    <menuitem id="menu_tintoreria_formula"
              name="Fórmulas de tintorería"
              parent="mrp.menu_mrp_configuration"
              action="tintoreria_formula_action"
              sequence="60"
              groups="mrp.group_mrp_manager"/>
</odoo>
