<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_production_daily_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Reporte de Produccion Tejido</h2>
                    <p class="text-center">
                        <strong>Periodo: </strong> <span t-esc="form['date_start']"/> al <span t-esc="form['date_end']"/>
                    </p>

                    <t t-set="total_general_producido" t-value="0"/>

                    <table class="table table-sm table-bordered mt-4">
                        <thead>
                            <tr class="table-active">
                                <th>Fecha</th>
                                <th>Orden (MO)</th>
                                <th>Producto</th>
                                <th>Centro Trabajo</th>
                                <th class="text-end">Cant. Plan</th>
                                <th class="text-end">Cant. Real</th>
                                <th>Subproductos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="env['mrp.production'].browse(production_orders)" t-as="mo">
                                <t t-set="total_general_producido" t-value="total_general_producido + mo.qty_producing"/>
                                <tr>
                                    <td><span t-field="mo.date_start" t-options='{"widget": "date"}'/></td>
                                    <td><span t-field="mo.name"/></td>
                                    <td><span t-field="mo.product_id.display_name"/></td>
                                    <td>
                                        <span t-esc="', '.join(mo.workorder_ids.mapped('workcenter_id.name'))"/>
                                    </td>
                                    <td class="text-end"><span t-field="mo.product_qty"/></td>
                                    <td class="text-end"><span t-field="mo.qty_producing"/></td>
                                    <td>
                                        <t t-foreach="mo.move_byproduct_ids" t-as="bp">
                                            <div>• <span t-field="bp.product_id.name"/> (<span t-field="bp.quantity"/>)</div>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="table-active">
                                <td colspan="5" class="text-end"><strong>TOTAL GENERAL PRODUCIDO:</strong></td>
                                <td class="text-end">
                                    <strong><t t-esc="total_general_producido" t-options='{"widget": "float", "precision": 2}'/></strong>
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>