<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_landscape_tejido" model="report.paperformat">
        <field name="name">Formato Carta Horizontal Tejido</field>
        <field name="default" eval="True"/>
        <field name="format">Letter</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_production_daily" model="ir.actions.report">
        <field name="name">Reporte de Produccion Tejido</field>
        <field name="model">production.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">reporte_produccion_diaria.report_production_daily_template</field>
        <field name="report_file">reporte_produccion_diaria.report_production_daily_template</field>
        <field name="print_report_name">'Reporte_Produccion_Tejido'</field>
        <field name="paperformat_id" ref="reporte_produccion_diaria.paperformat_landscape_tejido"/>
    </record>
</odoo>