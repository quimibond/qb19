<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_inherit_revisado" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.revisado</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="needs_review" readonly="1"/>
                <field name="is_reviewed" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Lista de lotes sin la columna "Transfer to" (partner_ids).
         Para llenarla, Odoo recorre la trazabilidad completa de cada lote de la
         página (_find_delivery_ids_by_lot_iterative: consumos en producción →
         lotes producidos → ... → entrega). Con la cadena hilo → tejido → teñido
         → acabado → desperdicio, una página lanzó 3,392 consultas, tardó 16 min,
         Postgres la cortó a los 990 s y Odoo.sh mató procesos por memoria
         (2026-09-23). Es opcional y oculta por defecto, pero quien la prende la
         conserva en su navegador; quitarla de la vista evita que vuelva.
         Los clientes del lote siguen en la ficha y el filtro "Clientes" de la
         búsqueda usa otra consulta (sin recorrer la cadena).
         Prioridad alta para aplicarse después de cualquier herencia (Studio 99). -->
    <record id="view_production_lot_tree_sin_partner" model="ir.ui.view">
        <field name="name">stock.lot.list.sin.partner_ids</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ids']" position="replace"/>
        </field>
    </record>
</odoo>
