<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de Lista: Reporte de Revisión de Rollos -->
    <record id="view_mrp_revision_log_report_list" model="ir.ui.view">
        <field name="name">mrp.revision.report.list</field>
        <field name="model">mrp.revision.report</field>
        <field name="arch" type="xml">
            <list string="Reporte de Revisión de Rollos"
                  default_order="production_date_finished desc, create_date desc"
                  create="0" edit="0" delete="0" import="0">
                <field name="production_date_finished" string="Fecha de Terminación de la Orden"/>
                <field name="production_id" string="Orden de Fabricación"/>
                <field name="product_id" string="Producto"/>
                <field name="workcenter_id" string="Centro de Trabajo"/>
                <field name="create_date" string="Fecha de Revisión"/>
                <field name="lot_id" string="Rollo"/>
                <field name="user_id" string="Usuario" widget="many2one_avatar_user" optional="show"/>
                <field name="inspector" string="Inspector"/>
                <field name="peso_original" string="Peso Inicial" options="{'digits': [12, 4]}"/>
                <field name="peso_final" string="Peso Revisado" options="{'digits': [12, 4]}"/>
                <field name="diferencia" string="Diferencia" sum="Total Diferencia" options="{'digits': [12, 4]}"/>
                <field name="causa_id" string="Causa de la Desviación"/>
            </list>
        </field>
    </record>

    <!-- Vista de Búsqueda: filtro por rango de fecha de terminación de la orden -->
    <record id="view_mrp_revision_log_report_search" model="ir.ui.view">
        <field name="name">mrp.revision.report.search</field>
        <field name="model">mrp.revision.report</field>
        <field name="arch" type="xml">
            <search string="Reporte de Revisión de Rollos">
                <field name="production_id" string="Orden de Fabricación"/>
                <field name="lot_id" string="Rollo"/>
                <field name="product_id" string="Producto"/>
                <field name="workcenter_id" string="Centro de Trabajo"/>
                <field name="inspector" string="Inspector"/>
                <field name="user_id" string="Usuario"/>
                <field name="causa_id" string="Causa de la Desviación"/>

                <!-- Filtros de fecha sobre la Fecha de Terminación de la Orden.
                     Se usa el patrón clásico de domain (en vez del atributo
                     abreviado date=) por compatibilidad. -->
                <filter name="filter_hoy" string="Terminadas Hoy"
                        domain="[('production_date_finished', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('production_date_finished', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="filter_esta_semana" string="Esta Semana"
                        domain="[('production_date_finished', '&gt;=', (context_today() + relativedelta(weekday=0, weeks=-1 if context_today().weekday()==0 else 0)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_este_mes" string="Este Mes"
                        domain="[('production_date_finished', '&gt;=', context_today().strftime('%Y-%m-01 00:00:00'))]"/>

                <separator/>
                <filter name="filter_con_desviacion" string="Con Desviación"
                        domain="[('causa_id', '!=', False)]"/>

                <group>
                    <filter name="group_by_orden" string="Orden de Fabricación" context="{'group_by': 'production_id'}"/>
                    <filter name="group_by_producto" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_wc" string="Centro de Trabajo" context="{'group_by': 'workcenter_id'}"/>
                    <filter name="group_by_causa" string="Causa de la Desviación" context="{'group_by': 'causa_id'}"/>
                    <filter name="group_by_fecha_terminacion" string="Fecha de Terminación (Mes)" context="{'group_by': 'production_date_finished:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_report_revision_rollos" model="ir.actions.act_window">
        <field name="name">Reporte de Revisión de Rollos</field>
        <field name="res_model">mrp.revision.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_mrp_revision_log_report_list"/>
        <field name="search_view_id" ref="view_mrp_revision_log_report_search"/>
        <field name="context">{'search_default_filter_este_mes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay revisiones de rollos registradas en el rango seleccionado.
            </p>
        </field>
    </record>

    <!-- Menú: Manufactura > Reportes > Reporte de Revisión de Rollos -->
    <menuitem id="menu_report_revision_rollos"
              name="Revisión de Rollos"
              parent="mrp.menu_mrp_reporting"
              action="action_report_revision_rollos"
              sequence="60"/>

</odoo>
