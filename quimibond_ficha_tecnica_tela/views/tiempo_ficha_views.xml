<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tiempo de las operaciones desde la ficha: 2.22.0 rama, 2.23.0 inspección, devanado, abridora y tintorería por
         baño; 2.25.0 parámetros del proceso en la operación. Extienden vistas de mrp (otro módulo). -->

    <record id="view_mrp_routing_workcenter_form_ft_tiempo" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form.ft.tiempo</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='workorder']" position="inside">
                <field name="ft_tiempo_difiere" invisible="1"/>
                <label for="ft_tiempo_ficha" invisible="not ft_tiempo_calculo"/>
                <div invisible="not ft_tiempo_calculo">
                    <field name="ft_tiempo_ficha" class="oe_inline" readonly="1" invisible="not ft_tiempo_ficha"/>
                    <span invisible="not ft_tiempo_ficha"> min por ciclo </span>
                    <button name="action_ft_usar_tiempo_ficha" type="object" string="Usar el tiempo de la ficha"
                            class="btn-link" icon="fa-calculator" invisible="not ft_tiempo_difiere"/>
                    <div class="text-muted">
                        <field name="ft_tiempo_calculo" readonly="1"/>
                    </div>
                </div>
            </xpath>
            <!-- 2.25.0: los datos de la tela en la máquina de la operación y en sus alternativas. -->
            <xpath expr="//sheet" position="inside">
                <separator string="Parámetros del proceso (la tela en esta máquina y en sus alternativas)"/>
                <button name="action_ft_nuevo_proceso" type="object" string="Agregar los datos de la tela en esta máquina"
                        class="btn-link" icon="fa-plus" invisible="ft_proceso_id"/>
                <field name="ft_proceso_id" invisible="1"/>
                <field name="ft_param_proceso_ids" readonly="1">
                    <list>
                        <field name="workcenter_id"/>
                        <field name="resumen"/>
                        <field name="fuente" optional="show"/>
                        <field name="fecha" optional="hide"/>
                        <button name="action_ft_editar" type="object" icon="fa-pencil" title="Editar los parámetros"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_routing_workcenter_list_ft_tiempo" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.list.ft.tiempo</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='time_cycle']" position="after">
                <field name="ft_tiempo_difiere" column_invisible="True"/>
                <field name="ft_tiempo_ficha" optional="show" decoration-danger="ft_tiempo_difiere"/>
                <field name="ft_tiempo_calculo" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- 2.23.0: todas las operaciones cuyo tiempo no es el de la ficha, sin abrir lista por lista. -->
    <record id="view_mrp_routing_workcenter_search_ft_tiempo" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.search.ft.tiempo</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <filter string="Tiempo distinto de la ficha" name="ft_tiempo_difiere"
                        domain="[('ft_tiempo_difiere', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_mrp_bom_ft_tiempos_rama" model="ir.actions.server">
        <field name="name">Usar los datos de la ficha (tiempos, capacidad de jets y conversión a metros)</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_ft_datos_ficha()</field>
    </record>
</odoo>
