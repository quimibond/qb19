<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ficha_tecnica_acabado_list" model="ir.ui.view">
        <field name="name">ficha.tecnica.acabado.list</field>
        <field name="model">ficha.tecnica.acabado</field>
        <field name="arch" type="xml">
            <!-- 2.19.0: la ruta (tejido → kg → metros) y los datos de la tela acabada; en rojo si el encogimiento
                 está fuera de norma. La norma ya no se cambia con un clic en la lista (era un interruptor). -->
            <list string="Fichas Técnicas de Acabado" default_order="articulo, revision desc"
                  decoration-danger="not encogimiento_largo_dentro_norma or not encogimiento_ancho_dentro_norma"
                  decoration-muted="not active">
                <field name="articulo"/>
                <field name="revision"/>
                <!-- 2.33.0: el estado de la ficha (Borrador, En revisión, Activa, Obsoleta). -->
                <field name="estado" widget="badge" decoration-muted="estado == 'borrador'"
                       decoration-info="estado == 'revision'" decoration-success="estado == 'activa'"
                       decoration-danger="estado == 'obsoleta'"/>
                <field name="ft_pendientes_n" string="Pendientes" optional="show"/>
                <field name="tejido_id" string="Ficha de tejido"/>
                <field name="product_proceso_id" string="Acabado en proceso (kg)" optional="show"/>
                <field name="product_acabado_id" string="Tela acabada (m)"/>
                <field name="peso_acabado" optional="show"/>
                <field name="ancho_acabado" optional="show"/>
                <field name="rendimiento_tela_acabada" optional="show"/>
                <field name="encogimiento_largo_dentro_norma" optional="show"/>
                <field name="encogimiento_ancho_dentro_norma" optional="show"/>
                <field name="fecha_elaboracion" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ficha_tecnica_acabado_form" model="ir.ui.view">
        <field name="name">ficha.tecnica.acabado.form</field>
        <field name="model">ficha.tecnica.acabado</field>
        <field name="arch" type="xml">
            <form string="Ficha Técnica de Acabado">
                <!-- 2.33.0 (Jose, 2026-11-24): la ficha manda y la lista sale de ella, en orden. Barra de etapas con el
                     estado de la ficha y en la cabecera solo el paso que toca. -->
                <header>
                    <button name="action_ft_enviar_revision" type="object" string="Enviar a revisión"
                            class="btn-primary" invisible="estado != 'borrador'"
                            help="Con la ficha completa, genera la lista en kg y la de metros (archivadas) y la revisa contra la ficha."/>
                    <button name="action_ft_corregir" type="object" string="Corregir con la ficha"
                            class="btn-primary" invisible="estado not in ('revision', 'activa') or not ft_corregible"
                            help="Copia de la ficha a las dos listas los tiempos, la capacidad de los jets y la conversión a metros; luego vuelve a revisar."/>
                    <button name="action_ft_activar" type="object" string="Activar"
                            class="btn-primary" invisible="estado != 'revision' or ft_pendientes_n"
                            confirm="Se copian los datos de la ficha a las listas y se activan las dos: Odoo fabrica con ellas. ¿Continuar?"
                            help="Sin pendientes: pone las listas al día con la ficha y las activa."/>
                    <button name="action_ft_activar" type="object" string="Activar"
                            invisible="estado != 'revision' or not ft_pendientes_n"
                            help="Primero se corrigen los pendientes; si queda alguno, dice cuál."/>
                    <button name="action_ft_generar_listas" type="object" string="Generar listas"
                            invisible="estado != 'revision'"
                            help="Arma o pone al día las listas archivadas con la ruta de la familia. Las activas no se tocan."/>
                    <button name="action_ft_revisar_listas" type="object" string="Revisar"
                            invisible="estado not in ('revision', 'activa')"
                            help="Compara otra vez las listas contra la ficha (cada noche se hace sola)."/>
                    <button name="action_ft_modificar" type="object" string="Modificar"
                            invisible="estado != 'activa'"
                            help="Regresa la ficha a revisión para cambiarla. Sus listas siguen activas y fabricando."/>
                    <button name="action_ft_volver_borrador" type="object" string="Volver a borrador"
                            invisible="estado != 'obsoleta' and (estado != 'revision' or ft_lista_kg_activa or ft_lista_m_activa)"/>
                    <button name="action_ft_obsoleta" type="object" string="Marcar obsoleta"
                            invisible="estado == 'obsoleta'"
                            confirm="La tela ya no se fabrica: se archivan la ficha y sus dos listas. ¿Continuar?"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,revision,activa"/>
                </header>
                <sheet>
                    <!-- 2.19.0: la ficha sigue la ruta en kg hasta la Clasificación final: tejido → acabado en
                         proceso (kg) → tela acabada (m). Botones a las listas de materiales de los dos productos. -->
                    <div class="oe_button_box" name="button_box">
                        <!-- 2.32.0: «Producto» regresa a la tela; «Lista de la ruta» se quitó (es una de las listas en
                             metros y se abre desde «Listas en metros»). -->
                        <button name="action_ft_ver_producto" type="object" class="oe_stat_button" icon="fa-cube"
                                string="Producto" invisible="not product_acabado_id"
                                help="La tela acabada, con su pestaña «Ficha técnica»: estado, pendientes y a dónde ir."/>
                        <button name="action_ft_ver_pendientes" type="object" class="oe_stat_button text-danger"
                                icon="fa-exclamation-triangle" invisible="not ft_pendientes_n">
                            <field name="ft_pendientes_n" widget="statinfo" string="Pendientes"/>
                        </button>
                        <button name="action_ft_ver_crudo" type="object" class="oe_stat_button" icon="fa-circle-o"
                                string="Crudo" invisible="not crudo_id"/>
                        <button name="action_ft_ver_ordenes" type="object" class="oe_stat_button" icon="fa-wrench"
                                invisible="not product_acabado_id">
                            <field name="ft_ordenes_n" widget="statinfo" string="Órdenes"/>
                        </button>
                        <button name="action_ft_boms_proceso" type="object" class="oe_stat_button" icon="fa-balance-scale"
                                invisible="not product_proceso_id">
                            <field name="bom_proceso_count" widget="statinfo" string="Listas en kg"/>
                        </button>
                        <button name="action_ft_boms_acabado" type="object" class="oe_stat_button" icon="fa-arrows-h"
                                invisible="not product_acabado_id">
                            <field name="bom_acabado_count" widget="statinfo" string="Listas en metros"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Obsoleta" bg_color="text-bg-danger" invisible="estado != 'obsoleta'"/>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active or estado == 'obsoleta'"/>
                    <div class="alert alert-info mb-2" role="status" invisible="estado != 'borrador' or not ft_faltantes">
                        Para enviarla a revisión falta: <field name="ft_faltantes" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not unidades_aviso">
                        <field name="unidades_aviso" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not crudo_aviso">
                        <field name="crudo_aviso" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not proceso_aviso">
                        <field name="proceso_aviso" readonly="1" nolabel="1"/>
                        <button name="action_ft_usar_proceso_sugerido" type="object" string="Usar el sugerido"
                                class="btn btn-link p-0 ms-2" invisible="not product_proceso_sugerido_id"/>
                        <field name="product_proceso_sugerido_id" invisible="1"/>
                    </div>
                    <div class="oe_title">
                        <span class="text-muted">Ficha de acabado</span>
                        <h1>
                            <field name="articulo" placeholder="Ej. WJ044Q22HNT235-NEGRO"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Ficha">
                            <field name="revision"/>
                            <field name="fecha_elaboracion"/>
                            <field name="active" invisible="1"/>
                            <field name="bom_id" invisible="1"/>
                        </group>
                        <group string="Ruta del artículo">
                            <field name="tejido_id" string="1. Ficha de tejido" readonly="estado in ('activa', 'obsoleta')"/>
                            <field name="crudo_id" string="2. Crudo"/>
                            <field name="product_proceso_id" string="3. Acabado en proceso (kg)" readonly="estado in ('activa', 'obsoleta')"/>
                            <field name="product_acabado_id" string="4. Tela acabada (m)" readonly="estado in ('activa', 'obsoleta')"/>
                            <div colspan="2" class="text-muted small">
                                Todo va en kg hasta la Clasificación final, que entrega la tela acabada en metros medidos.
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="Tela acabada" name="tela_acabada">
                            <!-- 2.24.0: formulario nativo (antes tabla HTML); valor ± tolerancia y unidad en un renglón.
                                 Arriba la especificación; abajo lo real (rendimiento de lo fabricado y peso real). -->
                            <separator string="Especificación"/>
                            <group>
                                <group string="Medidas">
                                    <label for="peso_acabado" string="Peso"/>
                                    <div class="o_row">
                                        <field name="peso_acabado" readonly="estado in ('activa', 'obsoleta')"/>
                                        <span class="text-muted">+</span>
                                        <field name="peso_acabado_tol"/>
                                        <span class="text-muted">/ −</span>
                                        <field name="peso_acabado_tol_minus"/>
                                        <field name="peso_acabado_tol_unit_id" options="{'no_create': True}" placeholder="Unidad"/>
                                    </div>
                                    <!-- 2.30.0: el mismo dato como rango; al escribirlo calcula nominal y tolerancias. -->
                                    <label for="peso_acabado_min" string="Rango (mín. a máx.)" class="text-muted"/>
                                    <div class="o_row">
                                        <field name="peso_acabado_min"/>
                                        <span class="text-muted">a</span>
                                        <field name="peso_acabado_max"/>
                                    </div>
                                    <label for="ancho_acabado" string="Ancho de venta (especificación)"/>
                                    <div class="o_row">
                                        <field name="ancho_acabado" readonly="estado in ('activa', 'obsoleta')"/>
                                        <span class="text-muted">+</span>
                                        <field name="ancho_acabado_tol"/>
                                        <span class="text-muted">/ −</span>
                                        <field name="ancho_acabado_tol_minus"/>
                                        <field name="ancho_acabado_tol_unit_id" options="{'no_create': True}" placeholder="Unidad"/>
                                    </div>
                                    <!-- 2.30.0: el mismo dato como rango; al escribirlo calcula nominal y tolerancias. -->
                                    <label for="ancho_acabado_min" string="Rango (mín. a máx.)" class="text-muted"/>
                                    <div class="o_row">
                                        <field name="ancho_acabado_min"/>
                                        <span class="text-muted">a</span>
                                        <field name="ancho_acabado_max"/>
                                    </div>
                                    <label for="espesor_acabado" string="Espesor"/>
                                    <div class="o_row">
                                        <field name="espesor_acabado"/>
                                        <span class="text-muted">+</span>
                                        <field name="espesor_acabado_tol"/>
                                        <span class="text-muted">/ −</span>
                                        <field name="espesor_acabado_tol_minus"/>
                                        <field name="espesor_acabado_tol_unit_id" options="{'no_create': True}" placeholder="Unidad"/>
                                    </div>
                                    <!-- 2.30.0: el mismo dato como rango; al escribirlo calcula nominal y tolerancias. -->
                                    <label for="espesor_acabado_min" string="Rango (mín. a máx.)" class="text-muted"/>
                                    <div class="o_row">
                                        <field name="espesor_acabado_min"/>
                                        <span class="text-muted">a</span>
                                        <field name="espesor_acabado_max"/>
                                    </div>
                                </group>
                                <group string="Encogimiento y elongación">
                                    <label for="encogimiento_largo" string="Encogimiento a lo largo"/>
                                    <div class="o_row">
                                        <field name="encogimiento_largo"/>
                                        <span class="text-muted">+</span>
                                        <field name="encogimiento_largo_tol"/>
                                        <span class="text-muted">/ −</span>
                                        <field name="encogimiento_largo_tol_minus"/>
                                        <field name="encogimiento_largo_tol_unit_id" options="{'no_create': True}" placeholder="Unidad"/>
                                    </div>
                                    <!-- 2.30.0: el mismo dato como rango; al escribirlo calcula nominal y tolerancias. -->
                                    <label for="encogimiento_largo_min" string="Rango (mín. a máx.)" class="text-muted"/>
                                    <div class="o_row">
                                        <field name="encogimiento_largo_min"/>
                                        <span class="text-muted">a</span>
                                        <field name="encogimiento_largo_max"/>
                                    </div>
                                    <label for="encogimiento_ancho" string="Encogimiento a lo ancho"/>
                                    <div class="o_row">
                                        <field name="encogimiento_ancho"/>
                                        <span class="text-muted">+</span>
                                        <field name="encogimiento_ancho_tol"/>
                                        <span class="text-muted">/ −</span>
                                        <field name="encogimiento_ancho_tol_minus"/>
                                        <field name="encogimiento_ancho_tol_unit_id" options="{'no_create': True}" placeholder="Unidad"/>
                                    </div>
                                    <!-- 2.30.0: el mismo dato como rango; al escribirlo calcula nominal y tolerancias. -->
                                    <label for="encogimiento_ancho_min" string="Rango (mín. a máx.)" class="text-muted"/>
                                    <div class="o_row">
                                        <field name="encogimiento_ancho_min"/>
                                        <span class="text-muted">a</span>
                                        <field name="encogimiento_ancho_max"/>
                                    </div>
                                    <label for="elongacion_largo_acabado" string="Elongación a lo largo"/>
                                    <div class="o_row">
                                        <field name="elongacion_largo_acabado"/>
                                        <span class="text-muted">+</span>
                                        <field name="elongacion_largo_acabado_tol"/>
                                        <span class="text-muted">/ −</span>
                                        <field name="elongacion_largo_acabado_tol_minus"/>
                                        <field name="elongacion_largo_acabado_tol_unit_id" options="{'no_create': True}" placeholder="Unidad"/>
                                    </div>
                                    <!-- 2.30.0: el mismo dato como rango; al escribirlo calcula nominal y tolerancias. -->
                                    <label for="elongacion_largo_acabado_min" string="Rango (mín. a máx.)" class="text-muted"/>
                                    <div class="o_row">
                                        <field name="elongacion_largo_acabado_min"/>
                                        <span class="text-muted">a</span>
                                        <field name="elongacion_largo_acabado_max"/>
                                    </div>
                                    <label for="elongacion_ancho_acabado" string="Elongación a lo ancho"/>
                                    <div class="o_row">
                                        <field name="elongacion_ancho_acabado"/>
                                        <span class="text-muted">+</span>
                                        <field name="elongacion_ancho_acabado_tol"/>
                                        <span class="text-muted">/ −</span>
                                        <field name="elongacion_ancho_acabado_tol_minus"/>
                                        <field name="elongacion_ancho_acabado_tol_unit_id" options="{'no_create': True}" placeholder="Unidad"/>
                                    </div>
                                    <!-- 2.30.0: el mismo dato como rango; al escribirlo calcula nominal y tolerancias. -->
                                    <label for="elongacion_ancho_acabado_min" string="Rango (mín. a máx.)" class="text-muted"/>
                                    <div class="o_row">
                                        <field name="elongacion_ancho_acabado_min"/>
                                        <span class="text-muted">a</span>
                                        <field name="elongacion_ancho_acabado_max"/>
                                    </div>
                                    <field name="encogimiento_largo_dentro_norma"/>
                                    <field name="encogimiento_ancho_dentro_norma"/>
                                </group>
                            </group>
                            <separator string="Real"/>
                            <group>
                                <group>
                                    <field name="rendimiento_tela_acabada" string="Rendimiento (m/kg)" readonly="estado in ('activa', 'obsoleta')"/>
                                    <field name="rendimiento_manual" widget="boolean_toggle"/>
                                    <field name="rendimiento_fuente"/>
                                    <div colspan="2" class="text-muted small" invisible="not rendimiento_manual">
                                        Escrito a mano por Ingeniería: el recálculo nocturno no lo cambia hasta que haya 3
                                        rollos de Inspección. Desmarque «Rendimiento forzado» para volver al cálculo.
                                    </div>
                                    <div colspan="2" class="text-muted small" invisible="rendimiento_fuente != 'rollos'">
                                        Metros ÷ kg netos de
                                        <field name="rendimiento_real_ordenes" class="oe_inline" readonly="1"/>
                                        rollos de primera y FE pesados en Inspección en 12 meses; se recalcula cada noche.
                                    </div>
                                    <div colspan="2" class="text-muted small" invisible="rendimiento_fuente != 'terminado'">
                                        Metros ÷ kg de tela terminada de
                                        <field name="rendimiento_real_ordenes" class="oe_inline" readonly="1"/>
                                        conversiones a kg (kg de la lista de empaque) en 12 meses, mientras la tela no
                                        tenga 3 rollos de Inspección; se recalcula cada noche.
                                    </div>
                                    <div colspan="2" class="text-muted small" invisible="rendimiento_fuente != 'estimado'">
                                        Sin rollos de Inspección ni conversiones a kg: metros por kg que entró de
                                        <field name="rendimiento_real_ordenes" class="oe_inline" readonly="1"/>
                                        órdenes × el consumo de crudo de la ficha. Es una estimación.
                                    </div>
                                    <field name="peso_real"/>
                                    <field name="rendimiento_por_revisar" invisible="1"/>
                                    <field name="rendimiento_teorico"/>
                                    <field name="rendimiento_teorico_ancho"/>
                                    <field name="rendimiento_medido" invisible="not rendimiento_medido"/>
                                    <field name="rendimiento_medido_fuente" invisible="not rendimiento_medido"/>
                                    <field name="rendimiento_medido_ordenes" invisible="not rendimiento_medido"/>
                                    <field name="rendimiento_medido_estado" invisible="not rendimiento_medido"/>
                                    <div colspan="2" class="alert alert-warning" role="status" invisible="not rendimiento_por_revisar">
                                        Lo fabricado da otro rendimiento que la ficha (calculado el
                                        <field name="rendimiento_cambio_fecha" class="oe_inline" readonly="1"/>). La ficha
                                        no cambia sola: úselo o quédese con el de la ficha.
                                        <button name="action_ft_usar_rendimiento_medido" type="object" string="Usar el medido"
                                                class="btn btn-sm btn-primary ms-2"/>
                                        <button name="action_ft_rendimiento_revisado" type="object" string="Dejar el de la ficha"
                                                class="btn btn-sm btn-secondary ms-2"/>
                                    </div>
                                    <div colspan="2" class="alert alert-danger" role="alert" invisible="rendimiento_medido_estado != 'fuera'">
                                        Lo fabricado se aleja más de 25 % del rendimiento teórico (peso y ancho de la
                                        ficha): es un dato malo y no se propone. Revise el peso, el ancho o las órdenes.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Ruta y máquinas" name="operaciones">
                            <p class="text-muted">Las operaciones de la lista de la ruta (flujo en kg) y de sus intermedios (no las
                                del crudo), con los datos del artículo en cada máquina. Las operaciones se editan en la lista
                                de materiales y los datos en Máquinas → Procesos por artículo. «Máquinas posibles» son la
                                máquina de la operación y sus alternativas como las ve el planificador: ✓ el artículo corre
                                ahí, ✗ no hay proceso del artículo, ⚠ la máquina no está operando, ○ el artículo corre en
                                otra máquina que no es alternativa.</p>
                            <!-- 2.23.0: la ruta de la familia (crudo) y lo propio de la tela; las listas se generan desde aquí. -->
                            <group string="Ruta de la familia">
                                <group>
                                    <field name="ruta_familia_id" readonly="1"/>
                                    <field name="ruta_resumen" readonly="1" invisible="not ruta_familia_id"/>
                                    <field name="ruta_tintoreria" readonly="1"/>
                                    <field name="ruta_tintoreria_manual" readonly="estado in ('activa', 'obsoleta')"/>
                                </group>
                                <group>
                                    <field name="ruta_rama_id" options="{'no_create': True}" readonly="estado in ('activa', 'obsoleta')"/>
                                    <field name="ruta_jet_id" options="{'no_create': True}" readonly="estado in ('activa', 'obsoleta')"/>
                                    <field name="consumo_crudo" readonly="estado in ('activa', 'obsoleta')"/>
                                </group>
                            </group>
                            <div class="mb-3">
                                <button name="action_ft_generar_listas" type="object" string="Generar listas desde la ruta"
                                        class="btn-secondary" invisible="not ruta_familia_id or estado != 'revision'"
                                        help="Arma o pone al día la lista en kg y la de metros de esta tela con la ruta de su familia. Solo si están archivadas: las activas las cambia Ingeniería."/>
                                <span class="text-muted" invisible="ruta_familia_id">El crudo de esta tela no tiene ruta de
                                    familia: se arma en Artículos → Rutas por familia.</span>
                            </div>
                            <div class="alert alert-warning mb-2" role="alert" invisible="not operacion_aviso">
                                <field name="operacion_aviso" readonly="1" nolabel="1"/>
                            </div>
                            <separator string="Operaciones"/>
                            <field name="operacion_ids" readonly="1">
                                <list decoration-warning="ft_aviso">
                                    <field name="bom_id" optional="show"/>
                                    <field name="sequence" optional="hide"/>
                                    <field name="name"/>
                                    <field name="workcenter_id"/>
                                    <field name="ft_tipo_id" optional="show"/>
                                    <field name="ft_maquinas_posibles" optional="show"/>
                                    <field name="ft_proceso_resumen"/>
                                    <field name="time_cycle_manual" optional="show"/>
                                    <!-- 2.22.0: tiempo de rama que da la ficha y su cálculo (o el dato que falta). -->
                                    <field name="ft_tiempo_difiere" column_invisible="True"/>
                                    <field name="ft_tiempo_ficha" optional="show" decoration-danger="ft_tiempo_difiere"/>
                                    <field name="ft_tiempo_calculo" optional="hide"/>
                                    <field name="ft_aviso" optional="show"/>
                                </list>
                            </field>
                            <separator string="Todas las máquinas en que corre el artículo"/>
                            <field name="proceso_ids" readonly="1">
                                <list>
                                    <field name="articulo" optional="show"/>
                                    <field name="tipo_id"/>
                                    <field name="workcenter_id"/>
                                    <field name="resumen"/>
                                    <field name="metros_hora" optional="show"/>
                                    <field name="fecha" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <!-- 2.33.0 (Jose, 2026-11-24): las dos listas de materiales de la tela dentro de la ficha, solo para
                             ver; se cambian en la ficha y se pasan con «Corregir con la ficha». -->
                        <page string="Listas de materiales" name="ft_listas">
                            <field name="ft_lista_kg_activa" invisible="1"/>
                            <field name="ft_lista_m_activa" invisible="1"/>
                            <field name="ft_corregible" invisible="1"/>
                            <div invisible="ft_lista_kg_id or ft_lista_m_id" class="text-muted">
                                Las listas se generan al enviar la ficha a revisión.
                            </div>
                            <group invisible="not ft_lista_kg_id and not ft_lista_m_id">
                                <group>
                                    <field name="ft_lista_kg_id" readonly="1"/>
                                    <field name="ft_lista_m_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="ft_revisada_el" readonly="1"/>
                                </group>
                            </group>
                            <div invisible="not ft_lista_kg_id">
                                <h3 class="mt-3">
                                    Lista en kg (acabado en proceso)
                                    <span class="badge text-bg-success ms-2" invisible="not ft_lista_kg_activa">En uso</span>
                                    <span class="badge text-bg-secondary ms-2" invisible="ft_lista_kg_activa">Borrador (archivada)</span>
                                    <button name="action_ft_abrir_lista_kg" type="object" string="Abrir la lista"
                                            class="btn btn-link btn-sm ms-2"/>
                                </h3>
                                <separator string="Componentes"/>
                                <field name="ft_lista_kg_line_ids" readonly="1" nolabel="1">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom_id"/>
                                        <field name="operation_id" optional="show"/>
                                    </list>
                                </field>
                                <separator string="Operaciones"/>
                                <field name="ft_lista_kg_op_ids" readonly="1" nolabel="1">
                                    <list decoration-warning="ft_tiempo_difiere">
                                        <field name="sequence" optional="hide"/>
                                        <field name="name"/>
                                        <field name="workcenter_id"/>
                                        <field name="time_cycle_manual" string="Duración (min)"/>
                                        <field name="ft_tiempo_ficha"/>
                                        <field name="ft_tiempo_difiere" column_invisible="True"/>
                                    </list>
                                </field>
                                <separator string="Subproductos (desperdicios)"/>
                                <field name="ft_lista_kg_sub_ids" readonly="1" nolabel="1">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom_id"/>
                                        <field name="operation_id" optional="show"/>
                                    </list>
                                </field>
                            </div>
                            <div invisible="not ft_lista_m_id">
                                <h3 class="mt-4">
                                    Lista en metros (Clasificación final)
                                    <span class="badge text-bg-success ms-2" invisible="not ft_lista_m_activa">En uso</span>
                                    <span class="badge text-bg-secondary ms-2" invisible="ft_lista_m_activa">Borrador (archivada)</span>
                                    <button name="action_ft_abrir_lista_m" type="object" string="Abrir la lista"
                                            class="btn btn-link btn-sm ms-2"/>
                                </h3>
                                <separator string="Componentes (kg por metro)"/>
                                <field name="ft_lista_m_line_ids" readonly="1" nolabel="1">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom_id"/>
                                    </list>
                                </field>
                                <separator string="Operaciones"/>
                                <field name="ft_lista_m_op_ids" readonly="1" nolabel="1">
                                    <list decoration-warning="ft_tiempo_difiere">
                                        <field name="name"/>
                                        <field name="workcenter_id"/>
                                        <field name="time_cycle_manual" string="Duración (min)"/>
                                        <field name="ft_tiempo_ficha"/>
                                        <field name="ft_tiempo_difiere" column_invisible="True"/>
                                    </list>
                                </field>
                                <separator string="Subproductos (saldos)"/>
                                <field name="ft_lista_m_sub_ids" readonly="1" nolabel="1">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom_id"/>
                                    </list>
                                </field>
                            </div>
                        </page>
                        <page string="Pendientes" name="ft_pendientes" invisible="not ft_pendientes_n">
                            <field name="ft_pendientes_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="area"/>
                                    <field name="tipo" column_invisible="True"/>
                                    <field name="detalle"/>
                                    <button name="action_ft_usar_medido" type="object" string="Usar el medido"
                                            class="btn-link" invisible="tipo != 'rendimiento_cambio'"/>
                                    <button name="action_ft_dejar_ficha" type="object" string="Dejar el de la ficha"
                                            class="btn-link" invisible="tipo != 'rendimiento_cambio'"/>
                                    <button name="action_ft_resolver" type="object" string="Resolver" icon="fa-wrench"
                                            class="btn-link" invisible="tipo == 'rendimiento_cambio'"/>
                                </list>
                            </field>
                        </page>
                        <!-- 2.16.0: la tintorería es una operación de la lista de materiales del acabado (F-P-D01-33 sin ficha aparte). -->
                        <page string="Tintorería" name="tintoreria">
                            <p class="text-muted">El jet, los datos del artículo en cada jet (temperatura, tiempo de ciclo, kg por
                                carga, relación y volumen de baño…) y la fórmula, sin recaptura: los datos se capturan en
                                Tintorería → Artículos en los jets y la fórmula en la lista de materiales.</p>
                            <div class="alert alert-warning mb-2" role="alert" invisible="not tint_aviso">
                                <field name="tint_aviso" readonly="1" nolabel="1"/>
                            </div>
                            <separator string="Jet en la lista de materiales"/>
                            <field name="tint_operacion_ids" readonly="1">
                                <list>
                                    <field name="bom_id" optional="show"/>
                                    <field name="name"/>
                                    <field name="workcenter_id"/>
                                    <field name="ft_maquinas_posibles" optional="show"/>
                                    <field name="time_cycle_manual" optional="show"/>
                                </list>
                            </field>
                            <separator string="El artículo en los jets"/>
                            <field name="tint_proceso_ids" readonly="1">
                                <list>
                                    <field name="workcenter_id"/>
                                    <field name="resumen"/>
                                    <field name="ft_volumen_bano"/>
                                    <field name="fecha" optional="show"/>
                                </list>
                            </field>
                            <separator string="Fórmula y auxiliares"/>
                            <field name="tint_linea_ids" readonly="1">
                                <list>
                                    <field name="bom_id" optional="show"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="operation_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Características" name="caracteristicas">
                            <p class="text-muted">Especificación del cliente y control interno por característica. El control interno nunca se imprime al cliente.</p>
                            <field name="spec_line_ids" context="{'default_acabado_id': id}">
                                <list editable="bottom" open_form_view="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="caracteristica_id" optional="hide"/>
                                    <field name="kind" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="direction"/>
                                    <field name="position" optional="show"/>
                                    <field name="unit"/>
                                    <field name="spec_limit" optional="show" readonly="kind != 'num'"/>
                                    <field name="spec_nominal" readonly="kind != 'num'"/>
                                    <field name="spec_tol_minus" readonly="kind != 'num' or spec_limit != 'tol'"/>
                                    <field name="spec_tol_plus" readonly="kind != 'num' or spec_limit != 'tol'"/>
                                    <field name="spec_min" optional="show" readonly="kind != 'num' or spec_limit != 'range'"/>
                                    <field name="spec_max" optional="show" readonly="kind != 'num' or spec_limit != 'range'"/>
                                    <field name="spec_tol_pct" optional="show" readonly="kind != 'num' or spec_limit != 'tol'"/>
                                    <field name="spec_text" optional="show" readonly="kind != 'text'"/>
                                    <field name="spec_bool" optional="hide" readonly="kind != 'bool'"/>
                                    <field name="spec_label" optional="hide"/>
                                    <field name="ctrl_tol_minus" optional="show" readonly="kind != 'num'"/>
                                    <field name="ctrl_tol_plus" optional="show" readonly="kind != 'num'"/>
                                    <field name="method" optional="hide"/>
                                    <field name="in_customer_spec" optional="show"/>
                                    <field name="in_coa" optional="show"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notas">
                            <field name="notas" placeholder="Notas"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ficha_tecnica_acabado_search" model="ir.ui.view">
        <field name="name">ficha.tecnica.acabado.search</field>
        <field name="model">ficha.tecnica.acabado</field>
        <field name="arch" type="xml">
            <search string="Buscar Ficha Técnica de Acabado">
                <field name="articulo"/>
                <field name="tejido_id"/>
                <field name="product_acabado_id"/>
                <field name="product_proceso_id"/>
                <filter string="Sin acabado en proceso (kg)" name="sin_proceso"
                        domain="[('product_proceso_id', '=', False)]"/>
                <filter string="Encogimiento fuera de norma" name="fuera_norma"
                        domain="['|', ('encogimiento_largo_dentro_norma','=',False),
                                      ('encogimiento_ancho_dentro_norma','=',False)]"/>
                <!-- 2.33.0: por estado de la ficha. -->
                <filter string="Borrador" name="borrador" domain="[('estado', '=', 'borrador')]"/>
                <filter string="En revisión" name="en_revision" domain="[('estado', '=', 'revision')]"/>
                <filter string="Activa" name="activa" domain="[('estado', '=', 'activa')]"/>
                <filter string="Obsoleta" name="obsoleta" domain="[('estado', '=', 'obsoleta')]"/>
                <separator/>
                <filter string="Archivadas" name="inactive" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado'}"/>
                    <filter string="Ficha de Tejido (base)" name="group_tejido" context="{'group_by':'tejido_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 2.33.0: cada ficha en la columna de su estado, como las etapas de Odoo. -->
    <record id="view_ficha_tecnica_acabado_kanban" model="ir.ui.view">
        <field name="name">ficha.tecnica.acabado.kanban</field>
        <field name="model">ficha.tecnica.acabado</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" group_create="false" group_delete="false" group_edit="false"
                    records_draggable="false">
                <field name="estado"/>
                <field name="ft_pendientes_n"/>
                <field name="ft_lista_kg_activa"/>
                <templates>
                    <t t-name="card">
                        <field name="articulo" class="fw-bold"/>
                        <field name="product_acabado_id" class="text-muted small"/>
                        <div class="small">
                            <field name="peso_acabado"/> g/m² · <field name="ancho_acabado"/> cm ·
                            <field name="rendimiento_tela_acabada"/> m/kg
                        </div>
                        <footer>
                            <span class="badge text-bg-danger" t-if="record.ft_pendientes_n.raw_value">
                                <t t-esc="record.ft_pendientes_n.value"/> pendiente(s)
                            </span>
                            <span class="badge text-bg-success" t-if="record.ft_lista_kg_activa.raw_value">Lista en uso</span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_ficha_tecnica_acabado" model="ir.actions.act_window">
        <field name="name">Fichas de acabado</field>
        <field name="res_model">ficha.tecnica.acabado</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_estado': 1}</field>
        <field name="search_view_id" ref="view_ficha_tecnica_acabado_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera ficha técnica de acabado
            </p>
            <p>
                Cada producto de tela acabada (ej. un color específico) tiene
                su propia ficha, vinculada a la ficha de tejido que le sirve
                de base. Captura manual, o usa "Importar Acabado desde
                Excel" para cargar varios artículos a la vez.
            </p>
        </field>
    </record>

</odoo>
