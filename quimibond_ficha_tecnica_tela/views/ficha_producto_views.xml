<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 2.23.0 (Dirección General 2026-11-03): la ficha técnica en las pantallas nativas de Odoo. Extienden vistas de
         product y mrp (otros módulos). 2.23.0: los parámetros de la operación pasan a tiempo_ficha_views.xml (una
         sola herencia del formulario de operación); en el centro de trabajo se pueden agregar telas. -->

    <!-- ===== Producto: pestaña «Ficha técnica» (primera, solo si el producto tiene ficha) ===== -->
    <record id="view_product_template_form_ft_ficha_nativa" model="ir.ui.view">
        <field name="name">product.template.form.ft.ficha.nativa</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[1]" position="before">
                <page string="Ficha técnica" name="ft_ficha_tecnica" invisible="not ft_tiene_ficha">
                    <field name="ft_tiene_ficha" invisible="1"/>
                    <field name="ft_es_tela" invisible="1"/>
                    <field name="ft_es_crudo" invisible="1"/>
                    <field name="ft_revision_listo" invisible="1"/>
                    <field name="ft_revision_id" invisible="1"/>

                    <!-- La tela (tela acabada en metros o su producto en kg) -->
                    <div invisible="not ft_es_tela" class="d-flex flex-wrap gap-2 mb-3">
                        <button name="action_ft_datos_ficha" type="object" string="Usar los datos de la ficha"
                                class="btn-primary" invisible="ft_revision_listo"
                                help="Capacidad de los jets, tiempos de las operaciones y conversión a metros desde la ficha; luego vuelve a revisar la tela."/>
                        <button name="action_ft_revisar" type="object" string="Volver a revisar" class="btn-secondary"/>
                        <button name="action_ft_generar_listas" type="object" string="Generar listas desde la ruta"
                                class="btn-secondary"
                                help="Arma o pone al día la lista en kg y la de metros con la ruta de la familia (solo las archivadas)."/>
                        <button name="action_ft_bom_kg" type="object" string="Lista en kg" class="btn-secondary"
                                icon="fa-sitemap" invisible="not ft_bom_kg_id"/>
                        <button name="action_ft_bom_m" type="object" string="Lista en metros" class="btn-secondary"
                                icon="fa-sitemap" invisible="not ft_bom_m_id"/>
                        <button name="action_view_ficha_tecnica_acabado" type="object" string="Ficha de acabado"
                                class="btn-secondary" icon="fa-file-text"
                                help="Los datos de origen de la tela (especificación, tintorería, validaciones del SGI)."/>
                        <button name="action_ft_procesos" type="object" string="Procesos de la tela" class="btn-secondary"
                                icon="fa-tachometer"/>
                        <field name="ft_bom_kg_id" invisible="1"/>
                        <field name="ft_bom_m_id" invisible="1"/>
                    </div>
                    <div invisible="not ft_es_crudo" class="d-flex flex-wrap gap-2 mb-3">
                        <button name="action_view_ficha_tecnica_tejido" type="object" string="Fichas de tejido"
                                class="btn-secondary" icon="fa-file-text-o"/>
                    </div>
                    <!-- 2.24.0 (Dirección General 2026-11-03): solo lectura; cada bloque dice de qué ficha sale y la
                         ayuda de cada campo (pasar el mouse) dice la pestaña y el campo. Se edita en el módulo. -->
                    <div invisible="not ft_es_tela" class="text-muted small mb-2">
                        Solo lectura. Los datos se cambian en su ficha (Fichas técnicas → Artículos); pase el mouse
                        por cada campo para ver de dónde sale.
                    </div>
                    <group invisible="not ft_es_tela">
                        <group string="La tela">
                            <field name="ft_acabado_ficha_id" string="Sale de la ficha de acabado"/>
                            <field name="ft_peso"/>
                            <field name="ft_ancho"/>
                            <field name="ft_rendimiento"/>
                            <label for="ft_ancho_rama"/>
                            <div class="o_row">
                                <field name="ft_ancho_rama"/>
                                <span class="text-muted" invisible="not ft_ancho_rama_origen">
                                    (<field name="ft_ancho_rama_origen" class="oe_inline"/>)
                                </span>
                            </div>
                            <field name="ft_producto_kg_id"/>
                            <field name="ft_producto_m_id"/>
                        </group>
                        <group string="El crudo">
                            <field name="ft_tejido_ficha_id" string="Sale de la ficha de tejido"/>
                            <field name="ft_crudo_id"/>
                            <field name="ft_crudo_peso"/>
                            <field name="ft_crudo_ancho"/>
                            <field name="ft_crudo_rendimiento"/>
                            <field name="ft_crudo_telas_count"/>
                        </group>
                    </group>
                    <div invisible="not ft_es_tela or ft_crudo_telas_count &lt; 2" class="alert alert-info" role="status">
                        Este crudo lo usan <field name="ft_crudo_telas_count" class="oe_inline" readonly="1"/> telas: sus
                        datos (peso, ancho, hilos, circulares) se editan en el crudo, no aquí.
                        <button name="action_ft_crudo" type="object" string="Abrir el crudo" class="btn-link"/>
                    </div>
                    <separator string="La ruta (operaciones de sus listas de materiales)" invisible="not ft_es_tela"/>
                    <div invisible="not ft_es_tela" class="text-muted small">
                        «Duración» es la de la lista (con ella planea Odoo); «Tiempo de la ficha» sale de la ficha de
                        acabado y de los procesos de la tela en esa máquina, con la cuenta en «Cálculo».
                    </div>
                    <field name="ft_operacion_ids" readonly="1" invisible="not ft_es_tela">
                        <list decoration-warning="ft_tiempo_difiere">
                            <field name="bom_id" string="Lista" optional="show"/>
                            <field name="name"/>
                            <field name="workcenter_id"/>
                            <field name="time_cycle_manual" string="Duración (min)"/>
                            <field name="ft_tiempo_ficha"/>
                            <field name="ft_tiempo_difiere" column_invisible="True"/>
                            <field name="ft_tiempo_calculo" string="Cálculo" optional="show"/>
                        </list>
                    </field>
                    <separator string="Especificación (de la ficha de acabado, pestaña «Características»)" invisible="not ft_es_tela"/>
                    <field name="ft_spec_ids" readonly="1" invisible="not ft_es_tela">
                        <list>
                            <field name="name"/>
                            <field name="unit"/>
                            <field name="spec_nominal"/>
                            <field name="spec_tol_minus"/>
                            <field name="spec_tol_plus"/>
                            <field name="method" optional="show"/>
                        </list>
                    </field>
                    <separator string="Pendientes" invisible="not ft_es_tela"/>
                    <field name="ft_estado" invisible="1"/>
                    <div invisible="ft_estado != 'para_activar'" class="alert alert-info" role="status">
                        <strong>Lista para activar.</strong> Las listas cuadran con la ficha y la lista en kg sigue
                        archivada: Ingeniería la revisa y la activa (con la de metros, para que no quede un círculo).
                    </div>
                    <div invisible="ft_estado != 'activa_pendientes'" class="alert alert-warning" role="alert">
                        <strong>La lista en kg ya está activa y tiene pendientes:</strong> Odoo fabrica con datos que no
                        cuadran con la ficha.
                    </div>
                    <div invisible="not ft_es_tela or ft_revision_id" class="text-muted">
                        Sin revisión todavía: «Volver a revisar» la hace.
                    </div>
                    <div invisible="not ft_revision_listo" class="alert alert-success" role="status">
                        Las listas de esta tela cuadran con la ficha.
                    </div>
                    <field name="ft_pendiente_ids" readonly="1" invisible="not ft_es_tela or ft_revision_listo">
                        <list>
                            <field name="area"/>
                            <field name="tipo"/>
                            <field name="detalle"/>
                        </list>
                    </field>

                    <!-- El crudo, visto desde su propio producto -->
                    <separator string="Circulares donde se teje" invisible="not ft_es_crudo"/>
                    <field name="ft_tejido_ids" readonly="1" invisible="not ft_es_crudo">
                        <list>
                            <field name="maquina_tejido"/>
                            <field name="maquina_config_id" optional="show"/>
                            <field name="galga"/>
                            <field name="diametro"/>
                            <field name="peso_acondicionado"/>
                            <field name="ancho_acondicionado"/>
                            <field name="rendimiento_tela_tejida"/>
                        </list>
                    </field>
                    <separator string="Telas que usan este crudo" invisible="not ft_es_crudo"/>
                    <field name="ft_tela_ids" readonly="1" invisible="not ft_es_crudo">
                        <list>
                            <field name="product_acabado_id"/>
                            <field name="peso_acabado"/>
                            <field name="ancho_acabado"/>
                            <field name="rendimiento_tela_acabada"/>
                        </list>
                    </field>
                </page>
                <!-- 2.23.0: producto con código de tela, acabado en kg o crudo y sin ficha: la ruta empieza aquí -->
                <page string="Ficha técnica" name="ft_ficha_tecnica_nueva"
                      invisible="ft_tiene_ficha or not ft_tipo_codigo">
                    <field name="ft_tipo_codigo" invisible="1"/>
                    <field name="ft_tela_m_de_kg_id" invisible="1"/>
                    <div invisible="ft_tipo_codigo != 'tela'">
                        <p>Esta tela todavía no tiene ficha técnica. La ficha de la tela guarda su peso, ancho y
                            rendimiento, la ficha de tejido en que se basa (su crudo), la especificación y la tintorería;
                            con ella se revisan sus listas de materiales.</p>
                        <button name="action_ft_crear_ficha" type="object" string="Crear la ficha de la tela"
                                class="btn-primary"/>
                    </div>
                    <div invisible="ft_tipo_codigo != 'crudo'">
                        <p>Este crudo todavía no tiene ficha de tejido (una por circular: máquina, hilos, ajustes, tela
                            acondicionada y rendimiento de tejido).</p>
                        <button name="action_ft_crear_ficha" type="object" string="Crear la ficha de tejido"
                                class="btn-primary"/>
                    </div>
                    <div invisible="ft_tipo_codigo != 'kg'">
                        <p>Este es el acabado en kg de una tela. Su ficha va en la tela en metros (el mismo código sin
                            la «I»).</p>
                        <button name="action_ft_crear_ficha" type="object" string="Abrir la tela en metros"
                                class="btn-primary" invisible="not ft_tela_m_de_kg_id"/>
                        <div invisible="ft_tela_m_de_kg_id" class="text-muted">La tela en metros no existe todavía:
                            la da de alta Innovación (C1 del SGI).</div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ===== Centro de trabajo: telas que corren aquí ===== -->
    <record id="view_mrp_workcenter_form_ft_telas" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.ft.telas</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Telas que corren aquí" name="ft_telas" invisible="not ft_tipo_id">
                    <field name="ft_tipo_id" invisible="1"/>
                    <field name="ft_proceso_ids" context="{'default_workcenter_id': id}">
                        <list>
                            <field name="articulo"/>
                            <field name="product_id" optional="show"/>
                            <field name="resumen"/>
                            <field name="fuente" optional="hide"/>
                            <button name="action_ft_editar" type="object" icon="fa-pencil" title="Editar los parámetros"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ===== App Fichas técnicas: el concentrado (abre el producto nativo) ===== -->
    <record id="view_product_template_ft_telas_list" model="ir.ui.view">
        <field name="name">product.template.list.ft.telas</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Acabado" create="0" decoration-success="ft_revision_listo" decoration-danger="ft_revision_n">
                <header>
                    <button name="action_ft_actualizar_revision" type="object" string="Actualizar la revisión"
                            display="always" class="btn-secondary"
                            help="Rehace la revisión de todas las telas, como la de cada noche."/>
                </header>
                <field name="default_code"/>
                <field name="name"/>
                <field name="ft_peso"/>
                <field name="ft_ancho"/>
                <field name="ft_rendimiento"/>
                <field name="ft_crudo_id"/>
                <field name="ft_estado" widget="badge" decoration-muted="ft_estado == 'sin_revisar'"
                       decoration-danger="ft_estado in ('pendientes', 'activa_pendientes')"
                       decoration-info="ft_estado == 'para_activar'" decoration-success="ft_estado == 'activa'"/>
                <field name="ft_revision_n"/>
                <field name="ft_revision_areas" optional="show"/>
                <field name="ft_revision_listo" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_product_template_ft_telas_search" model="ir.ui.view">
        <field name="name">product.template.search.ft.telas</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search string="Acabado">
                <field name="name" string="Tela" filter_domain="['|', ('default_code', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="ft_crudo_id" string="Crudo"/>
                <filter name="ft_pendientes" string="Con pendientes"
                        domain="[('ft_estado', 'in', ['pendientes', 'activa_pendientes'])]"/>
                <filter name="ft_para_activar" string="Lista para activar" domain="[('ft_estado', '=', 'para_activar')]"/>
                <filter name="ft_activa_pendientes" string="Activa con pendientes"
                        domain="[('ft_estado', '=', 'activa_pendientes')]"/>
                <filter name="ft_activa" string="Activa" domain="[('ft_estado', '=', 'activa')]"/>
                <filter name="ft_sin_revisar" string="Sin revisar" domain="[('ft_estado', '=', 'sin_revisar')]"/>
                <separator/>
                <filter name="ft_area_ingenieria" string="Pendientes de Ingeniería"
                        domain="[('ft_area_pendiente', '=', 'ingenieria')]"/>
                <filter name="ft_area_tintoreria" string="Pendientes de Tintorería"
                        domain="[('ft_area_pendiente', '=', 'tintoreria')]"/>
                <filter name="ft_area_acabado" string="Pendientes de Acabado"
                        domain="[('ft_area_pendiente', '=', 'acabado')]"/>
                <filter name="ft_area_inspeccion" string="Pendientes de Inspección"
                        domain="[('ft_area_pendiente', '=', 'inspeccion')]"/>
                <filter name="ft_area_manufactura" string="Pendientes de Manufactura"
                        domain="[('ft_area_pendiente', '=', 'manufactura')]"/>
            </search>
        </field>
    </record>

    <record id="view_product_template_ft_crudos_list" model="ir.ui.view">
        <field name="name">product.template.list.ft.crudos</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Crudos" create="0">
                <field name="default_code"/>
                <field name="name"/>
                <field name="ficha_tecnica_tejido_count" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_ft_telas" model="ir.actions.act_window">
        <field name="name">Acabado</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ft_es_tela', '=', True)]</field>
        <field name="search_view_id" ref="view_product_template_ft_telas_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_template_ft_telas_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin telas con ficha</p>
            <p>Cada tela acabada con ficha de acabado, con su estado: con pendientes, lista para activar o activa. Al
                abrirla, su pestaña «Ficha técnica» muestra la tela, su crudo, la ruta, la especificación y sus
                pendientes. Una tela sin ficha se la crea desde su producto (pestaña «Ficha técnica»).</p>
        </field>
    </record>

    <record id="action_ft_crudos" model="ir.actions.act_window">
        <field name="name">Crudos</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ft_es_crudo', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_template_ft_crudos_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin crudos con ficha</p>
            <p>Cada crudo con ficha de tejido. Al abrirlo, su pestaña «Ficha técnica» muestra las circulares donde se
                teje y las telas que lo usan.</p>
        </field>
    </record>
</odoo>
