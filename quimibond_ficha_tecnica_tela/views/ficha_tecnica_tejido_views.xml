<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ficha_tecnica_tejido_list" model="ir.ui.view">
        <field name="name">ficha.tecnica.tejido.list</field>
        <field name="model">ficha.tecnica.tejido</field>
        <field name="arch" type="xml">
            <list string="Fichas Técnicas de Tejido">
                <field name="articulo"/>
                <field name="revision"/>
                <field name="product_proceso_id"/>
                <field name="ficha_acabado_count" string="Fichas de acabado"/>
                <field name="maquina_tejido"/>
                <field name="ancho_rollo"/>
                <field name="peso_promedio_rollo"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ficha_tecnica_tejido_form" model="ir.ui.view">
        <field name="name">ficha.tecnica.tejido.form</field>
        <field name="model">ficha.tecnica.tejido</field>
        <field name="arch" type="xml">
            <form string="Ficha Técnica de Tejido">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_fichas_acabado" type="object"
                                class="oe_stat_button" icon="fa-list-alt"
                                invisible="ficha_acabado_count == 0">
                            <field name="ficha_acabado_count" widget="statinfo"
                                   string="Fichas de Acabado"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="articulo" placeholder="Ej. WJ044Q22HNT235"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="revision"/>
                            <field name="fecha_elaboracion"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="product_proceso_id"/>
                        </group>
                        <group>
                            <field name="jefe_manufactura"/>
                            <field name="auxiliar_procesos"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Máquina e Hilos">
                            <group>
                                <group string="Datos de máquina">
                                    <field name="maquina_tejido"/>
                                    <field name="marca_maquina"/>
                                    <field name="galga"/>
                                    <field name="diametro"/>
                                    <field name="no_agujas"/>
                                    <field name="no_alimentadores"/>
                                    <field name="velocidad"/>
                                    <field name="vueltas_por_rollo"/>
                                </group>
                            </group>
                            <field name="hilo_line_ids">
                                <list editable="bottom">
                                    <field name="numero"/>
                                    <field name="tipo_hilo"/>
                                    <field name="titulo_hilo"/>
                                    <field name="torsion"/>
                                    <field name="porcentaje"/>
                                    <field name="lote"/>
                                    <field name="proveedor_id" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>

                        <page string="Especificaciones">
                            <h4>Datos por polea</h4>
                            <table class="table table-bordered o_list_view" style="width:100%">
                                <thead>
                                    <tr class="text-center">
                                        <th>Dato</th>
                                        <th>Polea 1</th>
                                        <th>Polea 2</th>
                                        <th colspan="2">Tolerancia</th>
                                    </tr>
                                    <tr class="text-center text-muted">
                                        <td>Hilo</td>
                                        <td>HILO SET</td>
                                        <td>HILO STRETCH</td>
                                        <td colspan="2"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Longitud de malla</td>
                                        <td><field name="longitud_malla_polea1" nolabel="1"/></td>
                                        <td><field name="longitud_malla_polea2" nolabel="1"/></td>
                                        <td>+/- <field name="longitud_malla_tol" nolabel="1"/></td>
                                        <td><field name="longitud_malla_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Consumo - cm/vta</td>
                                        <td><field name="consumo_cm_vta_polea1" nolabel="1"/></td>
                                        <td><field name="consumo_cm_vta_polea2" nolabel="1"/></td>
                                        <td>+/- <field name="consumo_cm_vta_tol" nolabel="1"/></td>
                                        <td><field name="consumo_cm_vta_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Polea de alimentación</td>
                                        <td><field name="polea_alimentacion_polea1" nolabel="1"/></td>
                                        <td><field name="polea_alimentacion_polea2" nolabel="1"/></td>
                                        <td>+/- <field name="polea_alimentacion_tol" nolabel="1"/></td>
                                        <td><field name="polea_alimentacion_tol_unit" nolabel="1"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <h4 class="mt-3">Datos generales</h4>
                            <table class="table table-bordered o_list_view" style="width:100%">
                                <thead>
                                    <tr class="text-center">
                                        <th>Dato</th>
                                        <th>Valor</th>
                                        <th colspan="2">Tolerancia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Tensión</td>
                                        <td><field name="tension" nolabel="1"/></td>
                                        <td>+/- <field name="tension_tol" nolabel="1"/></td>
                                        <td><field name="tension_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Punto cilindro</td>
                                        <td><field name="punto_cilindro" nolabel="1"/></td>
                                        <td>+/- <field name="punto_cilindro_tol" nolabel="1"/></td>
                                        <td><field name="punto_cilindro_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Punto plato</td>
                                        <td><field name="punto_plato" nolabel="1"/></td>
                                        <td>+/- <field name="punto_plato_tol" nolabel="1"/></td>
                                        <td><field name="punto_plato_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Altura plato</td>
                                        <td><field name="altura_plato" nolabel="1"/></td>
                                        <td>+/- <field name="altura_plato_tol" nolabel="1"/></td>
                                        <td><field name="altura_plato_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Ancho de bastidor</td>
                                        <td><field name="ancho_bastidor" nolabel="1"/></td>
                                        <td>+/- <field name="ancho_bastidor_tol" nolabel="1"/></td>
                                        <td><field name="ancho_bastidor_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Estiraje</td>
                                        <td><field name="estiraje" nolabel="1"/></td>
                                        <td>+/- <field name="estiraje_tol" nolabel="1"/></td>
                                        <td><field name="estiraje_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Ancho de rollo</td>
                                        <td><field name="ancho_rollo" nolabel="1"/></td>
                                        <td>+/- <field name="ancho_rollo_tol" nolabel="1"/></td>
                                        <td><field name="ancho_rollo_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Peso promedio de rollo</td>
                                        <td><field name="peso_promedio_rollo" nolabel="1"/></td>
                                        <td>+/- <field name="peso_promedio_rollo_tol" nolabel="1"/></td>
                                        <td><field name="peso_promedio_rollo_tol_unit" nolabel="1"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </page>

                        <page string="Tela Acondicionada">
                            <h4>Datos de tela acondicionada</h4>
                            <table class="table table-bordered o_list_view" style="width:100%">
                                <thead>
                                    <tr class="text-center">
                                        <th>Condiciones</th>
                                        <th>Especificación</th>
                                        <th colspan="2">Tolerancia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Peso</td>
                                        <td><field name="peso_acondicionado" nolabel="1"/></td>
                                        <td><field name="peso_acondicionado_tol" nolabel="1"
                                                   placeholder="ej. +12 / -6"/></td>
                                        <td><field name="peso_acondicionado_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Ancho</td>
                                        <td><field name="ancho_acondicionado" nolabel="1"/></td>
                                        <td>+/- <field name="ancho_acondicionado_tol" nolabel="1"/></td>
                                        <td><field name="ancho_acondicionado_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Espesor</td>
                                        <td><field name="espesor_acondicionado" nolabel="1"/></td>
                                        <td>+/- <field name="espesor_acondicionado_tol" nolabel="1"/></td>
                                        <td><field name="espesor_acondicionado_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Columnas</td>
                                        <td><field name="columnas" nolabel="1"/></td>
                                        <td>+/- <field name="columnas_tol" nolabel="1"/></td>
                                        <td><field name="columnas_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Mallas</td>
                                        <td><field name="mallas" nolabel="1"/></td>
                                        <td>+/- <field name="mallas_tol" nolabel="1"/></td>
                                        <td><field name="mallas_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Elongación bajo carga largo</td>
                                        <td><field name="elongacion_carga_largo" nolabel="1"/></td>
                                        <td>+/- <field name="elongacion_carga_largo_tol" nolabel="1"/></td>
                                        <td><field name="elongacion_carga_largo_tol_unit" nolabel="1"/></td>
                                    </tr>
                                    <tr>
                                        <td>Elongación bajo carga ancho</td>
                                        <td><field name="elongacion_carga_ancho" nolabel="1"/></td>
                                        <td>+/- <field name="elongacion_carga_ancho_tol" nolabel="1"/></td>
                                        <td><field name="elongacion_carga_ancho_tol_unit" nolabel="1"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </page>

                        <page string="Notas">
                            <field name="notas"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ficha_tecnica_tejido_search" model="ir.ui.view">
        <field name="name">ficha.tecnica.tejido.search</field>
        <field name="model">ficha.tecnica.tejido</field>
        <field name="arch" type="xml">
            <search string="Buscar Ficha Técnica de Tejido">
                <field name="articulo"/>
                <field name="product_proceso_id"/>
                <filter string="Archivadas" name="inactive" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Artículo" name="group_articulo" context="{'group_by':'articulo'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ficha_tecnica_tejido" model="ir.actions.act_window">
        <field name="name">Fichas Técnicas de Tejido</field>
        <field name="res_model">ficha.tecnica.tejido</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ficha_tecnica_tejido_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera ficha técnica de tejido
            </p>
            <p>
                Captura manual, o usa "Importar Tejido desde Excel" para cargar
                varios artículos a la vez desde un archivo tabular.
            </p>
        </field>
    </record>

    <menuitem id="menu_ficha_tecnica_tela_root"
              name="Fichas Técnicas de Tela"
              sequence="60"/>
    <menuitem id="menu_ficha_tecnica_tejido_list"
              name="Fichas Técnicas de Tejido"
              parent="menu_ficha_tecnica_tela_root"
              action="action_ficha_tecnica_tejido"
              sequence="10"/>

</odoo>
