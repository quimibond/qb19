<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ficha_tecnica_tejido_list" model="ir.ui.view">
        <field name="name">ficha.tecnica.tejido.list</field>
        <field name="model">ficha.tecnica.tejido</field>
        <field name="arch" type="xml">
            <list string="Fichas Técnicas de Tejido">
                <field name="articulo"/>
                <field name="revision"/>
                <field name="maquina_tejido"/>
                <field name="fecha_elaboracion" optional="show"/>
                <field name="product_proceso_id"/>
                <field name="ficha_acabado_count" string="Fichas de acabado"/>
                <field name="maquina_config_id" optional="hide"/>
                <field name="rendimiento_tela_tejida" optional="show"/>
                <field name="salida_tela" optional="show"/>
                <field name="bom_aviso" optional="show"/>
                <field name="ancho_rollo"/>
                <field name="peso_promedio_rollo"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ficha_tecnica_tejido_form" model="ir.ui.view">
        <field name="name">ficha.tecnica.tejido.form</field>
        <field name="model">ficha.tecnica.tejido</field>
        <field name="arch" type="xml">
            <form string="Ficha Técnica de Tejido">
                <header>
                    <button name="action_ft_ligar_configuracion" type="object" string="Ligar a la configuración vigente"
                            invisible="maquina_config_id or not maquina_tejido"
                            help="Toma la configuración de la máquina vigente a la fecha de elaboración (hoy si no hay fecha). No se liga si un dato de máquina de la ficha contradice el de la configuración."/>
                    <button name="action_ft_reporte_ligado_ficha" type="object" string="Ligar hilos"
                            help="Reporte de los hilos de esta ficha con su producto candidato según la lista de materiales del crudo."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_fichas_acabado" type="object"
                                class="oe_stat_button" icon="fa-list-alt"
                                invisible="ficha_acabado_count == 0">
                            <field name="ficha_acabado_count" widget="statinfo"
                                   string="Fichas de Acabado"/>
                        </button>
                        <button name="action_ft_ver_maquina" type="object" class="oe_stat_button" icon="fa-cogs"
                                string="Máquina" invisible="not maquina_tejido"/>
                        <button name="action_ft_ver_bom" type="object" class="oe_stat_button" icon="fa-flask"
                                string="Lista de materiales" invisible="not bom_efectiva_id"/>
                        <button name="action_ft_ver_hilos" type="object" class="oe_stat_button" icon="fa-dot-circle-o"
                                string="Fichas de los hilos"/>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not bom_aviso">
                        <field name="bom_aviso" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not unidades_aviso">
                        <field name="unidades_aviso" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info mb-2" role="status" invisible="not maquina_config_aviso">
                        <field name="maquina_config_aviso" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info mb-2" role="status"
                         invisible="salida_tela or not maquina_config_id or not ancho_acondicionado">
                        La máquina no tiene capturada la «Salida de la tela» (tubular o abierta) en su configuración:
                        el rendimiento toma el ancho como tela abierta. Puede fijarlo en la ficha («Fijar medición del ancho»).
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="articulo" placeholder="Ej. WJ044Q22HNT235"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="revision"/>
                            <field name="fecha_elaboracion"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="product_proceso_id"/>
                            <field name="rendimiento_tela_tejida"/>
                            <field name="rendimiento_manual" widget="boolean_toggle"/>
                            <field name="salida_tela"/>
                            <field name="salida_tela_ficha"/>
                            <field name="product_proceso_tmpl_id" invisible="1"/>
                            <field name="bom_id" options="{'no_create': True}"
                                   placeholder="La principal del crudo"/>
                            <field name="bom_efectiva_id" invisible="bom_id or not bom_efectiva_id"/>
                        </group>
                        <group>
                            <field name="jefe_manufactura_id" options="{'no_create': True}"/>
                            <field name="auxiliar_procesos_id" options="{'no_create': True}"/>
                            <field name="jefe_manufactura" readonly="1" invisible="not jefe_manufactura"/>
                            <field name="auxiliar_procesos" readonly="1" invisible="not auxiliar_procesos"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Máquina e Hilos">
                            <group>
                                <group string="Datos de máquina">
                                    <!-- 2.3.0: los datos de máquina salen de la configuración de la máquina (cilindro)
                                         vigente a la fecha de elaboración; con configuración no se capturan aquí. -->
                                    <field name="galga_requerida"/>
                                    <field name="maquina_tejido" options="{'no_create': True}"
                                           domain="galga_requerida and [('ft_galga', '=', galga_requerida)] or []"/>
                                    <field name="maquina_config_id" options="{'no_create': True}" invisible="not maquina_tejido"/>
                                    <field name="maquina_tejido_texto" readonly="1" invisible="not maquina_tejido_texto"/>
                                    <field name="marca_maquina" readonly="maquina_config_id"/>
                                    <field name="galga" readonly="maquina_config_id"/>
                                    <field name="diametro" readonly="maquina_config_id"/>
                                    <field name="no_agujas" readonly="maquina_config_id"/>
                                    <field name="no_alimentadores" readonly="maquina_config_id"/>
                                    <field name="velocidad"/>
                                    <div colspan="2" class="alert alert-warning mb-0" role="alert" invisible="not velocidad_aviso">
                                        <field name="velocidad_aviso" readonly="1" nolabel="1"/>
                                    </div>
                                    <field name="vueltas_por_rollo"/>
                                </group>
                            </group>
                            <!-- 2.9.0: el hilo es el producto; el texto anterior queda de solo lectura. -->
                            <field name="hilo_line_ids">
                                <list editable="bottom">
                                    <field name="numero"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="material_resumen" optional="show"/>
                                    <field name="porcentaje"/>
                                    <field name="bom_pct" optional="show"/>
                                    <field name="polea" optional="show"/>
                                    <field name="alimentadores" optional="show"/>
                                    <field name="secuencia_alimentacion" optional="hide"/>
                                    <field name="consumo_cm_vta" optional="show"/>
                                    <field name="longitud_malla" optional="hide"/>
                                    <field name="proveedor_permitido_ids" column_invisible="1"/>
                                    <field name="proveedor_id" options="{'no_create': True}"
                                           domain="proveedor_permitido_ids and [('id', 'in', proveedor_permitido_ids)] or [('supplier_rank', '>', 0)]"/>
                                    <field name="lote_id" options="{'no_create': True}" optional="show"/>
                                    <field name="tipo_hilo" optional="show" readonly="product_id"/>
                                    <field name="titulo_hilo" optional="show" readonly="product_id"/>
                                    <field name="torsion" optional="show" readonly="product_id"/>
                                    <field name="lote" optional="hide" readonly="lote_id"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="hilo_pct_total"/>
                                </group>
                            </group>
                        </page>

                        <page string="Especificaciones">
                            <h4>Datos por polea</h4>
                            <table class="table table-bordered o_list_view" style="width:100%">
                                <thead>
                                    <tr class="text-center">
                                        <th>Dato</th>
                                        <th>Polea 1</th>
                                        <th>Polea 2</th>
                                        <th colspan="2">Tolerancia</th>
                                    </tr>
                                    <tr class="text-center text-muted">
                                        <td>Hilo</td>
                                        <td>HILO SET</td>
                                        <td>HILO STRETCH</td>
                                        <td colspan="2"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Longitud de malla</td>
                                        <td><field name="longitud_malla_polea1" nolabel="1"/></td>
                                        <td><field name="longitud_malla_polea2" nolabel="1"/></td>
                                        <td>+/- <field name="longitud_malla_tol" nolabel="1"/></td>
                                        <td><field name="longitud_malla_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Consumo - cm/vta</td>
                                        <td><field name="consumo_cm_vta_polea1" nolabel="1"/></td>
                                        <td><field name="consumo_cm_vta_polea2" nolabel="1"/></td>
                                        <td>+/- <field name="consumo_cm_vta_tol" nolabel="1"/></td>
                                        <td><field name="consumo_cm_vta_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Polea de alimentación</td>
                                        <td><field name="polea_alimentacion_polea1" nolabel="1"/></td>
                                        <td><field name="polea_alimentacion_polea2" nolabel="1"/></td>
                                        <td>+/- <field name="polea_alimentacion_tol" nolabel="1"/></td>
                                        <td><field name="polea_alimentacion_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <h4 class="mt-3">Datos generales</h4>
                            <table class="table table-bordered o_list_view" style="width:100%">
                                <thead>
                                    <tr class="text-center">
                                        <th>Dato</th>
                                        <th>Valor</th>
                                        <th colspan="2">Tolerancia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Tensión</td>
                                        <td><field name="tension" nolabel="1"/></td>
                                        <td>+/- <field name="tension_tol" nolabel="1"/></td>
                                        <td><field name="tension_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Punto cilindro</td>
                                        <td><field name="punto_cilindro" nolabel="1"/></td>
                                        <td>+/- <field name="punto_cilindro_tol" nolabel="1"/></td>
                                        <td><field name="punto_cilindro_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Punto plato</td>
                                        <td><field name="punto_plato" nolabel="1"/></td>
                                        <td>+/- <field name="punto_plato_tol" nolabel="1"/></td>
                                        <td><field name="punto_plato_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Altura plato</td>
                                        <td><field name="altura_plato" nolabel="1"/></td>
                                        <td>+/- <field name="altura_plato_tol" nolabel="1"/></td>
                                        <td><field name="altura_plato_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Ancho de bastidor</td>
                                        <td><field name="ancho_bastidor" nolabel="1"/></td>
                                        <td>+/- <field name="ancho_bastidor_tol" nolabel="1"/></td>
                                        <td><field name="ancho_bastidor_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Estiraje</td>
                                        <td><field name="estiraje" nolabel="1"/></td>
                                        <td>+/- <field name="estiraje_tol" nolabel="1"/></td>
                                        <td><field name="estiraje_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Ancho de rollo</td>
                                        <td><field name="ancho_rollo" nolabel="1"/></td>
                                        <td>+/- <field name="ancho_rollo_tol" nolabel="1"/></td>
                                        <td><field name="ancho_rollo_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Peso promedio de rollo</td>
                                        <td><field name="peso_promedio_rollo" nolabel="1"/></td>
                                        <td>+/- <field name="peso_promedio_rollo_tol" nolabel="1"/></td>
                                        <td><field name="peso_promedio_rollo_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </page>

                        <page string="Tela Acondicionada">
                            <h4>Datos de tela acondicionada</h4>
                            <table class="table table-bordered o_list_view" style="width:100%">
                                <thead>
                                    <tr class="text-center">
                                        <th>Condiciones</th>
                                        <th>Especificación</th>
                                        <th colspan="2">Tolerancia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Peso</td>
                                        <td><field name="peso_acondicionado" nolabel="1"/></td>
                                        <td>+ <field name="peso_acondicionado_tol" nolabel="1" class="oe_inline"/>
                                            / − <field name="peso_acondicionado_tol_minus" nolabel="1" class="oe_inline"/></td>
                                        <td><field name="peso_acondicionado_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Ancho</td>
                                        <td><field name="ancho_acondicionado" nolabel="1"/></td>
                                        <td>+/- <field name="ancho_acondicionado_tol" nolabel="1"/></td>
                                        <td><field name="ancho_acondicionado_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Espesor</td>
                                        <td><field name="espesor_acondicionado" nolabel="1"/></td>
                                        <td>+/- <field name="espesor_acondicionado_tol" nolabel="1"/></td>
                                        <td><field name="espesor_acondicionado_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Columnas</td>
                                        <td><field name="columnas" nolabel="1"/></td>
                                        <td>+/- <field name="columnas_tol" nolabel="1"/></td>
                                        <td><field name="columnas_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Mallas</td>
                                        <td><field name="mallas" nolabel="1"/></td>
                                        <td>+/- <field name="mallas_tol" nolabel="1"/></td>
                                        <td><field name="mallas_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Elongación bajo carga largo</td>
                                        <td><field name="elongacion_carga_largo" nolabel="1"/></td>
                                        <td>+/- <field name="elongacion_carga_largo_tol" nolabel="1"/></td>
                                        <td><field name="elongacion_carga_largo_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                    <tr>
                                        <td>Elongación bajo carga ancho</td>
                                        <td><field name="elongacion_carga_ancho" nolabel="1"/></td>
                                        <td>+/- <field name="elongacion_carga_ancho_tol" nolabel="1"/></td>
                                        <td><field name="elongacion_carga_ancho_tol_unit_id" nolabel="1" options="{'no_create': True}"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </page>

                        <page string="Características" name="caracteristicas">
                            <p class="text-muted">Especificación del cliente y control interno por característica. El control interno nunca se imprime al cliente.</p>
                            <field name="spec_line_ids" context="{'default_tejido_id': id}">
                                <list editable="bottom" open_form_view="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="caracteristica_id" optional="hide"/>
                                    <field name="kind" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="direction"/>
                                    <field name="position" optional="show"/>
                                    <field name="unit"/>
                                    <field name="spec_limit" optional="show" readonly="kind != 'num'"/>
                                    <field name="spec_nominal" readonly="kind != 'num'"/>
                                    <field name="spec_tol_minus" readonly="kind != 'num' or spec_limit != 'tol'"/>
                                    <field name="spec_tol_plus" readonly="kind != 'num' or spec_limit != 'tol'"/>
                                    <field name="spec_tol_pct" optional="show" readonly="kind != 'num' or spec_limit != 'tol'"/>
                                    <field name="spec_text" optional="show" readonly="kind != 'text'"/>
                                    <field name="spec_bool" optional="hide" readonly="kind != 'bool'"/>
                                    <field name="spec_label" optional="hide"/>
                                    <field name="ctrl_tol_minus" optional="show" readonly="kind != 'num'"/>
                                    <field name="ctrl_tol_plus" optional="show" readonly="kind != 'num'"/>
                                    <field name="method" optional="hide"/>
                                    <field name="in_customer_spec" optional="show"/>
                                    <field name="in_coa" optional="show"/>
                                    <field name="note" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="notas"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ficha_tecnica_tejido_search" model="ir.ui.view">
        <field name="name">ficha.tecnica.tejido.search</field>
        <field name="model">ficha.tecnica.tejido</field>
        <field name="arch" type="xml">
            <search string="Buscar Ficha Técnica de Tejido">
                <field name="articulo"/>
                <field name="maquina_tejido"/>
                <field name="product_proceso_id"/>
                <field name="hilo_line_ids" string="Hilo" filter_domain="[('hilo_line_ids.product_id', 'ilike', self)]"/>
                <filter string="Con aviso de hilos" name="con_aviso_hilos" domain="[('bom_aviso', '!=', False)]"/>
                <filter string="Sin configuración de máquina" name="sin_config" domain="[('maquina_config_id', '=', False)]"/>
                <filter string="Archivadas" name="inactive" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Artículo" name="group_articulo" context="{'group_by':'articulo'}"/>
                    <filter string="Máquina" name="group_maquina" context="{'group_by':'maquina_tejido'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 2.9.0: ligar las fichas seleccionadas a la configuración vigente de su máquina -->
    <record id="action_server_ft_ligar_configuracion" model="ir.actions.server">
        <field name="name">Ligar a la configuración vigente</field>
        <field name="model_id" ref="model_ficha_tecnica_tejido"/>
        <field name="binding_model_id" ref="model_ficha_tecnica_tejido"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_ft_ligar_configuracion()</field>
    </record>

    <record id="action_ficha_tecnica_tejido" model="ir.actions.act_window">
        <field name="name">Fichas de tejido</field>
        <field name="res_model">ficha.tecnica.tejido</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ficha_tecnica_tejido_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera ficha técnica de tejido
            </p>
            <p>
                Captura manual, o usa "Importar Tejido desde Excel" para cargar
                varios artículos a la vez desde un archivo tabular.
            </p>
        </field>
    </record>

</odoo>
