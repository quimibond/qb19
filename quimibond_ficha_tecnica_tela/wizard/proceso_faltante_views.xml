<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 2.13.0 (Dirección General 2026-10-19): producción en kg hasta la Clasificación final; los artículos en kg («I…», DAT
         P-D02-01) que faltan para las telas acabadas en metros (J) que ya existen. -->
    <record id="view_ficha_tecnica_proceso_faltante_list" model="ir.ui.view">
        <field name="name">ficha.tecnica.proceso.faltante.list</field>
        <field name="model">ficha.tecnica.proceso.faltante</field>
        <field name="arch" type="xml">
            <list string="Acabados en proceso faltantes" create="0" delete="0">
                <header>
                    <button name="action_crear" type="object" string="Crear los seleccionados"
                            help="Crea el artículo en kg de las telas acabadas seleccionadas (el mismo código con la «I» al frente, mismo nombre y categoría, sin venta ni compra) y lo liga a sus fichas de acabado."/>
                </header>
                <field name="acabado_id"/>
                <field name="codigo"/>
                <field name="categ_id" optional="show"/>
                <field name="sale_ok" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ficha_tecnica_proceso_faltante_search" model="ir.ui.view">
        <field name="name">ficha.tecnica.proceso.faltante.search</field>
        <field name="model">ficha.tecnica.proceso.faltante</field>
        <field name="arch" type="xml">
            <search string="Acabados en proceso faltantes">
                <field name="acabado_id"/>
                <field name="codigo"/>
                <filter string="Se vende" name="se_vende" domain="[('sale_ok', '=', True)]"/>
                <group>
                    <filter string="Categoría" name="group_categ" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_server_ft_proceso_faltante" model="ir.actions.server">
        <field name="name">Acabados en proceso faltantes</field>
        <field name="model_id" ref="model_ficha_tecnica_proceso_faltante"/>
        <field name="state">code</field>
        <field name="code">action = model._ft_generar()</field>
    </record>
</odoo>
