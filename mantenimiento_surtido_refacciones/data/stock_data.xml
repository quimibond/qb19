<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Regla de Negocio 1: ubicación virtual de Consumo Mantenimiento.
             usage='production' -> Odoo la trata como ubicación de consumo,
             lo que permite que las salidas de MANTTO hacia aquí generen
             asiento contable de valuación automáticamente, EXACTAMENTE
             igual que el consumo de materia prima en manufactura
             (confirmado contra la OF TL/OP-TEJ/12842 de Quimibond: el
             asiento usó la cuenta "Cuenta de producción" de la categoría
             del producto consumido, sin necesidad de código extra).
             La cuenta de gasto de mantenimiento NO se configura aquí: se
             define en Inventario > Configuración > Categorías de
             Producto > [categoría de la refacción] > "Cuenta de
             producción", apuntando a la cuenta de gasto de mantenimiento
             (Opción A). -->
        <record id="stock_location_consumo_mantenimiento" model="stock.location">
            <field name="name">Consumo Mantenimiento</field>
            <field name="usage">production</field>
            <field name="location_id" ref="stock.stock_location_locations_virtual"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Secuencia para el traslado interno de refacciones -->
        <record id="seq_picking_refacciones_mantto" model="ir.sequence">
            <field name="name">Requerimiento de Refacciones - Mantenimiento</field>
            <field name="code">stock.picking.refacciones.mantto</field>
            <field name="prefix">REQ-MTTO/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Regla de Negocio 2: tipo de operación dedicado para el
             requerimiento de refacciones. default_location_src_id se deja
             sin fijar aquí porque la ubicación MANTTO es específica del
             cliente (Toluca Varios TVAR/MTTO); se asigna por Ajustes >
             Inventario > Mantenimiento, o editando este registro. -->
        <record id="picking_type_refacciones_mantto" model="stock.picking.type">
            <field name="name">Requerimiento de Refacciones (Mantenimiento)</field>
            <field name="code">internal</field>
            <field name="sequence_id" ref="seq_picking_refacciones_mantto"/>
            <field name="sequence_code">REQMTTO</field>
            <field name="default_location_dest_id" ref="stock_location_consumo_mantenimiento"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="show_operations" eval="True"/>
        </record>

    </data>
</odoo>
