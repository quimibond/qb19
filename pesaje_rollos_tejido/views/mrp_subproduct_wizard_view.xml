<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_subproduct_wizard_form" model="ir.ui.view">
        <field name="name">mrp.subproduct.wizard.form</field>
        <field name="model">mrp.subproduct.wizard</field>
        <field name="arch" type="xml">
            <form string="Pesaje de Subproducto">
                <sheet>
                    <!-- Campo puente para el widget Owl 'peso_bascula'
                         (ver scale.wizard.mixin en iot_scale_common) -->
                    <field name="scale_read_url" invisible="1"/>

                    <group>
                        <field name="employee_number" 
                            password="True" 
                            default_focus="1" 
                            readonly="employee_number != False" 
                            force_save="1"/>
                        <field name="employee_name" readonly="1" force_save="1" invisible="not employee_number"/>
                    </group>

                    <div invisible="not employee_number">

                         <div class="alert alert-info d-flex align-items-center justify-content-between p-2 mb-3" 
                            role="status" 
                            groups="mrp.group_mrp_manager,pesaje_rollos_tejido.group_mrp_scale_manual_mode">
                            <group col="4" class="w-100 m-0">
                                <field name="weighing_mode" widget="radio" options="{'horizontal': true}"/>
                                <field name="iot_device_id" invisible="weighing_mode != 'iot'" required="weighing_mode == 'iot'"/>
                            </group>
                        </div>
                        
                        <div class="row">
                            <div class="col-6">
                                <strong>Orden de Trabajo: </strong> <field name="workorder_id" readonly="1"/><br/>
                                <strong>Centro de Trabajo: </strong> <field name="workcenter_id" readonly="1"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Subproducto: </strong> <field name="product_id" readonly="1" class="fw-bold text-primary"/>
                            </div>
                        </div>
                        <hr/>
                        <div class="row">
                            <div class="col-12 text-center">
                                <group>
                                    <field name="next_lot_name" readonly="1" style="font-weight: bold; color: #714B67; font-size: 1.2em; text-align: center;"/>
                                </group>
                            </div>
                        </div>
                        <div class="text-center mt-4 mb-4 p-4 border rounded bg-light shadow-sm">
                            <!-- Botón "Capturar" integrado en el widget Owl
                                 peso_bascula (módulo iot_scale_common),
                                 ya no como <button type="object"> suelto
                                 interceptado por un patch global. -->
                            <label for="weight" string="PESO DEL SUBPRODUCTO" style="font-size: 1.5em; font-weight: bold; color: #333;"/><br/>
                            <field name="weight" 
                                    widget="peso_bascula"
                                    style="font-size: 4.5em; font-weight: bold; width: 50%; text-align: center;" 
                                    class="oe_inline"
                                    options="{'digits': [12, 4]}"
                                    readonly="weighing_mode == 'iot'"
                                    force_save="1"/>
                            <span style="font-size: 2em; margin-left: 10px; color: #666;">KG</span>
                        </div>
                    </div>    
                </sheet>
                <footer>
                    <button name="confirm_subproduct" string="REGISTRAR SUBPRODUCTO E IMPRIMIR" type="object" class="btn-primary btn-lg shadow"/>
                    <button string="Cancelar" class="btn-secondary btn-lg" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>