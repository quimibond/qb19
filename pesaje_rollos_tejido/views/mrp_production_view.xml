<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_view_form_inherit_pesaje" model="ir.ui.view">
        <field name="name">mrp.production.view.form.inherit.pesaje</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Solo agregamos el Historial de Pesaje aquí -->
                <page string="Historial de Pesaje" name="weighing_logs">
                    <field name="weighing_log_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="date_time" string="Fecha/Hora"/>
                            <field name="roll_number" string="Lote / Rollo"/>
                            <field name="pesador" string="Operador (Báscula)"/>
                            <field name="weight_bruto" 
                                   string="P. Bruto (kg)" 
                                   sum="Total Bruto" 
                                   widget="float" 
                                   options="{'digits': [12, 4], 'precision': 4}"/>
                            <field name="tara" 
                                   string="Tara (kg)" 
                                   sum="Total Tara"  
                                   widget="float" 
                                   options="{'digits': [12, 4], 'precision': 4}"/>
                            <field name="weight_neto" 
                                   string="P. Neto (kg)" 
                                   sum="Total Neto" 
                                   widget="float" 
                                   options="{'digits': [12, 4], 'precision': 4}"/>
                            <field name="user_id" string="Usuario" widget="many2one_avatar_user"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>