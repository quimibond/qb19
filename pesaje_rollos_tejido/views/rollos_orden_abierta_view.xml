<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rollos pesados de órdenes que siguen abiertas (1.5.0, 2026-10-23).
         Al pesar, el rollo queda como línea del movimiento del terminado, que
         se hace hasta cerrar la orden: el lote existe pero la existencia no lo
         cuenta. Este reporte los muestra sin tocar el inventario. -->
    <record id="view_rollos_orden_abierta_list" model="ir.ui.view">
        <field name="name">stock.move.line.rollos.orden.abierta.list</field>
        <field name="model">stock.move.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date" string="Pesado"/>
                <field name="production_id"/>
                <field name="workorder_id"/>
                <field name="product_id"/>
                <field name="lot_id" string="Rollo"/>
                <field name="quantity" string="kg" sum="Total kg"/>
                <field name="product_uom_id" optional="hide"/>
                <field name="location_dest_id" string="Entrará a" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_rollos_orden_abierta_search" model="ir.ui.view">
        <field name="name">stock.move.line.rollos.orden.abierta.search</field>
        <field name="model">stock.move.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="lot_id"/>
                <group>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_production" string="Orden" context="{'group_by': 'production_id'}"/>
                    <filter name="group_date" string="Día de pesaje" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rollos_orden_abierta" model="ir.actions.act_window">
        <field name="name">Rollos en órdenes abiertas</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rollos_orden_abierta_list"/>
        <field name="search_view_id" ref="view_rollos_orden_abierta_search"/>
        <field name="domain">[
            ('move_id.production_id', '!=', False),
            ('move_id.byproduct_id', '=', False),
            ('move_id.production_id.state', 'in', ('confirmed', 'progress', 'to_close')),
            ('lot_id', '!=', False),
            ('state', 'not in', ('done', 'cancel')),
        ]</field>
        <field name="context">{'search_default_group_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay rollos pesados en órdenes abiertas</p>
            <p>Aquí aparecen los rollos ya pesados de órdenes de tejido que no se han cerrado.
               Todavía no cuentan en la existencia: entran al inventario cuando se cierra la orden.</p>
        </field>
    </record>

    <menuitem id="menu_rollos_orden_abierta"
              name="Rollos en órdenes abiertas"
              parent="mrp.menu_mrp_reporting"
              action="action_rollos_orden_abierta"
              sequence="40"/>
</odoo>
