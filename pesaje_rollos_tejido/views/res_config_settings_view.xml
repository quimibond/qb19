<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_scale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.scale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Control de Básculas Industriales" name="scale_control_block">
                    <setting string="Contingencia de Pesaje" help="Activa el teclado si las básculas Rhino están fuera de servicio">
                        <field name="group_mrp_scale_maintenance"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>