<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Movimientos ================= -->
    <record id="view_qb_nomina_imss_movimiento_list" model="ir.ui.view">
        <field name="name">qb.nomina.imss.movimiento.list</field>
        <field name="model">qb.nomina.imss.movimiento</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'exportado'" decoration-warning="nota and state == 'borrador'">
                <field name="fecha"/>
                <field name="tipo"/>
                <field name="employee_id"/>
                <field name="registro_patronal"/>
                <field name="nss"/>
                <field name="sdi" sum="SDI"/>
                <field name="causa_baja"/>
                <field name="origen" optional="show"/>
                <field name="nota" optional="show"/>
                <field name="lote_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'exportado'"
                       decoration-info="state == 'borrador'"/>
            </list>
        </field>
    </record>

    <record id="view_qb_nomina_imss_movimiento_form" model="ir.ui.view">
        <field name="name">qb.nomina.imss.movimiento.form</field>
        <field name="model">qb.nomina.imss.movimiento</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert" invisible="not nota">
                        <field name="nota" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group string="Movimiento">
                            <field name="tipo"/>
                            <field name="fecha"/>
                            <field name="sdi" invisible="tipo == '02'"/>
                            <field name="causa_baja" invisible="tipo != '02'" required="tipo == '02'"/>
                            <field name="origen"/>
                            <field name="state" widget="badge"/>
                            <field name="lote_id"/>
                        </group>
                        <group string="Trabajador">
                            <field name="employee_id"/>
                            <field name="version_id"/>
                            <field name="registro_patronal"/>
                            <field name="nss"/>
                            <field name="curp"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Nota" invisible="state == 'exportado'">
                        <field name="nota" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qb_nomina_imss_movimiento_search" model="ir.ui.view">
        <field name="name">qb.nomina.imss.movimiento.search</field>
        <field name="model">qb.nomina.imss.movimiento</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="registro_patronal"/>
                <field name="lote_id"/>
                <filter name="por_exportar" string="Por exportar" domain="[('state', '=', 'borrador')]"/>
                <filter name="exportados" string="Exportados" domain="[('state', '=', 'exportado')]"/>
                <separator/>
                <filter name="altas" string="Altas y reingresos" domain="[('tipo', '=', '08')]"/>
                <filter name="modificaciones" string="Modificaciones" domain="[('tipo', '=', '07')]"/>
                <filter name="bajas" string="Bajas" domain="[('tipo', '=', '02')]"/>
                <separator/>
                <filter name="con_nota" string="Con aviso" domain="[('nota', '!=', False)]"/>
                <group>
                    <filter name="group_tipo" string="Tipo" context="{'group_by': 'tipo'}"/>
                    <filter name="group_registro" string="Registro patronal" context="{'group_by': 'registro_patronal'}"/>
                    <filter name="group_lote" string="Lote" context="{'group_by': 'lote_id'}"/>
                    <filter name="group_fecha" string="Fecha" context="{'group_by': 'fecha'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qb_nomina_imss_movimiento" model="ir.actions.act_window">
        <field name="name">Movimientos IMSS</field>
        <field name="res_model">qb.nomina.imss.movimiento</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_por_exportar': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin movimientos por exportar</p>
            <p>Use «Detectar movimientos» para traer las altas, bajas y cambios de SDI de los contratos, o
               «SDI del bimestre» para la modificación por salario variable. Después agrúpelos en un lote
               por registro patronal y genere los archivos del SUA y del IDSE.</p>
        </field>
    </record>

    <!-- ================= Lotes ================= -->
    <record id="view_qb_nomina_imss_lote_list" model="ir.ui.view">
        <field name="name">qb.nomina.imss.lote.list</field>
        <field name="model">qb.nomina.imss.lote</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="name"/>
                <field name="registro_patronal"/>
                <field name="guia"/>
                <field name="movimiento_count" string="Movimientos"/>
                <field name="state" widget="badge" decoration-success="state == 'generado'"/>
            </list>
        </field>
    </record>

    <record id="view_qb_nomina_imss_lote_form" model="ir.ui.view">
        <field name="name">qb.nomina.imss.lote.form</field>
        <field name="model">qb.nomina.imss.lote</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_tomar_pendientes" type="object" string="Traer los pendientes"
                            class="btn-secondary" invisible="state != 'borrador'"
                            help="Agrega al lote todos los movimientos por exportar de este registro patronal."/>
                    <button name="action_generar" type="object" string="Generar archivos" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_borrador" type="object" string="Regresar a borrador"
                            invisible="state != 'generado'"
                            confirm="Se borran los archivos generados y los movimientos vuelven a quedar por exportar. ¿Continuar?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_movimientos" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="movimiento_count" widget="statinfo" string="Movimientos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="IMSS C6759945101 2026-09-01"/></h1>
                    </div>
                    <group>
                        <group string="Lote">
                            <field name="registro_patronal" placeholder="C6759945101"/>
                            <field name="guia" placeholder="13400"/>
                            <field name="fecha"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Archivos" invisible="state != 'generado'">
                            <field name="archivo_sua" filename="archivo_sua_nombre"/>
                            <field name="archivo_sua_nombre" invisible="1"/>
                            <field name="archivo_idse_altas" filename="archivo_idse_altas_nombre"/>
                            <field name="archivo_idse_altas_nombre" invisible="1"/>
                            <field name="archivo_idse_modificaciones" filename="archivo_idse_modificaciones_nombre"/>
                            <field name="archivo_idse_modificaciones_nombre" invisible="1"/>
                            <field name="archivo_idse_bajas" filename="archivo_idse_bajas_nombre"/>
                            <field name="archivo_idse_bajas_nombre" invisible="1"/>
                            <field name="resumen"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movimientos" name="movimientos">
                            <field name="movimiento_ids" readonly="state != 'borrador'"
                                   context="{'default_registro_patronal': registro_patronal, 'default_company_id': company_id}">
                                <list editable="bottom" decoration-warning="nota">
                                    <field name="fecha"/>
                                    <field name="tipo"/>
                                    <field name="employee_id"/>
                                    <field name="version_id" column_invisible="1"/>
                                    <field name="registro_patronal" column_invisible="1"/>
                                    <field name="nss"/>
                                    <field name="sdi"/>
                                    <field name="causa_baja"/>
                                    <field name="origen"/>
                                    <field name="nota"/>
                                    <field name="state" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_qb_nomina_imss_lote" model="ir.actions.act_window">
        <field name="name">Lotes IMSS (SUA e IDSE)</field>
        <field name="res_model">qb.nomina.imss.lote</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree un lote por registro patronal</p>
            <p>El lote toma los movimientos por exportar y genera el MOVT.TXT que se importa en el SUA y los
               archivos .dat que se suben al IDSE. Queda constancia de qué se mandó y cuándo.</p>
        </field>
    </record>

    <!-- ================= Asistentes ================= -->
    <record id="view_qb_nomina_imss_detectar_form" model="ir.ui.view">
        <field name="name">qb.nomina.imss.detectar.form</field>
        <field name="model">qb.nomina.imss.detectar</field>
        <field name="arch" type="xml">
            <form>
                <p>Busca en los contratos las altas, bajas y cambios de SDI del periodo y los deja como movimientos
                   por exportar. Lo que ya existe (mismo trabajador, tipo y fecha) no se repite. La modificación
                   bimestral por salario variable sale de «SDI del bimestre», no de aquí.</p>
                <group>
                    <group>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                        <field name="registro_patronal" placeholder="Todos"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="altas"/>
                        <field name="bajas"/>
                        <field name="modificaciones"/>
                    </group>
                </group>
                <footer>
                    <button name="action_detectar" type="object" string="Detectar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qb_nomina_imss_detectar" model="ir.actions.act_window">
        <field name="name">Detectar movimientos IMSS</field>
        <field name="res_model">qb.nomina.imss.detectar</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_qb_nomina_imss_sdi_bimestre_form" model="ir.ui.view">
        <field name="name">qb.nomina.imss.sdi.bimestre.form</field>
        <field name="model">qb.nomina.imss.sdi.bimestre</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <p invisible="state != 'nuevo'">Calcula el salario base de cotización de cada trabajador con las
                   percepciones variables del bimestre (SD × factor de integración + variables / días cotizados,
                   topado a 25 UMA), como lo hace NOI cada dos meses. Primero se revisa; al aplicar se escribe el
                   SDI nuevo en el contrato y se crea la modificación de salario con fecha del primer día del
                   bimestre siguiente, solo para quien cambia.</p>
                <group>
                    <group>
                        <field name="anio"/>
                        <field name="bimestre"/>
                        <field name="registro_patronal" placeholder="Todos"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group invisible="state != 'calculado'">
                        <field name="fecha_aplica"/>
                        <field name="tope"/>
                        <field name="dias_aguinaldo"/>
                    </group>
                </group>
                <div class="alert alert-info" role="status" invisible="state != 'calculado'">
                    <field name="resumen" nolabel="1" readonly="1"/>
                </div>
                <field name="linea_ids" invisible="state != 'calculado'">
                    <list editable="bottom" create="0" delete="0" decoration-muted="not aplicar"
                          decoration-warning="topado">
                        <field name="aplicar" widget="boolean_toggle"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="registro_patronal" readonly="1" optional="hide"/>
                        <field name="recibos" readonly="1" optional="hide"/>
                        <field name="sd" readonly="1"/>
                        <field name="factor" readonly="1"/>
                        <field name="variables" readonly="1"/>
                        <field name="dias" readonly="1"/>
                        <field name="sdv" readonly="1"/>
                        <field name="sdi_calculado" readonly="1" optional="hide"/>
                        <field name="sdi_actual" readonly="1"/>
                        <field name="sdi_nuevo" readonly="1"/>
                        <field name="diferencia" readonly="1"/>
                        <field name="topado" readonly="1" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_calcular" type="object" string="Calcular" class="btn-primary"
                            invisible="state != 'nuevo'"/>
                    <button name="action_calcular" type="object" string="Recalcular" class="btn-secondary"
                            invisible="state != 'calculado'"/>
                    <button name="action_aplicar" type="object" string="Aplicar y crear movimientos"
                            class="btn-primary" invisible="state != 'calculado'"
                            confirm="Se escribe el SDI nuevo en el contrato de cada trabajador marcado y se crean sus movimientos de modificación. ¿Continuar?"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qb_nomina_imss_sdi_bimestre" model="ir.actions.act_window">
        <field name="name">SDI del bimestre (salario variable)</field>
        <field name="res_model">qb.nomina.imss.sdi.bimestre</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ================= Menús =================
         Nacen sin padre e inactivos por lo mismo que el menú del centinela: un
         parent que no resuelve tumba la instalación. qb_nomina_colgar_menu_imss()
         cuelga «IMSS» de la raíz de la app de Nómina en cada instalación/actualización. -->
    <record id="menu_qb_nomina_imss" model="ir.ui.menu">
        <field name="name">IMSS</field>
        <field name="sequence">60</field>
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    <menuitem id="menu_qb_nomina_imss_movimiento" name="Movimientos" parent="menu_qb_nomina_imss"
              action="action_qb_nomina_imss_movimiento" sequence="10"/>
    <menuitem id="menu_qb_nomina_imss_lote" name="Lotes (SUA e IDSE)" parent="menu_qb_nomina_imss"
              action="action_qb_nomina_imss_lote" sequence="20"/>
    <menuitem id="menu_qb_nomina_imss_detectar" name="Detectar movimientos" parent="menu_qb_nomina_imss"
              action="action_qb_nomina_imss_detectar" sequence="30"/>
    <menuitem id="menu_qb_nomina_imss_sdi_bimestre" name="SDI del bimestre" parent="menu_qb_nomina_imss"
              action="action_qb_nomina_imss_sdi_bimestre" sequence="40"/>

    <function model="qb.nomina.imss.lote" name="qb_nomina_colgar_menu_imss"/>

</odoo>
