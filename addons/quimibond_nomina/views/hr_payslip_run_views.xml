<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_run_view_form_sgi" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.sgi</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_end']" position="after">
                <field name="sgi_recalculated"/>
                <field name="sgi_complement_paid"/>
                <field name="sgi_incident_note" invisible="not sgi_recalculated and not sgi_complement_paid"/>
            </xpath>
        </field>
    </record>
</odoo>
