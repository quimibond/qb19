<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ficha del empleado: en Odoo 19 el contrato (hr.version) se edita desde
         la pestaña de nómina del empleado. El campo va junto a Fondo de
         ahorro, dentro del grupo que sólo se ve con country_code == 'MX'. -->
    <record id="view_employee_form_quimibond_nomina" model="ir.ui.view">
        <field name="name">hr.employee.form.quimibond.nomina</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_mx_savings_fund']" position="after">
                <field name="l10n_mx_employer_registration" placeholder="C-675994510-1"/>
                <field name="qb_imss_umf" placeholder="007"/>
                <field name="qb_imss_tipo_trabajador"/>
                <field name="qb_imss_tipo_salario"/>
                <field name="qb_imss_semana_reducida"/>
                <field name="qb_apellido_paterno"/>
                <field name="qb_apellido_materno"/>
                <field name="qb_nombres"/>
            </xpath>
        </field>
    </record>

    <!-- Referencia del empleado (S-250, Q-127, C-26): hr_payroll la pone junto a
         «Categoría del pago» solo en modo desarrollador (base.group_no_one), y RH
         no la encontraba al dar de alta. Sin ella no se timbra el recibo
         (NumEmpleado) ni se da de alta a la persona en los checadores. -->
    <record id="payroll_hr_employee_view_form_referencia" model="ir.ui.view">
        <field name="name">hr.employee.form.quimibond.nomina.referencia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='registration_number']" position="attributes">
                <attribute name="groups">hr.group_hr_user</attribute>
                <attribute name="placeholder">S-250 (semanal), Q-127 (quincenal), C-26 (Ciruelos)</attribute>
            </xpath>
        </field>
    </record>

    <!-- Plantillas de contrato (hr.version sin empleado). -->
    <record id="hr_contract_template_form_view_quimibond_nomina" model="ir.ui.view">
        <field name="name">hr.contract.template.form.quimibond.nomina</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary_info']" position="inside">
                <group name="quimibond_nomina" string="IMSS" invisible="country_code != 'MX'">
                    <field name="country_code" invisible="1"/>
                    <field name="l10n_mx_employer_registration" placeholder="C-675994510-1"/>
                    <field name="qb_imss_umf" placeholder="007"/>
                    <field name="qb_imss_tipo_trabajador"/>
                    <field name="qb_imss_tipo_salario"/>
                    <field name="qb_imss_semana_reducida"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
