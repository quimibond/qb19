    <record id="concepto_noi_p017" model="qb.nomina.concepto.noi">
        <field name="clave">P017</field>
        <field name="name">OTRAS PERCEPCIONES</field>
        <field name="tipo">percepcion</field>
        <field name="clave_sat">038</field>
        <field name="codigos">H_SENC</field>
    </record>
    <record id="concepto_noi_p019" model="qb.nomina.concepto.noi">
        <field name="clave">P019</field>
        <field name="name">PRIMA DOMINICAL</field>
        <field name="tipo">percepcion</field>
        <field name="clave_sat">020</field>
        <field name="codigos">PDOM_TAX, PDOM_EXEMPT</field>
        <field name="codigos_exento">PDOM_EXEMPT</field>
    </record>
    <record id="concepto_noi_d001" model="qb.nomina.concepto.noi">
        <field name="clave">D001</field>
