<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Catálogo de conceptos de NOI (1.23.0), tomado de los reportes de NOI de la semana 48 de 2026
         («Reporte de la nómina» y «Percepción/deducción» que mandó RH el 20-nov). noupdate: RH lo edita en
         Nómina → Reportes NOI → Conceptos NOI y una actualización no lo pisa. Premio de asistencia (PA),
         retroactivo y vales (1.25.0, abajo) no salieron en esa semana: hasta darlos de alta se reportan con el nombre de la regla. -->
    <record id="concepto_noi_p001" model="qb.nomina.concepto.noi">
        <field name="clave">P001</field>
        <field name="name">SUELDO</field>
        <field name="tipo">percepcion</field>
        <field name="clave_sat">001</field>
        <field name="codigos">BASIC, DESC_FALTAS</field>
    </record>
    <record id="concepto_noi_p003" model="qb.nomina.concepto.noi">
        <field name="clave">P003</field>
        <field name="name">HORAS EXTRAS DOBLES</field>
        <field name="tipo">percepcion</field>
        <field name="clave_sat">019</field>
        <field name="codigos">HE_TAX, HE_EXEMPT</field>
        <field name="codigos_exento">HE_EXEMPT</field>
    </record>
    <record id="concepto_noi_p006" model="qb.nomina.concepto.noi">
        <field name="clave">P006</field>
        <field name="name">FONDO DE AHORRO PATRON</field>
        <field name="tipo">percepcion</field>
        <field name="clave_sat">005</field>
        <field name="codigos">FAP</field>
        <field name="codigos_exento">FAP</field>
    </record>
    <record id="concepto_noi_p010" model="qb.nomina.concepto.noi">
        <field name="clave">P010</field>
        <field name="name">PRIMA VACACIONAL</field>
        <field name="tipo">percepcion</field>
        <field name="clave_sat">021</field>
        <field name="codigos">PVAC_TAX, PVAC_EXEMPT</field>
        <field name="codigos_exento">PVAC_EXEMPT</field>
    </record>
    <record id="concepto_noi_p015" model="qb.nomina.concepto.noi">
        <field name="clave">P015</field>
        <field name="name">LOGRO DE OBJETIVOS</field>
