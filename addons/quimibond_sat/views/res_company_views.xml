<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_sat" model="ir.ui.view">
        <field name="name">res.company.form.sat</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="sat_sync_enabled"/>
                <field name="sat_syntage_entity_id" invisible="not sat_sync_enabled"/>
                <field name="sat_data_until_issued" invisible="not sat_sync_enabled"/>
                <field name="sat_data_until_received" invisible="not sat_sync_enabled"/>
            </xpath>
        </field>
    </record>

</odoo>
