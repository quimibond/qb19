<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sat_pull_wizard_form" model="ir.ui.view">
        <field name="name">sat.pull.wizard.form</field>
        <field name="model">sat.pull.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="mode" widget="radio"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="include_retentions" invisible="mode != 'extraction'"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Ejecutar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sat_pull_wizard" model="ir.actions.act_window">
        <field name="name">Traer CFDI del SAT</field>
        <field name="res_model">sat.pull.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
