<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Complementos de pago -->
    <record id="action_sat_cfdi_pago" model="ir.actions.act_window">
        <field name="name">Complementos de pago (SAT)</field>
        <field name="res_model">sat.cfdi.pago</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_vigente': 1}</field>
    </record>

    <record id="view_sat_cfdi_pago_list" model="ir.ui.view">
        <field name="name">sat.cfdi.pago.list</field>
        <field name="model">sat.cfdi.pago</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="estado_sat == 'cancelado'">
                <field name="fecha_pago"/>
                <field name="kind"/>
                <field name="counterparty_name"/>
                <field name="invoice_cfdi_id"/>
                <field name="move_id"/>
                <field name="parcialidad"/>
                <field name="monto" sum="Importe"/>
                <field name="moneda"/>
                <field name="saldo_insoluto"/>
                <field name="forma_pago" optional="hide"/>
                <field name="num_operacion" optional="hide"/>
                <field name="estado_sat"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sat_cfdi_pago_form" model="ir.ui.view">
        <field name="name">sat.cfdi.pago.form</field>
        <field name="model">sat.cfdi.pago</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="invoice_cfdi_id"/>
                            <field name="invoice_uuid"/>
                            <field name="move_id"/>
                            <field name="counterparty_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="fecha_pago"/>
                            <field name="monto"/>
                            <field name="moneda"/>
                            <field name="tipo_cambio"/>
                            <field name="parcialidad"/>
                            <field name="saldo_anterior"/>
                            <field name="saldo_insoluto"/>
                            <field name="forma_pago"/>
                            <field name="num_operacion"/>
                            <field name="estado_sat"/>
                            <field name="syntage_id"/>
                            <field name="last_event_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sat_cfdi_pago_search" model="ir.ui.view">
        <field name="name">sat.cfdi.pago.search</field>
        <field name="model">sat.cfdi.pago</field>
        <field name="arch" type="xml">
            <search>
                <field name="counterparty_name"/>
                <field name="invoice_uuid"/>
                <field name="move_id"/>
                <field name="num_operacion"/>
                <filter name="vigente" string="Vigentes" domain="[('estado_sat', '=', 'vigente')]"/>
                <filter name="cobros" string="Cobros" domain="[('kind', '=', 'cobro')]"/>
                <filter name="pagos" string="Pagos" domain="[('kind', '=', 'pago')]"/>
                <filter name="sin_factura" string="Sin factura en el SAT" domain="[('invoice_cfdi_id', '=', False)]"/>
                <separator/>
                <filter name="fecha_pago" string="Fecha de pago" date="fecha_pago"/>
                <separator/>
                    <filter name="group_kind" string="Agrupar por sentido" context="{'group_by': 'kind'}"/>
                    <filter name="group_month" string="Agrupar por mes" context="{'group_by': 'fecha_pago:month'}"/>
                    <filter name="group_counterparty" string="Agrupar por contraparte" context="{'group_by': 'counterparty_name'}"/>
            </search>
        </field>
    </record>

    <!-- Pagos SAT vs Odoo -->
    <record id="action_sat_pago_compare" model="ir.actions.act_window">
        <field name="name">Pagos SAT vs Odoo</field>
        <field name="res_model">sat.pago.compare</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_mi_compania': 1, 'search_default_hallazgos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin pagos que comparar</p>
            <p>Los complementos de pago llegan por webhook, por "Traer CFDI del SAT" (modo pagos) o por importación.</p>
        </field>
    </record>

    <record id="view_sat_pago_compare_list" model="ir.ui.view">
        <field name="name">sat.pago.compare.list</field>
        <field name="model">sat.pago.compare</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="issue == 'complemento_sin_pago'"
                  decoration-warning="issue == 'sin_complemento'"
                  decoration-muted="issue in ('pue', 'cancelado', 'sin_factura')">
                <field name="cfdi_id" column_invisible="1"/>
                <field name="move_id" column_invisible="1"/>
                <field name="fecha"/>
                <field name="issue"/>
                <field name="direction"/>
                <field name="counterparty_name"/>
                <field name="move_name"/>
                <field name="metodo_pago"/>
                <field name="moneda"/>
                <field name="total"/>
                <field name="pagado_sat"/>
                <field name="pagado_odoo"/>
                <field name="delta"/>
                <field name="saldo_sat" optional="hide"/>
                <field name="saldo_odoo" optional="hide"/>
                <field name="n_pagos"/>
                <field name="ultimo_pago" optional="hide"/>
                <field name="payment_state" optional="hide"/>
                <field name="delta_mxn" sum="Δ (MXN)" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_cfdi" type="object" string="CFDI" icon="fa-file-text-o"/>
                <button name="action_open_move" type="object" string="Factura" icon="fa-external-link" invisible="not move_id"/>
            </list>
        </field>
    </record>

    <record id="view_sat_pago_compare_search" model="ir.ui.view">
        <field name="name">sat.pago.compare.search</field>
        <field name="model">sat.pago.compare</field>
        <field name="arch" type="xml">
            <search>
                <field name="counterparty_name"/>
                <field name="counterparty_rfc"/>
                <field name="move_name"/>
                <filter name="mi_compania" string="Mi compañía" domain="[('company_id', 'in', allowed_company_ids)]"/>
                <separator/>
                <filter name="issued" string="Emitidas (cobros)" domain="[('direction', '=', 'issued')]"/>
                <filter name="received" string="Recibidas (pagos)" domain="[('direction', '=', 'received')]"/>
                <separator/>
                <filter name="hallazgos" string="Con hallazgo"
                        domain="[('issue', 'in', ('sin_complemento', 'complemento_sin_pago'))]"/>
                <filter name="ppd" string="PPD" domain="[('metodo_pago', '=', 'PPD')]"/>
                <separator/>
                <filter name="fecha" string="Fecha factura" date="fecha"/>
                <separator/>
                    <filter name="group_issue" string="Agrupar por hallazgo" context="{'group_by': 'issue'}"/>
                    <filter name="group_direction" string="Agrupar por sentido" context="{'group_by': 'direction'}"/>
                    <filter name="group_counterparty" string="Agrupar por contraparte" context="{'group_by': 'counterparty_name'}"/>
                    <filter name="group_month" string="Agrupar por mes" context="{'group_by': 'mes'}"/>
            </search>
        </field>
    </record>

    <record id="view_sat_pago_compare_pivot" model="ir.ui.view">
        <field name="name">sat.pago.compare.pivot</field>
        <field name="model">sat.pago.compare</field>
        <field name="arch" type="xml">
            <pivot string="Pagos SAT vs Odoo (MXN)">
                <field name="mes" type="row"/>
                <field name="direction" type="row"/>
                <field name="issue" type="col"/>
                <field name="pagado_sat_mxn" type="measure"/>
                <field name="pagado_odoo_mxn" type="measure"/>
                <field name="delta_mxn" type="measure"/>
            </pivot>
        </field>
    </record>

</odoo>
