<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_sat" model="ir.ui.view">
        <field name="name">res.partner.form.sat</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="sat_cfdi_policy" invisible="parent_id"/>
                <field name="sat_terceros_product_ids" widget="many2many_tags"
                       invisible="parent_id or sat_cfdi_policy != 'factura'"/>
                <field name="sat_69b_status" invisible="parent_id or not sat_69b_status"
                       decoration-danger="sat_69b_status == 'definitive'"
                       decoration-warning="sat_69b_status == 'presumed'"/>
                <field name="sat_69b_seen" invisible="parent_id or not sat_69b_status"/>
                <field name="sat_69b_autorizado" invisible="parent_id or sat_69b_status != 'definitive'"/>
            </xpath>
        </field>
    </record>

</odoo>
