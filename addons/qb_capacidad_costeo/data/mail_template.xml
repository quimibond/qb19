<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
<!-- Plantilla NUEVA: adjunta el PDF COMERCIAL (solo precio y condiciones).
     Es la que usa el botón "Enviar por correo". La plantilla vieja de abajo
     (que adjuntaba la hoja interna con costos) se conserva solo por
     compatibilidad de datos noupdate — NO usarla. -->
        <record id="mail_template_cotizacion_cliente" model="mail.template">
            <field name="name">Cotización — envío al cliente (PDF comercial)</field>
            <field name="model_id" ref="model_qb_cotizacion"/>
            <field name="subject">Cotización {{ object.name }} — Quimibond</field>
            <field name="partner_to">{{ object.partner_id.id or '' }}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 13px;">
    <p>Estimado cliente,</p>
    <p>Adjuntamos la cotización <b t-out="object.name"/>
       <t t-if="object.product_id"> del producto
       <b t-out="object.product_id.display_name"/></t>.</p>
    <p t-if="object.validez_hasta">Vigencia: hasta el
       <b t-out="object.validez_hasta"/>.</p>
    <p>Quedamos atentos a sus comentarios.</p>
    <p>Saludos cordiales,<br/>Productora de No Tejidos Quimibond, S.A. de C.V.</p>
</div>
            </field>
            <field name="report_template_ids"
                   eval="[(4, ref('qb_capacidad_costeo.action_report_cotizacion_cliente'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_cotizacion" model="mail.template">
            <field name="name">[Obsoleta — no usar] Cotización con hoja interna</field>
            <field name="model_id" ref="model_qb_cotizacion"/>
            <field name="subject">Cotización {{ object.name }} — Quimibond</field>
            <field name="partner_to">{{ object.partner_id.id or '' }}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 13px;">
    <p>Estimado cliente,</p>
    <p>Adjuntamos la cotización <b t-out="object.name"/>
       <t t-if="object.product_id"> del producto
       <b t-out="object.product_id.display_name"/></t>.</p>
    <p t-if="object.validez_hasta">Vigencia: hasta el
       <b t-out="object.validez_hasta"/>.</p>
    <p>Quedamos atentos a sus comentarios.</p>
    <p>Saludos cordiales,<br/>Productora de No Tejidos Quimibond, S.A. de C.V.</p>
</div>
            </field>
            <field name="report_template_ids"
                   eval="[(4, ref('qb_capacidad_costeo.action_report_cotizacion'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
