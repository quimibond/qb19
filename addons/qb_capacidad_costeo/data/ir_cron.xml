<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cuentas nuevas del plan entran solas a la clasificación -->
        <record id="cron_refresh_cuenta_matching" model="ir.cron">
            <field name="name">Capacidad &amp; Costeo - Refrescar matching de cuentas (diario)</field>
            <field name="model_id" ref="model_qb_costeo_cuenta_class"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_account_matching()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=30, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">10</field>
        </record>

        <!-- Mes en curso fresco sin esperar al cierre (semanal) -->
        <record id="cron_recompute_current_month" model="ir.cron">
            <field name="name">Capacidad &amp; Costeo - Refrescar mes en curso (semanal)</field>
            <field name="model_id" ref="model_qb_costo_producto"/>
            <field name="state">code</field>
            <field name="code">model.cron_recompute_current_month()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=30, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">15</field>
        </record>

        <!-- Recalcular por lotes los períodos históricos que una migración
             dejó diferidos (parámetro `recalculo_pendiente`). Apagado por
             default: lo prende la migración que difiere, y el propio método
             lo apaga al vaciar la lista. noupdate para que un -u posterior
             no lo re-prenda ni lo re-apague a mitad de la cola. -->
        <record id="cron_recalculo_pendientes" model="ir.cron"
                forcecreate="True">
            <field name="name">Capacidad &amp; Costeo - Recálculo diferido de históricos</field>
            <field name="model_id" ref="model_qb_costo_producto"/>
            <field name="state">code</field>
            <field name="code">model.cron_recompute_pendientes()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
            <field name="priority">20</field>
        </record>

        <!-- Snapshot mensual + recálculo de costos del mes cerrado -->
        <record id="cron_snapshot_monthly" model="ir.cron">
            <field name="name">Capacidad &amp; Costeo - Snapshot y costeo mensual (día 1)</field>
            <field name="model_id" ref="model_qb_costeo_snapshot"/>
            <field name="state">code</field>
            <field name="code">model.cron_snapshot_monthly()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
            <field name="nextcall" eval="((DateTime.now().replace(day=1, hour=4, minute=0, second=0, microsecond=0)) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
