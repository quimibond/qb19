<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Seeds idempotentes (noupdate: los ajustes del usuario sobreviven
         updates del módulo). Arrancan con la clasificación ya validada con
         dirección; todo es editable desde Configuración. -->
    <data noupdate="1">

        <!-- ============ Parámetros globales ============ -->
        <record id="factor_fab_weight_share" model="qb.costeo.factor.config">
            <field name="key">fab_weight_share</field>
            <field name="value">0.67</field>
            <field name="descripcion">Share del pool de fabricación repartido por PESO (tejido+tintorería+gas); el resto por LARGO (acabado).</field>
        </record>
        <record id="factor_energia_por_kg" model="qb.costeo.factor.config">
            <field name="key">energia_por_kg</field>
            <field name="value">0</field>
            <field name="descripcion">Energía variable $/kg. 0 = automático (pool cuentas bucket=energia ÷ kg producidos).</field>
        </record>
        <record id="factor_op_driver" model="qb.costeo.factor.config">
            <field name="key">op_driver</field>
            <field name="value">0</field>
            <field name="value_text">produccion</field>
            <field name="descripcion">Driver del costo de OPERACIÓN en el reporte: "produccion" reparte sobre el costo de producción (recomendado: el costo deja de depender del precio); "ventas" lo reparte como % del precio, como antes. El piso de precio del cotizador usa op% sobre venta en los dos casos.</field>
        </record>
        <record id="factor_mp_ajuste_min" model="qb.costeo.factor.config">
            <field name="key">mp_ajuste_min</field>
            <field name="value">0.5</field>
            <field name="descripcion">Piso del ajuste de MP (receta vs. costo primo del mayor). Fuera de la banda se recorta y se loggea: casi siempre es una cuenta mal clasificada en el bucket "mp".</field>
        </record>
        <record id="factor_mp_ajuste_max" model="qb.costeo.factor.config">
            <field name="key">mp_ajuste_max</field>
            <field name="value">1.5</field>
            <field name="descripcion">Techo del ajuste de MP. Ver mp_ajuste_min.</field>
        </record>
        <!-- Rendimiento de calidad (memo 31-ago, bloque A). Los ids son de
             la base de Toluca; editables desde Configuración → Parámetros. -->
        <record id="calidad_locs_vendible" model="qb.costeo.factor.config">
            <field name="key">calidad_locs_vendible</field>
            <field name="value">0</field>
            <field name="value_text">40</field>
            <field name="descripcion">Ubicaciones de PRIMERA calidad (ids de stock.location, coma-separados). Default: 14 PRODUCTO TERMINADO PQ.</field>
        </record>
        <record id="calidad_locs_merma" model="qb.costeo.factor.config">
            <field name="key">calidad_locs_merma</field>
            <field name="value">0</field>
            <field name="value_text">41,42,43</field>
            <field name="descripcion">Ubicaciones de MERMA: 15 FE (sin canal de venta directo — se recupera resinándolo como entretela de confección), 16 SEGUNDAS, 17 DESPERDICIO.</field>
        </record>
        <record id="calidad_locs_origen" model="qb.costeo.factor.config">
            <field name="key">calidad_locs_origen</field>
            <field name="value">0</field>
            <field name="value_text">15,36,246</field>
            <field name="descripcion">Solo entradas DESDE estas ubicaciones cuentan al rendimiento (Virtual/Producción, 10 INSPECCIÓN, Liberación): los reingresos por cuarentena/reetiquetado ya se clasificaron antes y contarían doble (C6).</field>
        </record>
        <record id="calidad_picking_excluir" model="qb.costeo.factor.config">
            <field name="key">calidad_picking_excluir</field>
            <field name="value">0</field>
            <field name="value_text">77,147</field>
            <field name="descripcion">Tipos de operación excluidos del rendimiento: Conversión de unidades (TL/CVU) y Cambio de artículo (TL/CONV-ART) reetiquetan material ya clasificado (C2/C3).</field>
        </record>
        <record id="calidad_rendimiento_min_m" model="qb.costeo.factor.config">
            <field name="key">rendimiento_min_m</field>
            <field name="value">10000</field>
            <field name="descripcion">Unidades clasificadas mínimas en la ventana para usar el rendimiento PROPIO del producto; abajo de esto se usa la tasa de planta (A4: pocos metros dan porcentajes sin sentido).</field>
        </record>
        <record id="factor_rendimiento_min" model="qb.costeo.factor.config">
            <field name="key">rendimiento_min</field>
            <field name="value">2</field>
            <field name="descripcion">Piso del rendimiento sano (unidades/hora) en el reporte de excepciones de tiempo. Tejido circular ronda 5-14 kg/h con nominal 11; la banda va ancha a propósito, para señalar timers rotos y no variación normal de artículo.</field>
        </record>
        <record id="factor_rendimiento_max" model="qb.costeo.factor.config">
            <field name="key">rendimiento_max</field>
            <field name="value">25</field>
            <field name="descripcion">Techo del rendimiento sano (unidades/hora). Arriba de esto casi siempre son horas sin registrar, no una máquina rapidísima.</field>
        </record>
        <record id="factor_refs_fuera_de_costeo" model="qb.costeo.factor.config">
            <field name="key">refs_fuera_de_costeo</field>
            <field name="value">0</field>
            <field name="value_text">CIERRE ANUAL,ENAJENACI</field>
            <field name="descripcion">Referencias de asiento que NO entran al costeo, separadas por coma (se comparan en mayúsculas, como subcadena). CIERRE ANUAL: la póliza que reversa el año entero contra diciembre. ENAJENACI: la baja de un activo vendido — en dic-2025 fueron $5,827,157 de dos máquinas que hoy se arriendan, ya compensados por $5,896,997 de utilidad en venta que el costeo no mira, y cuyo costo actual ya entra al pool por el arrendamiento. Cargarlos además sería cobrar la misma máquina dos veces.</field>
        </record>
        <record id="factor_utilizacion_min_comparable" model="qb.costeo.factor.config">
            <field name="key">utilizacion_min_comparable</field>
            <field name="value">0.70</field>
            <field name="descripcion">Debajo de esta utilización ponderada, el período se marca «Producción baja en la ventana»: la energía se divide entre kilos reales, así que su $/kg —y con él el costo unitario— sale inflado y no compara contra un mes normal. Un mes sano ronda 93-98%.</field>
        </record>
        <record id="factor_utilizacion_min_utilizable" model="qb.costeo.factor.config">
            <field name="key">utilizacion_min_utilizable</field>
            <field name="value">0.40</field>
            <field name="descripcion">Debajo de esto el período se marca «Ventana casi sin producción». Enero-2024 salió en 26.6% porque su ventana cae en 2023, cuando las órdenes todavía no se registraban en Odoo: la energía dio $34.22/kg contra $11.09 en diciembre del mismo año.</field>
        </record>
        <record id="factor_importacion_driver" model="qb.costeo.factor.config">
            <field name="key">importacion_driver</field>
            <field name="value">0</field>
            <field name="value_text">landed</field>
            <field name="descripcion">Cómo llega la aduana al costo. "landed" (default y recomendado): NO se prorratea — el pedimento se captura con el landed cost de Odoo sobre la recepción y cae en los productos que lo causaron; el módulo solo mide cuánta aduana se quedó en resultados. "compras": prorrateo aproximado sobre el valor de las compras importadas (proveedor extranjero); útil si no se van a capturar los pedimentos, pero le cobra al hilo el pedimento de una máquina y viceversa.</field>
        </record>
        <record id="factor_nomina_operacion_refs" model="qb.costeo.factor.config">
            <field name="key">nomina_operacion_refs</field>
            <field name="value">0</field>
            <field name="value_text">DISEÑO</field>
            <field name="descripcion">Pólizas de nómina que cobran por cuentas de fábrica (501.06) pero cuyo trabajo es gasto del período: se detectan por estos textos en la referencia (separados por coma) y su importe se mueve del pool fabril a operación. Hoy: DISEÑO (desarrollo de producto). La administración de la PLANTA se queda en fabril — administrar el sitio productivo sí es overhead (IAS 2).</field>
        </record>
        <record id="factor_importacion_factor_max" model="qb.costeo.factor.config">
            <field name="key">importacion_factor_max</field>
            <field name="value">1.0</field>
            <field name="descripcion">Techo del factor de importación (aduana ÷ valor importado). Arriba de esto se recorta y se loggea: una cuenta grande mal puesta en el bucket dispararía el costo de todos los importados.</field>
        </record>
        <record id="factor_denominador_capacidad_normal" model="qb.costeo.factor.config">
            <field name="key">denominador_capacidad_normal</field>
            <field name="value">1</field>
            <field name="descripcion">1 = el pool fijo se divide entre capacidad NORMAL (IAS 2: la ociosidad va al resultado del período, no al producto). 0 = entre producción real, como antes.</field>
        </record>
        <record id="factor_ficha_peso_tol_pct" model="qb.costeo.factor.config">
            <field name="key">ficha_peso_tol_pct</field>
            <field name="value">2</field>
            <field name="descripcion">Tolerancia (%) entre el peso guardado en la ficha técnica y el maestro de pesos. La ficha guarda una COPIA, y esa hoja va al cliente: arriba de esto el panel avisa. El WJ032Q22JNT160 vivió 16 días con 0.0512 kg/m del código contra 0.059114 de báscula.</field>
        </record>
        <record id="factor_capacidad_superada_meses" model="qb.costeo.factor.config">
            <field name="key">capacidad_superada_meses</field>
            <field name="value">12</field>
            <field name="descripcion">Cuántos períodos mira el check «Capacidad normal vs producción real». Mirar solo el último dejaba pasar el caso real: enero–mayo de 2026 produjeron arriba de la capacidad capturada y el check se pintaba verde con agosto.</field>
        </record>
        <record id="factor_capacidad_capturada_tol_pct" model="qb.costeo.factor.config">
            <field name="key">capacidad_capturada_tol_pct</field>
            <field name="value">10</field>
            <field name="descripcion">Tolerancia (%) entre la capacidad capturada del centro y la que dan sus turnos por su throughput nominal. Arriba de esto el panel avisa: uno de los dos está viejo.</field>
        </record>
        <record id="factor_op_pct_override" model="qb.costeo.factor.config">
            <field name="key">op_pct_override</field>
            <field name="value">0</field>
            <field name="descripcion">Operación % sobre ventas. 0 = automático (Σ cuentas operación ÷ Σ ventas, suavizado).</field>
        </record>
        <record id="factor_target_margin" model="qb.costeo.factor.config">
            <field name="key">target_margin</field>
            <field name="value">0.30</field>
            <field name="descripcion">Margen meta default del cotizador (fracción sobre venta).</field>
        </record>
        <record id="factor_escalera_desc_doble" model="qb.costeo.factor.config">
            <field name="key">escalera_desc_doble</field>
            <field name="value">0.03</field>
            <field name="descripcion">Escalera de volumen: descuento (fracción) por cada DUPLICACIÓN del volumen. 0.03 = 3% por doblar. El precio nunca baja del piso a planta llena y la contribución total nunca baja.</field>
        </record>
        <record id="factor_escalera_multiplos" model="qb.costeo.factor.config">
            <field name="key">escalera_multiplos</field>
            <field name="value_text">0.5,1,2,4</field>
            <field name="descripcion">Escalera de volumen: múltiplos del volumen cotizado que forman los tramos (separados por coma).</field>
        </record>
        <record id="factor_smoothing_months" model="qb.costeo.factor.config">
            <field name="key">smoothing_months</field>
            <field name="value">12</field>
            <field name="descripcion">Ventana de suavizado de gastos GL (meses). La renta se paga a saltos y la energía con rezago: promediar.</field>
        </record>
        <record id="factor_production_window" model="qb.costeo.factor.config">
            <field name="key">production_window_months</field>
            <field name="value">3</field>
            <field name="descripcion">Ventana de promedio de producción real (meses completos).</field>
        </record>
        <record id="factor_weeks_per_month" model="qb.costeo.factor.config">
            <field name="key">weeks_per_month</field>
            <field name="value">4.33</field>
            <field name="descripcion">Semanas por mes para convertir horas de calendario.</field>
        </record>
        <record id="factor_m_per_kg_default" model="qb.costeo.factor.config">
            <field name="key">m_per_kg_default</field>
            <field name="value">8.0</field>
            <field name="descripcion">Factor kg↔m default cuando el producto no tiene peso resuelto (balance de línea en metros-equivalentes).</field>
        </record>
        <record id="factor_quote_validity" model="qb.costeo.factor.config">
            <field name="key">quote_validity_days</field>
            <field name="value">15</field>
            <field name="descripcion">Días de vigencia de una cotización: después, TC y último costo de MP pueden haber cambiado — re-cotizar.</field>
        </record>
        <record id="factor_entretela_extra" model="qb.costeo.factor.config">
            <field name="key">entretela_overhead_extra_mxn</field>
            <field name="value">0</field>
            <field name="descripcion">Overhead extra mensual del centro de entretelas (energía/depreciación de carda) si se cuantifica.</field>
        </record>

        <!-- ============ Centros de costo/proceso ============ -->
        <record id="centro_tejido" model="qb.costeo.centro">
            <field name="sequence">10</field>
            <field name="code">TEJIDO</field>
            <field name="name">Tejido circular</field>
            <field name="nature">fabril_directo</field>
            <field name="driver_principal">peso</field>
            <field name="std_output_per_hour">11.73</field>
            <field name="capacidad_normal">197529</field>
            <field name="renta_contractual_mxn">284269</field>
            <field name="es_denominador_kg" eval="True"/>
            <field name="mo_name_pattern">TL/OP-TE%,OP-TE%</field>
            <field name="notes">37 circulares instaladas, 27 tejiendo en el mes. Capacidad = cada una a su velocidad del formato de planta (11.73 kg/h promedio, rango 9.1-28.2 según galga y artículo) por 623.5 h/mes (144 h/semana: 12 turnos de 12 h). Las 10 restantes existen y tejieron algo en 12 meses, pero no se dotan: son ociosidad instalada, no capacidad normal. Producción medida por orden (TL/OP-TE), no por workorder: la cantidad por workorder está mal registrada (abril colapsa a ~1/5); la DURACIÓN sí sirve y confirma que las máquinas corren a velocidad nominal — lo que falta son horas, no kilos por hora. Fuente: CapacidadesProducto + Turnos, informacion_de_carga_produccion.</field>
        </record>
        <record id="centro_tintoreria" model="qb.costeo.centro">
            <field name="sequence">20</field>
            <field name="code">TINTORERIA</field>
            <field name="name">Tintorería</field>
            <field name="nature">fabril_directo</field>
            <field name="driver_principal">peso</field>
            <field name="std_output_per_hour">138.62</field>
            <field name="capacidad_normal">216089</field>
            <field name="renta_contractual_mxn">178467</field>
            <field name="mo_name_pattern">TL/OP-TIN%,OP-TIN%</field>
            <field name="notes">Cuatro tinas trabajando (HTJ-1 SCHOLL, HTJ-2 y HTJ-5 THEN, HTJ-3 y HTJ-4 SCLAVOS; la HTJ-5 de 1,200 kg en pruebas). 554.5 kg/h ponderando el ciclo real de cada tina por la mezcla de color de las OPs: 2:20 h en naturales, 10:20 h en obscuros, 3.1 h efectivas. Con ese ciclo las tinas NO son el cuello. Producción medida por orden (TL/OP-TIN, kg) — sin patrón salía en CERO. Fuente: TIEMPOS TINTORERIA + CAP DE CARGAS, F-IT-P-P01-10-06 rev 02 abr-2026.</field>
        </record>
        <record id="centro_acabado" model="qb.costeo.centro">
            <field name="sequence">30</field>
            <field name="code">ACABADO</field>
            <field name="name">Acabado / Rama</field>
            <field name="nature">fabril_directo</field>
            <field name="driver_principal">largo</field>
            <field name="std_output_per_hour">1508</field>
            <field name="capacidad_normal">1175313</field>
            <field name="renta_contractual_mxn">178467</field>
            <field name="mo_name_pattern">TL/OP-ACA%,OP-ACA%</field>
            <field name="es_denominador_m" eval="True"/>
            <field name="notes">Ramas UNITECH (29.08 m/min, −10%) y BRUCKNER (28.35 m/min, −15%) = 3,015.9 m/h netos entre las dos, o 1,508 m/h por rama. La ICOMATEX (RAMA 3) sigue en montaje: al arrancar, subir máquinas a 3 y recapturar la capacidad. Producción por patrón TL/OP-ACA (tela). V10 NO es acabado — es entretelas/resina, va en su centro. Fuente: T RAMA, F-IT-P-P01-10-06 rev 02 abr-2026.</field>
        </record>
        <record id="centro_entretelas" model="qb.costeo.centro">
            <field name="sequence">40</field>
            <field name="code">ENTRETELAS</field>
            <field name="name">Entretelas (carda / puntos)</field>
            <field name="nature">fabril_directo</field>
            <field name="driver_principal">largo</field>
            <field name="renta_contractual_mxn">352062</field>
            <field name="mo_name_pattern">TL/OP-CAR%,TL/OP-V10%,OP-CAR%,OP-V1%</field>
            <field name="notes">Carda, puntos (resina), espolvoreo, perfoquim, impregnación, termofijado. Lote 10. Factor propio $/m. Producción TL/OP-CAR (carda) + TL/OP-V10 (aplicación de resina / fusionable) — antes V10 no se contaba en ningún centro.</field>
        </record>
        <record id="centro_insp" model="qb.costeo.centro">
            <field name="sequence">50</field>
            <field name="code">INSP_EMPAQUE</field>
            <field name="name">Inspección y empaque</field>
            <field name="nature">fabril_indirecto</field>
            <field name="driver_principal">largo</field>
            <field name="mo_name_pattern">TL/CONV%</field>
            <field name="notes">Gate final: mide toda la tela vendible.</field>
        </record>
        <record id="centro_admin" model="qb.costeo.centro">
            <field name="sequence">90</field>
            <field name="code">ADMINISTRACION</field>
            <field name="name">Administración</field>
            <field name="nature">admin</field>
            <field name="driver_principal">largo</field>
        </record>

        <!-- ============ Familias de máquinas ============
             Grupos intercambiables segun la columna «Alternos» del
             formato de planta: componentes conexos de esa relacion, asi
             que particionan el centro sin traslape. Un producto SI puede
             caber en varias (el WJ047 sale en galga 18 de los dos
             diametros) y ahi la carga se reparte. -->
        <record id="familia_tej_g24_d30_a" model="qb.costeo.familia">
            <field name="centro_id" ref="centro_tejido"/>
