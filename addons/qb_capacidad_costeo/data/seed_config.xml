        <record id="famprod_tej_g24_d30_a_wj064q66hnt135" model="qb.familia.producto">
            <field name="familia_id" ref="familia_tej_g24_d30_a"/>
            <field name="product_code">WJ064Q66HNT135</field>
            <field name="std_output_per_hour">10.64</field>
        </record>
        <record id="famprod_tej_g24_d30_a_wn048q66hnt098" model="qb.familia.producto">
            <field name="familia_id" ref="familia_tej_g24_d30_a"/>
            <field name="product_code">WN048Q66HNT098</field>
            <field name="std_output_per_hour">11.20</field>
        </record>
        <record id="famprod_tej_g24_d30_a_wn063q66hnt106" model="qb.familia.producto">
            <field name="familia_id" ref="familia_tej_g24_d30_a"/>
            <field name="product_code">WN063Q66HNT106</field>
            <field name="std_output_per_hour">10.95</field>
        </record>
        <record id="famprod_tej_g24_d30_a_wt065q66hnt097" model="qb.familia.producto">
            <field name="familia_id" ref="familia_tej_g24_d30_a"/>
            <field name="product_code">WT065Q66HNT097</field>
            <field name="std_output_per_hour">9.14</field>
        </record>
        <record id="familia_tej_g18_d32" model="qb.costeo.familia">
            <field name="centro_id" ref="centro_tejido"/>
            <field name="code">TEJ_G18_D32</field>
            <field name="name">Tejido galga 18 Ø32</field>
            <field name="machine_names">CIRCULAR 17, CIRCULAR 18, CIRCULAR 28, CIRCULAR 31, CIRCULAR 32, CIRCULAR 33, CIRCULAR 34, CIRCULAR 35, CIRCULAR 36, CIRCULAR 37</field>
            <field name="machine_count">10</field>
            <field name="hours_per_week">144</field>
