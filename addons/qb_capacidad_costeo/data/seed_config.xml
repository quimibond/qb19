            <field name="name">Tejido galga 24/28 Ø30 (grupo grande)</field>
            <field name="machine_names">CIRCULAR 6, CIRCULAR 7, CIRCULAR 8, CIRCULAR 9, CIRCULAR 14, CIRCULAR 15, CIRCULAR 16, CIRCULAR 20, CIRCULAR 27, CIRCULAR 29, CIRCULAR 30</field>
            <field name="machine_count">9</field>
            <field name="hours_per_week">144</field>
            <field name="std_output_per_hour">10.51</field>
            <field name="capacidad_normal">58983</field>
            <field name="notes">11 instaladas, 9 dotadas. Galga 24 Diametro 30 / Galga 28 Diametro 30. Fuente: CapacidadesProducto + centros de trabajo (columna Alternos), informacion_de_carga_produccion.</field>
        </record>
