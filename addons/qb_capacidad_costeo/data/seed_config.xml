        <!-- ============ Turnos ============
             El horario declarado de planta (HORARIO, F-IT-P-P01-10-06):
             dos turnos, 90 h/semana. No manda sobre `capacidad_normal`
             cuando está capturada, pero es contra lo que el panel la
             valida: horario × throughput nominal contra el número
             capturado. Sin esto la capacidad no tiene fuente viva. -->
        <record id="turno_tejido" model="qb.turno.config">
            <field name="centro_id" ref="centro_tejido"/>
            <field name="name">Tres turnos (144 h/semana)</field>
            <field name="hours_per_week">144</field>
            <field name="machine_count">27</field>
            <field name="notes">12 turnos de 12 h: L-V día, M-J noche, sábado y domingo noche, domingo día. Para de viernes 19:00 a sábado 19:00. Máquinas = las que tejieron en el mes, no las 37 instaladas.</field>
        </record>
        <record id="turno_acabado" model="qb.turno.config">
            <field name="centro_id" ref="centro_acabado"/>
            <field name="name">Dos turnos (90 h/semana)</field>
            <field name="hours_per_week">90</field>
            <field name="machine_count">2</field>
            <field name="notes">RAMA 1 y RAMA 2. La ICOMATEX (RAMA 3) está en montaje: al arrancar, 3.</field>
        </record>
        <record id="turno_tintoreria" model="qb.turno.config">
            <field name="centro_id" ref="centro_tintoreria"/>
            <field name="name">Dos turnos (90 h/semana)</field>
            <field name="hours_per_week">90</field>
            <field name="machine_count">4</field>
            <field name="notes">HTJ-1 a HTJ-4. La HTJ-5 (THEN, 1,200 kg) está en pruebas: al liberarla, 5.</field>
        </record>

        <!-- ============ Clasificación de cuentas ============
             El patrón más LARGO gana cuando varios matchean, así que
             504.01.0002 (energía) le gana a 504.01% (overhead). -->
        <record id="cc_ventas" model="qb.costeo.cuenta.class">
            <field name="code_pattern">401%</field>
            <field name="bucket">ventas</field>
        </record>
        <record id="cc_mod" model="qb.costeo.cuenta.class">
            <field name="code_pattern">501.06%</field>
            <field name="bucket">mod</field>
            <field name="driver">peso</field>
            <field name="notes">MOD. La nómina por centro se separa vía departamentos (RH); el GL entra completo al pool de fabricación.</field>
        </record>
        <record id="cc_energia_luz" model="qb.costeo.cuenta.class">
            <field name="code_pattern">504.01.0002%</field>
            <field name="bucket">energia</field>
            <field name="es_variable" eval="True"/>
            <field name="centro_id" ref="centro_tejido"/>
            <field name="driver">peso</field>
            <field name="notes">ENERGETICOS (electricidad) → Tejido. OJO: la 504.01.0001
                es SERVICIOS ADMINISTRATIVOS (fija, esporádica) — estuvo cruzada
                con esta hasta ago-2026 y el pool variable traía la cuenta
                equivocada.</field>
        </record>
        <record id="cc_energia_gas" model="qb.costeo.cuenta.class">
            <field name="code_pattern">504.01.0003%</field>
            <field name="bucket">energia</field>
            <field name="es_variable" eval="True"/>
            <field name="centro_id" ref="centro_acabado"/>
            <field name="driver">peso</field>
            <field name="notes">Gas → Acabado (secar tela pesada consume más gas: driver peso).</field>
        </record>
        <record id="cc_energia_agua" model="qb.costeo.cuenta.class">
            <field name="code_pattern">504.01.0004%</field>
            <field name="bucket">energia</field>
            <field name="es_variable" eval="True"/>
            <field name="centro_id" ref="centro_tintoreria"/>
            <field name="driver">peso</field>
            <field name="notes">Agua (la grande, del teñido) → Tintorería.</field>
        </record>
        <record id="cc_renta_planta" model="qb.costeo.cuenta.class">
            <field name="code_pattern">504.01.0008%</field>
            <field name="bucket">no_costeo</field>
            <field name="notes">Renta de planta según flujo (a saltos). Se usa la renta CONTRACTUAL fija de cada centro en su lugar — no doble contar.</field>
        </record>
        <record id="cc_overhead_fab" model="qb.costeo.cuenta.class">
            <field name="code_pattern">504.01%</field>
            <field name="bucket">overhead_fab</field>
            <field name="notes">Overhead fábrica general (mantenimiento, agujados, etc.). Las cuentas con patrón más largo (energía, renta) salen de aquí solas.</field>
        </record>
        <record id="cc_deprec_08" model="qb.costeo.cuenta.class">
            <field name="code_pattern">504.08%</field>
            <field name="bucket">depreciacion</field>
        </record>
        <record id="cc_deprec_09" model="qb.costeo.cuenta.class">
            <field name="code_pattern">504.09%</field>
            <field name="bucket">depreciacion</field>
        </record>
        <record id="cc_deprec_1x" model="qb.costeo.cuenta.class">
            <field name="code_pattern">504.1%</field>
            <field name="bucket">depreciacion</field>
        </record>
        <record id="cc_deprec_2x" model="qb.costeo.cuenta.class">
            <field name="code_pattern">504.2%</field>
            <field name="bucket">depreciacion</field>
        </record>
        <record id="cc_arrend_maq" model="qb.costeo.cuenta.class">
            <field name="code_pattern">701.11%</field>
            <field name="bucket">arrend_maquinaria</field>
            <field name="notes">Leaseback de maquinaria productiva (~$909k/mes): overhead fijo de fabricación, análogo a depreciación de maquinaria propia.</field>
        </record>
        <record id="cc_op_601" model="qb.costeo.cuenta.class">
            <field name="code_pattern">601%</field>
            <field name="bucket">operacion</field>
            <field name="driver">ventas</field>
        </record>
        <record id="cc_op_602" model="qb.costeo.cuenta.class">
            <field name="code_pattern">602%</field>
            <field name="bucket">operacion</field>
            <field name="driver">ventas</field>
        </record>
        <record id="cc_op_603" model="qb.costeo.cuenta.class">
            <field name="code_pattern">603%</field>
            <field name="bucket">operacion</field>
            <field name="driver">ventas</field>
        </record>
        <record id="cc_op_613" model="qb.costeo.cuenta.class">
            <field name="code_pattern">613%</field>
            <field name="bucket">operacion</field>
            <field name="driver">ventas</field>
            <field name="notes">Depreciación corporativa: gasto de operación, no de fábrica.</field>
        </record>
        <record id="cc_cogs_no" model="qb.costeo.cuenta.class">
            <field name="code_pattern">501.01%</field>
            <field name="bucket">no_costeo</field>
            <field name="notes">COGS contable AVCO: el módulo calcula MP desde BOM a último costo — no se toma del GL.</field>
        </record>
        <record id="cc_mp_ajustes_merma" model="qb.costeo.cuenta.class">
            <field name="code_pattern">501.01.02%</field>
            <field name="bucket">mp</field>
            <field name="filtro_etiqueta">SP/</field>
            <field name="notes">Ajustes a cantidad. La cuenta mezcla naturalezas: la merma real lleva etiqueta SP/ (el scrap de Odoo) y SÍ es costo del producto; los embarques (TL/EMB/), el encogimiento (TL/ENC/) y las entradas de refacciones (TVAR/ENT-REF/) son ajustes de cantidad y NO lo son. El filtro de etiqueta deja pasar solo la merma. Gana por patrón más largo sobre 501.01%.</field>
        </record>
        <record id="cc_502_no" model="qb.costeo.cuenta.class">
            <field name="code_pattern">502%</field>
            <field name="bucket">no_costeo</field>
            <field name="notes">Compras de importación: ya viven en el landed cost del producto.</field>
        </record>

        <!-- ============ Ruteo por familia ============ -->
        <record id="ruteo_subproducto" model="qb.producto.ruteo">
            <field name="sequence">5</field>
            <field name="name_pattern">^(SALDO|DESPERDICIO)</field>
            <field name="product_bucket">subproducto</field>
            <field name="notes">MP $0: su materia ya está en la receta del producto principal. Su venta es recuperación pura de margen.</field>
        </record>
        <record id="ruteo_importado" model="qb.producto.ruteo">
            <field name="sequence">8</field>
            <field name="name_pattern"> I$</field>
            <field name="product_bucket">importado</field>
            <field name="centro_ids" eval="[(6, 0, [ref('centro_insp')])]"/>
            <field name="notes">Solo inspección/reempaque: no cargan fabricación ni energía; sí operación.</field>
        </record>
        <record id="ruteo_importado_categ" model="qb.producto.ruteo">
            <field name="sequence">9</field>
            <field name="categ_pattern">%Importaci%</field>
            <field name="product_bucket">importado</field>
            <field name="centro_ids" eval="[(6, 0, [ref('centro_insp')])]"/>
        </record>
        <record id="ruteo_entretela_tejida" model="qb.producto.ruteo">
            <field name="sequence">10</field>
            <field name="categ_pattern">%fusionable tejida%</field>
            <field name="product_bucket">entretela_tejida</field>
            <field name="centro_ids" eval="[(6, 0, [ref('centro_tejido'), ref('centro_tintoreria'), ref('centro_entretelas')])]"/>
            <field name="notes">Base tejido circular + resina (puntos): carga tejido+tintorería por peso + factor entretela por metro.</field>
        </record>
        <record id="ruteo_entretela_tejida_nombre" model="qb.producto.ruteo">
            <field name="sequence">11</field>
            <field name="categ_pattern">%Entretela%</field>
            <field name="name_pattern">(?i)tejido circular|(?&lt;!no )tejida</field>
            <field name="product_bucket">entretela_tejida</field>
            <field name="centro_ids" eval="[(6, 0, [ref('centro_tejido'), ref('centro_tintoreria'), ref('centro_entretelas')])]"/>
        </record>
        <record id="ruteo_entretela_carda" model="qb.producto.ruteo">
            <field name="sequence">12</field>
            <field name="categ_pattern">%Entretela%</field>
            <field name="product_bucket">entretela_carda</field>
            <field name="centro_ids" eval="[(6, 0, [ref('centro_entretelas')])]"/>
        </record>
        <record id="ruteo_perfoquim" model="qb.producto.ruteo">
            <field name="sequence">13</field>
            <field name="categ_pattern">%Perfoquim%</field>
            <field name="product_bucket">entretela_carda</field>
            <field name="centro_ids" eval="[(6, 0, [ref('centro_entretelas')])]"/>
            <field name="notes">Árbol nuevo: Perfoquim ya no contiene la palabra Entretela.</field>
        </record>
        <record id="ruteo_tela_default" model="qb.producto.ruteo">
            <field name="sequence">100</field>
            <field name="categ_pattern">%Tejido Circular%</field>
            <field name="product_bucket">tela</field>
            <field name="centro_ids" eval="[(6, 0, [ref('centro_tejido'), ref('centro_tintoreria'), ref('centro_acabado')])]"/>
            <field name="notes">Tren completo de tela: tejido (kg) → tintorería (kg) → rama (m).</field>
        </record>

    </data>
</odoo>
