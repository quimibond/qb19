<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="panel_action" model="ir.actions.act_window">
        <field name="name">Panel — Capacidad &amp; Costeo</field>
        <field name="res_model">qb.costeo.panel</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <record id="panel_view_form" model="ir.ui.view">
        <field name="name">qb.costeo.panel.form</field>
        <field name="model">qb.costeo.panel</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1>Capacidad &amp; Costeo</h1></div>
                    <group>
                        <div colspan="2">
                            <button name="action_cotizar" string="➜ Cotizar"
                                    type="object" class="btn-primary me-2"/>
                            <button name="action_rentabilidad_clientes"
                                    string="Rentabilidad por cliente"
                                    type="object" class="btn-secondary me-2"/>
                            <button name="action_rentabilidad_productos"
                                    string="Rentabilidad por producto"
                                    type="object" class="btn-secondary me-2"/>
                            <button name="action_balance" string="Balance de línea"
                                    type="object" class="btn-secondary me-2"/>
                            <button name="action_ranking" string="Ranking $/hora-máquina"
                                    type="object" class="btn-secondary me-2"/>
                            <button name="action_recalcular"
                                    string="Recalcular costeo (mes anterior)"
                                    type="object" class="btn-secondary me-2"
                                    confirm="Recalcula factores y costo por producto del mes anterior. Puede tardar unos minutos. ¿Continuar?"/>
                        </div>
                    </group>
                    <field name="negocio_html" nolabel="1"/>
                    <group string="El techo de la planta — utilización por máquina">
                        <field name="kpi_html" nolabel="1" colspan="2"/>
                    </group>
                    <field name="estado_html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
