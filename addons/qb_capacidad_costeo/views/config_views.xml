<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Centros ============ -->
    <record id="centro_action" model="ir.actions.act_window">
        <field name="name">Centros de costo / proceso</field>
        <field name="res_model">qb.costeo.centro</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="centro_view_list" model="ir.ui.view">
        <field name="name">qb.costeo.centro.list</field>
        <field name="model">qb.costeo.centro</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="nature"/>
                <field name="driver_principal"/>
                <field name="workcenter_ids" widget="many2many_tags"/>
                <field name="std_output_per_hour"/>
                <field name="capacidad_normal"/>
                <field name="renta_contractual_mxn"/>
                <field name="modo_costeo" optional="show"/>
                <field name="fecha_absorcion" optional="show"/>
                <field name="es_denominador_kg" optional="hide"/>
                <field name="es_denominador_m" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="centro_view_form" model="ir.ui.view">
        <field name="name">qb.costeo.centro.form</field>
        <field name="model">qb.costeo.centro</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Identidad">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="nature"/>
                            <field name="driver_principal"/>
                            <field name="active"/>
                        </group>
                        <group string="Capacidad">
                            <field name="output_uom_id"/>
                            <field name="std_output_per_hour"/>
                            <field name="capacidad_normal"/>
                            <field name="mo_name_pattern"/>
                            <field name="es_denominador_kg"/>
                            <field name="es_denominador_m"/>
                        </group>
                    </group>
                    <group>
                        <group string="Vínculos con Odoo (escalabilidad)">
                            <field name="workcenter_ids" widget="many2many_tags"/>
                            <field name="department_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Costos">
                            <field name="renta_contractual_mxn"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Régimen de costeo">
                            <field name="modo_costeo"/>
                            <field name="fecha_absorcion"
                                   required="modo_costeo == 'absorcion_odoo'"
                                   invisible="modo_costeo != 'absorcion_odoo'"/>
                            <div colspan="2" class="text-muted"
                                 invisible="modo_costeo != 'absorcion_odoo'">
                                Desde esa fecha el gasto de este centro SALE del
                                pool del módulo: sus workcenters ya lo capitalizan
                                al AVCO del producto. Los períodos anteriores
                                conservan el régimen de capa.
                            </div>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notas..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Clasificación de cuentas ============ -->
    <record id="cuenta_class_action" model="ir.actions.act_window">
        <field name="name">Clasificación de cuentas</field>
        <field name="res_model">qb.costeo.cuenta.class</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="cuenta_class_view_list" model="ir.ui.view">
        <field name="name">qb.costeo.cuenta.class.list</field>
        <field name="model">qb.costeo.cuenta.class</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code_pattern"/>
                <field name="account_id"/>
                <field name="bucket"/>
                <field name="es_variable"/>
                <field name="es_renta" optional="show"/>
                <field name="centro_id"/>
                <field name="driver"/>
                <field name="allocation_pct"/>
                <field name="account_ids" widget="many2many_tags" optional="hide"/>
                <field name="notes" optional="show"/>
            </list>
        </field>
    </record>
    <record id="cuenta_map_action" model="ir.actions.act_window">
        <field name="name">Cuentas mapeadas (resuelto)</field>
        <field name="res_model">qb.costeo.cuenta.map</field>
        <field name="view_mode">list</field>
    </record>
    <record id="cuenta_map_view_list" model="ir.ui.view">
        <field name="name">qb.costeo.cuenta.map.list</field>
        <field name="model">qb.costeo.cuenta.map</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="account_id"/>
                <field name="bucket"/>
                <field name="es_variable"/>
                <field name="es_renta" optional="show"/>
                <field name="centro_id"/>
                <field name="driver"/>
                <field name="allocation_pct"/>
                <field name="class_id"/>
            </list>
        </field>
    </record>
    <record id="cuentas_pendientes_action" model="ir.actions.server">
        <field name="name">Cuentas pendientes de clasificar</field>
        <field name="model_id" ref="model_qb_costeo_cuenta_class"/>
        <field name="state">code</field>
        <field name="code">action = model.action_unclassified_accounts()</field>
    </record>

    <!-- ============ Parámetros ============ -->
    <record id="factor_config_action" model="ir.actions.act_window">
        <field name="name">Parámetros de costeo</field>
        <field name="res_model">qb.costeo.factor.config</field>
        <field name="view_mode">list</field>
    </record>
    <record id="factor_config_view_list" model="ir.ui.view">
        <field name="name">qb.costeo.factor.config.list</field>
        <field name="model">qb.costeo.factor.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="key"/>
                <field name="value"/>
                <field name="value_text"/>
                <field name="descripcion"/>
            </list>
        </field>
    </record>

    <!-- ============ Pesos por producto ============ -->
    <record id="producto_peso_action" model="ir.actions.act_window">
        <field name="name">Peso / conversión por producto</field>
        <field name="res_model">qb.producto.peso</field>
        <field name="view_mode">list</field>
    </record>
    <record id="producto_peso_view_list" model="ir.ui.view">
        <field name="name">qb.producto.peso.list</field>
        <field name="model">qb.producto.peso</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="kg_per_unit"/>
                <field name="m_per_kg"/>
                <field name="source"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- ============ Ruteo ============ -->
    <record id="producto_ruteo_action" model="ir.actions.act_window">
        <field name="name">Ruteo producto → centros</field>
        <field name="res_model">qb.producto.ruteo</field>
        <field name="view_mode">list</field>
    </record>
    <record id="producto_ruteo_view_list" model="ir.ui.view">
        <field name="name">qb.producto.ruteo.list</field>
        <field name="model">qb.producto.ruteo</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="categ_pattern"/>
                <field name="name_pattern"/>
                <field name="product_bucket"/>
                <field name="centro_ids" widget="many2many_tags"/>
                <field name="notes" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ============ Turnos ============ -->
    <record id="turno_config_action" model="ir.actions.act_window">
        <field name="name">Turnos / capacidad manual</field>
        <field name="res_model">qb.turno.config</field>
        <field name="view_mode">list</field>
    </record>
    <record id="turno_config_view_list" model="ir.ui.view">
        <field name="name">qb.turno.config.list</field>
        <field name="model">qb.turno.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="centro_id"/>
                <field name="name"/>
                <field name="hours_per_week"/>
                <field name="machine_count"/>
                <field name="dotacion_ajuste"/>
                <field name="notes"/>
            </list>
        </field>
    </record>


    <!-- ============ Factores por período ============ -->
    <record id="costo_factores_action" model="ir.actions.act_window">
        <field name="name">Factores por período</field>
        <field name="res_model">qb.costo.factores</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="costo_factores_view_list" model="ir.ui.view">
        <field name="name">qb.costo.factores.list</field>
        <field name="model">qb.costo.factores</field>
        <field name="arch" type="xml">
            <list create="false"
                  decoration-muted="state == 'cerrado'"
                  decoration-danger="reaperturas &gt; 0">
                <field name="period"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'cerrado'"
                       decoration-warning="state == 'borrador'"/>
                <field name="reaperturas" optional="show"/>
                <field name="window_months"/>
                <field name="fab_pool_month" sum="Total"/>
                <field name="absorcion_bruta_month" optional="hide" sum="Total"/>
                <field name="absorcion_ya_fuera_month" optional="hide" sum="Total"/>
                <field name="absorcion_pool_month" optional="show" sum="Total"/>
                <field name="centros_absorbidos" optional="show"/>
                <!-- Renta: contractual dentro del pool, GL sustituido fuera.
                     Si la contractual > 0 y la sustituida = 0, revisa que
                     las cuentas de renta estén marcadas «es renta». -->
                <field name="renta_contractual_pool" optional="show"/>
                <field name="renta_gl_sustituida" optional="show"/>
                <field name="mp_gl_month" optional="show"/>
                <field name="mp_modelada_month" optional="show"/>
                <field name="mp_ajuste" optional="show"/>
                <field name="kg_denom_month"/>
                <field name="m_denom_month"/>
                <field name="kg_produccion_month" optional="hide"/>
                <field name="m_produccion_month" optional="hide"/>
                <field name="utilizacion_kg_pct" optional="show"/>
                <field name="utilizacion_m_pct" optional="show"/>
                <field name="utilizacion_pond_pct" optional="hide"/>
                <field name="confiabilidad" optional="show" widget="badge"
                       decoration-warning="confiabilidad == 'parcial'"
                       decoration-danger="confiabilidad == 'mala'"/>
                <field name="fab_ocioso_month" optional="show"/>
                <field name="factor_fab_kg"/>
                <field name="factor_fab_m"/>
                <field name="energia_por_kg"/>
                <field name="importacion_pool_month" optional="show"/>
                <field name="importacion_base_costeable" optional="hide"/>
                <field name="importacion_base_month" optional="hide"/>
                <field name="factor_importacion" optional="show"/>
                <field name="op_pct" widget="percentage"/>
                <field name="op_rate" optional="show"/>
                <field name="entretela_factor_m"/>
                <field name="fab_pool_con_centro_pct" optional="show"/>
                <field name="cobertura_fab_pct"/>
                <button name="action_cerrar" type="object" string="Cerrar"
                        icon="fa-lock" invisible="state == 'cerrado'"
                        confirm="Cerrar el período congela sus factores y sus
                                 costos por producto: ni el cron ni un
                                 recálculo manual podrán volver a tocarlos.
                                 ¿Cerrar?"/>
                <button name="action_reabrir" type="object" string="Reabrir"
                        icon="fa-unlock" invisible="state != 'cerrado'"/>
            </list>
        </field>
    </record>
    <record id="costo_factores_view_form" model="ir.ui.view">
        <field name="name">qb.costo.factores.form</field>
        <field name="model">qb.costo.factores</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_cerrar" type="object" string="Cerrar período"
                            class="btn-primary" invisible="state == 'cerrado'"
                            confirm="Cerrar el período congela sus factores y sus
                                     costos por producto. ¿Cerrar?"/>
                    <button name="action_reabrir" type="object"
                            string="Reabrir período"
                            invisible="state != 'cerrado'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,cerrado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="period" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Ventanas y pools">
                            <field name="window_months"/>
                            <field name="fab_ventana_desde"/>
                            <field name="fab_ventana_meses"/>
                            <field name="fab_pool_month"/>
                            <field name="absorcion_bruta_month"/>
                            <field name="absorcion_ya_fuera_month"/>
                            <field name="absorcion_pool_month"/>
                            <field name="centros_capa"/>
                            <field name="centros_absorbidos"/>
                            <field name="renta_contractual_pool"/>
                            <field name="renta_gl_sustituida"/>
                            <field name="entretela_pool_month"/>
                            <field name="energia_pool_month"/>
                            <field name="op_pool_month"/>
                            <field name="ventas_pool_month"/>
                            <field name="importacion_pool_month"/>
                        </group>
                        <group string="Denominadores y capacidad">
                            <field name="kg_denom_month"/>
                            <field name="m_denom_month"/>
                            <field name="kg_produccion_month"/>
                            <field name="m_produccion_month"/>
                            <field name="utilizacion_kg_pct"/>
                            <field name="utilizacion_m_pct"/>
                            <field name="utilizacion_pond_pct"/>
                            <field name="confiabilidad"/>
                            <field name="confiabilidad_detalle" readonly="1"
                                   invisible="confiabilidad == 'ok'"/>
                            <field name="fab_ocioso_month"/>
                            <field name="entretela_m_denom_month"/>
                        </group>
                    </group>
                    <group>
                        <group string="Factores resultantes">
                            <field name="fab_weight_share"/>
                            <field name="factor_fab_kg"/>
                            <field name="factor_fab_m"/>
                            <field name="entretela_factor_m"/>
                            <field name="energia_por_kg"/>
                            <field name="op_pct" widget="percentage"/>
                            <field name="op_rate"/>
                            <field name="factor_importacion"/>
                            <field name="mp_ajuste"/>
                        </group>
                        <group string="Cierre">
                            <field name="cerrado_por"/>
                            <field name="cerrado_el"/>
                            <field name="reaperturas"/>
                            <field name="motivo_reapertura"
                                   placeholder="Obligatorio para reabrir: por qué hay que mover un período ya reportado."/>
                        </group>
                    </group>
                    <group string="Cobertura y trazabilidad">
                        <field name="cobertura_fab_pct"/>
                        <field name="fab_pool_con_centro_pct"/>
                        <field name="mp_gl_month"/>
                        <field name="mp_modelada_month"/>
                        <field name="importacion_base_month"/>
                        <field name="importacion_base_costeable"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
