<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="costo_producto_action" model="ir.actions.act_window">
        <field name="name">Costo por producto</field>
        <field name="res_model">qb.costo.producto</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
    <record id="costo_producto_view_search" model="ir.ui.view">
        <field name="name">qb.costo.producto.search</field>
        <field name="model">qb.costo.producto</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="default_code"/>
                <field name="product_bucket"/>
                <filter name="vendidos" string="Vendidos en el período"
                        domain="[('qty_vendida', '&gt;', 0)]"/>
                <filter name="margen_negativo" string="Margen absorbido negativo"
                        domain="[('margen_absorbido', '&lt;', 0), ('qty_vendida', '&gt;', 0)]"/>
                <filter name="contribucion_negativa" string="Contribución negativa"
                        domain="[('margen_contribucion', '&lt;', 0), ('qty_vendida', '&gt;', 0)]"/>
                <separator/>
                <filter name="alerta_bajo_variable" string="🔴 Bajo costo variable"
                        domain="[('alerta', '=', 'bajo_variable')]"/>
                <filter name="alerta_bajo_absorbido" string="🟡 No cubre absorbido"
                        domain="[('alerta', '=', 'bajo_absorbido')]"/>
                <filter name="alerta_sin_peso" string="⚪ Sin peso resuelto"
                        domain="[('alerta', '=', 'sin_peso')]"/>
                <filter name="alerta_peso_estimado" string="⚖️ Peso estimado (verificar)"
                        domain="[('alerta', '=', 'peso_estimado')]"
                        help="Productos costeados con un peso ADIVINADO (del código o del weight de Odoo), no medido. Su energía/fabricación/margen puede estar mal — captura su peso real en Configuración → Pesos por producto."/>
                <separator/>
                <filter name="group_period" string="Agrupar por período"
                        context="{'group_by': 'period'}"/>
                <filter name="group_bucket" string="Agrupar por clasificación"
                        context="{'group_by': 'product_bucket'}"/>
            </search>
        </field>
    </record>
    <record id="costo_producto_view_list" model="ir.ui.view">
        <field name="name">qb.costo.producto.list</field>
        <field name="model">qb.costo.producto</field>
        <field name="arch" type="xml">
            <list create="false"
                  decoration-danger="margen_contribucion &lt; 0 and qty_vendida &gt; 0"
                  decoration-warning="margen_absorbido &lt; 0 and margen_contribucion &gt;= 0 and qty_vendida &gt; 0">
                <field name="period" optional="show"/>
                <field name="default_code"/>
                <field name="product_id"/>
                <field name="product_bucket" optional="hide"/>
                <field name="uom_name"/>
                <field name="qty_vendida" sum="Total"/>
                <field name="precio_prom"/>
                <field name="mp_unit"/>
                <field name="energia_unit" optional="hide"/>
                <field name="costo_variable"/>
                <field name="fab_unit"/>
                <field name="op_unit" optional="hide"/>
                <field name="costo_absorbido"/>
                <field name="margen_contribucion"/>
                <field name="margen_contribucion_pct"/>
                <field name="margen_absorbido_pct"/>
                <field name="contrib_hora_maquina"/>
                <field name="alerta" widget="badge"
                       decoration-danger="alerta == 'bajo_variable'"
                       decoration-warning="alerta in ('bajo_absorbido', 'peso_estimado')"
                       decoration-info="alerta == 'sin_peso'"/>
                <field name="peso_source" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="costo_producto_view_form" model="ir.ui.view">
        <field name="name">qb.costo.producto.form</field>
        <field name="model">qb.costo.producto</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group string="Producto">
                            <field name="period"/>
                            <field name="product_id"/>
                            <field name="default_code"/>
                            <field name="product_bucket"/>
                            <field name="centro_route"/>
                            <field name="uom_name"/>
                            <field name="kg_per_unit"/>
                            <field name="m_per_kg"/>
                        </group>
                        <group string="Venta del período">
                            <field name="qty_vendida"/>
                            <field name="precio_prom"/>
                            <field name="factores_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Costo por capa ($/u)">
                            <field name="mp_unit"/>
                            <field name="energia_unit"/>
                            <field name="costo_variable"/>
                            <field name="fab_unit"/>
                            <field name="op_unit"/>
                            <field name="costo_absorbido"/>
                        </group>
                        <group string="Márgenes">
                            <field name="margen_contribucion"/>
                            <field name="margen_contribucion_pct"/>
                            <field name="margen_absorbido"/>
                            <field name="margen_absorbido_pct"/>
                            <field name="contrib_hora_maquina"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="costo_producto_view_pivot" model="ir.ui.view">
        <field name="name">qb.costo.producto.pivot</field>
        <field name="model">qb.costo.producto</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="product_bucket" type="row"/>
                <field name="period" type="col"/>
                <field name="qty_vendida" type="measure"/>
                <field name="margen_contribucion" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============ Ranking por hora-máquina ============
         Cuando la capacidad es el límite (hay cuello de botella), lo que
         importa NO es el margen % sino cuánta contribución deja cada hora
         de máquina. Este ranking dice qué productos empujar.
         (Las vistas van ANTES de la acción: view_ids las referencia.) -->
    <record id="costo_ranking_view_list" model="ir.ui.view">
        <field name="name">qb.costo.producto.ranking.list</field>
        <field name="model">qb.costo.producto</field>
        <field name="arch" type="xml">
            <list create="false" default_order="contrib_hora_maquina desc"
                  decoration-success="contrib_hora_maquina &gt;= 1000"
                  decoration-danger="margen_contribucion &lt; 0">
                <field name="period" optional="show"/>
                <field name="default_code"/>
                <field name="product_id"/>
                <field name="centro_route"/>
                <field name="contrib_hora_maquina"/>
                <field name="margen_contribucion"/>
                <field name="margen_contribucion_pct"/>
                <field name="qty_vendida" sum="Total"/>
                <field name="contrib_total" sum="Total"/>
                <field name="precio_prom" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="costo_ranking_view_graph" model="ir.ui.view">
        <field name="name">qb.costo.producto.ranking.graph</field>
        <field name="model">qb.costo.producto</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="default_code"/>
                <field name="contrib_hora_maquina" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="costo_ranking_action" model="ir.actions.act_window">
        <field name="name">Ranking: contribución por hora-máquina</field>
        <field name="res_model">qb.costo.producto</field>
        <field name="view_mode">list,graph</field>
        <field name="domain">[('qty_vendida', '&gt;', 0), ('contrib_hora_maquina', '&gt;', 0)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('costo_ranking_view_list')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('costo_ranking_view_graph')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ranking por hora-máquina</p>
            <p>Si el cuello de botella está lleno, cada hora de máquina debe
            dejar la mayor contribución posible. Los de arriba son los
            productos a empujar; los de abajo, los que ocupan el cuello
            dejando poco. Compara con "Contribución total" para ver si la
            mezcla actual de ventas está alineada.</p>
        </field>
    </record>

    <!-- Recalcular el mes anterior a demanda -->
    <record id="costo_recompute_action" model="ir.actions.server">
        <field name="name">Recalcular costeo (mes anterior)</field>
        <field name="model_id" ref="model_qb_costo_producto"/>
        <field name="state">code</field>
        <field name="code">model.action_recompute_period()</field>
    </record>

</odoo>
