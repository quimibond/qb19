<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_cotizacion" model="ir.actions.report">
        <field name="name">Cotización de costo (PDF)</field>
        <field name="model">qb.cotizacion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">qb_capacidad_costeo.report_cotizacion</field>
        <field name="print_report_name">'Cotizacion - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_qb_cotizacion"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cotizacion">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><span t-field="o.name"/></h2>
                        <p>
                            <strong>Cliente:</strong> <span t-field="o.partner_id"/><br/>
                            <strong>Fecha:</strong> <span t-field="o.create_date" t-options='{"widget": "date"}'/><br/>
                            <t t-if="o.product_id">
                                <strong>Producto:</strong> <span t-field="o.product_id.display_name"/><br/>
                            </t>
                            <t t-if="o.spec_descripcion">
                                <strong>Especificación:</strong> <span t-field="o.spec_descripcion"/>
                                (<span t-field="o.spec_gramaje"/> g/m² × <span t-field="o.spec_ancho"/> m)<br/>
                            </t>
                            <strong>Volumen:</strong>
                            <span t-esc="'%s %s/mes' % ('{:,.0f}'.format(o.volumen), o.uom_name or 'u')"/><br/>
                            <t t-if="o.validez_hasta">
                                <strong>Válida hasta:</strong>
                                <span t-field="o.validez_hasta"/> (después,
                                TC y costos de MP pueden cambiar)
                            </t>
                        </p>

                        <div t-if="o.semaforo == 'rojo'" class="alert alert-danger">
                            🔴 Precio debajo del costo variable — destruye valor.
                        </div>
                        <div t-if="o.semaforo == 'ambar'" class="alert alert-warning">
                            🟡 Aporta a fijos — conviene solo con capacidad ociosa.
                        </div>
                        <div t-if="o.semaforo == 'verde'" class="alert alert-success">
                            🟢 Cubre el costo total + margen.
                        </div>

                        <h4>Costo por capa ($/unidad)</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr><td>Materia prima (BOM a último costo)</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.mp_unit)"/></td></tr>
                                <tr><td>Energía variable</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.energia_unit)"/></td></tr>
                                <tr class="fw-bold"><td>Costo variable</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.costo_variable)"/></td></tr>
                                <tr><td>Fabricación absorbida</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.fab_unit)"/></td></tr>
                                <tr><td>Operación (<span t-esc="'{:.1f}'.format(o.op_pct)"/>% sobre venta)</td>
                                    <td class="text-end">s/precio</td></tr>
                            </tbody>
                        </table>

                        <h4>Precios</h4>
                        <table class="table table-sm">
                            <thead t-if="o.es_divisa">
                                <tr><th></th><th class="text-end">MXN</th>
                                    <th class="text-end">Divisa (TC <span t-esc="'{:.4f}'.format(o.fx_rate)"/>)</th></tr>
                            </thead>
                            <tbody>
                                <tr class="fw-bold"><td>Precio sugerido (margen meta <span t-esc="'{:.0f}'.format(o.target_margin)"/>%)</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.precio_sugerido)"/></td>
                                    <td t-if="o.es_divisa" class="text-end fw-bold"><span t-esc="'{:,.4f}'.format(o.precio_sugerido_divisa)"/></td></tr>
                                <tr t-if="o.precio_objetivo"><td>Precio objetivo</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.precio_objetivo)"/></td>
                                    <td t-if="o.es_divisa" class="text-end"><span t-esc="'{:,.4f}'.format(o.precio_objetivo / o.fx_rate)"/></td></tr>
                                <tr><td>Piso con capacidad ociosa (= costo variable)</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.piso_ocioso)"/></td>
                                    <td t-if="o.es_divisa" class="text-end"><span t-esc="'{:,.4f}'.format(o.piso_ocioso_divisa)"/></td></tr>
                                <tr><td>Piso a planta llena (margen cero absorbido)</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.piso_lleno)"/></td>
                                    <td t-if="o.es_divisa" class="text-end"><span t-esc="'{:,.4f}'.format(o.piso_lleno_divisa)"/></td></tr>
                            </tbody>
                        </table>

                        <h4>Márgenes al precio evaluado</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr><td>Margen bruto (precio − costo de producción)</td>
                                    <td class="text-end"><span t-esc="'{:.1f}'.format(o.margen_bruto_pct)"/>%</td></tr>
                                <tr><td>Margen neto (después de producción + operación)</td>
                                    <td class="text-end"><span t-esc="'{:.1f}'.format(o.margen_neto_pct)"/>%</td></tr>
                                <tr><td>Contribución</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.margen_contribucion)"/>
                                        (<span t-esc="'{:.1f}'.format(o.margen_contribucion_pct)"/>%)</td></tr>
                                <tr><td>Contribución por hora-máquina</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.contrib_hora_maquina)"/></td></tr>
                            </tbody>
                        </table>

                        <h4>Capacidad</h4>
                        <p><span t-esc="'✔ Cabe en capacidad' if o.capacity_ok else '✘ NO cabe en capacidad actual'"/></p>
                        <pre style="font-size:11px;"><span t-field="o.capacity_detail"/></pre>

                        <h4>Supuestos</h4>
                        <pre style="font-size:10px;"><span t-field="o.supuestos"/></pre>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
