<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         PDF 1 — HOJA INTERNA DE COSTO Y PRECIO (decisión, 1 página)
         Para dirección/ventas. NO se envía al cliente.
         ================================================================ -->
    <record id="action_report_cotizacion" model="ir.actions.report">
        <field name="name">Hoja interna de costo y precio (NO enviar al cliente)</field>
        <field name="model">qb.cotizacion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">qb_capacidad_costeo.report_cotizacion</field>
        <field name="print_report_name">'Hoja interna - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_qb_cotizacion"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cotizacion">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <h2><span t-field="o.name"/>
                            <span style="font-size:13px; color:#888;"> · hoja interna de costo y precio</span></h2>

                        <!-- Datos generales -->
                        <table class="table table-sm table-borderless" style="font-size:12px; margin-bottom:4px;">
                            <tbody>
                                <tr>
                                    <td style="width:50%; padding:2px;">
                                        <strong>Cliente:</strong> <span t-field="o.partner_id"/><br/>
                                        <t t-if="o.product_id">
                                            <strong>Producto:</strong> <span t-field="o.product_id.display_name"/><br/>
                                        </t>
                                        <t t-if="o.spec_descripcion">
                                            <strong>Especificación:</strong> <span t-field="o.spec_descripcion"/>
                                            (<span t-field="o.spec_gramaje"/> g/m² × <span t-field="o.spec_ancho"/> m)<br/>
                                        </t>
                                        <strong>Volumen:</strong>
                                        <span t-esc="'%s %s/mes' % ('{:,.0f}'.format(o.volumen), o.uom_name or 'u')"/>
                                    </td>
                                    <td style="padding:2px;">
                                        <strong>Fecha:</strong> <span t-field="o.create_date" t-options='{"widget": "date"}'/><br/>
                                        <t t-if="o.validez_hasta">
                                            <strong>Válida hasta:</strong> <span t-field="o.validez_hasta"/><br/>
                                        </t>
                                        <t t-if="o.es_divisa">
                                            <strong>TC:</strong> 1 <span t-esc="o.currency_id.name or 'divisa'"/> =
                                            $<span t-esc="'{:,.4f}'.format(o.fx_rate)"/> MXN (del día de cotizar)<br/>
                                        </t>
                                        <strong>Precio evaluado:</strong>
                                        <span t-esc="o.evaluado_fuente"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- La decisión, en una línea -->
                        <div t-if="o.semaforo == 'rojo'" class="alert alert-danger" style="font-size:12px; padding:6px 10px;">
                            🔴 <b>NO tomar a este precio</b>: está debajo del costo variable — ni la materia prima se recupera.
                        </div>
                        <div t-if="o.semaforo == 'ambar'" class="alert alert-warning" style="font-size:12px; padding:6px 10px;">
                            🟡 <b>Tomar SOLO con capacidad ociosa</b>: aporta a los fijos, pero no cubre el costo completo.
                        </div>
                        <div t-if="o.semaforo == 'verde'" class="alert alert-success" style="font-size:12px; padding:6px 10px;">
                            🟢 <b>Precio sano</b>: cubre el costo completo y deja margen.
                        </div>

                        <!-- Del costo al precio: cada número UNA sola vez -->
                        <h5 style="margin-bottom:4px;">Del costo al precio ($/<span t-esc="o.uom_name or 'unidad'"/>)</h5>
                        <table class="table table-sm" style="font-size:12px;">
                            <thead>
                                <tr><th></th>
                                    <th class="text-end" style="width:14%;">MXN</th>
                                    <th t-if="o.es_divisa" class="text-end" style="width:14%;"><span t-esc="o.currency_id.name or 'Divisa'"/></th>
                                    <th style="width:44%; font-weight:normal; color:#888;"></th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Materia prima</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.mp_unit)"/></td>
                                    <td t-if="o.es_divisa"/>
                                    <td style="color:#888;">receta a último costo de compra</td></tr>
                                <tr><td>+ Energía</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.energia_unit)"/></td>
                                    <td t-if="o.es_divisa"/>
                                    <td style="color:#888;">luz / gas / agua</td></tr>
                                <tr style="background:#f8f9fa;"><td><b>= Costo variable</b></td>
                                    <td class="text-end"><b><span t-esc="'{:,.2f}'.format(o.costo_variable)"/></b></td>
                                    <td t-if="o.es_divisa" class="text-end"><span t-esc="'{:,.4f}'.format(o.piso_ocioso_divisa)"/></td>
                                    <td style="color:#888;">piso mínimo absoluto — nunca vender debajo</td></tr>
                                <tr><td>+ Fabricación</td>
                                    <td class="text-end"><span t-esc="'{:,.2f}'.format(o.fab_unit)"/></td>
                                    <td t-if="o.es_divisa"/>
                                    <td style="color:#888;">gasto fijo de planta que absorbe esta unidad</td></tr>
                                <tr><td>+ Operación</td>
                                    <td class="text-end"><span t-esc="'{:.1f}'.format(o.op_pct)"/>%</td>
                                    <td t-if="o.es_divisa"/>
                                    <td style="color:#888;">admin y ventas, % sobre el precio</td></tr>
                                <tr style="background:#f8f9fa;"><td><b>= Piso a planta llena</b></td>
                                    <td class="text-end"><b><span t-esc="'{:,.2f}'.format(o.piso_lleno)"/></b></td>
                                    <td t-if="o.es_divisa" class="text-end"><span t-esc="'{:,.4f}'.format(o.piso_lleno_divisa)"/></td>
                                    <td style="color:#888;">cubre todo, gana cero — mínimo con planta llena</td></tr>
                                <tr t-if="o.precio_mercado" style="background:#e7f5ec;"><td><b>Precio de mercado (prom. 12m)</b></td>
                                    <td class="text-end"><b><span t-esc="'{:,.2f}'.format(o.precio_mercado)"/></b></td>
                                    <td t-if="o.es_divisa" class="text-end"><span t-esc="'{:,.4f}'.format(o.precio_mercado_divisa)"/></td>
                                    <td style="color:#888;">a lo que ya se vende de verdad (todos los clientes)</td></tr>
                                <tr t-if="o.precio_objetivo"><td><b>⭐ Precio objetivo (evaluado)</b></td>
                                    <td class="text-end"><b><span t-esc="'{:,.2f}'.format(o.precio_objetivo)"/></b></td>
                                    <td t-if="o.es_divisa" class="text-end"><b><span t-esc="'{:,.4f}'.format(o.precio_objetivo / o.fx_rate)"/></b></td>
                                    <td style="color:#888;">lo que pide el cliente / se propone</td></tr>
                            </tbody>
                        </table>

                        <!-- Qué deja el precio evaluado: una sola línea de márgenes -->
                        <h5 style="margin-bottom:4px;">Qué deja el precio evaluado
                            <span style="font-weight:normal; font-size:12px;">
                                (<span t-esc="o.evaluado_fuente"/>:
                                $<span t-esc="'{:,.2f}'.format(o.precio_evaluado)"/> MXN)
                            </span>
                        </h5>
                        <table class="table table-sm" style="font-size:12px;">
                            <thead>
                                <tr><th class="text-end">Contribución $/u</th>
                                    <th class="text-end">Contribución %</th>
                                    <th class="text-end">Margen bruto %</th>
                                    <th class="text-end">Margen neto %</th>
                                    <th class="text-end">$/hora-máquina</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-end">$<span t-esc="'{:,.2f}'.format(o.margen_contribucion)"/></td>
                                    <td class="text-end"><span t-esc="'{:.1f}'.format(o.margen_contribucion_pct)"/>%</td>
                                    <td class="text-end"><span t-esc="'{:.1f}'.format(o.margen_bruto_pct)"/>%</td>
                                    <td class="text-end"><b><span t-esc="'{:.1f}'.format(o.margen_neto_pct)"/>%</b></td>
                                    <td class="text-end">$<span t-esc="'{:,.0f}'.format(o.contrib_hora_maquina)"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p style="font-size:10px; color:#888; margin-top:-6px;">
                            Contribución = precio − costo variable (lo que aporta a fijos) ·
                            bruto = después de fabricar · neto = después de TODO.
                        </p>

                        <!-- Capacidad: una línea si cabe; detalle solo si NO cabe -->
                        <p style="font-size:12px; margin-bottom:2px;">
                            <b>Capacidad:</b>
                            <t t-if="o.capacity_ok">✔ el volumen cabe en la planta (detalle por centro en Odoo).</t>
                            <t t-else="">✘ <b>NO cabe en la capacidad actual:</b></t>
                        </p>
                        <pre t-if="not o.capacity_ok" style="font-size:10px;"><span t-field="o.capacity_detail"/></pre>

                        <!-- Comparativa: lo más valioso para decidir precio -->
                        <t t-if="o.comparativa_html">
                            <div t-field="o.comparativa_html"/>
                        </t>

                        <p style="font-size:9px; color:#888; border-top:1px solid #ddd; margin-top:8px; padding-top:4px;">
                            Documento INTERNO — al cliente se le envía la «Cotización
                            (PDF para cliente)», sin costos ni márgenes. Definiciones
                            de cada término: pestaña Glosario en Odoo. El anexo
                            siguiente muestra de dónde sale cada número.
                        </p>

                        <!-- ============ ANEXO: ¿de dónde salen los números? ============ -->
                        <t t-if="o.desglose_html">
                            <div style="page-break-before:always;"/>
                            <h4>Anexo — ¿De dónde sale cada número?</h4>
                            <p style="font-size:11px; color:#555;">
                                Foto tomada al momento de cotizar: la receta (BOM)
                                componente por componente con su última compra real
                                (proveedor, fecha, precio y tendencia), el peso usado y
                                su fuente, los pools de gasto del GL con la fórmula de
                                cada factor, y el % de operación. Si un número no
                                cuadra, aquí se ve exactamente de qué dato viene.
                            </p>
                            <div t-field="o.desglose_html"/>
                        </t>
                        <h5 style="margin-top:8px;">Supuestos de esta cotización</h5>
                        <pre style="font-size:10px; white-space:pre-wrap;"><span t-field="o.supuestos"/></pre>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ================================================================
         PDF 2 — COTIZACIÓN PARA CLIENTE (comercial)
         Solo producto, precio y condiciones. Sin ningún dato interno.
         ================================================================ -->
    <record id="action_report_cotizacion_cliente" model="ir.actions.report">
        <field name="name">Cotización (PDF para cliente)</field>
        <field name="model">qb.cotizacion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">qb_capacidad_costeo.report_cotizacion_cliente</field>
        <field name="print_report_name">'Cotizacion Quimibond - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_qb_cotizacion"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cotizacion_cliente">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Cotización</h2>
                        <p style="font-size:13px;">
                            <strong>Cliente:</strong> <span t-field="o.partner_id"/><br/>
                            <strong>Fecha:</strong> <span t-field="o.create_date" t-options='{"widget": "date"}'/>
                            <t t-if="o.validez_hasta"><br/>
                                <strong>Vigencia:</strong> hasta el <span t-field="o.validez_hasta"/>
                            </t>
                        </p>

                        <table class="table table-sm" style="font-size:13px;">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Volumen estimado</th>
                                    <th class="text-end">Precio unitario</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <t t-if="o.product_id">
                                            <span t-field="o.product_id.display_name"/>
                                        </t>
                                        <t t-if="o.spec_descripcion">
                                            <span t-field="o.spec_descripcion"/>
                                            (<span t-field="o.spec_gramaje"/> g/m² ×
                                            <span t-field="o.spec_ancho"/> m<t t-if="o.spec_galga">,
                                            galga <span t-field="o.spec_galga"/></t>)
                                        </t>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'%s %s/mes' % ('{:,.0f}'.format(o.volumen), o.uom_name or 'u')"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="o.es_divisa">
                                            <b><span t-esc="'{:,.4f}'.format(o.precio_cliente_divisa)"/>
                                            <span t-esc="o.currency_id.name or ''"/></b>
                                            por <span t-esc="o.uom_name or 'unidad'"/>
                                        </t>
                                        <t t-else="">
                                            <b>$<span t-esc="'{:,.2f}'.format(o.precio_cliente_mxn)"/> MXN</b>
                                            por <span t-esc="o.uom_name or 'unidad'"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h5>Condiciones</h5>
                        <ul style="font-size:12px;">
                            <li>Precio unitario más IVA.</li>
                            <li t-if="o.validez_hasta">Cotización válida hasta el
                                <span t-field="o.validez_hasta"/>; después de esa fecha
                                está sujeta a reconfirmación.</li>
                            <li t-if="o.es_divisa">Precio expresado en
                                <span t-esc="o.currency_id.name or 'divisa'"/>.</li>
                            <li>Volumen estimado mensual de referencia; ajustes
                                importantes de volumen pueden requerir re-cotización.</li>
                        </ul>

                        <p style="font-size:12px;">Quedamos atentos a sus comentarios.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
