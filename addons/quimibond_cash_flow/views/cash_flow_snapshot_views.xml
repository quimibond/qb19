<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_flow_snapshot_list" model="ir.ui.view">
        <field name="name">cash.flow.snapshot.list</field>
        <field name="model">cash.flow.snapshot</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="kind"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="opening_cash"/>
                <field name="operating"/>
                <field name="investing"/>
                <field name="financing"/>
                <field name="fx_effect"/>
                <field name="closing_cash"/>
                <field name="closing_cash_book"/>
                <field name="difference"/>
                <field name="unclassified"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_cash_flow_snapshot_form" model="ir.ui.view">
        <field name="name">cash.flow.snapshot.form</field>
        <field name="model">cash.flow.snapshot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_regenerate" type="object" string="Recalcular" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="kind"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="opening_cash"/>
                            <field name="operating"/>
                            <field name="investing"/>
                            <field name="financing"/>
                            <field name="net_increase"/>
                            <field name="fx_effect"/>
                            <field name="closing_cash"/>
                            <field name="closing_cash_book"/>
                            <field name="difference"/>
                            <field name="unclassified"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Datos (JSON)">
                            <field name="data" widget="json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cash_flow_snapshot" model="ir.actions.act_window">
        <field name="name">Snapshots de flujo de efectivo</field>
        <field name="res_model">cash.flow.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
