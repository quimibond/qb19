<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qb_checador_equipo_list" model="ir.ui.view">
        <field name="name">qb.checador.equipo.list</field>
        <field name="model">qb.checador.equipo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="serial"/>
                <field name="marca" optional="show"/>
                <field name="modelo"/>
                <field name="ubicacion"/>
                <field name="autorizado"/>
                <field name="estado_conexion" widget="badge"
                       decoration-success="estado_conexion == 'conectado'"
                       decoration-danger="estado_conexion == 'sin_conexion'"
                       decoration-muted="estado_conexion == 'nunca'"/>
                <field name="conexion_hace"/>
                <field name="ultima_conexion" optional="hide"/>
                <field name="ultima_checada"/>
                <field name="checada_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_qb_checador_equipo_form" model="ir.ui.view">
        <field name="name">qb.checador.equipo.form</field>
        <field name="model">qb.checador.equipo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reenviar_todo" type="object" string="Pedir todo el historial"
                            invisible="marca != 'zkteco'"
                            help="Pone la marca en 0: en la siguiente conexión el equipo vuelve a mandar todo lo que guarda. Las checadas repetidas se ignoran."
                            confirm="¿Pedir al equipo que vuelva a mandar todo su historial? Las repetidas se ignoran."/>
                    <button name="action_nuevo_token" type="object" string="Generar URL nueva"
                            invisible="marca != 'hikvision'"
                            help="Cambia el token de la URL de escucha. La URL anterior deja de funcionar: hay que capturar la nueva en el reloj."
                            confirm="La URL actual deja de funcionar y el reloj no podrá mandar checadas hasta que se capture la nueva. ¿Continuar?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Sin autorizar" bg_color="text-bg-danger" invisible="autorizado"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Entrada planta"/></h1>
                    </div>
                    <div class="alert alert-info mb-3" role="status" invisible="estado_conexion != 'nunca' or marca != 'hikvision'">
                        Este reloj Hikvision nunca ha mandado nada a Odoo. Odoo no puede buscarlo: el reloj es el que se conecta,
                        y solo cuando alguien checa o cuando se usa la prueba de su escucha HTTP. Capture en el reloj, en
                        «Escucha HTTP» (HTTP Listening / httpHosts), el servidor, el puerto 443 con HTTPS y la ruta que aparecen abajo.
                        Si el reloj no ofrece HTTPS, apúntelo al puente de la oficina (README del módulo, carpeta puente).
                    </div>
                    <div class="alert alert-info mb-3" role="status" invisible="estado_conexion != 'nunca' or marca != 'zkteco'">
                        Este reloj nunca se ha presentado a Odoo. Odoo no puede buscarlo: el reloj es el que se conecta.
                        Revise que el reloj tenga salida a internet (puerta de enlace, DNS, firewall por el puerto 443) y que
                        en Menú → Comunicación → Servidor en la nube apunte a quimibond-qb19.odoo.com, puerto 443, HTTPS.
                        En cuanto se presente, este aviso desaparece y abajo se ve «Conectado».
                    </div>
                    <div class="alert alert-danger mb-3" role="alert" invisible="estado_conexion != 'sin_conexion'">
                        El reloj se conectó antes pero lleva un rato sin presentarse: apagado, sin red o con la configuración
                        del servidor cambiada. Las checadas no se pierden: el reloj las guarda y las manda al volver.
                    </div>
                    <group>
                        <group string="Equipo">
                            <field name="marca"/>
                            <field name="serial"/>
                            <field name="modelo"/>
                            <field name="ubicacion"/>
                            <field name="ip"/>
                            <field name="firmware"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Cómo se interpreta">
                            <field name="tz"/>
                            <field name="prefijos"/>
                            <field name="autorizado"/>
                            <field name="active"/>
                        </group>
                        <group string="Actividad">
                            <field name="estado_conexion" widget="badge"
                                   decoration-success="estado_conexion == 'conectado'"
                                   decoration-danger="estado_conexion == 'sin_conexion'"
                                   decoration-muted="estado_conexion == 'nunca'"/>
                            <field name="conexion_hace"/>
                            <field name="ultima_conexion"/>
                            <field name="ultima_checada"/>
                            <field name="attlog_stamp" invisible="marca != 'zkteco'"/>
                            <field name="checada_count"/>
                        </group>
                    </group>
                    <group string="Usuarios del reloj">
                        <field name="usuario_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="pin"/>
                                <field name="nombre_reloj"/>
                                <field name="employee_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="Escucha HTTP del reloj (Hikvision)" invisible="marca != 'hikvision'">
                        <field name="host_push" readonly="1"/>
                        <field name="ruta_push" readonly="1"/>
                        <field name="url_push" readonly="1" widget="CopyClipboardChar"/>
                    </group>
                    <group string="Último mensaje recibido" invisible="marca != 'hikvision'">
                        <field name="ultimo_mensaje" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Notas">
                        <field name="notas" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qb_checador_equipo" model="ir.actions.act_window">
        <field name="name">Relojes checadores</field>
        <field name="res_model">qb.checador.equipo</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre aquí cada reloj checador</p>
            <p>Se identifica por su número de serie. Un equipo que se conecte sin estar registrado aparece aquí sin autorizar: revíselo, póngale nombre y márquelo autorizado y activo.</p>
        </field>
    </record>

</odoo>
