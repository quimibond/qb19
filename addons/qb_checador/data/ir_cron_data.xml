<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Empareja las checadas nuevas en asistencias. Cada 5 minutos; con Realtime=1
             el reloj manda cada checada al momento, así que la asistencia queda en Odoo
             a los pocos minutos de checar. -->
        <record id="cron_qb_checador_emparejar" model="ir.cron">
            <field name="name">Checadores - Emparejar checadas en asistencias</field>
            <field name="model_id" ref="model_qb_checada"/>
            <field name="state">code</field>
            <field name="code">model._cron_emparejar()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
