<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qb_pedimento_garantia_list" model="ir.ui.view">
        <field name="name">qb.pedimento.garantia.list</field>
        <field name="model">qb.pedimento.garantia</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'pendiente' and dias > 60" decoration-muted="state in ('devuelta', 'perdida')">
                <field name="fecha_pago"/>
                <field name="name"/>
                <field name="tipo"/>
                <field name="partner_id"/>
                <field name="pedimento_id"/>
                <field name="referencia" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="importe"/>
                <field name="devuelto" optional="show"/>
                <field name="pendiente"/>
                <field name="pendiente_mxn" sum="Pendiente (MXN)"/>
                <field name="dias"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="state" widget="badge" decoration-danger="state == 'pendiente'"
                       decoration-warning="state == 'parcial'" decoration-success="state == 'devuelta'"/>
            </list>
        </field>
    </record>

    <record id="view_qb_pedimento_garantia_form" model="ir.ui.view">
        <field name="name">qb.pedimento.garantia.form</field>
        <field name="model">qb.pedimento.garantia</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Garantía contenedor NYKU0807898"/></h1></div>
                    <group>
                        <group>
                            <field name="tipo"/>
                            <field name="partner_id"/>
                            <field name="pedimento_id"/>
                            <field name="referencia"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="importe"/>
                            <field name="fecha_pago"/>
                            <field name="devuelto"/>
                            <field name="fecha_devolucion"/>
                            <field name="pendiente"/>
                            <field name="pendiente_mxn"/>
                            <field name="dias"/>
                            <field name="perdida"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qb_pedimento_garantia_search" model="ir.ui.view">
        <field name="name">qb.pedimento.garantia.search</field>
        <field name="model">qb.pedimento.garantia</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('referencia', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="pedimento_id"/>
                <filter name="sin_devolver" string="Sin devolver" domain="[('state', 'in', ('pendiente', 'parcial'))]"/>
                <filter name="devueltas" string="Devueltas" domain="[('state', '=', 'devuelta')]"/>
                <filter name="perdidas" string="Perdidas" domain="[('state', '=', 'perdida')]"/>
                <separator/>
                <filter name="fecha_pago_f" string="Fecha de pago" date="fecha_pago"/>
                <separator/>
                <filter name="group_partner" string="Agrupar por quién la tiene" context="{'group_by': 'partner_id'}"/>
                <filter name="group_tipo" string="Agrupar por tipo" context="{'group_by': 'tipo'}"/>
            </search>
        </field>
    </record>

    <record id="action_qb_pedimento_garantia" model="ir.actions.act_window">
        <field name="name">Garantías</field>
        <field name="res_model">qb.pedimento.garantia</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_sin_devolver': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin garantías registradas</p>
            <p>Garantías navieras, depósitos a la agencia y cuenta aduanera de garantía, hasta que se devuelven.</p>
        </field>
    </record>

</odoo>
