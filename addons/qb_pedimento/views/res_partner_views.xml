<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_qb_pedimento" model="ir.ui.view">
        <field name="name">res.partner.form.qb_pedimento</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <field name="qb_pedimento_virtual" groups="qb_pedimento.group_pedimento_user"/>
            </xpath>
        </field>
    </record>
</odoo>
