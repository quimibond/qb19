<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pedimento" model="ir.module.category">
        <field name="name">Pedimentos</field>
        <field name="description">Expedientes de pedimentos de importación y exportación</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_pedimento" model="res.groups.privilege">
        <field name="name">Pedimentos</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_pedimento"/>
    </record>

    <!-- Capturan Logística, Contabilidad y CxC (Dario, Irma, Aurelio, Sandra). -->
    <record id="group_pedimento_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pedimento"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pedimento_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pedimento"/>
        <field name="implied_ids" eval="[(4, ref('group_pedimento_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_qb_pedimento_company" model="ir.rule">
        <field name="name">Pedimentos: compañías permitidas</field>
        <field name="model_id" ref="model_qb_pedimento"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_qb_pedimento_garantia_company" model="ir.rule">
        <field name="name">Garantías: compañías permitidas</field>
        <field name="model_id" ref="model_qb_pedimento_garantia"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
