<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Avisos diarios como actividades al responsable: despachado sin cruzar (C2.31),
             entregado sin cerrar (C2.32) y garantías sin devolver. Idempotente.
             13:20 UTC = 7:20 en Ciudad de México. -->
        <record id="cron_qb_pedimento_avisos" model="ir.cron">
            <field name="name">Pedimentos - Avisos diarios</field>
            <field name="model_id" ref="model_qb_pedimento"/>
            <field name="state">code</field>
            <field name="code">model._cron_avisos()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=13, minute=20, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
