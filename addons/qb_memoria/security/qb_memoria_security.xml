<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La pestaña Memoria del contacto se muestra solo a este grupo. Nace sin
         miembros (decisión del CEO, 2026-09-24: la pestaña se apaga en la ficha
         del cliente). Para volver a mostrarla: Ajustes → Usuarios → privilegio
         "Memoria" → "Ver pestaña Memoria". La memoria sigue viva: el cron de
         dueños aprendidos y el push a Supabase no dependen de la pestaña. -->
    <record id="module_category_memoria" model="ir.module.category">
        <field name="name">Memoria</field>
        <field name="description">Memoria de correo (Supabase) dentro de Odoo</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_memoria" model="res.groups.privilege">
        <field name="name">Memoria</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_memoria"/>
    </record>

    <record id="group_memoria_tab" model="res.groups">
        <field name="name">Ver pestaña Memoria</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_memoria"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
