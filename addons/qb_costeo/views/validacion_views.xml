<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qb_producto_validacion_list" model="ir.ui.view">
        <field name="name">qb.producto.validacion.list</field>
        <field name="model">qb.producto.validacion</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="estado == 'abierta'" decoration-muted="estado != 'abierta'">
                <field name="default_code"/>
                <field name="product_id"/>
                <field name="regla"/>
                <field name="componente_id"/>
                <field name="valor"/>
                <field name="detalle"/>
                <field name="estado"/>
                <field name="motivo"/>
                <field name="detectada_el"/>
            </list>
        </field>
    </record>

    <record id="view_qb_producto_validacion_form" model="ir.ui.view">
        <field name="name">qb.producto.validacion.form</field>
        <field name="model">qb.producto.validacion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_aceptar" type="object" string="Aceptar con motivo" invisible="estado != 'abierta'"/>
                    <button name="action_reabrir" type="object" string="Reabrir" invisible="estado == 'abierta'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="regla"/>
                            <field name="componente_id"/>
                            <field name="valor"/>
                        </group>
                        <group>
                            <field name="detalle"/>
                            <field name="motivo"/>
                            <field name="detectada_el"/>
                            <field name="resuelta_el"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qb_producto_validacion_search" model="ir.ui.view">
        <field name="name">qb.producto.validacion.search</field>
        <field name="model">qb.producto.validacion</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="componente_id"/>
                <filter name="abiertas" string="Abiertas" domain="[('estado', '=', 'abierta')]"/>
                <filter name="por_regla" string="Regla" context="{'group_by': 'regla'}"/>
            </search>
        </field>
    </record>

    <record id="action_qb_producto_validacion" model="ir.actions.act_window">
        <field name="name">Validaciones</field>
        <field name="res_model">qb.producto.validacion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_abiertas': 1}</field>
    </record>

    <record id="action_qb_validar_todo" model="ir.actions.server">
        <field name="name">Validar recetas y precios ahora</field>
        <field name="model_id" ref="model_qb_producto_validacion"/>
        <field name="state">code</field>
        <field name="code">action = model.action_revisar_todo()</field>
    </record>
</odoo>
