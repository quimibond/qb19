<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1.6.0: rentabilidad por cliente y por producto (12 meses) y órdenes de trabajo con tiempo fuera
         de rango, con el costo de este módulo. Sustituyen a los reportes de qb_capacidad_costeo. -->

    <record id="view_qb_rentabilidad_cliente_list" model="ir.ui.view">
        <field name="name">qb.rentabilidad.cliente.list</field>
        <field name="model">qb.rentabilidad.cliente</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-danger="semaforo == 'rojo'" decoration-warning="semaforo == 'ambar'"
                  decoration-muted="semaforo == 'sin_costo'">
                <field name="partner_id"/>
                <field name="revenue_12m" sum="Total"/>
                <field name="contrib_12m" sum="Total" optional="hide"/>
                <field name="contrib_pct"/>
                <field name="margen_bruto_12m" sum="Total" optional="hide"/>
                <field name="margen_bruto_pct" optional="hide"/>
                <field name="margen_neto_12m" sum="Total"/>
                <field name="margen_neto_pct"/>
                <field name="cobertura_pct"/>
                <field name="mismo_mes_pct" optional="hide"/>
                <field name="calidad_alta_pct" optional="hide"/>
                <field name="n_productos" optional="show"/>
                <field name="meses_activo" optional="hide"/>
                <field name="ultima_compra" optional="show"/>
                <field name="semaforo"/>
                <field name="company_currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_qb_rentabilidad_cliente_form" model="ir.ui.view">
        <field name="name">qb.rentabilidad.cliente.form</field>
        <field name="model">qb.rentabilidad.cliente</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id"/></h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        <field name="veredicto"/>
                    </div>
                    <group>
                        <group string="12 meses">
                            <field name="revenue_12m"/>
                            <field name="contrib_12m"/>
                            <field name="contrib_pct"/>
                            <field name="margen_bruto_12m"/>
                            <field name="margen_bruto_pct"/>
                            <field name="margen_neto_12m"/>
                            <field name="margen_neto_pct"/>
                            <field name="semaforo"/>
                        </group>
                        <group string="Qué tan confiable es">
                            <field name="cobertura_pct"/>
                            <field name="mismo_mes_pct"/>
                            <field name="calidad_alta_pct"/>
                            <field name="n_productos"/>
                            <field name="meses_activo"/>
                            <field name="ultima_compra"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qb_rentabilidad_cliente_search" model="ir.ui.view">
        <field name="name">qb.rentabilidad.cliente.search</field>
        <field name="model">qb.rentabilidad.cliente</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <filter name="rojo" string="Pierde" domain="[('semaforo', '=', 'rojo')]"/>
                <filter name="ambar" string="Apenas" domain="[('semaforo', '=', 'ambar')]"/>
                <filter name="sin_costo" string="Sin costo suficiente" domain="[('semaforo', '=', 'sin_costo')]"/>
                <group>
                    <filter name="por_semaforo" string="Semáforo" context="{'group_by': 'semaforo'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qb_rentabilidad_cliente" model="ir.actions.act_window">
        <field name="name">Rentabilidad por cliente</field>
        <field name="res_model">qb.rentabilidad.cliente</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin ventas en los últimos 12 meses</p>
            <p>Lo facturado a cada cliente en 12 meses contra el costo de lo que compró. Cada mes usa el costo
                de su período; si ese mes no se costeó, el del último período costeado del producto.</p>
        </field>
    </record>

    <record id="view_qb_rentabilidad_producto_list" model="ir.ui.view">
        <field name="name">qb.rentabilidad.producto.list</field>
        <field name="model">qb.rentabilidad.producto</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-danger="semaforo == 'rojo'" decoration-warning="semaforo == 'ambar'"
                  decoration-muted="semaforo == 'sin_costo'">
                <field name="product_id"/>
                <field name="qty_12m" sum="Total"/>
                <field name="precio_prom"/>
                <field name="revenue_12m" sum="Total"/>
                <field name="contrib_pct"/>
                <field name="margen_bruto_pct" optional="hide"/>
                <field name="margen_neto_12m" sum="Total"/>
                <field name="margen_neto_pct"/>
                <field name="cobertura_pct"/>
                <field name="mismo_mes_pct" optional="hide"/>
                <field name="calidad_alta_pct" optional="hide"/>
                <field name="n_clientes" optional="show"/>
                <field name="ultima_venta" optional="show"/>
                <field name="semaforo"/>
                <field name="company_currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_qb_rentabilidad_producto_form" model="ir.ui.view">
        <field name="name">qb.rentabilidad.producto.form</field>
        <field name="model">qb.rentabilidad.producto</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id"/></h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        <field name="veredicto"/>
                    </div>
                    <group>
                        <group string="12 meses">
                            <field name="qty_12m"/>
                            <field name="precio_prom"/>
                            <field name="revenue_12m"/>
                            <field name="contrib_12m"/>
                            <field name="contrib_pct"/>
                            <field name="margen_bruto_12m"/>
                            <field name="margen_bruto_pct"/>
                            <field name="margen_neto_12m"/>
                            <field name="margen_neto_pct"/>
                            <field name="semaforo"/>
                        </group>
                        <group string="Qué tan confiable es">
                            <field name="cobertura_pct"/>
                            <field name="mismo_mes_pct"/>
                            <field name="calidad_alta_pct"/>
                            <field name="n_clientes"/>
                            <field name="meses_activo"/>
                            <field name="ultima_venta"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qb_rentabilidad_producto_search" model="ir.ui.view">
        <field name="name">qb.rentabilidad.producto.search</field>
        <field name="model">qb.rentabilidad.producto</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <filter name="rojo" string="Pierde" domain="[('semaforo', '=', 'rojo')]"/>
                <filter name="ambar" string="Apenas" domain="[('semaforo', '=', 'ambar')]"/>
                <filter name="sin_costo" string="Sin costo suficiente" domain="[('semaforo', '=', 'sin_costo')]"/>
                <group>
                    <filter name="por_semaforo" string="Semáforo" context="{'group_by': 'semaforo'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qb_rentabilidad_producto" model="ir.actions.act_window">
        <field name="name">Rentabilidad por producto</field>
        <field name="res_model">qb.rentabilidad.producto</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin ventas en los últimos 12 meses</p>
            <p>Lo facturado de cada producto en 12 meses, todos los clientes, contra su costo.</p>
        </field>
    </record>

    <record id="view_qb_ot_excepcion_list" model="ir.ui.view">
        <field name="name">qb.ot.excepcion.list</field>
        <field name="model">qb.ot.excepcion</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="tipo == 'timer_largo'">
                <field name="semana"/>
                <field name="workorder_id"/>
                <field name="production_id"/>
                <field name="workcenter_id"/>
                <field name="centro_id" optional="hide"/>
                <field name="product_id"/>
                <field name="qty"/>
                <field name="horas" sum="Total"/>
                <field name="rendimiento"/>
                <field name="velocidad_min" optional="hide"/>
                <field name="velocidad_max" optional="hide"/>
                <field name="por" optional="hide"/>
                <field name="horas_desviadas" sum="Total"/>
                <field name="tipo"/>
            </list>
        </field>
    </record>

    <record id="view_qb_ot_excepcion_search" model="ir.ui.view">
        <field name="name">qb.ot.excepcion.search</field>
        <field name="model">qb.ot.excepcion</field>
        <field name="arch" type="xml">
            <search>
                <field name="workorder_id"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="workcenter_id"/>
                <filter name="largo" string="Horas de más" domain="[('tipo', '=', 'timer_largo')]"/>
                <filter name="corto" string="Horas de menos" domain="[('tipo', '=', 'timer_corto')]"/>
                <group>
                    <filter name="por_semana" string="Semana" context="{'group_by': 'semana'}"/>
                    <filter name="por_maquina" string="Máquina" context="{'group_by': 'workcenter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qb_ot_excepcion" model="ir.actions.act_window">
        <field name="name">Órdenes con tiempo fuera de rango</field>
        <field name="res_model">qb.ot.excepcion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ninguna orden fuera de rango en 90 días</p>
            <p>Órdenes de trabajo terminadas cuyas unidades por hora salen de la banda de velocidad del centro
                (Configuración de costos → Centros). El costeo ya no las usa al medir horas; aquí se ven para
                corregir el tiempo registrado.</p>
        </field>
    </record>
</odoo>
