            <field name="sequence">60</field>
            <field name="label">Jefe de área y supervisor</field>
            <field name="text">Que su gente use la versión vigente, firme sus acuses y conserve los registros en papel.</field>
        </record>
        <record id="sgi_miid_item_pg01_04_responsabilidades_07" model="sgi.miid.item">
            <field name="section_id" ref="sgi_miid_section_pg01_04_responsabilidades"/>
            <field name="sequence">70</field>
            <field name="label">Todo el personal</field>
            <field name="text">Consultar en Odoo y firmar «Leído y entendido» en 7 días hábiles.</field>
