            <field name="text">Aprobar el MIID, este procedimiento y los procedimientos que Dirección decida; autorizar entregas a externos.</field>
        </record>
        <record id="sgi_miid_item_pg01_04_responsabilidades_03" model="sgi.miid.item">
            <field name="section_id" ref="sgi_miid_section_pg01_04_responsabilidades"/>
            <field name="sequence">30</field>
            <field name="label">Dueño de proceso</field>
            <field name="text">Responder por los documentos de su proceso, firmar «Revisó», pedir la publicación de sus instructivos e implantar los externos en 10 días hábiles.</field>
        </record>
        <record id="sgi_miid_item_pg01_04_responsabilidades_04" model="sgi.miid.item">
            <field name="section_id" ref="sgi_miid_section_pg01_04_responsabilidades"/>
            <field name="sequence">40</field>
            <field name="label">Quien elabora un documento</field>
            <field name="text">Solicitar el cambio con el archivo propuesto («Elaboró») e implantarlo en 15 días hábiles.</field>
            <field name="menu_id" ref="menu_sgi_doc_changes"/>
        </record>
        <record id="sgi_miid_item_pg01_04_responsabilidades_05" model="sgi.miid.item">
            <field name="section_id" ref="sgi_miid_section_pg01_04_responsabilidades"/>
            <field name="sequence">50</field>
            <field name="label">Quien entra a un puesto</field>
            <field name="text">Firmar su Mi procedimiento y, en 30 días naturales, proponer lo que falte o sobre; su jefe lo verifica.</field>
            <field name="menu_id" ref="menu_sgi_my_procedure"/>
        </record>
        <record id="sgi_miid_item_pg01_04_responsabilidades_06" model="sgi.miid.item">
