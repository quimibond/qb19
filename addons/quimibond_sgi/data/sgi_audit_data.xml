<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ============================================================= -->
    <!-- Checklist de auditoría interna ISO 9001 (secciones 4-10).     -->
    <!-- Plantilla de encuesta reutilizable en sgi.audit.survey_id.    -->
    <!-- ============================================================= -->
    <record id="sgi_survey_audit_9001" model="survey.survey">
        <field name="title">Checklist Auditoría Interna ISO 9001:2015</field>
        <field name="survey_type">custom</field>
        <field name="description"><![CDATA[<p>Lista de verificación por cláusula. Marque Conforme / No conforme / Observación y registre la evidencia.</p>]]></field>
    </record>

    <!-- Cláusula 4 -->
    <record id="sgi_survey_page_4" model="survey.question">
        <field name="survey_id" ref="sgi_survey_audit_9001"/>
        <field name="is_page" eval="True"/>
        <field name="sequence">10</field>
        <field name="title">4. Contexto de la organización</field>
    </record>
    <record id="sgi_survey_q_4" model="survey.question">
        <field name="survey_id" ref="sgi_survey_audit_9001"/>
        <field name="sequence">11</field>
        <field name="title">¿La organización determina su contexto, partes interesadas y el alcance del SGC (4.1-4.4)?</field>
        <field name="question_type">simple_choice</field>
    </record>
    <record id="sgi_survey_a_4_c" model="survey.question.answer">
        <field name="question_id" ref="sgi_survey_q_4"/><field name="value">Conforme</field><field name="sequence">1</field>
    </record>
    <record id="sgi_survey_a_4_nc" model="survey.question.answer">
        <field name="question_id" ref="sgi_survey_q_4"/><field name="value">No conforme</field><field name="sequence">2</field>
    </record>
    <record id="sgi_survey_a_4_o" model="survey.question.answer">
        <field name="question_id" ref="sgi_survey_q_4"/><field name="value">Observación</field><field name="sequence">3</field>
    </record>

