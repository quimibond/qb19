    </record>
    <record id="sgi_area_s" model="sgi.area">
        <field name="code">S</field>
        <field name="name">SST</field>
    </record>
    <record id="sgi_area_v" model="sgi.area">
        <field name="code">V</field>
        <field name="name">Ventas</field>
    </record>
</odoo>
