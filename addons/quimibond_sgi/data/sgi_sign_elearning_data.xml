<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sincronización diaria de integraciones: acuses firmados vía Sign y
         competencias otorgadas por cursos eLearning terminados. -->
    <record id="sgi_cron_sign_elearning" model="ir.cron">
        <field name="name">SGI: Sincronizar Firma electrónica y eLearning</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_sign_elearning_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- D-14 (57.7.0): el registro del resumen semanal viejo (B-017) ahora
         manda a cada persona lo atrasado de su «Mis pendientes». Sale
         APAGADO: Jose lo enciende a mano. En producción lo reescribe la
         migración 19.0.57.7.0 (este archivo es noupdate). -->
    <record id="sgi_cron_weekly_digest" model="ir.cron">
        <field name="name">SGI: Mis pendientes atrasados (correo semanal por persona)</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_weekly_overdue_mail()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
