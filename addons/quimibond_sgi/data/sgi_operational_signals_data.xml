<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ===== Fase 8: señales operativas de Odoo → mejora continua ===== -->

    <!-- Fuente de NC automática: devolución de cliente validada. Apagable en
         SGI → Configuración → Fuentes de NC automáticas, como todas. -->
    <record id="sgi_alert_source_devolucion" model="sgi.alert.source">
        <field name="code">devolucion_cliente</field>
        <field name="name">Devolución de cliente validada</field>
        <field name="sequence">80</field>
        <field name="trigger_type">automatico</field>
        <field name="origin_module">quimibond_sgi</field>
        <field name="trigger_note">Al validar una recepción que devuelve una entrega a cliente se levanta una NC de origen Reclamación con el cliente, el producto y la remisión ligados. Apagar la fuente no impide la devolución: solo deja de abrirse el expediente.</field>
    </record>

    <record id="sgi_cron_operational_signals" model="ir.cron">
        <field name="name">SGI: Señales operativas (fallas repetitivas, SLA vencido)</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_operational_signals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
