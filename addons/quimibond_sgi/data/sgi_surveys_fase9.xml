<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Encuesta de consulta y participación de los trabajadores (45001 5.4).
         Sustituye F-P-A10-05: MAST la comparte desde Encuestas cuando toque
         la consulta; los resultados alimentan la RxD y las quejas del canal. -->
    <record id="sgi_survey_consulta" model="survey.survey">
        <field name="title">Consulta y participación de los trabajadores (F-P-A10-05)</field>
        <field name="description">Consulta periódica de SST: percepción de riesgos, participación en decisiones que afectan la seguridad y canales de reporte (ISO 45001 5.4).</field>
        <field name="questions_layout">one_page</field>
        <field name="access_mode">token</field>
        <field name="users_login_required" eval="True"/>
    </record>

    <record id="sgi_survey_consulta_q1" model="survey.question">
        <field name="survey_id" ref="sgi_survey_consulta"/>
        <field name="title">¿Conoce los peligros y riesgos de su puesto de trabajo?</field>
        <field name="sequence">1</field>
        <field name="question_type">scale</field>
        <field name="scale_min">1</field>
        <field name="scale_max">5</field>
    </record>

    <record id="sgi_survey_consulta_q2" model="survey.question">
        <field name="survey_id" ref="sgi_survey_consulta"/>
        <field name="title">¿Ha sido consultado sobre cambios que afectan su seguridad (equipos, procesos, EPP)?</field>
        <field name="sequence">2</field>
        <field name="question_type">simple_choice</field>
        <field name="suggested_answer_ids" eval="[
            (0, 0, {'value': 'Sí, siempre'}),
            (0, 0, {'value': 'A veces'}),
            (0, 0, {'value': 'No'}),
        ]"/>
    </record>

    <record id="sgi_survey_consulta_q3" model="survey.question">
        <field name="survey_id" ref="sgi_survey_consulta"/>
        <field name="title">¿Sabe cómo reportar un peligro o condición insegura?</field>
        <field name="sequence">3</field>
        <field name="question_type">simple_choice</field>
        <field name="suggested_answer_ids" eval="[
            (0, 0, {'value': 'Sí, y lo he usado'}),
            (0, 0, {'value': 'Sí, pero no lo he usado'}),
            (0, 0, {'value': 'No sé cómo'}),
        ]"/>
    </record>

    <record id="sgi_survey_consulta_q4" model="survey.question">
        <field name="survey_id" ref="sgi_survey_consulta"/>
        <field name="title">¿Se siente seguro de reportar sin represalias?</field>
        <field name="sequence">4</field>
        <field name="question_type">scale</field>
        <field name="scale_min">1</field>
        <field name="scale_max">5</field>
    </record>

    <record id="sgi_survey_consulta_q5" model="survey.question">
        <field name="survey_id" ref="sgi_survey_consulta"/>
        <field name="title">¿Qué mejoraría de la seguridad y salud en su área?</field>
        <field name="sequence">5</field>
        <field name="question_type">text_box</field>
    </record>

    <!-- Evaluación del comportamiento del auditor interno.
         Sustituye F-IT-P-G03-01-01: se abre con el botón «Evaluar al auditor»
         de la auditoría (estados informe/cerrada); la contesta el auditado. -->
    <record id="sgi_survey_auditor_eval" model="survey.survey">
        <field name="title">Evaluación del comportamiento del auditor (F-IT-P-G03-01-01)</field>
        <field name="description">La contesta el auditado al terminar la auditoría; alimenta el expediente del auditor interno.</field>
        <field name="questions_layout">one_page</field>
        <field name="access_mode">token</field>
        <field name="users_login_required" eval="True"/>
    </record>

    <record id="sgi_survey_auditor_q1" model="survey.question">
        <field name="survey_id" ref="sgi_survey_auditor_eval"/>
        <field name="title">Preparación: conocía el proceso y llegó con el checklist listo</field>
        <field name="sequence">1</field>
        <field name="question_type">scale</field>
        <field name="scale_min">1</field>
        <field name="scale_max">5</field>
    </record>

    <record id="sgi_survey_auditor_q2" model="survey.question">
        <field name="survey_id" ref="sgi_survey_auditor_eval"/>
        <field name="title">Objetividad: evaluó con evidencia, sin juicios personales</field>
        <field name="sequence">2</field>
        <field name="question_type">scale</field>
        <field name="scale_min">1</field>
        <field name="scale_max">5</field>
    </record>

    <record id="sgi_survey_auditor_q3" model="survey.question">
        <field name="survey_id" ref="sgi_survey_auditor_eval"/>
        <field name="title">Claridad: explicó los hallazgos y su fundamento en la norma</field>
        <field name="sequence">3</field>
        <field name="question_type">scale</field>
        <field name="scale_min">1</field>
        <field name="scale_max">5</field>
    </record>

    <record id="sgi_survey_auditor_q4" model="survey.question">
        <field name="survey_id" ref="sgi_survey_auditor_eval"/>
        <field name="title">Trato: condujo la auditoría con respeto y apertura</field>
        <field name="sequence">4</field>
        <field name="question_type">scale</field>
        <field name="scale_min">1</field>
        <field name="scale_max">5</field>
    </record>

    <record id="sgi_survey_auditor_q5" model="survey.question">
        <field name="survey_id" ref="sgi_survey_auditor_eval"/>
        <field name="title">Comentarios para el auditor</field>
        <field name="sequence">5</field>
        <field name="question_type">text_box</field>
    </record>
</odoo>
