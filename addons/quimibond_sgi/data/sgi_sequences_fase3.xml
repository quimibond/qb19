<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sgi_seq_control_plan" model="ir.sequence">
        <field name="name">Planes de control SGI</field>
        <field name="code">sgi.control.plan</field>
        <field name="prefix">PC-%(range_year)s-</field>
        <field name="padding">2</field>
        <field name="use_date_range" eval="True"/>
        <field name="number_increment">1</field>
    </record>

    <record id="sgi_seq_fmea" model="ir.sequence">
        <field name="name">AMEF SGI</field>
        <field name="code">sgi.fmea</field>
        <field name="prefix">AMEF-%(range_year)s-</field>
        <field name="padding">2</field>
        <field name="use_date_range" eval="True"/>
        <field name="number_increment">1</field>
    </record>

    <record id="sgi_seq_ppap" model="ir.sequence">
        <field name="name">PPAP SGI</field>
        <field name="code">sgi.ppap</field>
        <field name="prefix">PPAP-%(range_year)s-</field>
        <field name="padding">2</field>
        <field name="use_date_range" eval="True"/>
        <field name="number_increment">1</field>
    </record>

    <record id="sgi_seq_incident" model="ir.sequence">
        <field name="name">Incidentes SST SGI</field>
        <field name="code">sgi.incident</field>
        <field name="prefix">INC-%(range_year)s-</field>
        <field name="padding">2</field>
        <field name="use_date_range" eval="True"/>
        <field name="number_increment">1</field>
    </record>
</odoo>
