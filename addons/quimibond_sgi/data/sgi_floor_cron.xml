<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 57.94.0 (U-08): cada lunes, aviso a RH por departamento con empleados
         sin puesto, sin PIN o sin correo (Mis pendientes, tipo «Aviso»). -->
    <record id="sgi_cron_hr_employee_gaps" model="ir.cron">
        <field name="name">SGI: Empleados sin puesto, sin PIN o sin correo (aviso a RH)</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_hr_employee_gaps()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <!-- «Cada lunes» de verdad: la primera corrida, el lunes siguiente a
             las 13:00 UTC (07:00 de México); sin esto corre al instalar y luego
             cada 7 días desde ese día. -->
        <field name="nextcall" eval="(DateTime.today() + relativedelta(days=1, weekday=0, hour=13, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
