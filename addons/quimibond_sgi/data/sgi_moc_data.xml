<?xml version="1.0" encoding="utf-8"?>
<!-- Gestión del cambio (MOC): categoría de Aprobaciones para cambios de
     proceso / infraestructura / plantilla (9001 6.3, 45001 8.1.3). Reutiliza
     todo el motor del cambio documental; el gate de aprobación exige motivo,
     procesos afectados y evaluación de riesgos. noupdate: MAST puede ajustar
     aprobadores y descripción sin que el update los revierta. -->
<odoo noupdate="1">
    <record id="sgi_approval_category_moc" model="approval.category">
        <field name="name">Cambio de proceso / infraestructura (MOC SGI)</field>
        <field name="description">Gestión del cambio del SGI (9001 §6.3 / 45001
§8.1.3): cambios de proceso, maquinaria, infraestructura, layout o plantilla
que no son un cambio documental ni un ECO de ingeniería. La solicitud exige
motivo, procesos afectados y evaluación de riesgos antes de poder aprobarse.</field>
        <field name="sgi_is_moc" eval="True"/>
        <field name="approval_minimum">2</field>
    </record>
</odoo>
