<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 56.5.0: aprobadores de las reglas nativas al día con las personas
         de cada puesto; reglas archivadas si el rol o la actividad ya no
         existen. -->
    <record id="sgi_cron_sync_approvals" model="ir.cron">
        <field name="name">SGI: Sincronizar aprobaciones nativas</field>
        <field name="model_id" ref="model_sgi_activity_role"/>
        <field name="state">code</field>
        <field name="code">model.cron_sgi_sync_approvals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
