<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Mapeo formato SGI ↔ documento de Odoo. noupdate=1: estos registros son
         solo la semilla inicial; lo que MAST edite en SGI > Configuración >
         Formatos en documentos de Odoo SOBREVIVE a los odoo-update. La revisión
         NO se captura: se lee del documento vigente al mostrar/imprimir. -->

    <record id="format_map_sale_order" model="sgi.format.map">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="sgi_code">F-P-A28-12</field>
        <field name="sgi_code_alt">F-P-A28-06</field>
        <field name="note">Cotización F-P-A28-12 / Pedido F-P-A28-06 (P-A28 Rev.15; la 04 es Reporte de visita y la 03 Solicitud de muestras)</field>
    </record>

    <!-- F-P-A02-01 es la Requisición (solicitud interna previa a cotizar,
         que en Odoo es Aprobaciones > Solicitud de compra); la OC es
         F-P-A02-03. Corregido también en producción (2026-08-23). -->
    <record id="format_map_purchase_order" model="sgi.format.map">
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="sgi_code">F-P-A02-03</field>
        <field name="note">Orden de compra (la clave F-P-A02-01 es la Requisición, no la OC)</field>
    </record>

    <!-- OJO: F-P-A16-01 es "Citas" en el inventario real; la remisión parece
         ser la Lista de embarque F-IT-P-A07-01-03 (-04 exportación).
         Pendiente de que MAST confirme la clave para corregir aquí y en
         producción (SGI > Configuración > Formatos en documentos de Odoo). -->
    <record id="format_map_stock_picking" model="sgi.format.map">
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="sgi_code">F-P-A16-01</field>
        <field name="note">Remisión / lista de embarque (solo entregas de salida)</field>
    </record>

    <record id="format_map_mrp_production" model="sgi.format.map">
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="sgi_code">F-IT-P-P01-08-01</field>
        <field name="note">Orden de fabricación / tarjeta viajera</field>
    </record>

    <record id="format_map_maintenance_request" model="sgi.format.map">
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="sgi_code">F-P-M01-01</field>
        <field name="note">Orden de trabajo de mantenimiento</field>
    </record>

    <record id="format_map_quality_alert" model="sgi.format.map">
        <field name="model_id" ref="quality.model_quality_alert"/>
        <field name="sgi_code">F-P-G05-01</field>
        <field name="note">Reporte de no conformidad</field>
    </record>

    <record id="format_map_stock_lot" model="sgi.format.map">
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="sgi_code">F-P-C07-01</field>
        <field name="note">Certificado de Calidad (CoA) del lote</field>
    </record>

    <record id="format_map_mgmt_review" model="sgi.format.map">
        <field name="model_id" ref="model_sgi_management_review"/>
        <field name="sgi_code">F-P-A10-01</field>
        <field name="note">Acta de Revisión por la Dirección</field>
    </record>

    <!-- 57.11.0 (A-016): format_map_sales_budget (F-P-A28-18/13) lo declara
         quimibond_ventas_presupuesto: su modelo es de ese módulo. -->

    <!-- C-006 (19.0.56.30.0): formatos que el SGI imprime POR REFERENCIA desde
         su código (sin modelo). El código los pide por xmlid
         (sgi.format.map.sgi_ref_label) y la clave y revisión salen del
         documento ligado; la migración 19.0.56.30.0 los liga por la clave de
         abajo. Sin modelo, no llevan banner. -->
    <record id="format_ref_staff_efficiency" model="sgi.format.map">
        <field name="sgi_code">F-P-A01-32</field>
        <field name="note">Eficiencias del personal (hoja general, sin área)</field>
    </record>

    <record id="format_ref_staff_efficiency_area" model="sgi.format.map">
        <field name="sgi_code">F-P-A01-34</field>
        <field name="note">Eficiencias del personal por área</field>
    </record>

    <record id="format_ref_epp_responsiva" model="sgi.format.map">
        <field name="sgi_code">F-P-S03-02</field>
        <field name="note">Responsiva de entrega de EPP</field>
    </record>

    <record id="format_ref_machine_sheet" model="sgi.format.map">
        <field name="sgi_code">F-IT-P-P01-08-05</field>
        <field name="note">Ficha de proceso por máquina</field>
    </record>

    <!-- 57.126.0 (C1, bloque G): diagrama de flujo desde la ruta. -->
    <record id="format_ref_dev_flow" model="sgi.format.map">
        <field name="sgi_code">F-P-D01-32</field>
        <field name="note">Diagrama de flujo de proceso</field>
    </record>

    <record id="format_ref_dev_general" model="sgi.format.map">
        <field name="sgi_code">F-P-D01-02</field>
        <field name="note">Solicitud de desarrollo: general</field>
    </record>

    <record id="format_ref_dev_entretelas_v10" model="sgi.format.map">
        <field name="sgi_code">F-P-D01-18</field>
        <field name="note">Solicitud de desarrollo: entretelas V10</field>
    </record>

    <record id="format_ref_dev_carda" model="sgi.format.map">
        <field name="sgi_code">F-P-D01-26</field>
        <field name="note">Solicitud de desarrollo: carda</field>
    </record>

    <record id="format_ref_dev_tramado" model="sgi.format.map">
        <field name="sgi_code">F-P-D01-27</field>
        <field name="note">Solicitud de desarrollo: tramado</field>
    </record>

    <record id="format_ref_procedure_print" model="sgi.format.map">
        <field name="sgi_code">F-P-G01-02</field>
        <field name="note">Pie del procedimiento impreso</field>
    </record>

    <record id="format_ref_iper_matrix" model="sgi.format.map">
        <field name="sgi_code">F-P-S01-01</field>
        <field name="note">Matriz IPER citada en el procedimiento impreso</field>
    </record>

    <record id="format_ref_doc_change" model="sgi.format.map">
        <field name="sgi_code">F-P-G01-06</field>
        <field name="note">Solicitud de cambio documental (PDF para Sign)</field>
    </record>

    <record id="format_ref_calibration_label" model="sgi.format.map">
        <field name="sgi_code">F-P-C03-01</field>
        <field name="note">Etiqueta de equipo calibrado</field>
    </record>

    <record id="format_ref_out_of_service_label" model="sgi.format.map">
        <field name="sgi_code">F-P-C03-02</field>
        <field name="note">Etiqueta de equipo fuera de servicio</field>
    </record>

    <!-- 57.50.0 (bloque 1 de formularios): matriz de aspectos ambientales.
         P-E01 cita F-P-E01-01 como la matriz; hoy esa clave está en el
         documento «Evaluación luminaria» (4060). La corrección de la clave es
         del bloque 3 (decisiones 2026-09-30); mientras, el pie imprime la
         clave que cita el procedimiento. -->
    <record id="format_map_env_aspect" model="sgi.format.map">
        <field name="model_id" ref="model_sgi_env_aspect"/>
        <field name="sgi_code">F-P-E01-01</field>
        <field name="note">Matriz de aspectos e impactos ambientales (clave por corregir en el bloque 3)</field>
    </record>

    <!-- 57.51.0: permiso único de trabajo de alto riesgo. P-A19 y P-A24 lo
         citan como F-P-A14-03; no hay documento con esa clave en Documentos
         (inventario 2026-09-30, §3.5): el pie imprime la clave sin revisión
         hasta que MAST dé de alta el formato. -->
    <record id="format_map_work_permit" model="sgi.format.map">
        <field name="model_id" ref="model_sgi_work_permit"/>
        <field name="sgi_code">F-P-A14-03</field>
        <field name="note">Permiso único de trabajo de alto riesgo (formato por dar de alta)</field>
    </record>

    <!-- 57.52.0: bloqueo y etiquetado. P-A20 no tiene formato propio en el
         Dropbox: el registro se identifica con su procedimiento hasta que
         MAST dé de alta el formato y lo cambie aquí. -->
    <record id="format_map_loto" model="sgi.format.map">
        <field name="model_id" ref="model_sgi_loto"/>
        <field name="sgi_code">P-A20</field>
        <field name="note">Bloqueo y etiquetado: registro de P-A20 (sin formato propio todavía)</field>
    </record>

    <!-- 57.44.0 (V-M08): pies de los reportes que perdieron su identificación
         en 57.20.0. Por referencia porque el mismo modelo imprime más de un
         formato (plan e informe de auditoría) o es de otra app (NEWS, sobre
         Aprobaciones). Claves tomadas del propio SGI (README y comentarios de
         los reportes); MAST liga el documento en «Formatos en documentos de
         Odoo» y la revisión sale sola. -->
    <record id="format_ref_audit_plan" model="sgi.format.map">
        <field name="sgi_code">F-P-G03-03</field>
        <field name="note">Plan de auditoría</field>
    </record>

    <record id="format_ref_audit_report" model="sgi.format.map">
        <field name="sgi_code">F-P-G03-07</field>
        <field name="note">Informe de auditoría</field>
    </record>

    <record id="format_ref_master_list" model="sgi.format.map">
        <field name="sgi_code">F-P-G01-03</field>
        <field name="note">Lista maestra de información documentada (general y por proceso)</field>
    </record>

    <record id="format_ref_news" model="sgi.format.map">
        <field name="sgi_code">F-P-G01-16</field>
        <field name="note">Boletín NEWS de cambios documentales</field>
    </record>

    <!-- 57.62.0 (bloque 2 de formularios): laboratorio de Calidad (P-C05).
         Mapeos con criterio (57.60.0): la verificación imprime la bitácora de
         revisión de equipos y el equipo de laboratorio el formato de
         instrumental; el préstamo se usa por referencia en la ficha. -->
    <record id="format_map_lab_verification" model="sgi.format.map">
        <field name="model_id" ref="model_sgi_calibration"/>
        <field name="sgi_code">F-P-C05-11</field>
        <field name="record_domain">[('calibration_type', '=', 'verificacion')]</field>
        <field name="note">Bitácora de revisión de equipos de laboratorio (verificaciones)</field>
    </record>

    <record id="format_map_lab_equipment" model="sgi.format.map">
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="sgi_code">F-IT-P-C05-06-07</field>
        <field name="record_domain">[('sgi_is_lab', '=', True)]</field>
        <field name="note">Instrumental de laboratorio (equipos marcados de laboratorio)</field>
    </record>

    <record id="format_ref_lab_loan" model="sgi.format.map">
        <field name="sgi_code">F-P-C05-07</field>
        <field name="note">Préstamo de equipos de laboratorio (seguimiento del equipo)</field>
    </record>

    <!-- 57.63.0 (bloque 2 de formularios): etiquetas de lote (clase C) que se
         imprimen desde el lote o la NC; por referencia porque el mismo modelo
         imprime las tres. -->
    <record id="format_ref_lot_released" model="sgi.format.map">
        <field name="sgi_code">F-P-C04-02</field>
        <field name="note">Etiqueta de material liberado</field>
    </record>

    <record id="format_ref_lot_rejected" model="sgi.format.map">
        <field name="sgi_code">F-P-C04-03</field>
        <field name="note">Etiqueta de material rechazado</field>
    </record>

    <record id="format_ref_lot_held" model="sgi.format.map">
        <field name="sgi_code">F-P-C04-04</field>
        <field name="note">Etiqueta de material detenido</field>
    </record>
</odoo>
