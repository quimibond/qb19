<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Mapeo formato SGI ↔ documento de Odoo. noupdate=1: estos registros son
         solo la semilla inicial; lo que MAST edite en SGI > Configuración >
         Formatos en documentos de Odoo SOBREVIVE a los odoo-update. La revisión
         NO se captura: se lee del documento vigente al mostrar/imprimir. -->

    <record id="format_map_sale_order" model="sgi.format.map">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="sgi_code">F-P-A28-12</field>
        <field name="sgi_code_alt">F-P-A28-06</field>
        <field name="note">Cotización F-P-A28-12 / Pedido F-P-A28-06 (P-A28 Rev.15; la 04 es Reporte de visita y la 03 Solicitud de muestras)</field>
    </record>

    <!-- F-P-A02-01 es la Requisición (solicitud interna previa a cotizar,
         que en Odoo es Aprobaciones > Solicitud de compra); la OC es
         F-P-A02-03. Corregido también en producción (2026-08-23). -->
    <record id="format_map_purchase_order" model="sgi.format.map">
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="sgi_code">F-P-A02-03</field>
        <field name="note">Orden de compra (la clave F-P-A02-01 es la Requisición, no la OC)</field>
    </record>

    <!-- OJO: F-P-A16-01 es "Citas" en el inventario real; la remisión parece
         ser la Lista de embarque F-IT-P-A07-01-03 (-04 exportación).
         Pendiente de que MAST confirme la clave para corregir aquí y en
         producción (SGI > Configuración > Formatos en documentos de Odoo). -->
    <record id="format_map_stock_picking" model="sgi.format.map">
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="sgi_code">F-P-A16-01</field>
        <field name="note">Remisión / lista de embarque (solo entregas de salida)</field>
    </record>

    <record id="format_map_mrp_production" model="sgi.format.map">
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="sgi_code">F-IT-P-P01-08-01</field>
        <field name="note">Orden de fabricación / tarjeta viajera</field>
    </record>

    <record id="format_map_maintenance_request" model="sgi.format.map">
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="sgi_code">F-P-M01-01</field>
        <field name="note">Orden de trabajo de mantenimiento</field>
    </record>

    <record id="format_map_quality_alert" model="sgi.format.map">
        <field name="model_id" ref="quality.model_quality_alert"/>
        <field name="sgi_code">F-P-G05-01</field>
        <field name="note">Reporte de No Conformidad</field>
    </record>

    <record id="format_map_stock_lot" model="sgi.format.map">
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="sgi_code">F-P-C07-01</field>
        <field name="note">Certificado de Calidad (CoA) del lote</field>
    </record>

    <record id="format_map_mgmt_review" model="sgi.format.map">
        <field name="model_id" ref="model_sgi_management_review"/>
        <field name="sgi_code">F-P-A10-01</field>
        <field name="note">Acta de Revisión por la Dirección</field>
    </record>

    <record id="format_map_sales_budget" model="sgi.format.map">
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="sgi_code">F-P-A28-18</field>
        <field name="sgi_code_alt">F-P-A28-13</field>
        <field name="note">Presupuesto de Ventas General F-P-A28-18 (mensual) / Pronóstico F-P-A28-13 (semanal por cliente); F-P-A28-17 es el comparativo ppto vs real</field>
    </record>

    <!-- C-006 (19.0.56.30.0): formatos que el SGI imprime POR REFERENCIA desde
         su código (sin modelo). El código los pide por xmlid
         (sgi.format.map.sgi_ref_label) y la clave y revisión salen del
         documento ligado; la migración 19.0.56.30.0 los liga por la clave de
         abajo. Sin modelo, no llevan banner. -->
    <record id="format_ref_staff_efficiency" model="sgi.format.map">
        <field name="sgi_code">F-P-A01-32</field>
        <field name="note">Eficiencias del personal (hoja general, sin área)</field>
    </record>

    <record id="format_ref_staff_efficiency_area" model="sgi.format.map">
        <field name="sgi_code">F-P-A01-34</field>
        <field name="note">Eficiencias del personal por área</field>
    </record>

    <record id="format_ref_epp_responsiva" model="sgi.format.map">
        <field name="sgi_code">F-P-S03-02</field>
        <field name="note">Responsiva de entrega de EPP</field>
    </record>

    <record id="format_ref_machine_sheet" model="sgi.format.map">
        <field name="sgi_code">F-IT-P-P01-08-05</field>
        <field name="note">Ficha de proceso por máquina</field>
    </record>

    <record id="format_ref_dev_general" model="sgi.format.map">
        <field name="sgi_code">F-P-D01-02</field>
        <field name="note">Solicitud de desarrollo: general</field>
    </record>

    <record id="format_ref_dev_entretelas_v10" model="sgi.format.map">
        <field name="sgi_code">F-P-D01-18</field>
        <field name="note">Solicitud de desarrollo: entretelas V10</field>
    </record>

    <record id="format_ref_dev_carda" model="sgi.format.map">
        <field name="sgi_code">F-P-D01-26</field>
        <field name="note">Solicitud de desarrollo: carda</field>
    </record>

    <record id="format_ref_dev_tramado" model="sgi.format.map">
        <field name="sgi_code">F-P-D01-27</field>
        <field name="note">Solicitud de desarrollo: tramado</field>
    </record>

    <record id="format_ref_procedure_print" model="sgi.format.map">
        <field name="sgi_code">F-P-G01-02</field>
        <field name="note">Pie del procedimiento impreso</field>
    </record>

    <record id="format_ref_iper_matrix" model="sgi.format.map">
        <field name="sgi_code">F-P-S01-01</field>
        <field name="note">Matriz IPER citada en el procedimiento impreso</field>
    </record>

    <record id="format_ref_doc_change" model="sgi.format.map">
        <field name="sgi_code">F-P-G01-06</field>
        <field name="note">Solicitud de cambio documental (PDF para Sign)</field>
    </record>

    <record id="format_ref_calibration_label" model="sgi.format.map">
        <field name="sgi_code">F-P-C03-01</field>
        <field name="note">Etiqueta de equipo calibrado</field>
    </record>

    <record id="format_ref_out_of_service_label" model="sgi.format.map">
        <field name="sgi_code">F-P-C03-02</field>
        <field name="note">Etiqueta de equipo fuera de servicio</field>
    </record>
</odoo>
