<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ============================================================= -->
    <!-- KPIs reales F-P-A10-03. calc_mode=manual salvo indicación.    -->
    <!-- nc_on_red arranca en False: se activa tras validar 1 mes vs   -->
    <!-- el Excel (ver README, plan de activación gradual).            -->
    <!-- Responsables y procesos se asignan en la instancia.           -->
    <!-- ============================================================= -->

    <!-- ===================== Transversales ===================== -->
    <record id="sgi_ind_cierre_nc" model="sgi.indicator">
        <field name="code">TR-01</field>
        <field name="name">Cierre de No Conformidades (NCA/NCD)</field>
        <field name="uom">%</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">85</field>
        <field name="target_acceptable">75</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">cierre_nc</field>
    </record>
    <record id="sgi_ind_consumo_papel" model="sgi.indicator">
        <field name="code">TR-02</field>
        <field name="name">Consumo de papel 100−(NF/DL×100)</field>
        <field name="uom">%</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">90</field>
        <field name="target_acceptable">80</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">manual</field>
    </record>
    <record id="sgi_ind_consumo_energia" model="sgi.indicator">
        <field name="code">TR-03</field>
        <field name="name">Consumo de energía</field>
        <field name="uom">kWh</field>
        <field name="direction">lower_better</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">manual</field>
    </record>
    <record id="sgi_ind_separacion_residuos" model="sgi.indicator">
        <field name="code">TR-04</field>
        <field name="name">Separación de residuos</field>
        <field name="sgi_area_id" ref="sgi_area_e"/>
        <field name="uom">%</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">90</field>
        <field name="target_acceptable">80</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">manual</field>
    </record>

    <!-- ===================== Ventas ===================== -->
    <record id="sgi_ind_crecimiento_ventas" model="sgi.indicator">
        <field name="code">VE-01</field>
        <field name="name">Crecimiento anual de ventas</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_ingresos"/>
        <field name="uom">%</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">20</field>
        <field name="target_acceptable">15</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">manual</field>
    </record>
    <record id="sgi_ind_presupuesto_ventas" model="sgi.indicator">
        <field name="code">VE-02</field>
        <field name="name">Cumplimiento de presupuesto de ventas</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_ingresos"/>
        <field name="uom">%</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">90</field>
        <field name="target_acceptable">80</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">presupuesto_ventas</field>
    </record>

    <!-- ===================== Compras ===================== -->
    <record id="sgi_ind_otd_proveedores" model="sgi.indicator">
        <field name="code">CO-01</field>
        <field name="name">Entregas a tiempo de proveedores</field>
        <field name="sgi_area_id" ref="sgi_area_a"/>
