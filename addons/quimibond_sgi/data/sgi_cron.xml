<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- El default de quimibond_sgi.nc_escalation_days lo siembra
         sgi.config.seed_parameters() (fuente única; declararlo también aquí
         era frágil por depender del orden de carga del manifest). -->

    <record id="sgi_cron_nonconformities" model="ir.cron">
        <field name="name">SGI: Seguimiento de No Conformidades</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_nonconformities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="sgi_cron_overdue_actions" model="ir.cron">
        <field name="name">SGI: Escalamiento de acciones vencidas</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_overdue_actions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="sgi_cron_documents" model="ir.cron">
        <field name="name">SGI: Vencimientos documentales</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_documents()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="sgi_cron_news" model="ir.cron">
        <field name="name">SGI: Boletín NEWS mensual</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_news()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
    </record>

    <!-- 57.0.0 (entrega 6): respaldo diario de la membresía de «Dueño de
         proceso (SGI)» (el create/write de sgi.process ya la sincroniza; esto
         recoge, p. ej., un cambio del usuario del empleado dueño). -->
    <record id="sgi_cron_process_owner_group" model="ir.cron">
        <field name="name">SGI: Sincronizar el grupo «Dueño de proceso»</field>
        <field name="model_id" ref="model_sgi_process"/>
        <field name="state">code</field>
        <field name="code">model._sgi_sync_process_owner_group()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
