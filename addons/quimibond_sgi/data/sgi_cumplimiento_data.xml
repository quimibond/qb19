<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Vigilancia del cumplimiento legal (14001/45001 6.1.3 / 9.1.2):
         evaluaciones vencidas y permisos por vencer. -->
    <record id="sgi_cron_legal_requirements" model="ir.cron">
        <field name="name">SGI: Cumplimiento legal (evaluaciones y permisos)</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_legal_requirements()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
