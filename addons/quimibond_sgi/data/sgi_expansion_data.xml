<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ============================================================= -->
    <!-- Plan de Expansión Comercial 2026-2028                         -->
    <!-- KPIs automáticos: los mide el cron mensual de indicadores.    -->
    <!-- Metas = objetivos SMART de la estrategia; el aceptable es el  -->
    <!-- nivel de partida 2025 (mejorar desde ahí, no maquillar).      -->
    <!-- Responsables y procesos se asignan en la instancia.           -->
    <!-- nc_on_red arranca en False (plan de activación gradual).      -->
    <!-- ============================================================= -->

    <record id="sgi_objective_expansion" model="sgi.objective">
        <field name="name">Expansión comercial rentable y diversificada</field>
        <field name="target_year">2028</field>
        <field name="description">Convertir un negocio récord-pero-frágil en uno rentable y diversificado, usando la ventana T-MEC: (1) rentabilizar — margen ≥9% y compras ≤78% de ventas en 2026; (2) expandir — 100 clientes nuevos/año y top 3 &lt;40% en 2027; (3) plataformas — capacidad, reciclados y venta directa EUA en 2028.</field>
    </record>

    <record id="sgi_ind_ex_margen" model="sgi.indicator">
        <field name="code">EX-01</field>
        <field name="name">Margen sobre órdenes de venta</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">9</field>
        <field name="target_acceptable">8</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">margen_ventas</field>
    </record>
    <record id="sgi_ind_ex_compras_ventas" model="sgi.indicator">
        <field name="code">EX-02</field>
        <field name="name">Compras vs ventas facturadas</field>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">lower_better</field>
        <field name="target_objective">78</field>
        <field name="target_acceptable">80</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">compras_vs_ventas</field>
    </record>
    <record id="sgi_ind_ex_clientes_nuevos" model="sgi.indicator">
        <field name="code">EX-03</field>
        <field name="name">Clientes nuevos (primera factura)</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">clientes</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">8</field>
        <field name="target_acceptable">5</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">clientes_nuevos</field>
    </record>
    <record id="sgi_ind_ex_concentracion" model="sgi.indicator">
        <field name="code">EX-04</field>
        <field name="name">Concentración top 3 clientes (12 meses)</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">lower_better</field>
        <field name="target_objective">40</field>
        <field name="target_acceptable">45</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">concentracion_top3</field>
    </record>
    <record id="sgi_ind_ex_facturacion_usd" model="sgi.indicator">
        <field name="code">EX-05</field>
        <field name="name">Participación de facturación en USD</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">lower_better</field>
        <field name="target_objective">60</field>
        <field name="target_acceptable">70</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">facturacion_usd</field>
    </record>
    <record id="sgi_ind_ex_notas_credito" model="sgi.indicator">
        <field name="code">EX-06</field>
        <field name="name">Notas de crédito vs facturación</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">lower_better</field>
        <field name="target_objective">0.6</field>
        <field name="target_acceptable">1</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">notas_credito</field>
    </record>
    <record id="sgi_ind_ex_dso" model="sgi.indicator">
        <field name="code">EX-07</field>
        <field name="name">Días de cartera (DSO)</field>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">días</field>
        <field name="direction">lower_better</field>
        <field name="target_objective">42</field>
        <field name="target_acceptable">49</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">dso_cartera</field>
    </record>

    <!-- Nivel 1 adicional: línea base medida en ago-2026 sobre datos reales
         (cartera vencida 17.5% / >60d 12.3%; retención 24→25 70.3%;
         fuera del top 10 25.9%; top 5 productos 33.2%; cancelados 10.4%).
         El aceptable es esa partida: mejorar desde ahí, no maquillar. -->
    <record id="sgi_ind_ex_cartera_vencida" model="sgi.indicator">
        <field name="code">EX-08</field>
        <field name="name">Cartera vencida</field>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">lower_better</field>
        <field name="target_objective">10</field>
        <field name="target_acceptable">17.5</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">cartera_vencida</field>
    </record>
    <record id="sgi_ind_ex_cartera_vencida_60" model="sgi.indicator">
        <field name="code">EX-09</field>
        <field name="name">Cartera vencida a más de 60 días</field>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">lower_better</field>
        <field name="target_objective">5</field>
        <field name="target_acceptable">12.5</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">cartera_vencida_60</field>
    </record>
    <record id="sgi_ind_ex_retencion" model="sgi.indicator">
        <field name="code">EX-10</field>
        <field name="name">Retención de clientes (12 meses)</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">85</field>
        <field name="target_acceptable">70</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">retencion_clientes</field>
    </record>
    <record id="sgi_ind_ex_reactivados" model="sgi.indicator">
        <field name="code">EX-11</field>
        <field name="name">Clientes reactivados</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">clientes</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">3</field>
        <field name="target_acceptable">1</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">clientes_reactivados</field>
    </record>
    <record id="sgi_ind_ex_fuera_top10" model="sgi.indicator">
        <field name="code">EX-12</field>
        <field name="name">Ventas fuera del top 10 clientes (12 meses)</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">35</field>
        <field name="target_acceptable">26</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">ventas_fuera_top10</field>
    </record>
    <record id="sgi_ind_ex_conc_productos" model="sgi.indicator">
        <field name="code">EX-13</field>
        <field name="name">Concentración top 5 productos (12 meses)</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">lower_better</field>
        <field name="target_objective">30</field>
        <field name="target_acceptable">34</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">concentracion_productos</field>
    </record>
    <record id="sgi_ind_ex_cancelados" model="sgi.indicator">
        <field name="code">EX-14</field>
        <field name="name">Pedidos de venta cancelados</field>
        <field name="sgi_area_id" ref="sgi_area_v"/>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">lower_better</field>
        <field name="target_objective">5</field>
        <field name="target_acceptable">10</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">pedidos_cancelados</field>
    </record>
    <record id="sgi_ind_ex_entregas" model="sgi.indicator">
        <field name="code">EX-15</field>
        <field name="name">Entregas completas a la primera</field>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">%</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">95</field>
        <field name="target_acceptable">90</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">entregas_completas</field>
    </record>
    <record id="sgi_ind_ex_dpo" model="sgi.indicator">
        <field name="code">EX-16</field>
        <field name="name">Días de pago a proveedores (DPO)</field>
        <field name="objective_id" ref="sgi_objective_expansion"/>
        <field name="uom">días</field>
        <field name="direction">higher_better</field>
        <field name="target_objective">49</field>
        <field name="target_acceptable">42</field>
        <field name="frequency">monthly</field>
        <field name="calc_mode">dpo_pagos</field>
    </record>
</odoo>
