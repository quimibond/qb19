<?xml version="1.0" encoding="utf-8"?>
<!-- 57.152.0: catálogo «Información requerida al cliente» de la aprobación para iniciar el proyecto
     (formatos anteriores F-P-D01-09 tejido y F-P-D01-19 entretelas). noupdate: se ajusta en la base
     (SGI → Configuración → Listas del desarrollo de producto); sin línea aplica a las dos. -->
<odoo noupdate="1">
    <record id="sgi_dev_doc_ficha_coa" model="sgi.dev.option">
        <field name="kind">documento_cliente</field>
        <field name="sequence">10</field>
        <field name="name">Ficha técnica del producto y/o COA</field>
    </record>
    <record id="sgi_dev_doc_hoja_seguridad" model="sgi.dev.option">
        <field name="kind">documento_cliente</field>
        <field name="sequence">20</field>
        <field name="name">Hoja de seguridad</field>
    </record>
    <record id="sgi_dev_doc_iso_9001" model="sgi.dev.option">
        <field name="kind">documento_cliente</field>
        <field name="sequence">30</field>
        <field name="name">Certificado ISO 9001:2015</field>
    </record>
    <record id="sgi_dev_doc_iso_14001" model="sgi.dev.option">
        <field name="kind">documento_cliente</field>
        <field name="sequence">40</field>
        <field name="name">Certificado ISO 14001:2015</field>
    </record>
    <record id="sgi_dev_doc_ppap" model="sgi.dev.option">
        <field name="kind">documento_cliente</field>
        <field name="sequence">50</field>
        <field name="name">PPAP</field>
    </record>
    <record id="sgi_dev_doc_imds" model="sgi.dev.option">
        <field name="kind">documento_cliente</field>
        <field name="sequence">60</field>
        <field name="name">IMDS</field>
    </record>
    <record id="sgi_dev_doc_ctpat" model="sgi.dev.option">
        <field name="kind">documento_cliente</field>
        <field name="sequence">70</field>
        <field name="name">CT-PAT</field>
    </record>
    <record id="sgi_dev_doc_pscr" model="sgi.dev.option">
        <field name="kind">documento_cliente</field>
        <field name="sequence">80</field>
        <field name="name">PSCR</field>
    </record>
    <record id="sgi_dev_doc_caducidad" model="sgi.dev.option">
        <field name="kind">documento_cliente</field>
        <field name="sequence">90</field>
        <field name="name">Caducidad de materiales</field>
        <field name="line_key">entretelas</field>
    </record>
</odoo>
