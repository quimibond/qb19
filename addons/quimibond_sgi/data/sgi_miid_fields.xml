        <record id="sgi_system_rule_01" model="sgi.system.rule">
            <field name="sequence">10</field>
            <field name="name">Contexto y partes interesadas</field>
            <field name="clause_ids" eval="[(6, 0, [ref('c_9001_41'), ref('c_14001_41'), ref('c_45001_41'), ref('c_9001_42'), ref('c_14001_42'), ref('c_45001_42')])]"/>
