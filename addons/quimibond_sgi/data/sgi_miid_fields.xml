        <record id="sgi_system_rule_02" model="sgi.system.rule">
            <field name="sequence">20</field>
            <field name="name">Riesgos y oportunidades</field>
            <field name="clause_ids" eval="[(6, 0, [ref('c_9001_61'), ref('c_14001_61'), ref('c_45001_61')])]"/>
            <field name="text">Evaluación inicial y residual; se reevalúan en enero, julio y tras un incidente o un cambio. Un riesgo alto sin acción abierta avisa al dueño.</field>
            <field name="menu_id" ref="menu_sgi_risks"/>
        </record>
        <record id="sgi_system_rule_03" model="sgi.system.rule">
