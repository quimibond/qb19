<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <data noupdate="1">
        <record id="sgi_param_fmea_npr_action" model="ir.config_parameter">
            <field name="key">quimibond_sgi.fmea_npr_action</field>
            <field name="value">100</field>
        </record>
    </data>

    <record id="sgi_cron_calibrations" model="ir.cron">
        <field name="name">SGI: Vencimientos de calibración y EPP</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_calibrations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="sgi_cron_competences" model="ir.cron">
        <field name="name">SGI: Competencias y certificaciones por vencer</field>
        <field name="model_id" ref="model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_competences()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
