<?xml version="1.0" encoding="utf-8"?>
<!-- 57.124.0 (C1, bloque E): el reloj de materia prima del desarrollo se
     detiene solo cuando la requisición a Compras ya se recibió (o se cerró). -->
<odoo noupdate="1">
    <record id="sgi_cron_dev_mp_wait" model="ir.cron">
        <field name="name">SGI: Desarrollo, cierra la espera de materia prima recibida</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model.cron_sgi_dev_mp_wait()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.today() + relativedelta(days=1, hour=12, minute=20, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
