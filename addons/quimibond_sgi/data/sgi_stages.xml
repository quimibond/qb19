<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ================= EQUIPOS DE CALIDAD (NC) ================= -->
    <record id="sgi_quality_team_internal" model="quality.alert.team">
        <field name="name">NC Internas</field>
        <field name="sgi_sequence_id" ref="sgi_seq_nc_internal"/>
    </record>
    <record id="sgi_quality_team_external" model="quality.alert.team">
        <field name="name">NC Externas</field>
        <field name="sgi_sequence_id" ref="sgi_seq_nc_external"/>
    </record>

    <!-- Etapas NC Internas -->
    <record id="sgi_nc_int_stage_open" model="quality.alert.stage">
        <field name="name">Abierta</field><field name="sequence">10</field>
        <field name="team_ids" eval="[(4, ref('sgi_quality_team_internal'))]"/>
    </record>
    <record id="sgi_nc_int_stage_followup" model="quality.alert.stage">
        <field name="name">Seguimiento</field><field name="sequence">20</field>
        <field name="team_ids" eval="[(4, ref('sgi_quality_team_internal'))]"/>
    </record>
    <record id="sgi_nc_int_stage_closed" model="quality.alert.stage">
        <field name="name">Cerrada</field><field name="sequence">30</field>
        <field name="done" eval="True"/><field name="sgi_is_closing_stage" eval="True"/>
        <field name="team_ids" eval="[(4, ref('sgi_quality_team_internal'))]"/>
    </record>
    <record id="sgi_nc_int_stage_cancel" model="quality.alert.stage">
        <field name="name">Cancelada</field><field name="sequence">40</field>
        <field name="folded" eval="True"/><field name="sgi_is_cancel_stage" eval="True"/>
        <field name="team_ids" eval="[(4, ref('sgi_quality_team_internal'))]"/>
    </record>

    <!-- Etapas NC Externas -->
    <record id="sgi_nc_ext_stage_open" model="quality.alert.stage">
        <field name="name">Abierta</field><field name="sequence">10</field>
        <field name="team_ids" eval="[(4, ref('sgi_quality_team_external'))]"/>
    </record>
    <record id="sgi_nc_ext_stage_followup" model="quality.alert.stage">
        <field name="name">Seguimiento</field><field name="sequence">20</field>
        <field name="team_ids" eval="[(4, ref('sgi_quality_team_external'))]"/>
    </record>
    <record id="sgi_nc_ext_stage_closed" model="quality.alert.stage">
        <field name="name">Cerrada</field><field name="sequence">30</field>
        <field name="done" eval="True"/><field name="sgi_is_closing_stage" eval="True"/>
        <field name="team_ids" eval="[(4, ref('sgi_quality_team_external'))]"/>
    </record>
    <record id="sgi_nc_ext_stage_cancel" model="quality.alert.stage">
        <field name="name">Cancelada</field><field name="sequence">40</field>
        <field name="folded" eval="True"/><field name="sgi_is_cancel_stage" eval="True"/>
        <field name="team_ids" eval="[(4, ref('sgi_quality_team_external'))]"/>
    </record>

    <!-- ================= HELPDESK — RECLAMACIONES ================= -->
    <record id="sgi_helpdesk_team_complaints" model="helpdesk.team">
        <field name="name">Reclamaciones de clientes</field>
        <field name="use_sla" eval="True"/>
    </record>
    <record id="sgi_hd_stage_new" model="helpdesk.stage">
        <field name="name">Nueva</field><field name="sequence">10</field>
        <field name="team_ids" eval="[(6, 0, [ref('sgi_helpdesk_team_complaints')])]"/>
    </record>
    <record id="sgi_hd_stage_containment" model="helpdesk.stage">
        <field name="name">Contención</field><field name="sequence">20</field>
        <field name="team_ids" eval="[(6, 0, [ref('sgi_helpdesk_team_complaints')])]"/>
    </record>
    <record id="sgi_hd_stage_analysis" model="helpdesk.stage">
        <field name="name">Análisis</field><field name="sequence">30</field>
        <field name="team_ids" eval="[(6, 0, [ref('sgi_helpdesk_team_complaints')])]"/>
    </record>
    <record id="sgi_hd_stage_response" model="helpdesk.stage">
        <field name="name">Respuesta al cliente</field><field name="sequence">40</field>
        <field name="team_ids" eval="[(6, 0, [ref('sgi_helpdesk_team_complaints')])]"/>
    </record>
    <record id="sgi_hd_stage_closed" model="helpdesk.stage">
        <field name="name">Cerrada</field><field name="sequence">50</field><field name="fold" eval="True"/>
        <field name="team_ids" eval="[(6, 0, [ref('sgi_helpdesk_team_complaints')])]"/>
    </record>
    <record id="sgi_hd_sla_first_response" model="helpdesk.sla">
        <field name="name">Primera respuesta ≤ 3 días</field>
        <field name="team_id" ref="sgi_helpdesk_team_complaints"/>
        <field name="stage_id" ref="sgi_hd_stage_containment"/>
        <field name="time">24.0</field>
        <field name="priority">0</field>
    </record>

    <!-- ================= PROYECTO — MEJORA CONTINUA ================= -->
    <record id="sgi_project_improvement" model="project.project">
        <field name="name">Mejora Continua SGI</field>
        <field name="sgi_is_improvement" eval="True"/>
    </record>
    <record id="sgi_task_stage_proposal" model="project.task.type">
        <field name="name">Propuesta</field><field name="sequence">10</field>
        <field name="project_ids" eval="[(4, ref('sgi_project_improvement'))]"/>
    </record>
    <record id="sgi_task_stage_progress" model="project.task.type">
        <field name="name">En ejecución</field><field name="sequence">20</field>
        <field name="project_ids" eval="[(4, ref('sgi_project_improvement'))]"/>
    </record>
    <record id="sgi_task_stage_done" model="project.task.type">
        <field name="name">Terminada</field><field name="sequence">30</field><field name="fold" eval="True"/>
        <field name="sgi_is_done_stage" eval="True"/>
        <field name="project_ids" eval="[(4, ref('sgi_project_improvement'))]"/>
    </record>

    <!-- ================= APROBACIONES — CAMBIO DOCUMENTAL ================= -->
    <record id="sgi_approval_category_doc_change" model="approval.category">
        <field name="name">Modificación de documento SGI</field>
        <field name="sgi_is_doc_change" eval="True"/>
        <field name="approver_sequence" eval="True"/>
        <field name="approval_minimum">2</field>
        <field name="requirer_document">optional</field>
        <field name="description">Flujo F-P-G01-06: alta/modificación/baja de documentos controlados del SGI.</field>
    </record>
</odoo>
