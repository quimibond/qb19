<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tipo de documento «Mi procedimiento»: el PDF por puesto archivado como
         documento controlado (clave MP-<puesto>). noupdate como el resto de los
         tipos: lo que MAST ajuste no se pisa al actualizar. -->
    <data noupdate="1">
        <record id="sgi_doc_type_mi_procedimiento" model="sgi.document.type">
            <field name="code">mi_procedimiento</field>
            <field name="name">Mi procedimiento (MP)</field>
            <field name="sequence">52</field>
            <field name="prefix_pattern">MP-{seq:03d}</field>
            <field name="requires_process" eval="False"/>
            <field name="code_required" eval="True"/>
        </record>
    </data>

    <!-- Menú Inicio → «Mi procedimiento»: la vista por empleado (vía su puesto). -->
    <record id="sgi_my_procedure_action_mine" model="ir.actions.server">
        <field name="name">Mi procedimiento</field>
        <field name="model_id" ref="quimibond_sgi.model_sgi_activity_role"/>
        <field name="state">code</field>
        <field name="code">
employee = env.user.employee_id
if employee and employee.job_id:
    action = employee.action_sgi_my_procedure_view()
else:
    raise UserError("Tu usuario no tiene empleado con puesto asignado. Pide a RH que lo capture en tu ficha.")
        </field>
    </record>
</odoo>
