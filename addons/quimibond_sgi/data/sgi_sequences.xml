<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sgi_seq_nc_internal" model="ir.sequence">
        <field name="name">NC Internas SGI</field>
        <field name="code">sgi.nc.internal</field>
        <field name="prefix">NCI-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="use_date_range" eval="True"/>
        <field name="number_increment">1</field>
    </record>

    <record id="sgi_seq_nc_external" model="ir.sequence">
        <field name="name">NC Externas SGI</field>
        <field name="code">sgi.nc.external</field>
        <field name="prefix">NCE-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="use_date_range" eval="True"/>
        <field name="number_increment">1</field>
    </record>
</odoo>
