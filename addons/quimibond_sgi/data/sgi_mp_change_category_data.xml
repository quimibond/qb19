<?xml version="1.0" encoding="utf-8"?>
<!-- H-014 (entrega 3): la categoría que usa el botón «Proponer cambio» de Mi
     procedimiento (_sgi_mp_change_category) es parte del núcleo: sin ella, en
     una base nueva, el botón da error. noupdate: en producción ya existe (la
     11) y la migración 56.35.0 le pone este XML ID sin tocarla; MAST ajusta
     aprobadores y descripción sin que el update los revierta. En una base
     nueva se crea con aprobación del jefe directo; MAST agrega al aprobador
     del SGI (producción pide dos). -->
<odoo noupdate="1">
    <record id="sgi_approval_category_mp_change" model="approval.category">
        <field name="name">Proponer cambio a mi procedimiento (SGI)</field>
        <field name="description">Cualquier empleado propone agregar, quitar o cambiar una actividad de su procedimiento. En Referencia pon el proceso y la actividad. En Descripción escribe cómo se hace hoy, cómo propones que se haga y por qué. Adjunta foto o formato si ayuda. Aprueban tu jefe directo y el Jefe MAST y SGI; al aprobarse, MAST actualiza la actividad y vuelve a publicar el procedimiento.</field>
        <field name="sgi_is_mp_change" eval="True"/>
        <field name="has_reference">required</field>
        <field name="manager_approval">required</field>
        <field name="approval_minimum">1</field>
        <field name="requirer_document">optional</field>
        <field name="has_product">optional</field>
    </record>
</odoo>
