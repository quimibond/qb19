<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 57.109.0: «Nuevo indicador» con preguntas y vista previa. -->
    <record id="sgi_indicator_wizard_view_form" model="ir.ui.view">
        <field name="name">sgi.indicator.wizard.form</field>
        <field name="model">sgi.indicator.wizard</field>
        <field name="arch" type="xml">
            <form string="Nuevo indicador">
                <field name="source_model" invisible="1"/>
                <group>
                    <group>
                        <field name="name" placeholder="Ej.: Entregas completas a la primera"/>
                        <field name="process_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="code"/>
                        <field name="responsible_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="frequency" widget="radio"/>
                        <field name="direction" widget="radio"/>
                        <field name="target_objective"/>
                        <field name="target_acceptable"/>
                    </group>
                </group>
                <group string="1. ¿Qué quiere saber?">
                    <field name="kind" nolabel="1" colspan="2" widget="radio"/>
                </group>
                <group string="2. ¿De qué registros?">
                    <field name="source_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="window" widget="radio" options="{'horizontal': true}"/>
                </group>
                <group string="3. ¿Cuáles cuentan?" invisible="not source_id">
                    <field name="filter_domain" nolabel="1" colspan="2" widget="domain"
                           options="{'model': 'source_model', 'in_dialog': True}"/>
                    <field name="amount_field_id" invisible="kind != 'sum'" required="kind == 'sum'"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <div class="alert alert-info" role="status" invisible="not preview_html">
                    <b>Así habría salido:</b> <field name="formula_sentence" class="d-inline"/>
                    <field name="preview_html" nolabel="1"/>
                    <button name="action_view_records" type="object" string="Ver lo que cuenta el último periodo"
                            icon="fa-list" class="btn-link p-0"/>
                </div>
                <footer>
                    <button name="action_create" type="object" string="Crear indicador" class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sgi_indicator_wizard_action" model="ir.actions.act_window">
        <field name="name">Nuevo indicador</field>
        <field name="res_model">sgi.indicator.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="sgi_indicator_source_view_list" model="ir.ui.view">
        <field name="name">sgi.indicator.source.list</field>
        <field name="model">sgi.indicator.source</field>
        <field name="arch" type="xml">
            <list string="Fuentes de indicadores" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="model_name"/>
                <field name="domain"/>
                <field name="date_field"/>
                <field name="amount_field" optional="show"/>
                <field name="available"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sgi_indicator_source_action" model="ir.actions.act_window">
        <field name="name">Fuentes de indicadores</field>
        <field name="res_model">sgi.indicator.source</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Fuentes de datos con nombre de negocio</p>
            <p>Las que ofrece «Nuevo indicador»: el modelo, el filtro base y la fecha que cuenta, con un nombre
                que cualquiera entiende («Facturas de cliente publicadas»).</p>
        </field>
    </record>

    <!-- 57.109.0: Reportar → Riesgo u oportunidad. -->
    <record id="sgi_risk_report_view_form" model="ir.ui.view">
        <field name="name">sgi.risk.report.form</field>
        <field name="model">sgi.risk.report</field>
        <field name="arch" type="xml">
            <form string="Reportar un riesgo u oportunidad">
                <group>
                    <field name="kind" widget="radio"/>
                    <field name="name" placeholder="Ej.: Que el proveedor único de hilo deje de surtir"/>
                    <field name="consequence" placeholder="Ej.: Se para la línea de tejido una semana"/>
                    <field name="process_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="how_often" widget="radio"/>
                    <field name="how_bad" widget="radio" invisible="kind != 'riesgo'"/>
                    <field name="how_good" widget="radio" invisible="kind != 'oportunidad'"/>
                    <field name="existing_controls" placeholder="Ej.: Hay un segundo proveedor sin homologar"/>
                </group>
                <div class="alert alert-info" role="status" invisible="not preview_html">
                    <field name="preview_html" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_report" type="object" string="Reportar" class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sgi_risk_report_action" model="ir.actions.act_window">
        <field name="name">Riesgo u oportunidad</field>
        <field name="res_model">sgi.risk.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
