<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====== Paso 3: ficha de proceso (nivel 2) ====== -->

    <!-- ====== Paso 4: ficha de actividad (nivel 3) ====== -->
    <record id="sgi_process_activity_view_form_structure" model="ir.ui.view">
        <field name="name">sgi.process.activity.form.structure</field>
        <field name="model">sgi.process.activity</field>
        <field name="inherit_id" ref="quimibond_sgi.sgi_process_activity_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_open_odoo']" position="attributes">
                <attribute name="string">Ir a hacerlo</attribute>
                <attribute name="icon">fa-play</attribute>
                <attribute name="class">btn-primary</attribute>
            </xpath>
            <xpath expr="//form/header/button[@name='action_view_measure_records']" position="attributes">
                <attribute name="name">action_view_recent_records</attribute>
                <attribute name="string">Ver registros recientes</attribute>
            </xpath>
            <xpath expr="//form/header/button[@name='action_view_recent_records']" position="after">
                <button name="action_open_instruction" type="object"
                        string="Ver instructivo" icon="fa-book"
                        invisible="not instruction_id"/>
                <button name="action_sgi_register_finding" type="object"
                        string="Registrar hallazgo" icon="fa-flag"
                        groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
