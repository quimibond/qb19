<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====== Detalle de una actividad del procedimiento (modal) ====== -->
    <!-- Ficha de la actividad: arriba lo esencial (qué, de qué proceso, en
         qué estado) y cuatro pestañas: Qué y quién · Cómo se mide · Quién la
         ejecutó · Cadena. Las explicaciones van en la ayuda de cada campo. -->
    <record id="sgi_process_activity_view_form" model="ir.ui.view">
        <field name="name">sgi.process.activity.form</field>
        <field name="model">sgi.process.activity</field>
        <field name="arch" type="xml">
            <form string="Actividad">
                <header>
                    <button name="action_open_odoo" type="object"
                            string="Abrir en Odoo" icon="fa-external-link"
                            invisible="not odoo_menu_id and not measure_model_id and not odoo_ref"/>
                    <button name="action_view_measure_records" type="object"
                            string="Ver evidencia" icon="fa-check-square-o"
                            invisible="not measure_model_id"/>
                    <button name="action_open_next" type="object"
                            string="Siguiente paso" icon="fa-arrow-right"
                            invisible="not next_activity_ids"/>
                    <field name="measure_state" widget="statusbar"
                           invisible="not measure_state"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="next_activity_ids" invisible="1"/>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="not measure_warning">
                        <field name="measure_warning" nolabel="1" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <h2 class="d-flex gap-2">
                            <field name="number" class="w-auto" readonly="1"/>
                            <field name="name" placeholder="Verbo + qué: «Validar la recepción»"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="process_id" options="{'no_create': True}"/>
                            <field name="stage_id" options="{'no_quick_create': False}"
                                   context="{'default_process_id': process_id}"/>
                            <field name="step"/>
                            <field name="legacy_number" invisible="not legacy_number"/>
                        </group>
                        <group>
                            <field name="measure_method"/>
                            <field name="measure_adherence_pct"
                                   invisible="not measure_user_field"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Qué y quién" name="que_quien">
                            <field name="role_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="role" widget="badge"
                                           decoration-success="role == 'ejecuta'"
                                           decoration-warning="role == 'aprueba'"
                                           decoration-info="role == 'participa'"/>
                                    <field name="target_type"/>
                                    <field name="job_id" options="{'no_create': True}"
                                           invisible="target_type != 'job'"
                                           required="target_type == 'job'"/>
                                    <field name="family_id" options="{'no_create': True}"
                                           invisible="target_type != 'family'"
                                           required="target_type == 'family'"/>
                                    <field name="relative_role"
                                           invisible="target_type != 'relative'"
                                           required="target_type == 'relative'"/>
                                    <field name="condition" placeholder="Siempre"
                                           readonly="role not in ('aprueba', 'informa') and not condition"/>
                                </list>
                            </field>
                            <separator string="Recibe"/>
                            <field name="input_ids" context="{'default_company_id': company_id}">
                                <list editable="bottom" string="Recibe">
                                    <field name="sequence" widget="handle"/>
                                    <field name="deliverable_id"
                                           context="{'default_company_id': parent.company_id}"/>
                                    <field name="max_days"/>
                                </list>
                            </field>
                            <group>
                                <field name="output_deliverable_ids" widget="many2many_tags"
                                       context="{'default_company_id': company_id}"/>
                            </group>
                            <group>
                                <group>
                                    <field name="instruction_id" options="{'no_create': True}"/>
                                    <field name="format_document_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                    <field name="related_procedure_id" options="{'no_create': True}"/>
                                    <field name="odoo_menu_id"/>
                                    <field name="odoo_ref" invisible="1"/>
                                </group>
                                <group>
                                    <field name="value_class"/>
                                    <field name="automation_level_current"/>
                                    <field name="automation_level_target"/>
                                    <field name="automation_method"
                                           invisible="not automation_level_target or automation_level_target == automation_level_current"/>
                                </group>
                            </group>
                            <group>
                                <field name="note" placeholder="Solo si hace falta algo que no cabe en los campos"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Texto de la versión anterior"
                                   invisible="not description and not responsible_role">
                                <field name="responsible_role" readonly="1"
                                       invisible="not responsible_role"/>
                                <field name="description" readonly="1"
                                       invisible="not description"/>
                            </group>
                        </page>
                        <page string="Cómo se mide" name="medicion">
                            <group>
                                <group>
                                    <field name="measure_proxy_activity_id"
                                           invisible="measure_method != 'consecuencia'"
                                           required="measure_method == 'consecuencia'"
                                           options="{'no_create': True}"/>
                                    <field name="sample_cadence"
                                           invisible="measure_method != 'muestreo'"
                                           required="measure_method == 'muestreo'"/>
                                    <field name="measure_justification"
                                           invisible="measure_method != 'no_aplica'"
                                           required="measure_method == 'no_aplica'"/>
                                    <field name="measure_deliverable_id"
                                           invisible="measure_method != 'entregable'"
                                           required="measure_method == 'entregable'"
                                           domain="[('id', 'in', output_deliverable_ids), ('odoo_model_id', '!=', False)]"
                                           options="{'no_create': True}"/>
                                    <field name="measure_model_id" options="{'no_create': True}"
                                           invisible="measure_method not in (False, 'odoo', 'entregable')"
                                           readonly="measure_method == 'entregable'"/>
                                    <field name="measure_model_name"
                                           invisible="measure_method not in (False, 'odoo')"
                                           placeholder="o el nombre técnico: sale.order"/>
                                    <field name="measure_domain"
                                           invisible="not measure_model_id or measure_method not in (False, 'odoo', 'entregable')"
                                           readonly="measure_method == 'entregable'"
                                           placeholder="[('state', '=', 'done')]"/>
                                    <field name="measure_date_field"
                                           invisible="not measure_model_id or measure_method not in (False, 'odoo', 'entregable')"
                                           readonly="measure_method == 'entregable'"/>
                                    <field name="measure_user_field"
                                           invisible="not measure_model_id or measure_method not in (False, 'odoo', 'entregable')"
                                           readonly="measure_method == 'entregable'"
                                           placeholder="create_uid, user_id…"/>
                                    <field name="measure_cadence"/>
                                </group>
                                <group>
                                    <field name="measure_last_date"/>
                                    <field name="measure_count_30d"/>
                                </group>
                            </group>
                            <div class="text-muted"
                                 invisible="measure_method not in ('correo', 'manual', 'muestreo')">
                                Sin fuente todavía: el conector de correo y el registro
                                de un toque llegan en la fase 2. Mientras, sale en gris.
                            </div>
                        </page>
                        <page string="Quién la ejecutó" name="ejecuciones"
                              invisible="not measure_user_field">
                            <group>
                                <group>
                                    <field name="measure_top_users"/>
                                    <field name="measure_count_other_job"/>
                                </group>
                                <group>
                                    <field name="measure_count_generic"/>
                                    <field name="measure_count_no_employee"/>
                                    <field name="measure_count_system"/>
                                </group>
                            </group>
                            <field name="recent_exec_stat_ids">
                                <list default_order="period_start desc, count desc"
                                      decoration-success="exec_class == 'correcto'"
                                      decoration-danger="exec_class in ('generico', 'sin_empleado')"
                                      decoration-warning="exec_class == 'otro_puesto'"
                                      decoration-muted="exec_class == 'sistema'">
                                    <field name="period_start"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="job_id"/>
                                    <field name="family_id" optional="hide"/>
                                    <field name="exec_class" widget="badge"/>
                                    <field name="count" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cadena" name="cadena">
                            <div class="text-muted mb-2">
                                Las ligas se calculan solas de «Recibe» y «Entrega» y no se
                                editan a mano. Si una no aplica, apágala y escribe el motivo.
                            </div>
                            <separator string="Recibe de"/>
                            <field name="in_link_ids" context="{'active_test': False}">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-muted="not active">
                                    <field name="deliverable_id" column_invisible="1"/>
                                    <field name="from_activity_id" readonly="1"/>
                                    <field name="name" string="Entregable" readonly="1"/>
                                    <field name="max_days" optional="show"/>
                                    <field name="chain_state" widget="badge" optional="show"
                                           decoration-success="chain_state == 'fluye'"
                                           decoration-danger="chain_state == 'atorado'"/>
                                    <field name="active" widget="boolean_toggle"
                                           readonly="not deliverable_id"/>
                                    <field name="inactive_reason" optional="show"
                                           readonly="not deliverable_id"
                                           required="deliverable_id and not active"/>
                                </list>
                            </field>
                            <separator string="Entrega a"/>
                            <field name="out_link_ids" context="{'active_test': False}">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-muted="not active">
                                    <field name="deliverable_id" column_invisible="1"/>
                                    <field name="to_activity_id" readonly="1"/>
                                    <field name="name" string="Entregable" readonly="1"/>
                                    <field name="max_days" optional="show"/>
                                    <field name="chain_state" widget="badge" optional="show"
                                           decoration-success="chain_state == 'fluye'"
                                           decoration-danger="chain_state == 'atorado'"/>
                                    <field name="active" widget="boolean_toggle"
                                           readonly="not deliverable_id"/>
                                    <field name="inactive_reason" optional="show"
                                           readonly="not deliverable_id"
                                           required="deliverable_id and not active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sgi_process_activity_view_list" model="ir.ui.view">
        <field name="name">sgi.process.activity.list</field>
        <field name="model">sgi.process.activity</field>
        <field name="arch" type="xml">
            <list string="Actividades" default_order="process_id, sequence, number"
                  sample="1" multi_edit="1"
                  decoration-danger="measure_state == 'rojo'"
                  decoration-muted="measure_state in ('pendiente', 'no_aplica') or not measure_method">
                <field name="process_id" optional="show"/>
                <field name="number"/>
                <field name="section" optional="hide"/>
                <field name="name"/>
                <field name="executor_role_ids" widget="many2many_tags" optional="show"/>
                <field name="approver_role_ids" widget="many2many_tags" optional="show"/>
                <field name="informed_role_ids" widget="many2many_tags" optional="hide"/>
                <field name="responsible_role" optional="hide"/>
                <field name="instruction_id" optional="hide"/>
                <field name="format_document_ids" widget="many2many_tags" optional="hide"/>
                <field name="value_class" optional="hide"/>
                <field name="automation_level_current" optional="hide"/>
                <field name="odoo_ref" optional="hide"/>
                <field name="odoo_menu_id" optional="hide"/>
                <field name="measure_method" optional="show"/>
                <field name="measure_cadence" optional="hide"/>
                <field name="measure_count_30d" optional="show"/>
                <field name="measure_adherence_pct" optional="show"/>
                <field name="measure_top_users" optional="show"/>
                <field name="measure_count_other_job" optional="hide"/>
                <field name="measure_count_generic" optional="hide"/>
                <field name="measure_model_id" column_invisible="1"/>
                <field name="measure_state" optional="show" widget="badge"
                       decoration-success="measure_state == 'verde'"
                       decoration-danger="measure_state == 'rojo'"
                       decoration-muted="measure_state in ('pendiente', 'no_aplica')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_odoo" type="object"
                        string="Abrir en Odoo" icon="fa-external-link"
                        invisible="not odoo_menu_id and not measure_model_id and not odoo_ref"/>
                <button name="action_view_measure_records" type="object"
                        string="Evidencia" icon="fa-check-square-o"
                        invisible="not measure_model_id"/>
            </list>
        </field>
    </record>

    <record id="sgi_process_activity_view_kanban" model="ir.ui.view">
        <field name="name">sgi.process.activity.kanban</field>
        <field name="model">sgi.process.activity</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_order="process_id, sequence, number">
                <field name="measure_state"/>
                <field name="measure_warning"/>
                <progressbar field="measure_state"
                             colors='{"verde": "success", "rojo": "danger", "pendiente": "muted", "no_aplica": "muted"}'/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline gap-1">
                            <field name="number" class="fw-bold"/>
                            <field name="name" class="text-truncate"/>
                        </div>
                        <field name="process_id" class="text-muted small"/>
                        <field name="executor_role_ids" widget="many2many_tags"/>
                        <footer class="pt-1 small gap-2">
                            <field name="measure_method"/>
                            <field name="measure_state" widget="badge"
                                   decoration-success="measure_state == 'verde'"
                                   decoration-danger="measure_state == 'rojo'"/>
                            <span t-if="record.measure_warning.raw_value" class="text-warning fa fa-exclamation-triangle"
                                  title="Tiene avisos de medición"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sgi_process_activity_view_search" model="ir.ui.view">
        <field name="name">sgi.process.activity.search</field>
        <field name="model">sgi.process.activity</field>
        <field name="arch" type="xml">
            <search string="Actividades de procedimiento">
                <field name="name" string="Resumen / descripción"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('description', 'ilike', self), ('number', 'ilike', self)]"/>
                <field name="number"/>
                <field name="responsible_role"/>
                <field name="process_id"/>
                <separator/>
                <filter name="my_activities" string="Mis actividades"
                        domain="[('responsible_job_ids.employee_ids.user_id', '=', uid)]"/>
                <filter name="no_responsible" string="Sin responsable"
                        domain="[('responsible_job_ids', '=', False), ('responsible_role', '=', False)]"/>
                <filter name="no_executor" string="Sin puesto que la ejecuta"
                        domain="[('responsible_job_ids', '=', False), ('automation_level_current', '!=', 'automatico')]"/>
                <filter name="archived" string="Archivadas" domain="[('active', '=', False)]"/>
                <filter name="no_format" string="Sin formato ligado"
                        domain="[('format_document_ids', '=', False)]"/>
                <filter name="no_menu" string="Sin menú de Odoo"
                        domain="[('odoo_menu_id', '=', False)]"/>
                <separator/>
                <filter name="measurable" string="Medibles"
                        domain="[('measure_model_id', '!=', False)]"/>
                <filter name="not_measurable" string="Sin medir"
                        domain="[('measure_method', '=', False)]"/>
                <filter name="adherence_low" string="Adherencia &lt; 80%"
                        domain="[('measure_user_field', '!=', False), ('measure_adherence_pct', '&lt;', 80), ('measure_count_30d', '&gt;', 0)]"/>
                <filter name="with_warning" string="Con avisos de medición"
                        domain="[('measure_warning', '!=', False)]"/>
                <separator/>
                <filter name="rojo" string="En rojo"
                        domain="[('measure_state', '=', 'rojo')]"/>
                <filter name="sin_metodo" string="Sin método"
                        domain="[('measure_method', '=', False)]"/>
                <filter name="otro_puesto" string="Ejecuta otro puesto"
                        domain="[('measure_count_other_job', '&gt;', 0)]"/>
                <filter name="cuenta_generica" string="Cuenta genérica"
                        domain="[('measure_count_generic', '&gt;', 0)]"/>
                <filter name="parece_automatica" string="Parece automática"
                        domain="[('measure_warning', 'ilike', 'Parece automática')]"/>
                <filter name="por_evento" string="Por evento"
                        domain="[('measure_cadence', '=', 'evento')]"/>
                <group>
                    <filter name="group_process" string="Proceso"
                            context="{'group_by': 'process_id'}"/>
                    <filter name="group_block" string="Bloque"
                            context="{'group_by': 'block'}"/>
                    <filter name="group_section" string="Sección"
                            context="{'group_by': 'section'}"/>
                    <filter name="group_automation" string="Automatización"
                            context="{'group_by': 'automation_level_current'}"/>
                    <filter name="group_method" string="Método de medición"
                            context="{'group_by': 'measure_method'}"/>
                    <filter name="group_state" string="Estado de medición"
                            context="{'group_by': 'measure_state'}"/>
                    <filter name="group_executor" string="Puesto que ejecuta"
                            context="{'group_by': 'responsible_job_ids'}"/>
                </group>
                <searchpanel>
                    <field name="process_id" select="one" icon="fa-sitemap"/>
                    <field name="measure_method" select="multi" icon="fa-tachometer"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="sgi_process_activity_action" model="ir.actions.act_window">
        <field name="name">Actividades de procedimiento</field>
        <field name="res_model">sgi.process.activity</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="search_view_id" ref="sgi_process_activity_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">El Desarrollo de los procedimientos, como datos vivos</p>
            <p>El procedimiento dejó de ser un PDF muerto: cada <b>actividad</b> es un numeral (4.2.3.1) con su <b>rol responsable</b>, sus <b>formatos</b> (en rojo en el PDF) y el <b>menú de Odoo</b> donde se ejecuta — el botón <i>Abrir en Odoo</i> te lleva ahí. Se capturan en la pestaña <i>Procedimiento</i> de cada proceso; el PDF F-P-G01-02 se imprime desde el botón con el contador de actividades. Editar una actividad marca el procedimiento como pendiente de revisión documental (candado G14).</p>
        </field>
    </record>

    <record id="sgi_process_activity_action_mine" model="ir.actions.act_window">
        <field name="name">Mis actividades de procedimiento</field>
        <field name="res_model">sgi.process.activity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sgi_process_activity_view_search"/>
        <field name="context">{'search_default_my_activities': 1, 'search_default_group_process': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Los pasos de procedimiento que le tocan a tu puesto</p>
            <p>Aquí ves <b>qué te toca hacer y dónde</b>: cada línea es un numeral de procedimiento asignado a tu puesto, con su formato y el botón <i>Abrir en Odoo</i> que te lleva directo al menú donde se ejecuta. Si está vacío, pide a RH que asigne tu puesto (hr.job) a tu ficha de empleado.</p>
        </field>
    </record>

    <!-- ====== Cadena de actividades: el hilo conductor paso a paso ====== -->
    <record id="sgi_activity_link_view_list" model="ir.ui.view">
        <field name="name">sgi.activity.link.list</field>
        <field name="model">sgi.activity.link</field>
        <field name="arch" type="xml">
            <list string="Cadena de actividades" default_order="from_process_id, id"
                  create="0" decoration-info="is_cross_process" decoration-muted="not active">
                <field name="from_process_id" optional="show"/>
                <field name="from_activity_id"/>
                <field name="name" string="Entregable"/>
                <field name="to_activity_id"/>
                <field name="to_process_id" optional="show"/>
                <field name="is_cross_process" string="Cruza procesos" optional="show"/>
                <field name="chain_state" widget="badge" optional="show"
                       decoration-success="chain_state == 'fluye'"
                       decoration-danger="chain_state == 'atorado'"/>
                <field name="max_days" optional="show"/>
                <field name="lag_days" optional="show"/>
                <field name="nc_alert_id" optional="hide"/>
                <field name="origin" optional="hide"/>
                <field name="active" column_invisible="1"/>
                <field name="inactive_reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sgi_activity_link_view_search" model="ir.ui.view">
        <field name="name">sgi.activity.link.search</field>
        <field name="model">sgi.activity.link</field>
        <field name="arch" type="xml">
            <search string="Cadena de actividades">
                <field name="name" string="Entregable"/>
                <field name="from_activity_id"/>
                <field name="to_activity_id"/>
                <field name="from_process_id"/>
                <field name="to_process_id"/>
                <filter name="cross" string="Cruzan procesos"
                        domain="[('is_cross_process', '=', True)]"/>
                <filter name="internal" string="Dentro del proceso"
                        domain="[('is_cross_process', '=', False)]"/>
                <separator/>
                <filter name="stuck" string="Atorados"
                        domain="[('chain_state', '=', 'atorado')]"/>
                <filter name="flowing" string="Fluyen"
                        domain="[('chain_state', '=', 'fluye')]"/>
                <separator/>
                <filter name="manual" string="Capturadas a mano (anteriores)"
                        domain="[('deliverable_id', '=', False)]"/>
                <filter name="inactive" string="Desactivadas"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_from" string="Proceso origen"
                            context="{'group_by': 'from_process_id'}"/>
                    <filter name="group_to" string="Proceso destino"
                            context="{'group_by': 'to_process_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_activity_link_action" model="ir.actions.act_window">
        <field name="name">Cadena de actividades</field>
        <field name="res_model">sgi.activity.link</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="sgi_activity_link_view_search"/>
        <field name="context">{'search_default_group_from': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">El hilo conductor de la operación</p>
            <p>Cada liga dice <b>qué entregable pasa de un paso al siguiente</b> — el pedido confirmado, el programa semanal, el lote liberado — incluso cruzando procesos. Salen solas de lo que cada actividad recibe y entrega (catálogo de entregables) y se imprimen en el procedimiento.</p>
        </field>
    </record>

    <!-- ====== Tablero de cumplimiento: por proceso y por puesto ====== -->
    <record id="sgi_activity_compliance_view_pivot" model="ir.ui.view">
        <field name="name">sgi.process.activity.pivot.compliance</field>
        <field name="model">sgi.process.activity</field>
        <field name="arch" type="xml">
            <pivot string="Cumplimiento de procedimientos">
                <field name="process_id" type="row"/>
                <field name="measure_state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_activity_compliance_view_graph" model="ir.ui.view">
        <field name="name">sgi.process.activity.graph.compliance</field>
        <field name="model">sgi.process.activity</field>
        <field name="arch" type="xml">
            <graph string="Cumplimiento de procedimientos" type="bar" stacked="1">
                <field name="process_id"/>
                <field name="measure_state"/>
            </graph>
        </field>
    </record>

    <record id="sgi_activity_compliance_action" model="ir.actions.act_window">
        <field name="name">Cumplimiento de procedimientos</field>
        <field name="res_model">sgi.process.activity</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('measure_model_id', '!=', False)]</field>
        <field name="search_view_id" ref="sgi_process_activity_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">El procedimiento medido con acciones reales</p>
            <p>Cada actividad medible contra su cadencia: verde con evidencia en su periodo, rojo sin ella. Agrupa por <b>proceso</b> o por <b>puesto responsable</b> para ver quién cumple su procedimiento — la base de la mejora continua.</p>
        </field>
    </record>

    <!-- ====== Pestaña "Procedimiento" en la ficha del proceso ====== -->
    <record id="sgi_process_view_form_procedure" model="ir.ui.view">
        <field name="name">sgi.process.form.procedure</field>
        <field name="model">sgi.process</field>
        <field name="inherit_id" ref="quimibond_sgi.sgi_process_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="action_print_procedure" type="object"
                            string="Imprimir procedimiento" icon="fa-print"
                            invisible="activity_count == 0"/>
                </header>
            </xpath>
            <xpath expr="//page[@name='entradas_salidas']" position="before">
                <page string="Actividades" name="procedimiento">
                    <div class="mb-2">
                        <span class="text-muted"><field name="measure_method_summary" class="d-inline"/></span>
                    </div>
                    <field name="stage_ids" context="{'default_process_id': id}">
                        <list editable="bottom" string="Etapas">
                            <field name="sequence" widget="handle"/>
                            <field name="code" string="Letra"/>
                            <field name="name"/>
                            <field name="activity_count"/>
                        </list>
                    </field>
                    <field name="procedure_activity_ids" context="{'default_process_id': id}">
                        <list string="Actividades" default_order="sequence, number"
                              decoration-danger="measure_state == 'rojo'"
                              decoration-muted="not measure_method">
                            <field name="sequence" widget="handle"/>
                            <field name="number"/>
                            <field name="name"/>
                            <field name="stage_id" optional="show"/>
                            <field name="executor_role_ids" widget="many2many_tags"/>
                            <field name="input_deliverable_ids" widget="many2many_tags" optional="hide"/>
                            <field name="output_deliverable_ids" widget="many2many_tags" optional="show"/>
                            <field name="approver_role_ids" widget="many2many_tags" optional="show"/>
                            <field name="measure_method" optional="show"/>
                            <field name="measure_state" widget="badge" optional="show"
                                   decoration-success="measure_state == 'verde'"
                                   decoration-danger="measure_state == 'rojo'"/>
                            <field name="measure_adherence_pct" optional="show"/>
                            <field name="instruction_id" optional="hide"/>
                            <field name="format_document_ids" widget="many2many_tags" optional="hide"/>
                            <field name="odoo_menu_id" column_invisible="1"/>
                            <field name="odoo_ref" column_invisible="1"/>
                            <field name="measure_model_id" column_invisible="1"/>
                            <button name="action_open_odoo" type="object"
                                    title="Abrir en Odoo" icon="fa-external-link"
                                    invisible="not odoo_menu_id and not measure_model_id and not odoo_ref"/>
                        </list>
                    </field>
                    <separator string="Texto del procedimiento (sale en el PDF)"/>
                    <group>
                        <field name="scope" placeholder="A qué áreas aplica…"/>
                        <field name="env_aspects"/>
                        <field name="norm_ids" widget="many2many_tags"/>
                    </group>
                    <field name="job_responsibility_ids">
                        <list string="Responsabilidades" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="job_id"/>
                            <field name="responsibilities"/>
                        </list>
                    </field>
                    <group string="Firmas">
                        <group>
                            <field name="doc_owner_id"/>
                            <field name="doc_approver_id"/>
                        </group>
                        <group>
                            <field name="doc_vobo_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
