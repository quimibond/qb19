<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sgi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sgi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="SGI" string="SGI" name="quimibond_sgi"
                     logo="/quimibond_sgi/static/description/icon.png">
                    <block title="Datos de arranque">
                        <setting string="Presupuesto mensual de ventas (MXN)"
                                 help="Alimenta los indicadores de cumplimiento y eficiencia del presupuesto (mientras llega el presupuesto por segmento).">
                            <field name="sgi_monthly_sales_budget"/>
                        </setting>
                        <setting string="Usuario de RH"
                                 help="Recibe las actividades automáticas de RH: competencias por vencer, DNC.">
                            <field name="sgi_rh_user_id"/>
                        </setting>
                        <setting string="Bloquear equipos con calibración vencida"
                                 help="Apagado: solo avisa (resumen diario al Coordinador de Laboratorio y al Jefe de Calidad). Encendido: además marca «No usar».">
                            <field name="sgi_calibration_block_expired"/>
                        </setting>
                        <setting string="PIN obligatorio para firmar checklists"
                                 help="Apagado: quien no tiene PIN firma y la hoja dice «sin PIN registrado». Encendido: sin PIN no se firma. Encender cuando RH haya capturado los PIN.">
                            <field name="sgi_checklist_pin_required"/>
                        </setting>
                        <setting string="Jefe MAST y SGI"
                                 help="Recibe los avisos automáticos del SGI sin dueño. Vacío: mas@quimibond.com o el primer miembro directo del grupo.">
                            <field name="sgi_mast_user_id"/>
                        </setting>
                    </block>
                    <!-- 57.119.0 (C1, bloque 3) -->
                    <block title="Desarrollo de producto" name="sgi_dev_product">
                        <setting string="Bloquear el artículo genérico de muestra"
                                 help="Fecha (AAAA-MM-DD) desde la que las órdenes de fabricación de muestra deben llevar el artículo generado por el proyecto y no «MUESTRA PILOTO». Vacío: sin bloqueo.">
                            <field name="sgi_dev_block_generic_sample_from"/>
                        </setting>
                        <setting string="Puesto que autoriza pruebas de laboratorio"
                                 help="Las solicitudes de pruebas de los desarrollos las autorizan las personas de este puesto (Coordinador de Laboratorio y MP) o el Jefe MAST.">
                            <field name="sgi_dev_lab_authorizer_job_id"/>
                        </setting>
                    </block>
                    <block title="Indicadores automáticos" name="sgi_auto_kpis">
                        <setting string="Categoría de requisiciones de compra"
                                 help="Indicador Requisiciones (CO-02): categoría de aprobación que cuenta como requisición. Vacío = detecta las de tipo compra automáticamente; configúrelo solo si hay varias.">
                            <field name="sgi_purchase_approval_category_id"/>
                        </setting>
                        <setting string="Categorías de proveedores críticos"
                                 help="Materia prima y maquila: solo esos proveedores entran a la evaluación trimestral. Vacío = materia prima más las categorías «maquila».">
                            <field name="sgi_supplier_critical_categ_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Capacidad instalada mensual de producción"
                                 help="Indicador Producido vs capacidad (MA-02): capacidad mensual en la misma unidad que la producción (kg). Para periodos no mensuales se prorratea por días. 0 = captura manual.">
                            <field name="sgi_production_monthly_capacity"/>
                        </setting>
                        <setting string="Proveedor de energía"
                                 help="Indicador Consumo de energía (TR-03): proveedor cuyas facturas del periodo suman el consumo. Sin configurar, la medición queda en 0 con nota.">
                            <field name="sgi_energy_partner_id"/>
                            <field name="sgi_satisfaction_survey_id"
                                   context="{'active_test': False}"/>
                        </setting>
                        <!-- 57.11.0 (A-016): los ajustes del presupuesto y del
                             pronóstico de ventas los agrega quimibond_ventas_presupuesto
                             al final de este bloque. -->
                    </block>
                    <block title="No conformidades y AMEF">
                        <setting string="Fuentes de NC automáticas"
                                 help="Enciende o apaga cada automatismo que levanta NC solo: rollo fuera de peso, equipo descalibrado, indicador en rojo, incidente SST…">
                            <div class="mt8">
                                <button name="%(quimibond_sgi.sgi_alert_source_action)d"
                                        type="action" string="Ver fuentes de NC"
                                        class="btn-link" icon="fa-arrow-right"/>
                            </div>
                        </setting>
                        <setting string="Días hábiles para escalar una NC sin acciones"
                                 help="NC interna sin acciones tras estos días hábiles (sin fines de semana ni festivos del calendario del SGI) → actividad al responsable y aviso a MAST.">
                            <field name="sgi_nc_escalation_days"/>
                        </setting>
                        <setting string="Días hábiles para escalar una NC externa/cliente"
                                 help="Auditoría externa y reclamaciones de cliente escalan más rápido que las internas (días hábiles).">
                            <field name="sgi_nc_escalation_days_external"/>
                        </setting>
                        <setting string="Plazos por etapa de una NC (días hábiles)"
                                 help="Desde que se abre la NC: contención, causa raíz y plan de acción. El cron avisa el día que vence cada uno y escala al dueño del proceso y luego a MAST.">
                            <div class="row">
                                <label for="sgi_nc_days_containment" class="col-lg-6 o_light_label">Contención</label>
                                <field name="sgi_nc_days_containment"/>
                            </div>
                            <div class="row">
                                <label for="sgi_nc_days_root_cause" class="col-lg-6 o_light_label">Causa raíz</label>
                                <field name="sgi_nc_days_root_cause"/>
                            </div>
                            <div class="row">
                                <label for="sgi_nc_days_plan" class="col-lg-6 o_light_label">Plan de acción</label>
                                <field name="sgi_nc_days_plan"/>
                            </div>
                            <div class="row">
                                <label for="sgi_nc_escalation_mast_days" class="col-lg-6 o_light_label">Días hábiles vencido antes de escalar a MAST</label>
                                <field name="sgi_nc_escalation_mast_days"/>
                            </div>
                        </setting>
                        <setting string="Días hábiles para que el proveedor conteste una NC"
                                 help="NC a proveedor por el portal: plazo de respuesta; vencido, aviso al comprador y escalamiento a MAST.">
                            <field name="sgi_nc_days_supplier_response"/>
                        </setting>
                        <setting string="Días para verificar la eficacia de una NC"
                                 help="Al terminar la última acción correctiva se agenda la verificación de eficacia al Jefe MAST a estos días. Sin eficacia registrada la NC no cierra.">
                            <field name="sgi_nc_effectiveness_days"/>
                        </setting>
                        <setting string="Ventana de reincidencia de NC (meses)"
                                 help="Una NC reincide si en estos meses hubo otra del mismo proceso (misma cláusula pesa doble). Al cerrarla se exige acción correctiva.">
                            <field name="sgi_nc_recurrence_months"/>
                        </setting>
                        <setting string="Escalar acción vencida al jefe (días hábiles)"
                                 help="Acción vencida más de estos días hábiles → además del responsable, se avisa a su jefe directo (fallback Jefe MAST).">
                            <field name="sgi_action_escalation_manager_days"/>
                        </setting>
                        <setting string="Escalar acción vencida a Dirección (días hábiles)"
                                 help="Acción vencida más de estos días hábiles → además, se avisa a Dirección.">
                            <field name="sgi_action_escalation_director_days"/>
                        </setting>
                        <setting string="NPR que exige acción en el AMEF"
                                 help="Modos de falla con NPR igual o mayor requieren acción antes de que el AMEF sea vigente.">
                            <field name="sgi_fmea_npr_action"/>
                        </setting>
                    </block>
                    <block title="Matriz de riesgos (RyO 5×5)">
                        <setting string="Puntaje para atención Inmediata">
                            <field name="sgi_risk_ryo_inmediata"/>
                        </setting>
                        <setting string="Puntaje para atención Media">
                            <field name="sgi_risk_ryo_media"/>
                        </setting>
                        <setting string="Puntaje para atención Intermedia">
                            <field name="sgi_risk_ryo_intermedia"/>
                        </setting>
                    </block>
                    <block title="Evaluación de proveedores">
                        <setting string="Peso de entregas a tiempo (0-1)">
                            <field name="sgi_supplier_weight_otd"/>
                        </setting>
                        <setting string="Peso de calidad (0-1)">
                            <field name="sgi_supplier_weight_quality"/>
                        </setting>
                        <setting string="Puntos que descuenta cada NC">
                            <field name="sgi_supplier_nc_penalty"/>
                        </setting>
                        <setting string="Tolerancia OTD (días de gracia sobre la fecha compromiso)">
                            <field name="sgi_supplier_otd_tolerance_days"/>
                        </setting>
                    </block>
                    <block title="Documental (avisos)">
                        <setting string="Primer aviso de revisión documental (días)"
                                 help="Días de anticipación del primer recordatorio de revisión bienal.">
                            <field name="sgi_doc_review_notice_days"/>
                        </setting>
                        <setting string="Segundo aviso de revisión documental (días)"
                                 help="Días de anticipación del segundo (último) recordatorio de revisión.">
                            <field name="sgi_doc_review_notice_days_final"/>
                        </setting>
                        <setting string="Aviso de piloto por vencer (días)"
                                 help="Días de anticipación del aviso de vencimiento de una prueba piloto.">
                            <field name="sgi_doc_pilot_notice_days"/>
                        </setting>
                        <setting string="Días hábiles para reclamar un acuse pendiente"
                                 help="Un acuse de lectura sin firmar tras estos días hábiles genera recordatorio.">
                            <field name="sgi_doc_ack_pending_days"/>
                        </setting>
                    </block>
                    <!-- 57.10.0 (A-020): el bloque «Piso» (tolerancia de peso de
                         rollo) lo agrega quimibond_sgi_pesaje antes de «Firmas en Sign». -->
                    <block title="Firmas en Sign" name="sgi_sign">
                        <setting string="«Mi procedimiento» se firma en Sign"
                             help="Publicar deja la revisión en borrador y la manda a firmar: MAST elabora, el jefe directo del puesto aprueba. Entra en vigor sola al firmarse.">
                            <field name="sgi_mp_sign_required"/>
                        </setting>
                    </block>
                    <block title="EPP" name="sgi_epp">
                        <setting string="Plantilla de Sign de la responsiva de EPP"
                             help="Opcional. Vacío: el SGI arma la plantilla sola (responsiva + hoja «Recibí el EPP»).">
                            <field name="sgi_epp_sign_template_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="sgi_config_settings_action" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'quimibond_sgi'}</field>
    </record>
</odoo>
