<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====== Cliente: requiere COA y quién lo recibe ====== -->
    <!-- SGI y Calidad lo editan; los demás lo ven de solo lectura. La regla
         real está en res.partner.write; aquí solo la pantalla. -->
    <record id="sgi_coa_res_partner_view_form" model="ir.ui.view">
        <field name="name">sgi.coa.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group" position="before">
                <group string="Certificado de análisis (COA)" name="sgi_coa">
                    <field name="sgi_requires_coa"
                           groups="quimibond_sgi.group_sgi_user,quality.group_quality_user"/>
                    <field name="sgi_coa_recipient_ids" widget="many2many_tags"
                           invisible="not sgi_requires_coa"
                           groups="quimibond_sgi.group_sgi_user,quality.group_quality_user"/>
                    <field name="sgi_requires_coa" readonly="1"
                           groups="!quimibond_sgi.group_sgi_user,!quality.group_quality_user"/>
                    <field name="sgi_coa_recipient_ids" widget="many2many_tags" readonly="1"
                           invisible="not sgi_requires_coa"
                           groups="!quimibond_sgi.group_sgi_user,!quality.group_quality_user"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ====== Entrega: aviso, botón y estado ====== -->
    <record id="sgi_coa_stock_picking_view_form" model="ir.ui.view">
        <field name="name">sgi.coa.stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sgi_attach_coa" type="object" string="Adjuntar COA"
                        class="btn-secondary" invisible="not sgi_requires_coa"
                        groups="quality.group_quality_user,quimibond_sgi.group_sgi_user"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="sgi_coa_status != 'pendiente'">
                    Este cliente requiere COA y no está adjunto.
                </div>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="sgi_requires_coa" invisible="1"/>
                <field name="sgi_coa_status" widget="badge"
                       invisible="not sgi_requires_coa"
                       decoration-danger="sgi_coa_status == 'pendiente'"
                       decoration-warning="sgi_coa_status == 'adjunto'"
                       decoration-success="sgi_coa_status == 'enviado'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="COA" name="sgi_coa" invisible="not sgi_requires_coa">
                    <group>
                        <group>
                            <field name="sgi_coa_date"/>
                            <field name="sgi_coa_uid"/>
                            <field name="sgi_coa_sent_date"/>
                        </group>
                    </group>
                    <field name="sgi_coa_attachment_ids" widget="many2many_binary" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sgi_coa_stock_picking_view_search" model="ir.ui.view">
        <field name="name">sgi.coa.stock.picking.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="sgi_coa_pendiente" string="COA pendiente"
                        domain="[('sgi_coa_status', '=', 'pendiente')]"/>
            </xpath>
        </field>
    </record>

    <!-- ====== Pedido: estado del COA y sus archivos ====== -->
    <record id="sgi_coa_sale_order_view_form" model="ir.ui.view">
        <field name="name">sgi.coa.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_sgi_view_coa" type="object" class="oe_stat_button"
                        icon="fa-certificate" invisible="sgi_coa_status == 'no_aplica'">
                    <field name="sgi_coa_attachment_count" widget="statinfo" string="COA"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sgi_coa_status" widget="badge"
                       invisible="sgi_coa_status == 'no_aplica'"
                       decoration-danger="sgi_coa_status == 'pendiente'"
                       decoration-warning="sgi_coa_status == 'adjunto'"
                       decoration-success="sgi_coa_status == 'enviado'"/>
            </xpath>
        </field>
    </record>

    <record id="sgi_coa_sale_order_view_list" model="ir.ui.view">
        <field name="name">sgi.coa.sale.order.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="sgi_coa_status" optional="hide" widget="badge"
                       decoration-danger="sgi_coa_status == 'pendiente'"
                       decoration-success="sgi_coa_status == 'enviado'"/>
            </xpath>
        </field>
    </record>

    <record id="sgi_coa_sale_order_view_search" model="ir.ui.view">
        <field name="name">sgi.coa.sale.order.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="sgi_coa_pendiente" string="COA pendiente"
                        domain="[('sgi_coa_status', '=', 'pendiente')]"/>
            </xpath>
        </field>
    </record>

    <!-- ====== Asistentes ====== -->
    <record id="sgi_coa_attach_wizard_view_form" model="ir.ui.view">
        <field name="name">sgi.coa.attach.wizard.form</field>
        <field name="model">sgi.coa.attach.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjuntar COA">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <field name="send"/>
                    <field name="recipient_ids" widget="many2many_tags"
                           invisible="not send" required="send"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Guardar"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sgi_coa_exception_wizard_view_form" model="ir.ui.view">
        <field name="name">sgi.coa.exception.wizard.form</field>
        <field name="model">sgi.coa.exception.wizard</field>
        <field name="arch" type="xml">
            <form string="Validar sin COA">
                <p>Estas salidas requieren COA y no lo tienen. Como Jefe de Calidad
                    puedes validarlas dejando el motivo; queda en el chatter.</p>
                <group>
                    <field name="picking_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Por qué sale sin COA"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Validar sin COA"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ====== Buzón COA: lo que llega por correo ====== -->
    <record id="sgi_coa_inbox_view_list" model="ir.ui.view">
        <field name="name">sgi.coa.inbox.list</field>
        <field name="model">sgi.coa.inbox</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="state == 'sin_ligar'">
                <field name="create_date" string="Recibido"/>
                <field name="name"/>
                <field name="email_from"/>
                <field name="picking_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="sgi_coa_inbox_view_form" model="ir.ui.view">
        <field name="name">sgi.coa.inbox.form</field>
        <field name="model">sgi.coa.inbox</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_link_manual" type="object" string="Ligar a la salida"
                            class="btn-primary" invisible="state == 'ligado'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email_from"/>
                        <field name="picking_ids" widget="many2many_tags"/>
                        <field name="picking_id" invisible="state == 'ligado'"/>
                        <field name="result"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_coa_inbox_view_search" model="ir.ui.view">
        <field name="name">sgi.coa.inbox.search</field>
        <field name="model">sgi.coa.inbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email_from"/>
                <filter name="sin_ligar" string="COA sin ligar"
                        domain="[('state', '=', 'sin_ligar')]"/>
            </search>
        </field>
    </record>

    <record id="sgi_coa_inbox_action" model="ir.actions.act_window">
        <field name="name">COA recibidos por correo</field>
        <field name="res_model">sgi.coa.inbox</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sgi_coa_inbox_view_search"/>
        <field name="context">{'search_default_sin_ligar': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aquí llegan los COA que se mandan al buzón «coa@»</p>
            <p>Cada PDF «&lt;producto&gt; &lt;factura&gt;.pdf» se liga solo a su salida. Los que no se pudieron ligar esperan aquí: elige la salida y pulsa «Ligar a la salida».</p>
        </field>
    </record>

</odoo>
