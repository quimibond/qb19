<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 57.105.0: Manual del SGI (MIID) desde Odoo. Todo en su propio record
         (sin herencias). La pantalla la leen todo Usuario SGI y Auditor;
         editar textos y solicitar el cambio es del Jefe MAST; «Por
         confirmar» lo quitan el Jefe MAST, Dirección o el Administrador SGI.
         57.148.0: la misma pantalla sirve al MIID y al P-G01 (kind); los
         textos no nombran al documento, lo pone el título.
         57.161.0 (Jose, 2026-10-20: «no se entiende ni se puede leer bien»):
         una pestaña por capítulo, con la letra de Odoo. Lo que es registro
         de Odoo (procesos, política, objetivos, normas, tipos de documento,
         rutinas) es una lista que se abre; cada sección abre su pantalla en
         Odoo. El PDF (botones de arriba) es lo que se firma. -->
    <record id="sgi_miid_view_form" model="ir.ui.view">
        <field name="name">sgi.miid.form</field>
        <field name="model">sgi.miid</field>
        <field name="arch" type="xml">
            <form string="Documento generado del SGI" create="0" delete="0">
                <header>
                    <button name="action_sgi_miid_request_change" type="object" string="Solicitar cambio de revisión"
                            class="btn-primary" icon="fa-pencil" groups="quimibond_sgi.group_sgi_manager"
                            invisible="not document_id or pending_request_id"/>
                    <button name="action_print_live" type="object" string="Vista en PDF (borrador)"
                            class="btn-secondary" icon="fa-file-pdf-o"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_request" type="object" class="oe_stat_button text-warning"
                                icon="fa-check-square-o" string="Solicitud en curso" invisible="not pending_request_id"/>
                        <button name="action_open_vigente_pdf" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" string="PDF vigente" invisible="not document_id"/>
                        <button name="action_open_sections" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="section_count" widget="statinfo" string="Textos"/>
                        </button>
                        <button name="action_open_sections" type="object" class="oe_stat_button text-danger"
                                icon="fa-exclamation-triangle" invisible="not to_confirm_count"
                                context="{'search_default_to_confirm': 1}">
                            <field name="to_confirm_count" widget="statinfo" string="Por confirmar"/>
                        </button>
                        <button name="action_open_revisions" type="object" class="oe_stat_button" icon="fa-history">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="revision_label" readonly="1"/></span>
                                <span class="o_stat_text">Rev. vigente</span>
                            </div>
                        </button>
                        <!-- 57.167.0: antes menú de «Manual del SGI». -->
                        <button name="action_open_requests" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager,quimibond_sgi.group_sgi_director">
                            <field name="request_count" widget="statinfo" string="Solicitudes"/>
                        </button>
                    </div>
                    <!-- 57.164.0: lo que impide aprobar, como listas que se resuelven aquí. -->
                    <div class="alert alert-warning mb-2" role="status" invisible="not approval_todo_count">
                        <b>Para aprobar una revisión nueva faltan <field name="approval_todo_count" class="oe_inline"
                        readonly="1"/> cosa(s).</b> Resuélvalas aquí abajo; la lista se vacía sola.
                    </div>
                    <div class="mb-3" invisible="not to_confirm_section_ids">
                        <h5>Secciones por confirmar</h5>
                        <field name="to_confirm_section_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="clause"/>
                                <field name="name"/>
                                <field name="to_confirm_note" string="Qué falta confirmar"/>
                                <button name="action_open_form" type="object" string="Editar" icon="fa-pencil"
                                        groups="quimibond_sgi.group_sgi_manager"/>
                                <button name="action_sgi_confirm" type="object" string="Confirmar" icon="fa-check"
                                        class="btn-primary"
                                        groups="quimibond_sgi.group_sgi_manager,quimibond_sgi.group_sgi_director"
                                        confirm="¿Ya está confirmado lo que dice la nota? Se quita «Por confirmar» y queda en el historial de la sección."/>
                            </list>
                        </field>
                    </div>
                    <div class="mb-3" invisible="not pending_process_ids">
                        <h5>Procesos que faltan por publicar</h5>
                        <field name="pending_process_ids" nolabel="1" readonly="1">
                            <list decoration-success="not spec_error_count" decoration-danger="spec_error_count">
                                <field name="code"/>
                                <field name="name"/>
                                <field name="owner_id" widget="many2one_avatar_employee"/>
                                <field name="state" widget="badge" decoration-warning="state == 'piloto'"
                                       decoration-info="state == 'borrador'"/>
                                <field name="spec_error_count" string="Le faltan"/>
                                <button name="action_view_spec_gaps" type="object" string="Qué falta"
                                        icon="fa-list" invisible="not spec_error_count"/>
                                <button name="action_sgi_publish" type="object" string="Publicar" icon="fa-check"
                                        class="btn-primary" invisible="spec_error_count"
                                        groups="quimibond_sgi.group_sgi_manager"
                                        confirm="¿Publicar el proceso? Queda vigente y los procedimientos que sustituye quedan obsoletos."/>
                            </list>
                        </field>
                    </div>
                    <div class="alert alert-success mb-2" role="status" invisible="state != 'al_dia'">
                        La revisión vigente coincide con los datos del sistema.
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="state != 'desactualizado'">
                        La revisión vigente ya no coincide con el sistema: vea la pestaña «Diferencias». El Jefe
                        MAST solicita el cambio con «Solicitar cambio de revisión».
                    </div>
                    <div class="alert alert-info mb-2" role="status" invisible="state != 'sin_base'">
                        La revisión vigente es un PDF cargado del Dropbox: todavía no hay contra qué comparar. La
                        comparación diaria empieza con la primera revisión aprobada desde Odoo.
                    </div>
                    <div class="alert alert-danger mb-2" role="alert" invisible="state != 'sin_documento'">
                        No hay revisión vigente en Documentos (la clave del documento es la de este generado).
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind" readonly="1"/>
                            <field name="document_id" readonly="1"/>
                            <field name="issue_date" readonly="1"/>
                            <field name="state" widget="badge" readonly="1"
                                   decoration-success="state == 'al_dia'"
                                   decoration-warning="state == 'desactualizado'"
                                   decoration-info="state == 'sin_base'"
                                   decoration-danger="state == 'sin_documento'"/>
                        </group>
                        <group>
                            <field name="outdated_since" readonly="1" invisible="not outdated_since"/>
                            <field name="last_check" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-warning py-2 mb-2" role="status">
                        <b>Borrador — no vigente:</b> las pestañas muestran lo que el sistema tiene hoy, no la
                        revisión aprobada. La revisión vigente es la de «PDF de la revisión vigente».
                    </div>
                    <notebook>
                        <page string="Identificación" name="page_general">
                            <field name="scr_general_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Objeto y alcance" name="page_objeto" invisible="kind != 'miid'">
                            <field name="scr_objeto_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Propósito y alcance" name="page_proposito" invisible="kind != 'pg01'">
                            <field name="scr_proposito_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Responsabilidades" name="page_responsabilidades" invisible="kind != 'pg01'">
                            <field name="scr_responsabilidades_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Normas" name="page_normas" invisible="kind != 'miid'">
                            <field name="scr_normas_normas_html" nolabel="1" readonly="1"/>
                            <field name="norm_ids" nolabel="1" readonly="1" invisible="not scr_normas_normas_html">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="clause_count"/>
                                </list>
                            </field>
                            <field name="scr_normas_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Dónde vive el sistema" name="page_donde" invisible="kind != 'miid'">
                            <field name="scr_donde_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="El sistema" name="page_sistema" invisible="kind != 'miid'">
                            <field name="scr_sistema_procesos_html" nolabel="1" readonly="1"/>
                            <field name="process_ids" nolabel="1" readonly="1" invisible="not scr_sistema_procesos_html">
                                <list decoration-muted="state != 'vigente'">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="process_type"/>
                                    <field name="owner_id" widget="many2one_avatar_employee"/>
                                    <field name="activity_count"/>
                                    <field name="state" widget="badge" decoration-success="state == 'vigente'"
                                           decoration-warning="state == 'piloto'" decoration-info="state == 'borrador'"/>
                                </list>
                            </field>
                            <field name="scr_sistema_politica_html" nolabel="1" readonly="1"/>
                            <div invisible="not scr_sistema_politica_html">
                                <div class="alert alert-warning py-2" role="alert" invisible="policy_id">No hay
                                    política vigente.</div>
                                <group invisible="not policy_id">
                                    <field name="policy_id" string="Política vigente" readonly="1"/>
                                </group>
                                <field name="policy_text" nolabel="1" readonly="1" invisible="not policy_id"/>
                            </div>
                            <field name="scr_sistema_objetivos_html" nolabel="1" readonly="1"/>
                            <field name="objective_ids" nolabel="1" readonly="1" invisible="not scr_sistema_objetivos_html">
                                <list>
                                    <field name="name"/>
                                    <field name="target_year"/>
                                    <field name="indicator_count"/>
                                    <field name="health" widget="badge" decoration-success="health == 'verde'"
                                           decoration-warning="health == 'amarillo'" decoration-danger="health == 'rojo'"/>
                                </list>
                            </field>
                            <field name="scr_sistema_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Cómo se cumple" name="page_requisitos" invisible="kind != 'miid'">
                            <field name="scr_requisitos_reglas_html" nolabel="1" readonly="1"/>
                            <field name="rule_ids" nolabel="1" readonly="1" invisible="not scr_requisitos_reglas_html">
                                <list>
                                    <field name="name"/>
                                    <field name="clause_label"/>
                                    <field name="text"/>
                                    <field name="menu_id"/>
                                    <button name="action_open_menu" type="object" icon="fa-external-link"
                                            title="Abrir en Odoo" invisible="not menu_id"/>
                                </list>
                            </field>
                            <field name="scr_requisitos_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Desarrollo" name="page_desarrollo" invisible="kind != 'pg01'">
                            <field name="scr_desarrollo_tipos_documento_html" nolabel="1" readonly="1"/>
                            <field name="pg01_doc_type_ids" nolabel="1" readonly="1" invisible="not scr_desarrollo_tipos_documento_html">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="prefix_pattern"/>
                                    <field name="requires_process" optional="hide"/>
                                </list>
                            </field>
                            <field name="scr_desarrollo_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Información documentada" name="page_documentos" invisible="kind != 'miid'">
                            <field name="scr_documentos_tipos_documento_html" nolabel="1" readonly="1"/>
                            <field name="doc_type_ids" nolabel="1" readonly="1" invisible="not scr_documentos_tipos_documento_html">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="prefix_pattern"/>
                                    <field name="requires_process" optional="hide"/>
                                </list>
                            </field>
                            <field name="scr_documentos_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Rutinas" name="page_rutinas" invisible="kind != 'pg01'">
                            <field name="scr_rutinas_actividades_html" nolabel="1" readonly="1"/>
                            <field name="routine_ids" nolabel="1" readonly="1" invisible="not scr_rutinas_actividades_html">
                                <list>
                                    <field name="number"/>
                                    <field name="name"/>
                                    <field name="responsible_job_ids" widget="many2many_tags"/>
                                    <field name="measure_cadence"/>
                                    <field name="done_criteria"/>
                                </list>
                            </field>
                            <field name="scr_rutinas_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Marco normativo" name="page_marco" invisible="kind != 'pg01'">
                            <field name="scr_marco_normas_html" nolabel="1" readonly="1"/>
                            <field name="pg01_norm_ids" nolabel="1" readonly="1" invisible="not scr_marco_normas_html">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="clause_count"/>
                                </list>
                            </field>
                            <field name="scr_marco_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Transición" name="page_transicion" invisible="kind != 'miid'">
                            <field name="scr_transicion_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Control de cambios" name="page_cambios">
                            <field name="scr_cambios_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Otros capítulos" name="page_otros" invisible="not scr_otros_html">
                            <field name="scr_otros_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Diferencias" name="diff" invisible="state != 'desactualizado'">
                            <field name="diff_html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_miid_section_view_list" model="ir.ui.view">
        <field name="name">sgi.miid.section.list</field>
        <field name="model">sgi.miid.section</field>
        <field name="arch" type="xml">
            <list string="Textos" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="kind" optional="show"/>
                <field name="page" optional="show"/>
                <field name="clause"/>
                <field name="name"/>
                <field name="item_count" optional="show"/>
                <field name="menu_id" optional="hide"/>
                <field name="live_block" optional="show"/>
                <field name="to_confirm" widget="boolean_toggle" decoration-danger="to_confirm"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sgi_miid_section_view_form" model="ir.ui.view">
        <field name="name">sgi.miid.section.form</field>
        <field name="model">sgi.miid.section</field>
        <field name="arch" type="xml">
            <form string="Sección" delete="0">
                <header>
                    <button name="action_open_menu" type="object" string="Abrir en Odoo" icon="fa-external-link"
                            class="btn-secondary" invisible="not menu_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="alert alert-danger mb-2" role="alert" invisible="not to_confirm">
                        <b>Por confirmar:</b> mientras esta sección esté marcada, ninguna revisión de su documento se
                        envía ni se aprueba. Quítelo cuando el texto esté confirmado.
                    </div>
                    <group>
                        <group>
                            <field name="to_confirm" widget="boolean_toggle"/>
                            <field name="to_confirm_note" required="to_confirm" invisible="not to_confirm"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="oe_title">
                        <h1><field name="clause" class="oe_inline" placeholder="4.4"/> <field name="name" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="page"/>
                            <field name="heading_level"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="menu_id" options="{'no_create': True}"/>
                            <field name="live_block"/>
                            <field name="body_fallback" invisible="not live_block"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Texto de la sección" name="body">
                            <p class="text-muted">Texto corto de la sección. Escriba [[datos]] en un párrafo propio
                                para decidir dónde van los renglones y los datos del sistema; si no, van al final del
                                texto.</p>
                            <field name="body" nolabel="1"/>
                        </page>
                        <page string="Renglones" name="items">
                            <p class="text-muted">Una fila por concepto: lo que antes eran viñetas o tablas escritas
                                en el texto. Cada renglón puede abrir su pantalla en Odoo.</p>
                            <group>
                                <group>
                                    <field name="item_style" widget="radio" options="{'horizontal': true}"/>
                                    <field name="item_label_title" required="1"/>
                                    <field name="item_clause_title" invisible="item_style == 'list'"/>
                                </group>
                                <group invisible="item_style == 'list'">
                                    <field name="item_text_title"/>
                                    <field name="item_text2_title"/>
                                    <field name="item_text3_title"/>
                                </group>
                            </group>
                            <field name="item_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="clause" optional="show"/>
                                    <field name="text"/>
                                    <field name="text_2" optional="show"/>
                                    <field name="text_3" optional="hide"/>
                                    <field name="menu_id" options="{'no_create': True}" optional="show"/>
                                    <button name="action_open_menu" type="object" icon="fa-external-link"
                                            title="Abrir en Odoo" invisible="not menu_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas por renglón" name="row_notes" invisible="not live_block">
                            <p class="text-muted">Columna fija de un bloque de datos: en los anexos del MIID, la
                                situación de cada anexo (el renglón es la clave del anexo, p. ej. ANEXO 9).</p>
                            <field name="row_note_ids" nolabel="1">
                                <list editable="bottom" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="key"/>
                                    <field name="text"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_miid_section_view_search" model="ir.ui.view">
        <field name="name">sgi.miid.section.search</field>
        <field name="model">sgi.miid.section</field>
        <field name="arch" type="xml">
            <search string="Textos">
                <field name="name"/>
                <field name="clause"/>
                <field name="live_block"/>
                <filter name="kind_miid" string="Manual (MIID)" domain="[('kind', '=', 'miid')]"/>
                <filter name="kind_pg01" string="P-G01" domain="[('kind', '=', 'pg01')]"/>
                <separator/>
                <filter name="to_confirm" string="Por confirmar" domain="[('to_confirm', '=', True)]"/>
                <filter name="with_block" string="Con datos del sistema" domain="[('live_block', '!=', False)]"/>
                <separator/>
                <filter name="inactive" string="Archivadas" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_kind" string="Documento" context="{'group_by': 'kind'}"/>
                    <filter name="group_page" string="Pestaña" context="{'group_by': 'page'}"/>
                    <filter name="group_block" string="Bloque de datos" context="{'group_by': 'live_block'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_miid_section_action" model="ir.actions.act_window">
        <field name="name">Textos</field>
        <field name="res_model">sgi.miid.section</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sgi_miid_section_view_list"/>
        <field name="search_view_id" ref="sgi_miid_section_view_search"/>
        <field name="context">{'search_default_group_kind': 1, 'search_default_group_page': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin textos</p>
            <p>Una sección por título y subtítulo del manual y del P-G01. Edite el texto fijo; los datos del sistema
                los pone Odoo.</p>
        </field>
    </record>

    <record id="sgi_miid_action_open" model="ir.actions.server">
        <field name="name">Manual del SGI (MIID)</field>
        <field name="model_id" ref="quimibond_sgi.model_sgi_miid"/>
        <field name="state">code</field>
        <field name="code">action = env['sgi.miid'].action_open()</field>
    </record>

    <!-- 57.148.0: el P-G01 generado con el mismo motor (kind = pg01). -->
    <record id="sgi_pg01_action_open" model="ir.actions.server">
        <field name="name">Control de información documentada (P-G01)</field>
        <field name="model_id" ref="quimibond_sgi.model_sgi_miid"/>
        <field name="state">code</field>
        <field name="code">action = env['sgi.miid'].with_context(sgi_miid_kind='pg01').action_open()</field>
    </record>

    <!-- 57.148.0: todas las revisiones del manual y del P-G01 (vigentes y
         obsoletas), la lista de documentos controlados de siempre. -->
    <record id="sgi_miid_revisions_action" model="ir.actions.act_window">
        <field name="name">Revisiones del manual y del P-G01</field>
        <field name="res_model">documents.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sgi_is_controlled', '=', True), ('sgi_code', 'in', ('MIID', 'P-G01'))]</field>
        <field name="context">{'active_test': False}</field>
        <field name="search_view_id" ref="sgi_document_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_document_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sgi_document_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin revisiones</p>
            <p>Cada revisión publicada del Manual del SGI (MIID) y del P-G01, con su archivo, su emisión y sus
                acuses.</p>
        </field>
    </record>

    <!-- 57.148.0: las solicitudes de cambio que llevan huella (las generadas
         desde el manual o el P-G01). -->
    <record id="sgi_miid_requests_action" model="ir.actions.act_window">
        <field name="name">Solicitudes de cambio del manual y del P-G01</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sgi_miid_hash', '!=', False)]</field>
        <field name="search_view_id" ref="sgi_doc_change_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_doc_change_view_list')}),
