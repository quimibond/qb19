<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 57.105.0: Manual del SGI (MIID) desde Odoo. Todo en su propio record
         (sin herencias). La pantalla la leen todo Usuario SGI y Auditor;
         editar textos y solicitar el cambio es del Jefe MAST; «Por
         confirmar» lo quitan el Jefe MAST, Dirección o el Administrador SGI. -->
    <record id="sgi_miid_view_form" model="ir.ui.view">
        <field name="name">sgi.miid.form</field>
        <field name="model">sgi.miid</field>
        <field name="arch" type="xml">
            <form string="Manual del SGI (MIID)" create="0" delete="0">
                <header>
                    <button name="action_sgi_miid_request_change" type="object" string="Solicitar cambio del MIID"
                            class="btn-primary" icon="fa-pencil" groups="quimibond_sgi.group_sgi_manager"
                            invisible="not document_id or pending_request_id"/>
                    <button name="action_print_live" type="object" string="Vista en PDF (borrador)"
                            class="btn-secondary" icon="fa-file-pdf-o"/>
                    <button name="action_open_vigente_pdf" type="object" string="PDF de la revisión vigente"
                            class="btn-secondary" icon="fa-file-text-o" invisible="not document_id"/>
                    <button name="action_open_sections" type="object" string="Textos del manual"
                            class="btn-secondary" icon="fa-pencil-square-o"/>
                    <button name="action_open_request" type="object" string="Abrir la solicitud en curso"
                            class="btn-secondary" icon="fa-check-square-o" invisible="not pending_request_id"/>
                </header>
                <sheet>
                    <div class="alert alert-danger mb-2" role="alert" invisible="not blocker_html">
                        <b>Una revisión del MIID no se puede aprobar todavía:</b>
                        <field name="blocker_html" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-success mb-2" role="status" invisible="state != 'al_dia'">
                        La revisión vigente coincide con los datos del sistema.
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="state != 'desactualizado'">
                        El MIID vigente ya no coincide con el sistema: vea la pestaña «Diferencias». El Jefe MAST
                        solicita el cambio con «Solicitar cambio del MIID».
                    </div>
                    <div class="alert alert-info mb-2" role="status" invisible="state != 'sin_base'">
                        La revisión vigente es un PDF cargado del Dropbox: todavía no hay contra qué comparar. La
                        comparación diaria empieza con la primera revisión aprobada desde Odoo.
                    </div>
                    <div class="alert alert-danger mb-2" role="alert" invisible="state != 'sin_documento'">
                        No hay MIID vigente (clave MIID) en Documentos.
                    </div>
                    <div class="alert alert-info mb-2" role="status" invisible="not pending_request_id">
                        Hay una solicitud de cambio del MIID en curso: <field name="pending_request_id" readonly="1"
                        class="oe_inline" nolabel="1"/>.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_id" readonly="1"/>
                            <field name="revision_label" readonly="1"/>
                            <field name="issue_date" readonly="1"/>
                            <field name="state" widget="badge" readonly="1"
                                   decoration-success="state == 'al_dia'"
                                   decoration-warning="state == 'desactualizado'"
                                   decoration-info="state == 'sin_base'"
                                   decoration-danger="state == 'sin_documento'"/>
                        </group>
                        <group>
                            <field name="to_confirm_count" readonly="1"/>
                            <field name="outdated_since" readonly="1" invisible="not outdated_since"/>
                            <field name="last_check" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vista del sistema" name="live">
                            <div class="alert alert-warning mb-2" role="alert">
                                <b>Borrador — no vigente:</b> lo que ve abajo es la vista del sistema, no la
                                revisión aprobada. La revisión vigente es la de «PDF de la revisión vigente».
                            </div>
                            <field name="live_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Diferencias" name="diff">
                            <p class="text-muted" invisible="diff_html">Sin diferencias que mostrar: la revisión
                                vigente está al día o no tiene línea base.</p>
                            <field name="diff_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Historial de revisiones" name="history">
                            <field name="history_html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_miid_section_view_list" model="ir.ui.view">
        <field name="name">sgi.miid.section.list</field>
        <field name="model">sgi.miid.section</field>
        <field name="arch" type="xml">
            <list string="Textos del MIID" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="clause"/>
                <field name="name"/>
                <field name="live_block" optional="show"/>
                <field name="to_confirm" widget="boolean_toggle" decoration-danger="to_confirm"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sgi_miid_section_view_form" model="ir.ui.view">
        <field name="name">sgi.miid.section.form</field>
        <field name="model">sgi.miid.section</field>
        <field name="arch" type="xml">
            <form string="Sección del MIID" delete="0">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="alert alert-danger mb-2" role="alert" invisible="not to_confirm">
                        <b>Por confirmar:</b> mientras esta sección esté marcada, ninguna revisión del MIID se envía
                        ni se aprueba. Quítelo cuando el texto esté confirmado.
                    </div>
                    <group>
                        <group>
                            <field name="to_confirm" widget="boolean_toggle"/>
                            <field name="to_confirm_note" required="to_confirm" invisible="not to_confirm"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="oe_title">
                        <h1><field name="clause" class="oe_inline" placeholder="4.4"/> <field name="name" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="heading_level"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="live_block"/>
                            <field name="body_fallback" invisible="not live_block"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Texto de la sección" name="body">
                            <p class="text-muted">Escriba [[datos]] en un párrafo propio para decidir dónde van los
                                datos del sistema; si no, van al final de la sección.</p>
                            <field name="body" nolabel="1"/>
                        </page>
                        <page string="Notas por renglón" name="row_notes" invisible="not live_block">
                            <p class="text-muted">Columna fija de un bloque de datos: en 12.1, la situación de cada
                                anexo (el renglón es la clave del anexo, p. ej. ANEXO 9).</p>
                            <field name="row_note_ids" nolabel="1">
                                <list editable="bottom" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="key"/>
                                    <field name="text"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_miid_section_view_search" model="ir.ui.view">
        <field name="name">sgi.miid.section.search</field>
        <field name="model">sgi.miid.section</field>
        <field name="arch" type="xml">
            <search string="Textos del MIID">
                <field name="name"/>
                <field name="clause"/>
                <field name="live_block"/>
                <filter name="to_confirm" string="Por confirmar" domain="[('to_confirm', '=', True)]"/>
                <filter name="with_block" string="Con datos del sistema" domain="[('live_block', '!=', False)]"/>
                <separator/>
                <filter name="inactive" string="Archivadas" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_block" string="Bloque de datos" context="{'group_by': 'live_block'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_miid_section_action" model="ir.actions.act_window">
        <field name="name">Textos del MIID</field>
        <field name="res_model">sgi.miid.section</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sgi_miid_section_view_list"/>
        <field name="search_view_id" ref="sgi_miid_section_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin textos del MIID</p>
            <p>Una sección por título y subtítulo del manual. Edite el texto fijo; los datos del sistema los pone
                Odoo.</p>
        </field>
    </record>

    <record id="sgi_miid_action_open" model="ir.actions.server">
        <field name="name">Manual del SGI (MIID)</field>
        <field name="model_id" ref="quimibond_sgi.model_sgi_miid"/>
        <field name="state">code</field>
        <field name="code">action = env['sgi.miid'].action_open()</field>
    </record>
</odoo>
