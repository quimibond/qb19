    <!-- quality.alert: desde 57.40.0 (V-A01) el aviso de formato controlado
         va dentro del aviso único de la NC (sgi_nonconformity_views.xml). -->

    <record id="sgi_format_banner_stock_lot" model="ir.ui.view">
        <field name="name">stock.lot.form.sgi.format</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
