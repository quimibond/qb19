                     invisible="not sgi_format_banner">
                    📋 Formato controlado del SGI (CoA):
                    <field name="sgi_format_banner" readonly="1" nolabel="1" class="fw-bold"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
