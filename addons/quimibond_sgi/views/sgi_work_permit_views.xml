<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 57.51.0: permiso de trabajo de alto riesgo (ISO 45001 8.1, E2.18).
         Ficha propia completa, sin herencias. -->
    <record id="sgi_work_permit_view_form" model="ir.ui.view">
        <field name="name">sgi.work.permit.form</field>
        <field name="model">sgi.work.permit</field>
        <field name="arch" type="xml">
            <form string="Permiso de trabajo de alto riesgo">
                <header>
                    <button name="action_submit" type="object" string="Solicitar autorización"
                            class="btn-primary" invisible="state != 'borrador'"/>
                    <button name="action_approve_area" type="object" string="Autorizar por el área"
                            class="btn-primary" invisible="state != 'solicitado' or area_approved_by_id"/>
                    <button name="action_approve_sst" type="object" string="Autorizar por Seguridad"
                            class="btn-primary" invisible="state != 'solicitado' or sst_approved_by_id"
                            groups="quimibond_sgi.group_sgi_manager"/>
                    <button name="action_close" type="object" string="Cerrar permiso"
                            class="btn-primary" invisible="state != 'autorizado'"
                            confirm="El permiso se cierra y queda como evidencia. ¿Desea continuar?"/>
                    <button name="action_load_checks" type="object" string="Cargar verificaciones del tipo"
                            invisible="state != 'borrador'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            confirm="Se cancelará el permiso de trabajo. ¿Desea continuar?"
                            invisible="state in ('cerrado', 'cancelado')"/>
                    <button name="action_reset" type="object" string="Regresar a borrador"
                            confirm="El permiso regresa a borrador y se borran sus autorizaciones. ¿Desea continuar?"
                            invisible="state == 'borrador'"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,solicitado,autorizado,cerrado"/>
                </header>
                <div class="alert alert-info mb-0" role="alert" invisible="not sgi_format_banner">
                    📋 Formato controlado del SGI:
                    <field name="sgi_format_banner" readonly="1" nolabel="1" class="fw-bold"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="not expired">
                    El permiso ya venció. Suspenda el trabajo o ciérrelo y solicite uno nuevo.
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. Cambio de lámparas en nave 2"
                                   readonly="state != 'borrador'"/></h1>
                        <h3><field name="folio" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Trabajo">
                            <field name="work_type" readonly="state != 'borrador'"/>
                            <field name="requester_id" readonly="state != 'borrador'"/>
                            <field name="sgi_area_id" readonly="state != 'borrador'"/>
                            <field name="location" readonly="state != 'borrador'"/>
                            <field name="equipment_id" readonly="state != 'borrador'"/>
                            <field name="maintenance_request_id" readonly="state != 'borrador'"/>
                        </group>
                        <group string="Vigencia">
                            <field name="date_start" readonly="state != 'borrador'"/>
                            <field name="date_end" readonly="state != 'borrador'"/>
                            <field name="expired" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Quién lo hace">
                            <field name="executor_ids" widget="many2many_tags" readonly="state != 'borrador'"/>
                            <field name="contractor_id" readonly="state != 'borrador'"/>
                        </group>
                        <group string="Autorizaciones">
                            <field name="area_manager_id" readonly="state != 'borrador'"/>
                            <field name="area_approved_by_id"/>
                            <field name="area_approved_date"/>
                            <field name="sst_approved_by_id"/>
                            <field name="sst_approved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Peligros y verificaciones" name="checks">
                            <group>
                                <field name="hazards" readonly="state != 'borrador'"/>
                                <field name="epp_notes" readonly="state != 'borrador'"/>
                            </group>
                            <field name="check_ids" readonly="state != 'borrador'">
                                <list editable="bottom" decoration-danger="answer == 'no'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="category"/>
                                    <field name="name"/>
                                    <field name="answer"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cierre" name="closing">
                            <group>
                                <field name="close_note" readonly="state != 'autorizado'"/>
                                <field name="closed_by_id"/>
                                <field name="closed_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_work_permit_view_list" model="ir.ui.view">
        <field name="name">sgi.work.permit.list</field>
        <field name="model">sgi.work.permit</field>
        <field name="arch" type="xml">
            <list string="Permisos de trabajo de alto riesgo"
                  decoration-info="state == 'solicitado'"
                  decoration-muted="state in ('cerrado', 'cancelado')">
                <field name="folio"/>
                <field name="name"/>
                <field name="work_type"/>
                <field name="location"/>
                <field name="requester_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="area_approved_by_id" optional="hide"/>
                <field name="sst_approved_by_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'solicitado'"
                       decoration-success="state == 'autorizado'"/>
            </list>
        </field>
    </record>

    <record id="sgi_work_permit_view_search" model="ir.ui.view">
        <field name="name">sgi.work.permit.search</field>
        <field name="model">sgi.work.permit</field>
        <field name="arch" type="xml">
            <search string="Permisos de trabajo de alto riesgo">
                <field name="folio"/>
                <field name="name"/>
                <field name="location"/>
                <field name="requester_id"/>
                <field name="equipment_id"/>
                <filter name="to_authorize" string="Por autorizar" domain="[('state', '=', 'solicitado')]"/>
                <filter name="authorized" string="Autorizados" domain="[('state', '=', 'autorizado')]"/>
                <filter name="expired_open" string="Vencidos sin cerrar"
                        domain="[('state', '=', 'autorizado'), ('date_end', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="mine" string="Mis solicitudes" domain="[('requester_id', '=', uid)]"/>
                <filter name="to_me" string="Me toca autorizar" domain="[('state', '=', 'solicitado'), ('area_manager_id', '=', uid), ('area_approved_by_id', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Tipo de trabajo" context="{'group_by': 'work_type'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'date_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_work_permit_action" model="ir.actions.act_window">
        <field name="name">Permisos de trabajo de alto riesgo</field>
        <field name="res_model">sgi.work.permit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sgi_work_permit_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Solicite el primer permiso de trabajo</p>
            <p>ISO 45001 8.1: antes de un trabajo en alturas, en espacio confinado, en caliente o
               eléctrico, registre los peligros, el EPP y las verificaciones. Lo autorizan el jefe
               del área y Seguridad; al terminar, se cierra con las condiciones del área.</p>
        </field>
    </record>
</odoo>
