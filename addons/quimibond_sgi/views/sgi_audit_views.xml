<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= PROGRAMA ================= -->
    <record id="sgi_audit_program_view_form" model="ir.ui.view">
        <field name="name">sgi.audit.program.form</field>
        <field name="model">sgi.audit.program</field>
        <field name="arch" type="xml">
            <form string="Programa de auditorías">
                <header>
                    <button name="action_approve" type="object" string="Aprobar"
                            class="btn-primary" invisible="state != 'borrador'"
                            groups="quimibond_sgi.group_sgi_manager"/>
                    <button name="action_close" confirm="Se cerrará el programa de auditorías y dejará de editarse. ¿Desea continuar?" type="object" string="Cerrar"
                            class="btn-primary" invisible="state != 'aprobado'"
                            groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"/>
                    <button name="action_suggest_lines" type="object" string="Programa sugerido"
                            icon="fa-magic" invisible="state != 'borrador'"
                            groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"
                            help="Una línea por subproceso (en borrador, piloto o vigente), repartidos por trimestre; los procesos con NC abiertas o indicadores en rojo, dos veces al año."/>
                    <button name="action_draft" confirm="El programa de auditorías regresa a borrador y vuelve a editarse. ¿Desea continuar?" type="object" string="Regresar a borrador"
                            invisible="state == 'borrador'"
                            groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Programa de auditorías <field name="year" class="oe_inline"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not coverage_gap_count">
                        <b>Cobertura de 3 años:</b>
                        <field name="coverage_gap_count" class="oe_inline"/> subproceso(s) sin
                        auditoría en este programa ni en los dos anteriores (ISO 9.2.2). Agréguelos
                        o deje el motivo en el historial:
                        <field name="coverage_gap_ids" widget="many2many_tags" readonly="1" nolabel="1"/>
                    </div>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="process_id"/>
                            <field name="partner_id" optional="hide"/>
                            <field name="planned_month"/>
                            <field name="audit_type"/>
                            <field name="norm_ids" widget="many2many_tags"/>
                            <field name="lead_auditor_id"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'cerrada'"
                                   decoration-info="state == 'creada'"/>
                            <button name="action_create_audit" type="object"
                                    string="Crear auditoría" icon="fa-plus"
                                    invisible="state != 'pendiente'"
                                    groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"/>
                            <field name="audit_id" readonly="1" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_audit_program_view_list" model="ir.ui.view">
        <field name="name">sgi.audit.program.list</field>
        <field name="model">sgi.audit.program</field>
        <field name="arch" type="xml">
            <list string="Programas de auditoría" decoration-muted="state == 'borrador'" decoration-success="state == 'cerrado'">
                <field name="year"/>
                <!-- V-M14 (57.80.0): cuántas auditorías lleva y cuántas se hicieron. -->
                <field name="line_count"/>
                <field name="line_done_count"/>
                <field name="progress_pct" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'cerrado'"
                       decoration-info="state == 'aprobado'"/>
            </list>
        </field>
    </record>

    <!-- D-014 (57.21.0): búsqueda con filtros y archivados. -->
    <record id="sgi_audit_program_view_search" model="ir.ui.view">
        <field name="name">sgi.audit.program.search</field>
        <field name="model">sgi.audit.program</field>
        <field name="arch" type="xml">
            <search string="Programas de auditoría">
                <field name="name"/>
                <field name="year"/>
                <filter name="state_borrador" string="Borrador" domain="[('state', '=', 'borrador')]"/>
                <filter name="state_aprobado" string="Aprobado" domain="[('state', '=', 'aprobado')]"/>
                <filter name="state_cerrado" string="Cerrado" domain="[('state', '=', 'cerrado')]"/>
                <separator/>
                <filter name="this_year" string="Este año" domain="[('year', '=', context_today().year)]"/>
                <group>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_year" string="Año" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_audit_program_action" model="ir.actions.act_window">
        <field name="name">Programa</field>
        <field name="res_model">sgi.audit.program</field>
        <field name="view_mode">list,sgi_diagram,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree el programa anual de auditorías</p>
            <p>El sistema avisa al auditor líder 15 días antes de cada auditoría programada.</p>
        </field>
    </record>

    <!-- ================= AUDITORÍA ================= -->
    <record id="sgi_audit_view_form" model="ir.ui.view">
        <field name="name">sgi.audit.form</field>
        <field name="model">sgi.audit</field>
        <field name="arch" type="xml">
            <form string="Auditoría">
                <header>
                    <!-- V-M06 (57.42.0): el siguiente paso de cada estado es el único
                         primario y va primero. -->
                    <button name="action_plan" type="object" string="Planificar"
                            class="btn-primary" invisible="state != 'borrador'" groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"/>
                    <button name="action_start" type="object" string="Iniciar"
                            class="btn-primary" invisible="state != 'planificada'" groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"/>
                    <button name="action_report" type="object" string="Elaborar informe"
                            class="btn-primary" invisible="state != 'en_ejecucion'" groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"/>
                    <button name="action_close" confirm="Se cerrará la auditoría y dejará de editarse. ¿Desea continuar?" type="object" string="Cerrar"
                            class="btn-primary" invisible="state != 'informe'" groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"/>
                    <button name="action_generate_checklist" type="object"
                            string="Regenerar checklist" icon="fa-refresh"
                            invisible="state not in ('planificada', 'en_ejecucion')" groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"
                            help="Trae al checklist las actividades de los procesos auditados que falten (no borra respuestas)."/>
                    <button name="action_open_report_document" type="object"
                            string="Ver informe" icon="fa-file-pdf-o"
                            invisible="not report_document_id"/>
                    <button name="action_evaluate_auditors" type="object"
                            string="Evaluar al auditor" icon="fa-star-o"
                            invisible="state not in ('informe', 'cerrada')"
                            help="Abre la encuesta de evaluación del comportamiento del auditor (sustituye el formato anterior; ver Del Dropbox a Odoo); la contesta el auditado."/>
                    <button name="action_draft" confirm="La auditoría regresa a borrador y vuelve a editarse. ¿Desea continuar?" type="object" string="Regresar a borrador"
                            invisible="state in ('borrador','cerrada')" groups="quimibond_sgi.group_sgi_auditor,quimibond_sgi.group_sgi_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- V-A03 (57.41.0): cerrado es evidencia; solo el Jefe MAST lo edita. -->
                    <widget name="web_ribbon" title="Cerrada" bg_color="text-bg-secondary"
                            invisible="state != 'cerrada'"/>
                    <field name="sgi_is_locked" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_findings" type="object"
                                class="oe_stat_button" icon="fa-search">
                            <field name="finding_count" widget="statinfo" string="Hallazgos"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-square-o" disabled="1">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="checklist_answered_count"/>/<field name="checklist_count"/></span>
                                <span class="o_stat_text">Checklist</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="sgi_heading" readonly="1"/></h1>
                        <h3><field name="folio" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Alcance">
                            <field name="audit_type" readonly="sgi_is_locked"/>
                            <field name="partner_id" readonly="sgi_is_locked" invisible="audit_type not in ('cliente', 'proveedor')"
                                   required="audit_type in ('cliente', 'proveedor')"/>
                            <field name="external_report_ref" readonly="sgi_is_locked" invisible="audit_type != 'cliente'"/>
                            <field name="norm_ids" readonly="sgi_is_locked" widget="many2many_tags"/>
                            <field name="process_ids" readonly="sgi_is_locked" widget="many2many_tags"/>
                            <field name="program_line_id" readonly="1"/>
                        </group>
                        <group string="Equipo y fechas">
                            <field name="lead_auditor_id" readonly="sgi_is_locked"/>
                            <field name="auditor_ids" readonly="sgi_is_locked" widget="many2many_tags"/>
                            <field name="auditee_ids" readonly="sgi_is_locked" widget="many2many_tags"/>
                            <field name="date_planned" readonly="sgi_is_locked"/>
                            <field name="date_start" readonly="sgi_is_locked"/>
                            <field name="date_end" readonly="sgi_is_locked"/>
                        </group>
                    </group>
                    <field name="report_document_id" invisible="1"/>
                    <notebook>
                        <page string="Checklist" name="checklist">
                            <div class="text-muted mb-2">
                                Una pregunta por actividad de cada proceso auditado, con los puntos
                                de la norma que cumple, y una por cada punto de las normas de la
                                auditoría sin actividad en el SGI (se genera al planificar). «Ver registros» abre la evidencia real del entregable;
                                cada respuesta distinta de Conforme crea su hallazgo.
                            </div>
                            <field name="checklist_line_ids" readonly="(state in ('borrador', 'cerrada')) or sgi_is_locked">
                                <list editable="bottom" create="0"
                                      decoration-danger="answer in ('nc_mayor', 'nc_menor')"
                                      decoration-warning="answer == 'observacion'"
                                      decoration-success="answer == 'conforme'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="process_id" optional="show"/>
                                    <field name="question"/>
                                    <field name="norm_clause_ids" widget="many2many_tags" optional="show"/>
                                    <field name="executor" optional="show"/>
                                    <field name="deliverables" optional="show"/>
                                    <field name="can_open_records" column_invisible="1"/>
                                    <button name="action_open_records" type="object" string="Ver registros"
                                            icon="fa-database" invisible="not can_open_records"/>
                                    <field name="answer"/>
                                    <field name="evidence"/>
                                    <field name="finding_id" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Hallazgos">
                            <field name="finding_ids" readonly="sgi_is_locked" context="{'default_audit_id': id}">
                                <list editable="bottom">
                                    <field name="finding_type"/>
                                    <field name="norm_clause_id"/>
                                    <field name="process_id"/>
                                    <field name="description"/>
                                    <field name="disposition"/>
                                    <field name="reason_no_action"
                                           invisible="disposition != 'sin_accion'"/>
                                    <field name="alert_id" readonly="1"/>
                                    <button name="action_generate_nc" type="object"
                                            string="Generar NC" icon="fa-exclamation-triangle"
                                            invisible="alert_id or finding_type in ('conformidad','oportunidad')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reuniones">
                            <div class="text-muted mb-2">
                                Los asistentes son los de «Equipo y fechas»;
                                aquí quedan las actas de apertura y de cierre. Sustituyen
                                los formatos anteriores (ver Del Dropbox a Odoo).
                            </div>
                            <group>
                                <field name="opening_minutes" readonly="sgi_is_locked"
                                       placeholder="Apertura: alcance confirmado, agenda, criterios, acuerdos..."/>
                                <field name="closing_minutes" readonly="sgi_is_locked"
                                       placeholder="Cierre: hallazgos presentados, conclusión, plazos de respuesta..."/>
                            </group>
                        </page>
                        <page string="Conclusión">
                            <field name="conclusion" readonly="sgi_is_locked" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_audit_view_list" model="ir.ui.view">
        <field name="name">sgi.audit.list</field>
        <field name="model">sgi.audit</field>
        <field name="arch" type="xml">
            <list string="Auditorías" decoration-muted="state == 'borrador'" decoration-info="state in ('planificada', 'en_ejecucion', 'informe')" decoration-success="state == 'cerrada'">
                <!-- V-M14 (57.80.0): qué se auditó, a quién y cuándo terminó. -->
                <field name="folio"/>
                <field name="audit_type"/>
                <field name="process_ids" widget="many2many_tags"/>
                <field name="partner_id" optional="hide"/>
                <field name="date_planned"/>
                <field name="date_end" optional="show"/>
                <field name="lead_auditor_id" widget="many2one_avatar_user"/>
                <field name="finding_count"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'borrador'"
                       decoration-info="state in ('planificada', 'en_ejecucion', 'informe')"
                       decoration-success="state == 'cerrada'"/>
            </list>
        </field>
    </record>

    <record id="sgi_audit_view_search" model="ir.ui.view">
        <field name="name">sgi.audit.search</field>
        <field name="model">sgi.audit</field>
        <field name="arch" type="xml">
            <search string="Auditorías">
                <field name="folio"/>
                <field name="lead_auditor_id"/>
                <field name="process_ids"/>
                <filter name="open" string="En curso"
                        domain="[('state','not in',('cerrada',))]"/>
                <!-- V-M03 (57.43.0): «Míos» y filtro de fecha nativo. -->
                <separator/>
                <filter name="mine" string="Mías"
                        domain="['|', '|', ('lead_auditor_id', '=', uid), ('auditor_ids', 'in', uid), ('auditee_ids', 'in', uid)]"/>
                <filter name="filter_date_planned" string="Fecha planificada" date="date_planned"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'audit_type'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- V-B12 (57.80.0): las auditorías en el calendario por fecha
         planificada, con color por estado. -->
    <record id="sgi_audit_view_calendar" model="ir.ui.view">
        <field name="name">sgi.audit.calendar</field>
        <field name="model">sgi.audit</field>
        <field name="arch" type="xml">
            <calendar string="Auditorías" date_start="date_planned" color="state"
                      mode="month" quick_create="0" event_open_popup="0">
                <field name="audit_type"/>
                <field name="lead_auditor_id"/>
                <field name="process_ids" widget="many2many_tags"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="sgi_audit_action" model="ir.actions.act_window">
        <field name="name">Auditorías</field>
        <field name="res_model">sgi.audit</field>
        <field name="view_mode">list,calendar,form,activity</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="search_view_id" ref="sgi_audit_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Programe la primera auditoría</p>
            <p>Folio AUD- automático, checklist que sale de las actividades de los procesos auditados y hallazgos convertibles en NC con un clic. Nadie puede auditar su propio proceso.</p>
        </field>
    </record>

    <!-- ================= HALLAZGOS ================= -->
    <record id="sgi_audit_finding_view_list" model="ir.ui.view">
        <field name="name">sgi.audit.finding.list</field>
        <field name="model">sgi.audit.finding</field>
        <field name="arch" type="xml">
            <list string="Hallazgos">
                <field name="audit_id"/>
                <field name="finding_type"/>
                <field name="norm_clause_id"/>
                <field name="process_id"/>
                <field name="description"/>
                <field name="disposition"/>
                <field name="alert_id" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="sgi_audit_view_activity" model="ir.ui.view">
        <field name="name">sgi.audit.activity</field>
        <field name="model">sgi.audit</field>
        <field name="arch" type="xml">
            <activity string="Auditorías">
                <templates>
                    <div t-name="activity-box">
                        <div><field name="display_name" display="full"/></div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>
</odoo>
