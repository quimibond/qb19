<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sgi_diagnostic_view_form" model="ir.ui.view">
        <field name="name">sgi.diagnostic.form</field>
        <field name="model">sgi.diagnostic</field>
        <field name="arch" type="xml">
            <form string="Diagnóstico del SGI">
                <sheet>
                    <field name="result" nolabel="1" readonly="1"/>
                </sheet>
                <footer>
                    <button name="action_refresh" type="object" string="Actualizar"
                            icon="fa-refresh" class="btn-primary"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sgi_diagnostic_action" model="ir.actions.act_window">
        <field name="name">Diagnóstico del SGI</field>
        <field name="res_model">sgi.diagnostic</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
