<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sgi_msa_study_view_form" model="ir.ui.view">
        <field name="name">sgi.msa.study.form</field>
        <field name="model">sgi.msa.study</field>
        <field name="arch" type="xml">
            <form string="Estudio MSA">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="folio" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Sistema de medición">
                            <field name="equipment_id"/>
                            <field name="point_id"/>
                            <field name="characteristic"/>
                            <field name="date"/>
                        </group>
                        <group string="Resultado">
                            <field name="study_type"/>
                            <field name="grr_pct" invisible="study_type != 'grr_variable'"/>
                            <field name="ndc" invisible="study_type != 'grr_variable'"/>
                            <field name="verdict" widget="badge"
                                   decoration-success="verdict == 'aceptable'"
                                   decoration-warning="verdict == 'marginal'"
                                   decoration-danger="verdict == 'inaceptable'"/>
                        </group>
                    </group>
                    <group string="Notas / referencia del reporte">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_msa_study_view_list" model="ir.ui.view">
        <field name="name">sgi.msa.study.list</field>
        <field name="model">sgi.msa.study</field>
        <field name="arch" type="xml">
            <list string="Estudios MSA"
                  decoration-danger="verdict == 'inaceptable'"
                  decoration-warning="verdict == 'marginal'">
                <field name="folio"/>
                <field name="equipment_id"/>
                <field name="study_type"/>
                <field name="date"/>
                <field name="grr_pct"/>
                <field name="ndc" optional="hide"/>
                <field name="verdict" widget="badge"
                       decoration-success="verdict == 'aceptable'"
                       decoration-warning="verdict == 'marginal'"
                       decoration-danger="verdict == 'inaceptable'"/>
            </list>
        </field>
    </record>

    <record id="sgi_msa_study_view_search" model="ir.ui.view">
        <field name="name">sgi.msa.study.search</field>
        <field name="model">sgi.msa.study</field>
        <field name="arch" type="xml">
            <search string="Estudios MSA">
                <field name="folio"/>
                <field name="equipment_id"/>
                <filter name="inaceptables" string="Inaceptables"
                        domain="[('verdict','=','inaceptable')]"/>
                <group>
                    <filter name="group_equipment" string="Equipo"
                            context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_type" string="Tipo de estudio"
                            context="{'group_by': 'study_type'}"/>
                    <filter name="group_verdict" string="Veredicto"
                            context="{'group_by': 'verdict'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_msa_study_action" model="ir.actions.act_window">
        <field name="name">Estudios MSA</field>
        <field name="res_model">sgi.msa.study</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sgi_msa_study_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra un estudio MSA</p>
            <p>IATF 7.1.5.1.1: Gage R&amp;R con umbrales AIAG (&lt;10% aceptable, 10-30% marginal, &gt;30% inaceptable). Un veredicto inaceptable agenda actividad al Jefe MAST.</p>
        </field>
    </record>

    <!-- Smart button MSA en el equipo de medición -->
    <record id="sgi_equipment_view_form_msa" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.sgi.msa</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sgi_msa" type="object" class="oe_stat_button"
                        icon="fa-balance-scale" invisible="not sgi_is_measuring">
                    <field name="sgi_msa_count" widget="statinfo" string="MSA"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
