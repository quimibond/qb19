<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= CALIBRACIÓN ================= -->
    <record id="sgi_calibration_view_form" model="ir.ui.view">
        <field name="name">sgi.calibration.form</field>
        <field name="model">sgi.calibration</field>
        <field name="arch" type="xml">
            <form string="Calibración">
                <sheet>
                    <div class="oe_title">
                        <label for="equipment_id" string="Equipo"/>
                        <h1><field name="equipment_id" placeholder="Equipo de medición"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="calibration_type"/>
                            <field name="provider_id"/>
                        </group>
                        <group>
                            <field name="certificate_ref"/>
                            <field name="certificate_file" filename="certificate_filename"/>
                            <field name="certificate_filename" invisible="1"/>
                            <field name="result" widget="badge"
                                   decoration-success="result == 'conforme'"
                                   decoration-danger="result == 'fuera_tolerancia'"/>
                            <field name="next_date"/>
                            <field name="sgi_alert_id" readonly="1"
                                   invisible="not sgi_alert_id"/>
                        </group>
                    </group>
                    <div class="text-muted mb-2">
                        Un resultado <b>Fuera de tolerancia</b> marca el equipo
                        como NO USAR y genera la NC de evaluación de impacto
                        (qué producto se midió con él). La <b>Próxima fecha</b>
                        actualiza el semáforo del equipo: avisa 30 días antes
                        y al vencer también lo bloquea.
                    </div>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_calibration_view_list" model="ir.ui.view">
        <field name="name">sgi.calibration.list</field>
        <field name="model">sgi.calibration</field>
        <field name="arch" type="xml">
            <list string="Calibraciones"
                  decoration-danger="result == 'fuera_tolerancia'">
                <field name="date"/>
                <field name="equipment_id"/>
                <field name="calibration_type"/>
                <field name="provider_id"/>
                <field name="certificate_ref"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'conforme'"
                       decoration-danger="result == 'fuera_tolerancia'"/>
                <field name="next_date" widget="remaining_days"/>
            </list>
        </field>
    </record>

    <record id="sgi_calibration_view_search" model="ir.ui.view">
        <field name="name">sgi.calibration.search</field>
        <field name="model">sgi.calibration</field>
        <field name="arch" type="xml">
            <search string="Calibraciones">
                <field name="equipment_id"/>
                <field name="provider_id"/>
                <field name="certificate_ref"/>
                <filter name="fuera" string="Fuera de tolerancia"
                        domain="[('result','=','fuera_tolerancia')]"/>
                <!-- V-M02/V-M03 (57.43.0): lo que vence y filtro de fecha nativo. -->
                <filter name="due" string="Próximas a vencer"
                        domain="[('equipment_id.sgi_calibration_state', 'in', ('vencido', 'por_vencer'))]"
                        help="Calibraciones de equipos vencidos o que vencen en 30 días."/>
                <separator/>
                <filter name="filter_date" string="Fecha de calibración" date="date"/>
                <filter name="filter_next_date" string="Próxima fecha" date="next_date"/>
                <group>
                    <filter name="group_equipment" string="Equipo" context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_result" string="Resultado" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_calibration_action" model="ir.actions.act_window">
        <field name="name">Calibraciones</field>
        <field name="res_model">sgi.calibration</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_due': 1}</field>
        <field name="search_view_id" ref="sgi_calibration_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre la primera calibración</p>
            <p>Equipo vencido o fuera de tolerancia queda NO USAR automáticamente; fuera de tolerancia genera la NC de evaluación de impacto.</p>
        </field>
    </record>

    <!-- ================= maintenance.equipment: extensión SGI ================= -->
    <record id="sgi_equipment_view_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.sgi</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_calibrations" type="object" class="oe_stat_button"
                        icon="fa-check-square-o" invisible="not sgi_is_measuring"
                        groups="quimibond_sgi.group_sgi_user">
                    <field name="sgi_calibration_count" widget="statinfo" string="Calibraciones"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Metrología / EPP (SGI)" name="sgi_metrology">
                    <group>
                        <group string="Equipo de medición">
                            <field name="sgi_is_measuring"/>
                            <field name="sgi_magnitude" invisible="not sgi_is_measuring"/>
                            <field name="sgi_range" invisible="not sgi_is_measuring"/>
                            <field name="sgi_resolution" invisible="not sgi_is_measuring"/>
                            <field name="sgi_calibration_interval_months"
                                   invisible="not sgi_is_measuring"/>
                            <field name="sgi_last_calibration_date"
                                   invisible="not sgi_is_measuring"/>
                            <field name="sgi_next_calibration_date"
                                   invisible="not sgi_is_measuring"/>
                            <field name="sgi_calibration_state" widget="badge"
                                   decoration-success="sgi_calibration_state == 'vigente'"
                                   decoration-warning="sgi_calibration_state == 'por_vencer'"
                                   decoration-danger="sgi_calibration_state == 'vencido'"
                                   invisible="not sgi_is_measuring"/>
                            <field name="sgi_do_not_use"
                                   invisible="not sgi_is_measuring"/>
                        </group>
                        <group string="Equipo de protección personal (EPP)">
                            <field name="sgi_is_ppe"/>
                            <field name="sgi_ppe_expiry_date" invisible="not sgi_is_ppe"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sgi_equipment_view_list_sgi" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.sgi</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="sgi_calibration_state" optional="hide" widget="badge"/>
                <field name="sgi_do_not_use" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- 57.43.0 (V-A09): lista y búsqueda propias de metrología. Antes la
         acción usaba la lista estándar de equipos, con el semáforo y el «NO
         USAR» ocultos. Vistas primarias con prioridad alta: no le ganan a las de
         Mantenimiento en su app. -->
    <record id="sgi_equipment_view_list_measuring" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.sgi.measuring</field>
        <field name="model">maintenance.equipment</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Equipos de medición" decoration-danger="sgi_do_not_use"
                  decoration-warning="sgi_calibration_state == 'por_vencer'">
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="serial_no" optional="hide"/>
                <field name="sgi_magnitude" optional="show"/>
                <field name="sgi_last_calibration_date" optional="show"/>
                <field name="sgi_next_calibration_date" widget="remaining_days"/>
                <field name="sgi_calibration_state" widget="badge"
                       decoration-success="sgi_calibration_state == 'vigente'"
                       decoration-warning="sgi_calibration_state == 'por_vencer'"
                       decoration-danger="sgi_calibration_state == 'vencido'"/>
                <field name="sgi_do_not_use" string="NO USAR" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="sgi_equipment_view_search_measuring" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.sgi.measuring</field>
        <field name="model">maintenance.equipment</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search string="Equipos de medición">
                <field name="name"/>
                <field name="category_id"/>
                <field name="serial_no"/>
                <field name="sgi_magnitude"/>
                <filter name="sgi_due" string="Vencido o por vencer"
                        domain="[('sgi_calibration_state', 'in', ('vencido', 'por_vencer'))]"/>
                <separator/>
                <filter name="sgi_expired" string="Vencido"
                        domain="[('sgi_calibration_state', '=', 'vencido')]"/>
                <filter name="sgi_expiring" string="Por vencer"
                        domain="[('sgi_calibration_state', '=', 'por_vencer')]"/>
                <filter name="sgi_blocked" string="No usar"
                        domain="[('sgi_do_not_use', '=', True)]"/>
                <separator/>
                <filter name="sgi_next_date" string="Próxima calibración" date="sgi_next_calibration_date"/>
                <group>
                    <filter name="group_state" string="Estado de calibración"
                            context="{'group_by': 'sgi_calibration_state'}"/>
                    <filter name="group_category" string="Categoría" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_equipment_action_measuring" model="ir.actions.act_window">
        <field name="name">Equipos de medición</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,sgi_diagram,form</field>
        <field name="domain">[('sgi_is_measuring', '=', True)]</field>
        <field name="context">{'default_sgi_is_measuring': True, 'search_default_sgi_due': 1}</field>
        <field name="search_view_id" ref="sgi_equipment_view_search_measuring"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_equipment_view_list_measuring')}),
            (0, 0, {'view_mode': 'sgi_diagram'}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Dé de alta los equipos de medición</p>
            <p>Con su frecuencia de calibración; el semáforo avisa los vencimientos 30 días antes.</p>
        </field>
    </record>
</odoo>
