<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Documentos externos (E2.36, 56.21.0): emisor, revisión del emisor,
         recepción, proceso dueño e implantación en 10 días hábiles. -->
    <record id="sgi_external_doc_view_list" model="ir.ui.view">
        <field name="name">sgi.external.document.list</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <list string="Documentos externos" default_order="sgi_ext_received_date desc"
                  decoration-danger="sgi_ext_state == 'vencido'"
                  decoration-muted="sgi_state == 'obsoleto'">
                <field name="sgi_code"/>
                <field name="name"/>
                <field name="sgi_ext_issuer"/>
                <field name="sgi_ext_issuer_revision"/>
                <field name="sgi_ext_received_date"/>
                <field name="sgi_process_id" string="Proceso dueño"/>
                <field name="sgi_ext_deadline"/>
                <field name="sgi_ext_implemented_date" optional="show"/>
                <field name="sgi_ext_state" widget="badge"
                       decoration-success="sgi_ext_state == 'implantado'"
                       decoration-warning="sgi_ext_state == 'por_implantar'"
                       decoration-danger="sgi_ext_state == 'vencido'"/>
                <field name="sgi_state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sgi_external_doc_view_search" model="ir.ui.view">
        <field name="name">sgi.external.document.search</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <search string="Documentos externos">
                <field name="name"/>
                <field name="sgi_code"/>
                <field name="sgi_ext_issuer"/>
                <field name="sgi_process_id"/>
                <filter name="por_implantar" string="Por implantar"
                        domain="[('sgi_ext_state', 'in', ('por_implantar', 'vencido'))]"/>
                <filter name="vencido" string="Vencidos" domain="[('sgi_ext_state', '=', 'vencido')]"/>
                <separator/>
                <filter name="vigente" string="Vigentes" domain="[('sgi_state', '=', 'vigente')]"/>
                <group>
                    <filter name="group_issuer" string="Emisor" context="{'group_by': 'sgi_ext_issuer'}"/>
                    <filter name="group_process" string="Proceso dueño" context="{'group_by': 'sgi_process_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_external_doc_action" model="ir.actions.act_window">
        <field name="name">Documentos externos</field>
        <field name="res_model">documents.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sgi_doc_type_id.code', '=', 'externo')]</field>
        <field name="context">{'default_sgi_is_controlled': True, 'default_sgi_doc_type': 'externo',
                               'search_default_por_implantar': 1}</field>
        <field name="search_view_id" ref="sgi_external_doc_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_external_doc_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sgi_document_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra el primer documento externo</p>
            <p>Norma, especificación de cliente, NOM o manual de proveedor: quién lo emite, su revisión, cuándo llegó y qué proceso lo aplica. Hay 10 días hábiles desde la recepción para implantarlo; el dueño del proceso recibe el aviso.</p>
        </field>
    </record>

</odoo>
