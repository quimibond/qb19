<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 56.3.0: «Mis pendientes» en una sola lista con semáforo.
         57.145.0 (rediseño): renglones guardados, un «Hecho» que sabe qué
         hacer según el tipo, ficha del pendiente (form) y recarga estándar:
         cada botón devuelve una notificación con act_window_close, la vista
         recarga sola. «Vence» con remaining_days («Hace 3 días», «Hoy»). -->
    <record id="sgi_my_pending_view_list" model="ir.ui.view">
        <field name="name">sgi.my.pending.list</field>
        <field name="model">sgi.my.pending</field>
        <field name="arch" type="xml">
            <list string="Mis pendientes" create="0" edit="0" delete="0" expand="1"
                  default_order="state_rank, date_due, id"
                  decoration-danger="state == 'atrasada'" decoration-warning="state == 'por_vencer'">
                <!-- 57.92.0 (U-02): validar en lote las mediciones seleccionadas. -->
                <header>
                    <button name="action_validate_selected" type="object"
                            string="Validar seleccionadas" class="btn-primary"/>
                    <!-- 57.150.0: acuses en lote (solo los propios). -->
                    <button name="action_sign_ack_selected" type="object" string="Leído y entendido (seleccionados)"
                            confirm="¿Confirma que leyó y entendió los documentos seleccionados? Sus acuses quedan registrados con la fecha de hoy."/>
                </header>
                <field name="state_rank" column_invisible="1"/>
                <field name="is_mine" column_invisible="1"/>
                <field name="can_done" column_invisible="1"/>
                <field name="can_mark_exec" column_invisible="1"/>
                <field name="res_model" column_invisible="1"/>
                <field name="employee_id" string="Persona" optional="hide"/>
                <field name="kind" string="Tipo" widget="badge"/>
                <field name="name" string="Qué"/>
                <!-- 57.168.0: lo repetido va junto en un renglón. -->
                <field name="group_count" string="Cuántos" optional="show" invisible="not group_count"/>
                <field name="process_id" string="Proceso" optional="show"/>
                <field name="date_due" string="Vence" widget="remaining_days"/>
                <field name="state" string="Estado" widget="badge"
                       decoration-danger="state == 'atrasada'"
                       decoration-warning="state == 'por_vencer'"
                       decoration-success="state == 'al_dia'"/>
                <!-- 57.103.0: avance de las actividades del periodo. -->
                <field name="exec_state" string="Avance" widget="badge" optional="show"
                       decoration-info="exec_state == 'en_proceso'"/>
                <!-- 57.174.0 (interfaz, entrega 5): «Qué sigue» dice con palabras lo
                     que toca, y cada renglón lleva dos botones: el del tipo (a lo
                     más uno visible) y uno para abrir. Rechazar, «No corresponde»,
                     «En proceso» y «Posponer» viven en la ficha del pendiente. -->
                <field name="next_step" string="Qué sigue" optional="show"/>
                <button name="action_done" type="object" string="Hecho" icon="fa-check"
                        class="btn-link text-success" invisible="not can_done or kind in ('nc', 'legal', 'documento', 'solicitud', 'aprobacion', 'revision')"/>
                <button name="action_nc_step" type="object" string="Registrar paso" icon="fa-check"
                        class="btn-link text-success" invisible="kind != 'nc' or not can_done"/>
                <button name="action_legal_evaluate" type="object" string="Evaluar" icon="fa-check"
                        class="btn-link text-success" invisible="kind != 'legal' or not can_done"/>
                <button name="action_doc_review" type="object" string="Revisar" icon="fa-check"
                        class="btn-link text-success" invisible="kind != 'documento' or not can_done"/>
                <button name="action_request_approve" type="object" string="Aprobar" icon="fa-check"
                        class="btn-link text-success" invisible="kind != 'solicitud' or not can_done"
                        confirm="¿Aprueba esta solicitud? Queda registrado a su nombre."/>
                <button name="action_rule_approve" type="object" string="Aprobar" icon="fa-check"
                        class="btn-link text-success" invisible="kind != 'aprobacion' or not can_done"
                        confirm="¿Aprueba esta solicitud? Queda registrado a su nombre."/>
                <button name="action_validate_measure" type="object" string="Validar" icon="fa-check"
                        class="btn-link text-success" invisible="kind != 'validacion'"/>
                <button name="action_sign_ack" type="object" string="Leído y entendido" icon="fa-check"
                        class="btn-link text-success" invisible="kind != 'acuse' or not is_mine or group_count"
                        confirm="¿Confirma que leyó y entendió este documento? Su acuse queda registrado con la fecha de hoy."/>
                <!-- Abrir: el verbo cambia con el tipo; siempre uno solo. -->
                <button name="action_open" type="object" string="Ir a hacerlo" icon="fa-play"
                        invisible="kind not in ('actividad', 'escalamiento', 'flujo') or group_count"/>
                <button name="action_open" type="object" string="Leer el documento" icon="fa-book"
                        invisible="kind != 'acuse' or group_count"/>
                <button name="action_open" type="object" string="Firmar" icon="fa-pencil"
                        invisible="kind != 'firma' or group_count"/>
                <button name="action_open" type="object" string="Capturar" icon="fa-pencil-square-o"
                        invisible="kind != 'medicion' or group_count"/>
                <button name="action_open" type="object" string="Abrir" icon="fa-external-link"
                        invisible="kind in ('actividad', 'escalamiento', 'flujo', 'acuse', 'firma', 'medicion') and not group_count"/>
            </list>
        </field>
    </record>

    <!-- 57.94.0 (I-05): en el celular y la tableta, una tarjeta por pendiente
         con el botón grande. Mismas condiciones que la lista. -->
    <record id="sgi_my_pending_view_kanban" model="ir.ui.view">
        <field name="name">sgi.my.pending.kanban</field>
        <field name="model">sgi.my.pending</field>
        <field name="arch" type="xml">
            <kanban create="0" default_order="state_rank, date_due, id">
                <field name="state_rank"/>
                <field name="is_mine"/>
                <field name="kind"/>
                <field name="can_done"/>
                <field name="can_mark_exec"/>
                <field name="can_snooze"/>
                <field name="res_model"/>
                <field name="exec_state"/>
                <field name="exec_note"/>
                <field name="group_count"/>
                <field name="next_step"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fs-5 fw-bold"/>
                        <div class="text-muted"><field name="kind"/> · <field name="process_id"/></div>
                        <div>Vence: <field name="date_due" widget="remaining_days"/></div>
                        <div class="text-muted"><field name="next_step"/></div>
                        <div t-if="record.exec_state.raw_value == 'en_proceso'" class="text-info">
                            En proceso<t t-if="record.exec_note.raw_value">: <field name="exec_note"/></t>
                        </div>
                        <footer class="d-flex flex-wrap gap-2 pt-2">
                            <field name="state" widget="badge"
                                   decoration-danger="state == 'atrasada'"
                                   decoration-warning="state == 'por_vencer'"
                                   decoration-success="state == 'al_dia'"/>
                            <!-- 57.174.0: un botón del tipo (btn-primary) y uno para abrir. -->
                            <button name="action_done" type="object" string="Hecho"
                                    class="btn btn-primary btn-lg" invisible="not can_done or kind in ('nc', 'legal', 'documento', 'solicitud', 'aprobacion', 'revision')"/>
                            <button name="action_nc_step" type="object" string="Registrar paso" class="btn btn-primary btn-lg" invisible="kind != 'nc' or not can_done"/>
                            <button name="action_legal_evaluate" type="object" string="Evaluar" class="btn btn-primary btn-lg" invisible="kind != 'legal' or not can_done"/>
                            <button name="action_doc_review" type="object" string="Revisar" class="btn btn-primary btn-lg" invisible="kind != 'documento' or not can_done"/>
                            <button name="action_request_approve" type="object" string="Aprobar" class="btn btn-primary btn-lg" invisible="kind != 'solicitud' or not can_done" confirm="¿Aprueba esta solicitud? Queda registrado a su nombre."/>
                            <button name="action_rule_approve" type="object" string="Aprobar" class="btn btn-primary btn-lg" invisible="kind != 'aprobacion' or not can_done" confirm="¿Aprueba esta solicitud? Queda registrado a su nombre."/>
                            <button name="action_validate_measure" type="object" string="Validar"
                                    class="btn btn-primary btn-lg" invisible="kind != 'validacion'"/>
                            <button name="action_sign_ack" type="object" string="Leído y entendido"
                                    class="btn btn-primary btn-lg" invisible="kind != 'acuse' or not is_mine or group_count"
                                    confirm="¿Confirma que leyó y entendió este documento? Su acuse queda registrado con la fecha de hoy."/>
                            <button name="action_open" type="object" string="Ir a hacerlo" class="btn btn-secondary btn-lg"
                                    invisible="kind not in ('actividad', 'escalamiento', 'flujo') or group_count"/>
                            <button name="action_open" type="object" string="Leer el documento" class="btn btn-secondary btn-lg"
                                    invisible="kind != 'acuse' or group_count"/>
                            <button name="action_open" type="object" string="Firmar" class="btn btn-secondary btn-lg"
                                    invisible="kind != 'firma' or group_count"/>
                            <button name="action_open" type="object" string="Capturar" class="btn btn-secondary btn-lg"
                                    invisible="kind != 'medicion' or group_count"/>
                            <button name="action_open" type="object" string="Abrir" class="btn btn-secondary btn-lg"
                                    invisible="kind in ('actividad', 'escalamiento', 'flujo', 'acuse', 'firma', 'medicion') and not group_count"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 57.145.0: la ficha del pendiente. Qué hay que hacer, sobre qué registro,
         cuándo vence y todas las formas de actuar. Solo lectura: los cambios
         van por los botones. -->
    <record id="sgi_my_pending_view_form" model="ir.ui.view">
        <field name="name">sgi.my.pending.form</field>
        <field name="model">sgi.my.pending</field>
        <field name="arch" type="xml">
            <form string="Pendiente" create="0" edit="0" delete="0">
                <header>
                    <button name="action_done" type="object" string="Hecho" class="btn-primary"
                            icon="fa-check" invisible="not can_done or kind in ('nc', 'legal', 'documento', 'solicitud', 'aprobacion', 'revision')"/>
                    <!-- 57.150.0 (auditoría UX, fase 2): cada tipo con su acción real. -->
                    <button name="action_nc_step" type="object" string="Registrar paso" class="btn-primary" invisible="kind != 'nc' or not can_done"/>
                    <button name="action_legal_evaluate" type="object" string="Evaluar" class="btn-primary" invisible="kind != 'legal' or not can_done"/>
                    <button name="action_doc_review" type="object" string="Revisar" class="btn-primary" invisible="kind != 'documento' or not can_done"/>
                    <button name="action_request_approve" type="object" string="Aprobar" class="btn-primary" invisible="kind != 'solicitud' or not can_done" confirm="¿Aprueba esta solicitud? Queda registrado a su nombre."/>
                    <button name="action_request_refuse" type="object" string="Rechazar" invisible="kind != 'solicitud' or not can_done" confirm="¿Rechaza esta solicitud? Queda registrado a su nombre."/>
                    <button name="action_rule_approve" type="object" string="Aprobar" class="btn-primary" invisible="kind != 'aprobacion' or not can_done" confirm="¿Aprueba esta solicitud? Queda registrado a su nombre."/>
                    <button name="action_rule_refuse" type="object" string="Rechazar" invisible="kind != 'aprobacion' or not can_done" confirm="¿Rechaza esta solicitud? Queda registrado a su nombre."/>
                    <button name="action_review_confirm" type="object" string="Sí, es lo que hago" class="btn-primary" invisible="kind != 'revision' or not can_done"/>
                    <button name="action_review_not_matching" type="object" string="No corresponde" invisible="kind != 'revision' or not can_done"/>
                    <button name="action_exec_progress" type="object" string="En proceso"
                            icon="fa-hourglass-half" invisible="not can_mark_exec"/>
                    <button name="action_exec_not_applicable" type="object" string="No aplica este periodo"
                            invisible="not can_mark_exec"/>
                    <button name="action_validate_measure" type="object" string="Validar" class="btn-primary"
                            icon="fa-check" invisible="kind != 'validacion'"/>
                    <button name="action_sign_ack" type="object" string="Leído y entendido" class="btn-primary"
                            icon="fa-check" invisible="kind != 'acuse' or not is_mine"
                            confirm="¿Confirma que leyó y entendió este documento? Su acuse queda registrado con la fecha de hoy."/>
                    <button name="action_snooze_notice" type="object" string="Posponer una semana"
                            icon="fa-clock-o" invisible="not can_snooze"
                            confirm="¿Pospone este aviso una semana (5 días hábiles)? La fecha límite del aviso cambia en Odoo."/>
                </header>
                <sheet>
                    <field name="is_mine" invisible="1"/>
                    <field name="can_done" invisible="1"/>
                    <field name="can_mark_exec" invisible="1"/>
                    <field name="can_snooze" invisible="1"/>
                    <field name="res_model" invisible="1"/>
                    <field name="group_count" invisible="1"/>
                    <!-- 57.174.0: abrir el registro es navegación: botón inteligente. -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open" type="object" class="oe_stat_button" icon="fa-play"
                                string="Ir a hacerlo" invisible="kind not in ('actividad', 'escalamiento', 'flujo') or group_count"/>
                        <button name="action_open" type="object" class="oe_stat_button" icon="fa-book"
                                string="Leer el documento" invisible="kind != 'acuse' or group_count"/>
                        <button name="action_open" type="object" class="oe_stat_button" icon="fa-pencil"
                                string="Firmar" invisible="kind != 'firma' or group_count"/>
                        <button name="action_open" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                string="Capturar" invisible="kind != 'medicion' or group_count"/>
                        <button name="action_open" type="object" class="oe_stat_button" icon="fa-external-link"
                                invisible="kind in ('actividad', 'escalamiento', 'flujo', 'acuse', 'firma', 'medicion') and not group_count">
                            <div class="o_stat_info">
                                <span class="o_stat_value" invisible="not group_count"><field name="group_count"/></span>
                                <span class="o_stat_text">Abrir</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Pendiente">
                            <field name="kind" widget="badge"/>
                            <field name="process_id"/>
                            <field name="employee_id"/>
                            <field name="source_name"/>
                            <field name="next_step"/>
                        </group>
                        <group string="Plazo">
                            <field name="date_due" widget="remaining_days"/>
                            <field name="state" widget="badge"
                                   decoration-danger="state == 'atrasada'"
                                   decoration-warning="state == 'por_vencer'"
                                   decoration-success="state == 'al_dia'"/>
                            <field name="exec_state" widget="badge" invisible="not exec_state"
                                   decoration-info="exec_state == 'en_proceso'"/>
                            <field name="exec_note" invisible="not exec_note"/>
                            <field name="exec_date_estimated" invisible="not exec_date_estimated"/>
                        </group>
                    </group>
                    <field name="nc_id" invisible="1"/>
                    <!-- 57.165.0: los pasos de la NC como campos con su estado. -->
                    <group string="Pasos de la NC" invisible="kind != 'nc' or not nc_id">
                        <group>
                            <field name="nc_containment_state" widget="badge" decoration-danger="nc_containment_state == 'vencida'"
                                   decoration-success="nc_containment_state == 'hecha'"/>
                            <field name="nc_due_containment"/>
                            <field name="nc_root_cause_state" widget="badge" decoration-danger="nc_root_cause_state == 'vencida'"
                                   decoration-success="nc_root_cause_state == 'hecha'"/>
                            <field name="nc_due_root_cause"/>
                        </group>
                        <group>
                            <field name="nc_plan_state" widget="badge" decoration-danger="nc_plan_state == 'vencida'"
                                   decoration-success="nc_plan_state == 'hecha'"/>
                            <field name="nc_due_plan"/>
                            <field name="nc_effectiveness_due"/>
                        </group>
                    </group>
                    <group string="Qué hay que hacer" invisible="not detail">
                        <field name="detail" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sgi_my_pending_view_search" model="ir.ui.view">
        <field name="name">sgi.my.pending.search</field>
        <field name="model">sgi.my.pending</field>
        <field name="arch" type="xml">
            <search string="Mis pendientes">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="process_id"/>
                <!-- 57.92.0 (U-02): filtro por omisión de Mis pendientes. -->
                <filter name="actionable" string="Atrasadas o por vencer"
                        domain="[('state', 'in', ('atrasada', 'por_vencer'))]"/>
                <filter name="late" string="Atrasadas" domain="[('state', '=', 'atrasada')]"/>
                <filter name="this_week" string="Vence esta semana"
                        domain="[('date_due', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_due', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="ok" string="Al día" domain="[('state', '=', 'al_dia')]"/>
                <!-- 57.170.0: aparte del estado (se unía con «o»). -->
                <separator/>
                <filter name="in_progress" string="En proceso" domain="[('exec_state', '=', 'en_proceso')]"/>
                <group>
                    <filter name="group_kind" string="Tipo" context="{'group_by': 'kind'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Persona" context="{'group_by': 'employee_id'}"/>
                </group>
                <!-- 57.174.0: los 15 tipos en el panel, con su número (antes 6 filtros sueltos). -->
                <searchpanel>
                    <field name="kind" string="Tipo" icon="fa-filter" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- D-14 (57.7.0): cada quien apaga su correo semanal de atrasados desde
         su perfil → Preferencias. -->
    <record id="sgi_res_users_view_form_preferences" model="ir.ui.view">
        <field name="name">res.users.preferences.sgi.weekly.overdue</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="sgi_weekly_overdue_mail" readonly="0"/>
                <field name="sgi_daily_pending_mail" readonly="0"/>
            </xpath>
        </field>
    </record>

    <!-- 57.150.0 (auditoría UX, fase 2): asistentes de Mis pendientes. -->
    <record id="sgi_nc_step_view_form" model="ir.ui.view">
        <field name="name">sgi.nc.step.form</field>
        <field name="model">sgi.nc.step</field>
        <field name="arch" type="xml">
            <form string="Registrar el paso de la NC">
                <field name="alert_id" invisible="1"/>
                <div class="alert alert-info" role="status">
                    <field name="plazos" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="step" widget="radio"/>
                    <field name="root_cause" invisible="step != 'causa'" required="step == 'causa'"
                           placeholder="Por qué pasó (5 porqués, Ishikawa)"/>
                    <field name="name" invisible="step == 'causa'" required="step != 'causa'"
                           placeholder="Qué se hace"/>
                    <field name="responsible_id" widget="many2one_avatar_user" invisible="step == 'causa'" required="step != 'causa'"/>
                    <field name="date_commit" invisible="step == 'causa'" required="step != 'causa'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sgi_doc_review_view_form" model="ir.ui.view">
        <field name="name">sgi.doc.review.form</field>
        <field name="model">sgi.doc.review</field>
        <field name="arch" type="xml">
            <form string="Revisar el documento">
                <field name="document_id" invisible="1"/>
                <group>
                    <field name="decision" widget="radio"/>
                    <field name="note" required="decision == 'vigente'"
                           placeholder="Con quién y contra qué se revisó"/>
                    <field name="next_review_date" invisible="decision != 'vigente'"/>
                </group>
                <div class="alert alert-info" role="status" invisible="decision != 'cambio'">
                    Al guardar se abre la solicitud de cambio documental ya apuntando a este documento.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
