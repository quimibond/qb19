<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ FLUJOS ============ -->
    <record id="sgi_process_flow_view_list" model="ir.ui.view">
        <field name="name">sgi.process.flow.list</field>
        <field name="model">sgi.process.flow</field>
        <field name="arch" type="xml">
            <list string="Flujos" create="0" decoration-muted="not active">
                <field name="active" column_invisible="1"/>
                <field name="from_process_id"/>
                <field name="name"/>
                <field name="to_process_id"/>
                <field name="document_id"/>
                <field name="odoo_model_id"/>
                <field name="origin" optional="show"/>
                <field name="inactive_reason" optional="hide"/>
                <button name="action_view_records" type="object" string="Ver registros"
                        icon="fa-external-link" invisible="not odoo_model_id"/>
            </list>
        </field>
    </record>

    <record id="sgi_process_flow_view_form" model="ir.ui.view">
        <field name="name">sgi.process.flow.form</field>
        <field name="model">sgi.process.flow</field>
        <field name="arch" type="xml">
            <form string="Flujo" create="0" edit="0">
                <header>
                    <button name="action_view_records" type="object"
                            string="Ver registros" class="btn-primary"
                            invisible="not odoo_model_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Anterior" bg_color="text-bg-secondary"
                            invisible="deliverable_id"/>
                    <widget name="web_ribbon" title="Apagado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="alert alert-info mb-3" role="status">
                        <b>¿Qué es un flujo?</b> Una <b>entrega entre dos procesos</b>.
                        Se calcula solo del <b>entregable</b>: sale de las actividades
                        que lo entregan y llega a las que lo reciben. Para cambiarlo,
                        cambia el entregable o las actividades.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Entregable"/>
                        <h1><field name="name" placeholder="¿Qué se entrega? (ej. Programa semanal F-P-A12-01)"/></h1>
                    </div>
                    <group>
                        <group string="La entrega">
                            <field name="from_process_id" string="Lo entrega (origen)"/>
                            <field name="to_process_id" string="Lo recibe (destino)"/>
                        </group>
                        <group string="Con qué">
                            <field name="deliverable_id"/>
                            <field name="document_id" string="Formato de entrega"/>
                            <field name="odoo_model_id" string="Dónde vive en Odoo"/>
                            <field name="active" invisible="1"/>
                            <field name="inactive_reason" invisible="active"/>
                        </group>
                    </group>
                    <group string="Criterio de aceptación (¿cuándo se recibe como buena la entrega?)">
                        <field name="acceptance_criteria" nolabel="1"
                               placeholder="Ej. MP sin liberar no se surte a producción; primera respuesta al cliente en ≤ 3 días…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sgi_process_flow_view_search" model="ir.ui.view">
        <field name="name">sgi.process.flow.search</field>
        <field name="model">sgi.process.flow</field>
        <field name="arch" type="xml">
            <search string="Flujos entre procesos">
                <field name="name"/>
                <field name="from_process_id"/>
                <field name="to_process_id"/>
                <filter name="vigentes" string="Mapa vigente"
                        domain="[('deliverable_id', '!=', False), ('from_process_id.active', '=', True), ('to_process_id.active', '=', True)]"
                        help="Solo los flujos calculados de entregables entre procesos activos."/>
                <separator/>
                <filter name="con_modelo" string="Viven en Odoo"
                        domain="[('odoo_model_id', '!=', False)]"/>
                <filter name="documentales" string="Documentales (sin modelo)"
                        domain="[('odoo_model_id', '=', False)]"/>
                <separator/>
                <filter name="manual" string="Capturados a mano (anteriores)"
                        domain="[('deliverable_id', '=', False)]"/>
                <filter name="inactive" string="Apagados o reemplazados"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_from" string="Proceso que entrega"
                            context="{'group_by': 'from_process_id'}"/>
                    <filter name="group_to" string="Proceso que recibe"
                            context="{'group_by': 'to_process_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ PROCESOS ============ -->
    <record id="sgi_process_view_kanban" model="ir.ui.view">
        <field name="name">sgi.process.kanban</field>
        <field name="model">sgi.process</field>
        <field name="arch" type="xml">
            <kanban default_group_by="process_type" sample="1" default_order="code">
                <field name="health"/>
                <field name="owner_valid"/>
                <field name="activity_green_count"/>
                <field name="activity_red_count"/>
                <field name="activity_grey_count"/>
                <field name="activity_count"/>
                <field name="nc_count"/>
                <field name="red_kpi_count"/>
                <field name="chain_stuck_count"/>
                <progressbar field="measure_status"
                             colors='{"verde": "success", "rojo": "danger", "gris": "muted"}'/>
                <templates>
                    <t t-name="card">
                        <widget name="web_ribbon" title="Dueño no válido" bg_color="text-bg-danger"
                                invisible="owner_valid"/>
                        <div class="d-flex align-items-baseline gap-1">
                            <span t-attf-class="badge #{record.health.raw_value == 'verde' ? 'text-bg-success' : (record.health.raw_value == 'rojo' ? 'text-bg-danger' : 'text-bg-warning')}"
                                  t-att-title="record.health.value">●</span>
                            <field name="code" class="fw-bold"/>
                            <field name="name" class="text-truncate fs-5"/>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <field name="owner_id" widget="many2one_avatar_employee"/>
                        </div>
                        <div class="progress mt-2" style="height: 8px;"
                             t-if="record.activity_count.raw_value"
                             t-att-title="record.activity_green_count.raw_value + ' en verde, ' + record.activity_red_count.raw_value + ' en rojo, ' + record.activity_grey_count.raw_value + ' sin evidencia aún'">
                            <div class="progress-bar bg-success"
                                 t-attf-style="width: #{record.activity_green_count.raw_value * 100 / record.activity_count.raw_value}%"/>
                            <div class="progress-bar bg-danger"
                                 t-attf-style="width: #{record.activity_red_count.raw_value * 100 / record.activity_count.raw_value}%"/>
                            <div class="progress-bar bg-secondary"
                                 t-attf-style="width: #{record.activity_grey_count.raw_value * 100 / record.activity_count.raw_value}%"/>
                        </div>
                        <footer class="pt-2 text-muted small flex-wrap gap-2">
                            <span title="Actividades medidas de verdad (Odoo + consecuencia)">
                                Medido: <field name="measure_real_pct"/>%
                            </span>
                            <span title="Adherencia promedio de quién ejecuta">
                                Adherencia: <field name="measure_adherence_avg"/>%
                            </span>
                            <span class="text-danger" t-if="record.nc_count.raw_value">
                                NC: <field name="nc_count"/>
                            </span>
                            <span class="text-danger" t-if="record.red_kpi_count.raw_value">
                                KPI rojos: <field name="red_kpi_count"/>
                            </span>
                            <span class="text-danger" t-if="record.chain_stuck_count.raw_value">
                                Atorados: <field name="chain_stuck_count"/>
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sgi_process_view_list" model="ir.ui.view">
        <field name="name">sgi.process.list</field>
        <field name="model">sgi.process</field>
        <field name="arch" type="xml">
            <list string="Procesos" sample="1" multi_edit="1" default_order="process_type, code"
                  decoration-danger="measure_status == 'rojo'"
                  decoration-muted="measure_status == 'gris'"
                  decoration-success="measure_status == 'verde'">
                <field name="code"/>
                <field name="name"/>
                <field name="process_type"/>
                <field name="owner_id" widget="many2one_avatar_employee"/>
                <field name="parent_id" optional="hide"/>
                <field name="activity_count" optional="show"/>
                <field name="measure_real_pct" optional="show"/>
                <field name="measure_adherence_avg" optional="show"/>
                <field name="measure_status" widget="badge" optional="show"
                       decoration-danger="measure_status == 'rojo'"
                       decoration-success="measure_status == 'verde'"/>
                <field name="nc_count" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Ficha del proceso: 3 botones y 4 pestañas (Ficha, Actividades,
         Conexiones, Documentos). La pestaña Actividades la agrega
         sgi_process_procedure_views.xml ANTES de «Conexiones»
         (page name="entradas_salidas": no cambiar el nombre). -->
    <record id="sgi_process_view_form" model="ir.ui.view">
        <field name="name">sgi.process.form</field>
        <field name="model">sgi.process</field>
        <field name="arch" type="xml">
            <form string="Proceso">
                <header>
                    <button name="action_sgi_set_pilot" type="object" string="Pasar a piloto"
                            invisible="state != 'borrador'" groups="quimibond_sgi.group_sgi_manager"/>
                    <button name="action_sgi_publish" type="object" string="Publicar"
                            class="btn-primary" invisible="state == 'vigente'"
                            groups="quimibond_sgi.group_sgi_manager"
                            confirm="Publicar exige que ninguna actividad ni indicador tenga faltantes que bloquean. ¿Continuar?"/>
                    <button name="action_sgi_set_draft" type="object" string="Regresar a borrador"
                            invisible="state == 'borrador'" groups="quimibond_sgi.group_sgi_manager"/>
                    <button name="action_print_master_list" type="object" string="Lista maestra (PDF)"
                            icon="fa-print"/>
                    <button name="action_print_risk_matrix" type="object" string="Matriz de riesgos (PDF)"
                            icon="fa-print"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_activities" type="object" class="oe_stat_button"
                                icon="fa-list-ol">
                            <field name="activity_count" widget="statinfo" string="Actividades"/>
                        </button>
                        <button name="action_view_red_activities" type="object" class="oe_stat_button"
                                icon="fa-times-circle" invisible="activity_red_count == 0">
                            <field name="activity_red_count" widget="statinfo" string="En rojo"/>
                        </button>
                        <button name="action_open_ncs" type="object" class="oe_stat_button"
                                icon="fa-exclamation-triangle" invisible="nc_count == 0">
                            <field name="nc_count" widget="statinfo" string="NC abiertas"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon" title="Dueño no válido" bg_color="text-bg-warning"
                            invisible="owner_valid or not active or not id"/>
                    <field name="active" invisible="1"/>
                    <field name="owner_valid" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del proceso"/></h1>
                        <h3><field name="code" placeholder="Clave (C6, S2…)"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="process_type"/>
                            <field name="owner_id" string="Dueño" widget="many2one_avatar_employee"/>
                            <field name="parent_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="health" widget="badge"
                                   decoration-success="health == 'verde'"
                                   decoration-warning="health == 'amarillo'"
                                   decoration-danger="health == 'rojo'"/>
                            <field name="measure_real_pct" widget="progressbar"/>
                            <field name="measure_adherence_avg"/>
                            <label for="spec_error_count" string="Especificación"/>
                            <div class="o_row">
                                <button name="action_view_spec_gaps" type="object" class="btn-link p-0">
                                    <field name="spec_error_count" class="text-danger"/> que bloquean ·
                                    <field name="spec_warning_count"/> advertencias
                                </button>
                            </div>
                            <field name="channel_odoo_pct" widget="progressbar"/>
                            <field name="channel_manual_pct" widget="progressbar"/>
                            <field name="odoo_measured_pct" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ficha" name="ficha">
                            <field name="purpose" placeholder="Para qué existe este proceso…"/>
                            <group>
                                <group>
                                    <field name="input_deliverable_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="output_deliverable_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group string="Texto de la versión anterior"
                                   invisible="not inputs and not outputs and not start_trigger and not end_trigger">
                                <field name="start_trigger" readonly="1" invisible="not start_trigger"/>
                                <field name="end_trigger" readonly="1" invisible="not end_trigger"/>
                                <field name="inputs" readonly="1" invisible="not inputs"/>
                                <field name="outputs" readonly="1" invisible="not outputs"/>
                            </group>
                            <group>
                                <group>
                                    <field name="department_id"/>
                                    <field name="job_ids" widget="many2many_tags"
                                           string="Puestos que participan"/>
                                </group>
                                <group>
                                    <field name="odoo_model_ids" string="Se opera en Odoo con"
                                           widget="many2many_tags" readonly="1"/>
                                    <field name="replaced_document_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                            <separator string="Indicadores"/>
                            <field name="indicator_ids" readonly="1">
                                <list decoration-danger="last_semaphore == 'rojo'"
                                      decoration-warning="last_semaphore == 'amarillo'"
                                      decoration-success="last_semaphore == 'verde'">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="responsible_id" widget="many2one_avatar_user"/>
                                    <field name="target_objective" optional="show"/>
                                    <field name="last_value"/>
                                    <field name="last_semaphore" column_invisible="1"/>
                                </list>
                            </field>
                            <separator string="Riesgos y oportunidades"/>
                            <field name="risk_ids" readonly="1">
                                <list decoration-danger="high_without_action">
                                    <field name="instrument"/>
                                    <field name="name"/>
                                    <field name="score" optional="show"/>
                                    <field name="semaphore" widget="badge"
                                           decoration-success="semaphore == 'verde'"
                                           decoration-warning="semaphore == 'amarillo'"
                                           decoration-danger="semaphore == 'rojo'"/>
                                    <field name="high_without_action" optional="show"/>
                                    <field name="state" widget="badge"/>
                                    <field name="last_eval_date" optional="show"/>
                                    <field name="next_review_date" optional="show"/>
                                </list>
                            </field>
                            <separator string="Subprocesos" invisible="not child_ids"/>
                            <field name="child_ids" readonly="1" invisible="not child_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="owner_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Conexiones" name="entradas_salidas">
                            <separator string="Recibe de otros procesos"/>
                            <field name="in_flow_ids" readonly="1">
                                <list>
                                    <field name="from_process_id" string="Lo entrega"/>
                                    <field name="name" string="Entregable"/>
                                    <field name="document_id" optional="hide"/>
                                    <field name="acceptance_criteria" optional="show"/>
                                    <field name="odoo_model_id" optional="hide"/>
                                    <button name="action_view_records" type="object"
                                            string="Ver registros" icon="fa-external-link"
                                            invisible="not odoo_model_id"/>
                                </list>
                            </field>
                            <separator string="Entrega a otros procesos"/>
                            <field name="out_flow_ids" readonly="1">
                                <list>
                                    <field name="name" string="Entregable"/>
                                    <field name="to_process_id" string="Lo recibe"/>
                                    <field name="document_id" optional="hide"/>
                                    <field name="acceptance_criteria" optional="show"/>
                                    <field name="odoo_model_id" optional="hide"/>
                                    <button name="action_view_records" type="object"
                                            string="Ver registros" icon="fa-external-link"
                                            invisible="not odoo_model_id"/>
                                </list>
                            </field>
                            <separator string="Ligas entre actividades"/>
                            <field name="chain_link_ids" readonly="1">
                                <list decoration-danger="chain_state == 'atorado'"
                                      decoration-info="is_cross_process">
                                    <field name="from_activity_id"/>
                                    <field name="name" string="Entregable"/>
                                    <field name="to_activity_id"/>
                                    <field name="is_cross_process" optional="hide"/>
                                    <field name="chain_state" widget="badge"
                                           decoration-success="chain_state == 'fluye'"
                                           decoration-danger="chain_state == 'atorado'"/>
                                    <field name="lag_days" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentos" name="documentos">
                            <field name="linked_document_ids" readonly="1">
                                <list default_order="sgi_doc_type_id, sgi_code"
                                      decoration-muted="sgi_state == 'obsoleto'">
                                    <field name="sgi_code"/>
                                    <field name="name"/>
                                    <field name="sgi_doc_type_id"/>
                                    <field name="sgi_revision"/>
                                    <field name="sgi_state" widget="badge"
                                           decoration-success="sgi_state == 'vigente'"
                                           decoration-warning="sgi_state == 'piloto'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="sgi_process_view_search" model="ir.ui.view">
        <field name="name">sgi.process.search</field>
        <field name="model">sgi.process</field>
        <field name="arch" type="xml">
            <search string="Procesos">
                <field name="code"/>
                <field name="name"/>
                <field name="owner_id"/>
                <filter name="tipo_cop" string="Cadena de valor" domain="[('process_type', '=', 'cop')]"/>
                <filter name="tipo_soporte" string="Soporte" domain="[('process_type', '=', 'soporte')]"/>
                <separator/>
                <filter name="rojo" string="Con actividades en rojo"
                        domain="[('measure_status', '=', 'rojo')]"/>
                <filter name="dueno_invalido" string="Dueño no válido"
                        domain="['|', '|', ('owner_id', '=', False), ('owner_id.active', '=', False), ('owner_id.user_id', '=', False)]"/>
                <filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
                <filter name="macros" string="Solo macroprocesos" domain="[('parent_id', '=', False)]"/>
                <group>
                    <filter name="group_parent" string="Macroproceso" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'process_type'}"/>
                    <filter name="group_owner" string="Dueño" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_measure" string="Estado de medición"
                            context="{'group_by': 'measure_status'}"/>
                </group>
                <searchpanel>
                    <field name="process_type" select="one" icon="fa-sitemap"/>
                    <field name="measure_status" select="multi" icon="fa-tachometer"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="sgi_process_action" model="ir.actions.act_window">
        <field name="name">Procesos</field>
        <field name="res_model">sgi.process</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="search_view_id" ref="sgi_process_view_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Administración del mapa de procesos</p>
            <p>Edite fichas de proceso: dueño, puestos, documentos y flujos.</p></field>
    </record>

</odoo>
