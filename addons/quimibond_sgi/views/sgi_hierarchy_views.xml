<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Diagramas con la vista nativa «hierarchy» (la del organigrama de
         Empleados). Sin JS propio: solo padre, hijos y una tarjeta. -->

    <!-- ===== Mapa de procesos: macroproceso → procesos → subprocesos ===== -->
    <record id="sgi_process_view_hierarchy" model="ir.ui.view">
        <field name="name">sgi.process.hierarchy</field>
        <field name="model">sgi.process</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids" parent_field="parent_id" icon="fa-sitemap" draggable="0">
                <field name="code"/>
                <field name="name"/>
                <field name="process_type"/>
                <field name="health"/>
                <field name="owner_id"/>
                <field name="child_count"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div t-attf-class="o_hierarchy_node_header d-flex align-items-center gap-1 pb-2 #{record.health.raw_value == 'verde' ? 'text-success' : (record.health.raw_value == 'rojo' ? 'text-danger' : 'text-warning')}">
                            <i class="fa fa-circle" t-att-title="record.health.value"/>
                            <field name="code" class="fw-bold"/>
                            <span class="badge text-bg-light ms-auto"><field name="process_type"/></span>
                        </div>
                        <div class="fw-bold lh-sm" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            <field name="name"/>
                        </div>
                        <field name="owner_id" class="text-muted small text-truncate d-block"/>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <record id="sgi_process_hierarchy_action" model="ir.actions.act_window">
        <field name="name">Mapa de procesos</field>
        <field name="res_model">sgi.process</field>
        <field name="view_mode">hierarchy,kanban,list,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="search_view_id" ref="sgi_process_view_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Sin procesos con macroproceso</p>
            <p>El diagrama sale del campo «Macroproceso» de cada proceso.</p></field>
    </record>

    <record id="sgi_process_action" model="ir.actions.act_window">
        <field name="view_mode">kanban,hierarchy,list,form</field>
    </record>

    <!-- Diagramas en HTML: componente sgi_diagram (static/src/diagram); los
         datos salen de sgi.diagram.data(kind, res_id). -->
    <record id="sgi_process_map_action" model="ir.actions.client">
        <field name="name">Mapa de procesos</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'process_map'}</field>
    </record>
    <record id="sgi_diagram_process_flow_action" model="ir.actions.client">
        <field name="name">Flujo del proceso</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'process_flow'}</field>
    </record>
    <record id="sgi_diagram_sipoc_action" model="ir.actions.client">
        <field name="name">Tortuga (SIPOC)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'sipoc'}</field>
    </record>
    <record id="sgi_diagram_doc_tree_action" model="ir.actions.client">
        <field name="name">Árbol documental</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'doc_tree'}</field>
    </record>
    <record id="sgi_diagram_kpi_tree_action" model="ir.actions.client">
        <field name="name">Árbol de indicadores</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'kpi_tree'}</field>
    </record>
    <record id="sgi_diagram_who_action" model="ir.actions.client">
        <field name="name">Quién hace qué (mapa)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'who_does_what'}</field>
    </record>


    <!-- Diagramas ISO (53.6.0, models/sgi_diagram_iso.py): uno por cláusula. -->
    <record id="sgi_diagram_interaction_matrix_action" model="ir.actions.client">
        <field name="name">Interacción de procesos (4.4)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'interaction_matrix'}</field>
    </record>
    <record id="sgi_diagram_context_map_action" model="ir.actions.client">
        <field name="name">Contexto y partes interesadas (4.1/4.2)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'context_map'}</field>
    </record>
    <record id="sgi_diagram_roles_map_action" model="ir.actions.client">
        <field name="name">Roles y responsabilidades (5.3)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'roles_map'}</field>
    </record>
    <record id="sgi_diagram_risk_matrix_action" model="ir.actions.client">
        <field name="name">Matriz de riesgos (6.1)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'risk_matrix'}</field>
    </record>
    <record id="sgi_diagram_legal_matrix_action" model="ir.actions.client">
        <field name="name">Cumplimiento legal (6.1.3)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'legal_matrix'}</field>
    </record>
    <record id="sgi_diagram_calibration_map_action" model="ir.actions.client">
        <field name="name">Calibración (7.1.5)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'calibration_map'}</field>
    </record>
    <record id="sgi_diagram_competence_matrix_action" model="ir.actions.client">
        <field name="name">Competencias (7.2)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'competence_matrix'}</field>
    </record>
    <record id="sgi_diagram_doc_pyramid_action" model="ir.actions.client">
        <field name="name">Pirámide documental (7.5)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'doc_pyramid'}</field>
    </record>
    <record id="sgi_diagram_emergency_map_action" model="ir.actions.client">
        <field name="name">Emergencias (45001 8.2)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'emergency_map'}</field>
    </record>
    <record id="sgi_diagram_audit_program_action" model="ir.actions.client">
        <field name="name">Programa de auditorías (9.2)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'audit_program'}</field>
    </record>
    <record id="sgi_diagram_management_review_action" model="ir.actions.client">
        <field name="name">Revisión por la dirección (9.3)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'management_review'}</field>
    </record>
    <record id="sgi_diagram_nc_flow_action" model="ir.actions.client">
        <field name="name">No conformidades (10.2)</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'nc_flow'}</field>
    </record>
    <record id="sgi_diagram_pdca_action" model="ir.actions.client">
        <field name="name">PDCA del proceso</field>
        <field name="tag">sgi_diagram</field>
        <field name="context">{'sgi_diagram_kind': 'pdca'}</field>
    </record>
    <menuitem id="menu_sgi_diagrams" name="Diagramas" parent="menu_sgi_processes" sequence="6"/>
    <menuitem id="menu_sgi_diagram_process_diagram" name="Mapa de procesos" parent="menu_sgi_diagrams" action="sgi_process_map_action" sequence="1"/>
    <menuitem id="menu_sgi_diagram_interaction" name="Interacción de procesos (4.4)" parent="menu_sgi_diagrams" action="sgi_diagram_interaction_matrix_action" sequence="2"/>
    <menuitem id="menu_sgi_diagram_flow" name="Flujo del proceso" parent="menu_sgi_diagrams" action="sgi_diagram_process_flow_action" sequence="3"/>
    <menuitem id="menu_sgi_diagram_sipoc" name="Tortuga (SIPOC)" parent="menu_sgi_diagrams" action="sgi_diagram_sipoc_action" sequence="4"/>
    <menuitem id="menu_sgi_diagram_pdca" name="PDCA del proceso" parent="menu_sgi_diagrams" action="sgi_diagram_pdca_action" sequence="5"/>
    <menuitem id="menu_sgi_diagram_context" name="Contexto y partes interesadas (4.1/4.2)" parent="menu_sgi_diagrams" action="sgi_diagram_context_map_action" sequence="6"/>
    <menuitem id="menu_sgi_diagram_roles" name="Roles y responsabilidades (5.3)" parent="menu_sgi_diagrams" action="sgi_diagram_roles_map_action" sequence="7"/>
    <menuitem id="menu_sgi_diagram_who" name="Quién hace qué" parent="menu_sgi_diagrams" action="sgi_diagram_who_action" sequence="8"/>
    <menuitem id="menu_sgi_diagram_kpis" name="Política, objetivos e indicadores (5.2/6.2)" parent="menu_sgi_diagrams" action="sgi_diagram_kpi_tree_action" sequence="9"/>
    <menuitem id="menu_sgi_diagram_risk" name="Matriz de riesgos (6.1)" parent="menu_sgi_diagrams" action="sgi_diagram_risk_matrix_action" sequence="10"/>
    <menuitem id="menu_sgi_diagram_legal" name="Cumplimiento legal (6.1.3)" parent="menu_sgi_diagrams" action="sgi_diagram_legal_matrix_action" sequence="11"/>
    <menuitem id="menu_sgi_diagram_calibration" name="Calibración (7.1.5)" parent="menu_sgi_diagrams" action="sgi_diagram_calibration_map_action" sequence="12"/>
    <menuitem id="menu_sgi_diagram_competence" name="Competencias (7.2)" parent="menu_sgi_diagrams" action="sgi_diagram_competence_matrix_action" sequence="13"/>
    <menuitem id="menu_sgi_diagram_docs" name="Árbol documental (7.5)" parent="menu_sgi_diagrams" action="sgi_diagram_doc_tree_action" sequence="14"/>
    <menuitem id="menu_sgi_diagram_pyramid" name="Pirámide documental (7.5)" parent="menu_sgi_diagrams" action="sgi_diagram_doc_pyramid_action" sequence="15"/>
    <menuitem id="menu_sgi_diagram_emergency" name="Emergencias (45001 8.2)" parent="menu_sgi_diagrams" action="sgi_diagram_emergency_map_action" sequence="16"/>
    <menuitem id="menu_sgi_diagram_audits" name="Programa de auditorías (9.2)" parent="menu_sgi_diagrams" action="sgi_diagram_audit_program_action" sequence="17"/>
    <menuitem id="menu_sgi_diagram_review" name="Revisión por la dirección (9.3)" parent="menu_sgi_diagrams" action="sgi_diagram_management_review_action" sequence="18"/>
    <menuitem id="menu_sgi_diagram_nc" name="No conformidades (10.2)" parent="menu_sgi_diagrams" action="sgi_diagram_nc_flow_action" sequence="19"/>

    <!-- ===== Actividades: el flujo paso a paso de un proceso ===== -->
    <record id="sgi_process_activity_view_hierarchy" model="ir.ui.view">
        <field name="name">sgi.process.activity.hierarchy</field>
        <field name="model">sgi.process.activity</field>
        <field name="arch" type="xml">
            <hierarchy child_field="flow_child_ids" parent_field="flow_parent_id" icon="fa-sitemap" draggable="0">
                <field name="number"/>
                <field name="name"/>
                <field name="stage_id"/>
                <field name="measure_state"/>
                <field name="flow_executor"/>
                <field name="flow_child_count"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <!-- Solo numeral, etapa y título (2026-09-25: la lista de
                             puestos estiraba las tarjetas). Quién ejecuta va en el
                             tooltip; el detalle, al abrir la actividad. -->
                        <div t-attf-class="o_hierarchy_node_header d-flex align-items-center gap-1 pb-1 #{record.measure_state.raw_value == 'verde' ? 'text-success' : (record.measure_state.raw_value == 'rojo' ? 'text-danger' : 'text-muted')}"
                             t-att-title="record.measure_state.value">
                            <i class="fa fa-circle small"/>
                            <field name="number" class="fw-bold"/>
                            <span class="badge text-bg-light ms-auto text-truncate" style="max-width: 55%;"><field name="stage_id"/></span>
                        </div>
                        <div class="fw-bold lh-sm" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"
                             t-att-title="record.flow_executor.raw_value ? 'Ejecuta: ' + record.flow_executor.raw_value : ''">
                            <field name="name"/>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <record id="sgi_process_activity_action" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,hierarchy,form</field>
    </record>

    <!-- Botón «Ver en el mapa» junto a «Ver en diagrama» en la ficha del proceso. -->
    <record id="sgi_process_view_form_hierarchy" model="ir.ui.view">
        <field name="name">sgi.process.form.hierarchy</field>
        <field name="model">sgi.process</field>
        <field name="inherit_id" ref="quimibond_sgi.sgi_process_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_sgi_view_process_map" type="object"
                        string="Ver en el mapa" icon="fa-sitemap"/>
                <button name="action_sgi_view_sipoc" type="object"
                        string="Tortuga" icon="fa-refresh"/>
                <button name="action_sgi_view_doc_tree" type="object"
                        string="Árbol documental" icon="fa-folder-open-o"/>
            </xpath>
        </field>
    </record>
</odoo>
