<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Brechas de competencia (DNC) ================= -->
    <record id="sgi_competence_gap_view_list" model="ir.ui.view">
        <field name="name">sgi.competence.gap.list</field>
        <field name="model">sgi.competence.gap</field>
        <field name="arch" type="xml">
            <list string="Brechas de competencia" create="false" edit="false"
                  decoration-danger="gap >= 50" decoration-warning="gap &lt; 50">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="skill_type_id"/>
                <field name="skill_id"/>
                <field name="required_level_id"/>
                <field name="current_level_id"/>
                <field name="gap"/>
            </list>
        </field>
    </record>

    <record id="sgi_competence_gap_view_pivot" model="ir.ui.view">
        <field name="name">sgi.competence.gap.pivot</field>
        <field name="model">sgi.competence.gap</field>
        <field name="arch" type="xml">
            <pivot string="Brechas por departamento">
                <field name="department_id" type="row"/>
                <field name="skill_type_id" type="col"/>
                <field name="gap" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_competence_gap_view_search" model="ir.ui.view">
        <field name="name">sgi.competence.gap.search</field>
        <field name="model">sgi.competence.gap</field>
        <field name="arch" type="xml">
            <search string="Brechas de competencia">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="skill_id"/>
                <group>
                    <filter name="group_department" string="Departamento"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_job" string="Puesto" context="{'group_by': 'job_id'}"/>
                    <filter name="group_skill_type" string="Tipo de competencia"
                            context="{'group_by': 'skill_type_id'}"/>
                    <filter name="group_employee" string="Empleado"
                            context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_competence_gap_action" model="ir.actions.act_window">
        <field name="name">Brechas de competencia (DNC)</field>
        <field name="res_model">sgi.competence.gap</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="sgi_competence_gap_view_search"/>
        <field name="context">{'search_default_group_department': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin brechas de competencia 🎉</p>
            <p>La brecha se calcula sola: competencias que el <b>puesto</b> exige (Empleados → Puestos → Habilidades) vs las <b>vigentes</b> del empleado (las certificaciones caducadas cuentan como brecha). Se cierra registrando la competencia en la ficha del empleado tras la capacitación — el cron trimestral avisa a RH y la encuesta DNC (menú de abajo) levanta las necesidades percibidas.</p>
        </field>
    </record>

    <!-- ================= hr.employee: botón de brechas ================= -->
    <record id="sgi_employee_view_form_competence" model="ir.ui.view">
        <field name="name">hr.employee.form.sgi.competence</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_skill_gaps" type="object" class="oe_stat_button"
                        icon="fa-graduation-cap">
                    <field name="sgi_skill_gap_count" widget="statinfo" string="Brechas"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Acceso directo a la encuesta DNC (F-P-A01-17): antes estaba huérfana
         (solo alcanzable buceando en la app Encuestas). -->
    <record id="sgi_dnc_survey_action" model="ir.actions.server">
        <field name="name">Encuesta DNC</field>
        <field name="model_id" ref="survey.model_survey_survey"/>
        <field name="state">code</field>
        <field name="code">
survey = env.ref('quimibond_sgi.sgi_survey_dnc', raise_if_not_found=False)
if survey:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Encuesta DNC (F-P-A01-17)',
        'res_model': 'survey.survey',
        'res_id': survey.id,
        'view_mode': 'form',
    }
else:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Encuesta DNC',
        'res_model': 'survey.survey',
        'view_mode': 'list,form',
        'domain': [('id', '=', False)],
    }
        </field>
    </record>
</odoo>
