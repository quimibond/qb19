<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Desglose de mediciones por equipo de ventas o mercado (56.16.0). Las
         líneas de negocio son los equipos de venta y las posiciones fiscales
         de Odoo; el SGI no tiene catálogo propio. -->
    <record id="sgi_measure_split_view_list" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.split.list</field>
        <field name="model">sgi.indicator.measure.split</field>
        <field name="arch" type="xml">
            <list string="Desglose de mediciones" create="0" edit="0" delete="0"
                  default_order="period_date desc, indicator_id, label"
                  decoration-danger="semaphore == 'rojo'"
                  decoration-warning="semaphore == 'amarillo'"
                  decoration-muted="state == 'sin_dato'">
                <field name="period_date"/>
                <field name="indicator_id"/>
                <field name="label"/>
                <field name="team_id" optional="hide"/>
                <field name="market" optional="hide"/>
                <field name="value"/>
                <field name="uom"/>
                <field name="numerator" optional="hide"/>
                <field name="denominator" optional="hide"/>
                <field name="sample_size" optional="show"/>
                <field name="semaphore" widget="badge"
                       decoration-success="semaphore == 'verde'"
                       decoration-warning="semaphore == 'amarillo'"
                       decoration-danger="semaphore == 'rojo'"/>
                <field name="state" optional="hide"/>
                <field name="detail_ids" column_invisible="1"/>
                <button name="action_view_evidence" type="object" string="Registros"
                        icon="fa-list" invisible="not detail_ids"/>
            </list>
        </field>
    </record>

    <record id="sgi_measure_split_view_pivot" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.split.pivot</field>
        <field name="model">sgi.indicator.measure.split</field>
        <field name="arch" type="xml">
            <pivot string="Desglose de mediciones" sample="1">
                <field name="indicator_id" type="row"/>
                <field name="label" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_measure_split_view_graph" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.split.graph</field>
        <field name="model">sgi.indicator.measure.split</field>
        <field name="arch" type="xml">
            <graph string="Desglose de mediciones" type="line" sample="1">
                <field name="period_date" interval="month"/>
                <field name="label"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sgi_measure_split_view_search" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.split.search</field>
        <field name="model">sgi.indicator.measure.split</field>
        <field name="arch" type="xml">
            <search string="Desglose de mediciones">
                <field name="indicator_id"/>
                <field name="team_id"/>
                <filter name="by_team" string="Por equipo de ventas" domain="[('team_id', '!=', False)]"/>
                <filter name="by_market" string="Por mercado" domain="[('market', '!=', False)]"/>
                <separator/>
                <filter name="rojo" string="En rojo" domain="[('semaphore', '=', 'rojo')]"/>
                <filter name="sin_dato" string="Sin dato" domain="[('state', '=', 'sin_dato')]"/>
                <separator/>
                <filter name="period_date" string="Periodo" date="period_date"/>
                <group>
                    <filter name="group_indicator" string="Indicador" context="{'group_by': 'indicator_id'}"/>
                    <filter name="group_label" string="Renglón" context="{'group_by': 'label'}"/>
                    <filter name="group_period" string="Periodo" context="{'group_by': 'period_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_measure_split_action" model="ir.actions.act_window">
        <field name="name">Mediciones por equipo o mercado</field>
        <field name="res_model">sgi.indicator.measure.split</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="sgi_measure_split_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin desglose todavía</p>
            <p>En un indicador con fórmula, elige «Desglose: por equipo de ventas» o «por mercado». La medición oficial sigue siendo el total; aquí queda cada renglón.</p>
        </field>
    </record>

    <menuitem id="menu_sgi_measures_split" name="Mediciones por equipo o mercado"
              parent="menu_sgi_admin_indicators" action="sgi_measure_split_action" sequence="21"/>
</odoo>
