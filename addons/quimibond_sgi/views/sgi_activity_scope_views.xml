<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Líneas de negocio (56.16.0): «Aplica a» de las actividades, líneas de
         cada puesto y medición de indicadores por línea. La lista la edita
         MAST; no está fija en el código. -->
    <record id="sgi_activity_scope_view_list" model="ir.ui.view">
        <field name="name">sgi.activity.scope.list</field>
        <field name="model">sgi.activity.scope</field>
        <field name="arch" type="xml">
            <list string="Líneas de negocio" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="team_ids" widget="many2many_tags" optional="show"/>
                <field name="crm_tag_ids" widget="many2many_tags" optional="show"/>
                <field name="description" optional="hide"/>
                <field name="activity_count"/>
                <button name="action_view_activities" type="object" string="Actividades"
                        icon="fa-list" invisible="not activity_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sgi_activity_scope_view_search" model="ir.ui.view">
        <field name="name">sgi.activity.scope.search</field>
        <field name="model">sgi.activity.scope</field>
        <field name="arch" type="xml">
            <search string="Líneas de negocio">
                <field name="name"/>
                <filter name="archived" string="Archivadas" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="sgi_activity_scope_action" model="ir.actions.act_window">
        <field name="name">Líneas de negocio</field>
        <field name="res_model">sgi.activity.scope</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="sgi_activity_scope_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Líneas de negocio</p>
            <p>Industrial, confección, exportación… Cada actividad dice a qué líneas aplica (vacío = a todas) y cada puesto qué líneas atiende. Con equipos de venta o etiquetas del pedido, un indicador con fórmula se mide también por línea.</p>
        </field>
    </record>

    <menuitem id="menu_sgi_config_scopes" name="Líneas de negocio" parent="menu_sgi_config"
              action="sgi_activity_scope_action" sequence="11"/>

    <!-- Mediciones por línea: el desglose de cada medición del periodo. -->
    <record id="sgi_measure_scope_view_list" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.scope.list</field>
        <field name="model">sgi.indicator.measure.scope</field>
        <field name="arch" type="xml">
            <list string="Mediciones por línea" create="0" edit="0" delete="0"
                  default_order="period_date desc, indicator_id, scope_sequence"
                  decoration-danger="semaphore == 'rojo'"
                  decoration-warning="semaphore == 'amarillo'"
                  decoration-muted="state == 'sin_dato'">
                <field name="period_date"/>
                <field name="indicator_id"/>
                <field name="scope_id"/>
                <field name="value"/>
                <field name="uom"/>
                <field name="numerator" optional="hide"/>
                <field name="denominator" optional="hide"/>
                <field name="sample_size" optional="show"/>
                <field name="semaphore" widget="badge"
                       decoration-success="semaphore == 'verde'"
                       decoration-warning="semaphore == 'amarillo'"
                       decoration-danger="semaphore == 'rojo'"/>
                <field name="state" optional="hide"/>
                <field name="detail_ids" column_invisible="1"/>
                <button name="action_view_evidence" type="object" string="Registros"
                        icon="fa-list" invisible="not detail_ids"/>
            </list>
        </field>
    </record>

    <record id="sgi_measure_scope_view_pivot" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.scope.pivot</field>
        <field name="model">sgi.indicator.measure.scope</field>
        <field name="arch" type="xml">
            <pivot string="Mediciones por línea" sample="1">
                <field name="indicator_id" type="row"/>
                <field name="scope_id" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_measure_scope_view_graph" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.scope.graph</field>
        <field name="model">sgi.indicator.measure.scope</field>
        <field name="arch" type="xml">
            <graph string="Mediciones por línea" type="line" sample="1">
                <field name="period_date" interval="month"/>
                <field name="scope_id"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sgi_measure_scope_view_search" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.scope.search</field>
        <field name="model">sgi.indicator.measure.scope</field>
        <field name="arch" type="xml">
            <search string="Mediciones por línea">
                <field name="indicator_id"/>
                <field name="scope_id"/>
                <filter name="rojo" string="En rojo" domain="[('semaphore', '=', 'rojo')]"/>
                <filter name="sin_dato" string="Sin dato" domain="[('state', '=', 'sin_dato')]"/>
                <separator/>
                <filter name="period_date" string="Periodo" date="period_date"/>
                <group>
                    <filter name="group_indicator" string="Indicador" context="{'group_by': 'indicator_id'}"/>
                    <filter name="group_scope" string="Línea" context="{'group_by': 'scope_id'}"/>
                    <filter name="group_period" string="Periodo" context="{'group_by': 'period_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_measure_scope_action" model="ir.actions.act_window">
        <field name="name">Mediciones por línea</field>
        <field name="res_model">sgi.indicator.measure.scope</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="sgi_measure_scope_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin mediciones por línea</p>
            <p>Marca «Medir por línea» en un indicador con fórmula cuyos registros traigan equipo de ventas o etiqueta del pedido. La medición oficial sigue siendo el total; aquí queda el desglose.</p>
        </field>
    </record>

    <menuitem id="menu_sgi_measures_scope" name="Mediciones por línea" parent="menu_sgi_admin_indicators"
              action="sgi_measure_scope_action" sequence="21"/>
</odoo>
