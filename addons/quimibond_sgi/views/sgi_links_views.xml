<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Campos de liga entrada ↔ salida (2026-09-25). Ver models/sgi_links.py.
         AMEF, plan de control, PPAP, proveedores críticos y Ajustes ya los traen
         en su vista base (A-008, 57.27.0). -->

    <!-- C1: tarea del desarrollo en LdM y orden -->
    <record id="sgi_mrp_bom_view_form_links" model="ir.ui.view">
        <field name="name">mrp.bom.form.sgi.links</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="SGI" name="sgi">
                    <group>
                        <field name="sgi_dyd_task_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="sgi_mrp_production_view_form_links" model="ir.ui.view">
        <field name="name">mrp.production.form.sgi.links</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="SGI" name="sgi">
                    <group>
                        <group string="Desarrollo (C1)">
                            <field name="sgi_dyd_task_id"/>
                        </group>
                        <group string="Liberación">
                            <field name="sgi_release_picking_ids" nolabel="1" colspan="2" readonly="1">
                                <list><field name="name"/><field name="picking_type_id"/><field name="state" widget="badge"/></list>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="sgi_project_task_view_form_links" model="ir.ui.view">
        <field name="name">project.task.form.sgi.links</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="SGI" name="sgi_dyd" invisible="not sgi_dyd_link_count">
                    <field name="sgi_dyd_link_count" invisible="1"/>
                    <group>
                        <group string="AMEF">
                            <field name="sgi_fmea_ids" nolabel="1" colspan="2" readonly="1">
                                <list><field name="name"/><field name="fmea_type"/><field name="revision"/></list>
                            </field>
                        </group>
                        <group string="Listas de materiales">
                            <field name="sgi_bom_ids" nolabel="1" colspan="2" readonly="1">
                                <list><field name="product_tmpl_id"/><field name="code"/></list>
                            </field>
                        </group>
                        <group string="Órdenes de muestra">
                            <field name="sgi_production_ids" nolabel="1" colspan="2" readonly="1">
                                <list><field name="name"/><field name="product_id"/><field name="state" widget="badge"/></list>
                            </field>
                        </group>
                        <group string="Planes de control y PPAP">
                            <field name="sgi_control_plan_ids" nolabel="1" colspan="2" readonly="1">
                                <list><field name="name"/><field name="revision"/><field name="state" widget="badge"/></list>
                            </field>
                            <field name="sgi_ppap_ids" nolabel="1" colspan="2" readonly="1">
                                <list><field name="display_name"/><field name="partner_id"/><field name="state" widget="badge"/></list>
                            </field>
                        </group>
                        <group string="Envíos de muestra">
                            <field name="sgi_dyd_picking_ids" nolabel="1" colspan="2" readonly="1">
                                <list><field name="name"/><field name="partner_id"/><field name="state" widget="badge"/></list>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- S1.09: la orden de compra guarda su requisición -->
    <record id="sgi_purchase_order_view_form_links" model="ir.ui.view">
        <field name="name">purchase.order.form.sgi.links</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="SGI" name="sgi">
                    <group>
                        <field name="sgi_approval_request_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- S2.08: la factura guarda las entregas que cobra -->
    <record id="sgi_account_move_view_form_links" model="ir.ui.view">
        <field name="name">account.move.form.sgi.links</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="SGI" name="sgi" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <group>
                        <field name="sgi_picking_ids" widget="many2many_tags"/>
                        <field name="sgi_action_line_id" invisible="move_type != 'out_refund'"/>
                        <!-- 57.95.0 (K-05): lo propuesto, cuando hay ajuste a mano o
                             lo guardado difiere. -->
                        <field name="sgi_picking_manual" invisible="not sgi_picking_manual"/>
                        <field name="sgi_picking_outdated" invisible="1"/>
                        <field name="sgi_picking_proposed_ids" widget="many2many_tags"
                               invisible="not sgi_picking_manual and not sgi_picking_outdated"/>
                    </group>
                    <button name="action_sgi_picking_reset" type="object"
                            string="Volver a las entregas propuestas" class="btn-secondary"
                            invisible="not sgi_picking_manual and not sgi_picking_outdated"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- 57.114.0: la solicitud de aprobación guarda su tarea del desarrollo
         (C1.08), su NC (C5.22) y su solicitud de mantenimiento (S5.03). -->
    <record id="sgi_approval_request_view_form_links" model="ir.ui.view">
        <field name="name">approval.request.form.sgi.links</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Liga con el SGI" name="sgi_links">
                    <field name="sgi_dyd_task_id"/>
                    <field name="sgi_alert_id"/>
                    <field name="sgi_maintenance_request_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- 57.114.0: el traslado guarda su tarea del desarrollo (C1.12) y su
         solicitud de mantenimiento (S5.04). -->
    <record id="sgi_stock_picking_view_form_links" model="ir.ui.view">
        <field name="name">stock.picking.form.sgi.links</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Liga con el SGI" name="sgi_links">
                    <group>
                        <field name="sgi_dyd_task_id"/>
                        <field name="sgi_maintenance_request_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sgi_acuse_attach_wizard_view_form" model="ir.ui.view">
        <field name="name">sgi.acuse.attach.wizard.form</field>
        <field name="model">sgi.acuse.attach.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjuntar acuse firmado">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_attach" type="object" string="Adjuntar" class="btn-primary"/>
                    <button string="Descartar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
