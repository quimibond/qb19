<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sgi_objective_view_list" model="ir.ui.view">
        <field name="name">sgi.objective.list</field>
        <field name="model">sgi.objective</field>
        <field name="arch" type="xml">
            <list string="Objetivos Integrales">
                <field name="name"/>
                <field name="target_year"/>
                <field name="indicator_count"/>
            </list>
        </field>
    </record>

    <record id="sgi_objective_view_form" model="ir.ui.view">
        <field name="name">sgi.objective.form</field>
        <field name="model">sgi.objective</field>
        <field name="arch" type="xml">
            <form string="Objetivo Integral">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_indicators" type="object"
                                class="oe_stat_button" icon="fa-tachometer">
                            <field name="indicator_count" widget="statinfo" string="Indicadores"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="policy_id"/>
                        <field name="target_year"/>
                        <field name="health" widget="badge"
                               decoration-success="health == 'verde'"
                               decoration-warning="health == 'amarillo'"
                               decoration-danger="health == 'rojo'"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sgi_objective_action" model="ir.actions.act_window">
        <field name="name">Objetivos Integrales</field>
        <field name="res_model">sgi.objective</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra los objetivos integrales</p>
            <p>Los del ANEXO 6 (Planeación Estratégica). Cada indicador del SGI se liga a uno de estos objetivos.</p>
        </field>
    </record>
</odoo>
