<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 57.137.0 (C1, Jessica punto 9): solicitud de modificación del proyecto de desarrollo
         (qué cambia, causa, 5 porqués, solución, fases afectadas; firma Dirección de Operaciones). -->
    <record id="sgi_dev_change_request_view_form" model="ir.ui.view">
        <field name="name">sgi.dev.change.request.form</field>
        <field name="model">sgi.dev.change.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de modificación del proyecto">
                <header>
                    <button name="action_approve" type="object" string="Firmar (Dirección de Operaciones)" class="btn-primary" icon="fa-pencil"
                            invisible="state != 'borrador'"
                            confirm="Firma la solicitud con su usuario y la fecha de hoy. Se abre la revisión del desarrollo (si la respuesta del cliente no la abrió ya), el proyecto vuelve a «Muestra» y se guarda el PDF. ¿Continuar?"/>
                    <button name="action_apply" type="object" string="Marcar aplicada" class="btn-primary" icon="fa-check"
                            invisible="state != 'firmada'"/>
                    <button name="action_back_to_draft" type="object" string="Volver a borrador" class="btn-secondary"
                            invisible="state != 'firmada'" groups="quimibond_sgi.group_sgi_manager"/>
                    <button name="action_print" type="object" string="Imprimir" class="btn-secondary" icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,firmada,aplicada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'borrador'" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="date" readonly="state != 'borrador'"/>
                            <field name="origin" readonly="state != 'borrador'"/>
                            <field name="shipment_id" invisible="not shipment_id"/>
                        </group>
                        <group>
                            <field name="requested_by_id"/>
                            <field name="revision" invisible="not revision"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_at" invisible="not approved_at"/>
                            <field name="applied_by_id" invisible="not applied_by_id"/>
                            <field name="applied_at" invisible="not applied_at"/>
                            <field name="attachment_id" invisible="not attachment_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cambio" name="change">
                            <group>
                                <field name="description" readonly="state != 'borrador'" placeholder="Qué pide el cliente o qué no salió como se esperaba en la muestra."/>
                                <field name="solution" readonly="state != 'borrador'" placeholder="Qué se va a cambiar (materia prima, proceso, especificación) para obtener el resultado."/>
                                <field name="dev_stage_ids" invisible="1"/>
                                <field name="stage_ids" widget="many2many_tags" readonly="state != 'borrador'" options="{'no_create': True}"/>
                            </group>
                        </page>
                        <page string="Causa raíz (5 porqués)" name="whys">
                            <group>
                                <field name="cause" readonly="state != 'borrador'"/>
                            </group>
                            <group>
                                <group>
                                    <field name="why_1" readonly="state != 'borrador'"/>
                                    <field name="why_2" readonly="state != 'borrador'"/>
                                    <field name="why_3" readonly="state != 'borrador'"/>
                                    <field name="why_4" readonly="state != 'borrador'"/>
                                    <field name="why_5" readonly="state != 'borrador'"/>
                                </group>
                                <group>
                                    <field name="root_cause" readonly="state != 'borrador'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_dev_change_request_view_list" model="ir.ui.view">
        <field name="name">sgi.dev.change.request.list</field>
        <field name="model">sgi.dev.change.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de modificación" decoration-muted="state == 'aplicada'" decoration-info="state == 'borrador'">
                <field name="date"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id" optional="show"/>
                <field name="origin"/>
                <field name="revision" optional="show"/>
                <field name="requested_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="approved_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'aplicada'" decoration-warning="state == 'firmada'"/>
            </list>
        </field>
    </record>

    <record id="sgi_dev_change_request_view_search" model="ir.ui.view">
        <field name="name">sgi.dev.change.request.search</field>
        <field name="model">sgi.dev.change.request</field>
        <field name="arch" type="xml">
            <search string="Solicitudes de modificación">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter name="draft" string="Por firmar" domain="[('state', '=', 'borrador')]"/>
                <filter name="signed" string="Firmadas, por aplicar" domain="[('state', '=', 'firmada')]"/>
                <group>
                    <filter name="group_project" string="Desarrollo" context="{'group_by': 'project_id'}"/>
                    <filter name="group_origin" string="Motivo" context="{'group_by': 'origin'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_dev_change_request_action" model="ir.actions.act_window">
        <field name="name">Solicitudes de modificación de desarrollos</field>
        <field name="res_model">sgi.dev.change.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sgi_dev_change_request_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ninguna solicitud de modificación</p>
            <p>Cuando la muestra no dio el resultado o el cliente pide cambios, Diseño de Producto llena aquí qué cambia,
               la causa con sus 5 porqués, la solución y las fases afectadas; Dirección de Operaciones la firma y el
               desarrollo vuelve a la muestra con la revisión siguiente.</p>
        </field>
    </record>
</odoo>
