<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====== Roles por actividad (quién ejecuta, aprueba, participa, se entera) ====== -->
    <record id="sgi_activity_role_view_list" model="ir.ui.view">
        <field name="name">sgi.activity.role.list</field>
        <field name="model">sgi.activity.role</field>
        <field name="arch" type="xml">
            <list string="Roles en actividades" editable="bottom">
                <field name="process_id" optional="show"/>
                <field name="activity_id"/>
                <field name="role" widget="badge"
                       decoration-success="role == 'ejecuta'"
                       decoration-warning="role == 'aprueba'"
                       decoration-info="role == 'participa'"/>
                <field name="target_type"/>
                <field name="job_id" invisible="target_type != 'job'"
                       required="target_type == 'job'"/>
                <field name="family_id" invisible="target_type != 'family'"
                       required="target_type == 'family'"/>
                <field name="relative_role" invisible="target_type != 'relative'"
                       required="target_type == 'relative'"/>
                <field name="condition" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sgi_activity_role_view_search" model="ir.ui.view">
        <field name="name">sgi.activity.role.search</field>
        <field name="model">sgi.activity.role</field>
        <field name="arch" type="xml">
            <search string="Roles en actividades">
                <field name="job_id"/>
                <field name="family_id"/>
                <field name="activity_id"/>
                <field name="process_id"/>
                <filter name="relative" string="Roles relativos"
                        domain="[('target_type', '=', 'relative')]"/>
                <filter name="executes" string="Ejecuta" domain="[('role', '=', 'ejecuta')]"/>
                <filter name="approves" string="Aprueba" domain="[('role', '=', 'aprueba')]"/>
                <filter name="participates" string="Participa" domain="[('role', '=', 'participa')]"/>
                <filter name="informs" string="Se entera" domain="[('role', '=', 'informa')]"/>
                <group>
                    <filter name="group_role" string="Rol" context="{'group_by': 'role'}"/>
                    <filter name="group_job" string="Puesto" context="{'group_by': 'job_id'}"/>
                    <filter name="group_process" string="Proceso" context="{'group_by': 'process_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_activity_role_action" model="ir.actions.act_window">
        <field name="name">Roles por puesto</field>
        <field name="res_model">sgi.activity.role</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="sgi_activity_role_view_search"/>
        <field name="context">{'search_default_group_job': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Quién hace qué, por puesto</p>
            <p>Cada fila dice qué papel tiene un puesto en una actividad: la <b>ejecuta</b>, la <b>aprueba</b>, <b>participa</b> o <b>se entera</b>. De aquí salen el procedimiento, la descripción de puesto y la medición de quién la hace de verdad.</p>
        </field>
    </record>

    <!-- ====== Familias de puestos ====== -->
    <record id="sgi_job_family_view_list" model="ir.ui.view">
        <field name="name">sgi.job.family.list</field>
        <field name="model">sgi.job.family</field>
        <field name="arch" type="xml">
            <list string="Familias de puestos">
                <field name="code"/>
                <field name="name"/>
                <field name="job_ids" widget="many2many_tags"/>
                <field name="employee_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sgi_job_family_view_form" model="ir.ui.view">
        <field name="name">sgi.job.family.form</field>
        <field name="model">sgi.job.family</field>
        <field name="arch" type="xml">
            <form string="Familia de puestos">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="code" placeholder="OP-TEJ"/>
                            <field name="name" placeholder="Operador de tejido circular"/>
                        </group>
                        <group>
                            <field name="employee_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Puestos que solo cambian por nivel o letra. Las
                        actividades se asignan a la familia; el nivel se queda
                        en el puesto. Un puesto solo puede estar en una familia.
                    </div>
                    <field name="job_ids" options="{'no_create': True}">
                        <list>
                            <field name="name"/>
                            <field name="no_of_employee"/>
                            <field name="sgi_vacancy_approved"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sgi_job_family_action" model="ir.actions.act_window">
        <field name="name">Familias de puestos</field>
        <field name="res_model">sgi.job.family</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Un rol, varios niveles</p>
            <p>«Operador de tejido circular» vive en once puestos (A a J). La familia los junta para que la actividad tenga un solo ejecutor.</p>
        </field>
    </record>

    <!-- ====== Tablero: cuánto de cada proceso se mide de verdad ====== -->
    <record id="sgi_activity_method_view_pivot" model="ir.ui.view">
        <field name="name">sgi.process.activity.pivot.method</field>
        <field name="model">sgi.process.activity</field>
        <field name="arch" type="xml">
            <pivot string="Actividades por método de medición">
                <field name="process_id" type="row"/>
                <field name="measure_method" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_activity_method_action" model="ir.actions.act_window">
        <field name="name">Medición por método</field>
        <field name="res_model">sgi.process.activity</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_id" ref="sgi_activity_method_view_pivot"/>
        <field name="search_view_id" ref="quimibond_sgi.sgi_process_activity_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cuánto del proceso está a la vista</p>
            <p>Cada actividad por su método de medición: <b>Registro en Odoo</b> y <b>Por consecuencia</b> se miden de verdad; correo, manual y muestreo esperan su fuente; <b>No aplica</b> exige justificación. «Sin medir» solo se permite con el procedimiento en borrador.</p>
        </field>
    </record>

    <!-- ====== Tipos de documento (datos, no código) ====== -->
    <record id="sgi_document_type_view_list" model="ir.ui.view">
        <field name="name">sgi.document.type.list</field>
        <field name="model">sgi.document.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de documento" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="prefix_pattern" placeholder="IT-{process}-{seq:02d}"/>
                <field name="requires_process"/>
                <field name="code_required"/>
                <field name="legacy_code_regex" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sgi_document_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de documento</field>
        <field name="res_model">sgi.document.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">La nomenclatura de claves, como datos</p>
            <p>Cada tipo dice cómo se arma su clave: <code>{process}</code> es la clave del proceso (C6, S2…) y <code>{seq:02d}</code> el consecutivo. La <b>clave heredada</b> es la nomenclatura anterior que se sigue aceptando mientras se migra.</p>
        </field>
    </record>

    <!-- ====== Puesto: sus roles en el catálogo ====== -->
    <record id="sgi_hr_job_view_form_roles" model="ir.ui.view">
        <field name="name">sgi.hr.job.form.roles</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="quimibond_sgi.sgi_hr_job_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sgi_documents']" position="before">
                <page string="Actividades SGI" name="sgi_roles">
                    <group>
                        <group>
                            <field name="sgi_family_id"/>
                        </group>
                        <group>
                            <field name="sgi_vacancy_approved"/>
                            <field name="sgi_vacancy_until"
                                   invisible="not sgi_vacancy_approved"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="sgi_execute_count"/>
                            <field name="sgi_approve_count"/>
                        </group>
                        <group>
                            <field name="sgi_participate_count"/>
                            <field name="sgi_inform_count"/>
                        </group>
                    </group>
                    <button name="action_sgi_view_roles" type="object"
                            string="Ver sus actividades" icon="fa-list" class="btn-link"/>
                    <field name="sgi_role_ids" readonly="1">
                        <list>
                            <field name="process_id"/>
                            <field name="activity_id"/>
                            <field name="role"/>
                            <field name="target_type" optional="hide"/>
                            <field name="condition" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
