<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 57.155.0 (Dirección General 2026-10-13): una sola ficha por proceso, la de
         quimibond_ficha_tecnica_tela. El SGI le agrega solo la capa de control del desarrollo
         (proyecto, orden, propuso / midió / validó y el valor real de cada parámetro). Son
         herencias de vistas de OTRO módulo: el SGI no hereda las suyas. -->
    <record id="ficha_tecnica_tejido_view_form_sgi_dev" model="ir.ui.view">
        <field name="name">ficha.tecnica.tejido.form.sgi.dev</field>
        <field name="model">ficha.tecnica.tejido</field>
        <field name="inherit_id" ref="quimibond_ficha_tecnica_tela.view_ficha_tecnica_tejido_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Control del desarrollo" name="sgi_dev_control">
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="production_id" options="{'no_create': True}"
                                   domain="[('sgi_dev_project_id', '=', project_id)]"/>
                        </group>
                        <group>
                            <field name="sgi_proposed_by_id"/>
                            <field name="sgi_proposed_date"/>
                            <field name="sgi_measured_by_id"/>
                            <field name="sgi_measured_date"/>
                            <field name="sgi_validated_by_id"/>
                            <field name="sgi_validated_date"/>
                        </group>
                    </group>
                    <div class="d-flex gap-2 mb-2">
                        <button name="action_sgi_load_readings" type="object" string="Cargar parámetros" class="btn-secondary" icon="fa-list"/>
                        <button name="action_sgi_propose" type="object" string="Proponer" class="btn-secondary" icon="fa-pencil"
                                invisible="sgi_validated_by_id"/>
                        <button name="action_sgi_measure" type="object" string="Medido por Laboratorio" class="btn-secondary" icon="fa-flask"/>
                        <button name="action_sgi_validate" type="object" string="Validar" class="btn-primary" icon="fa-check"
                                invisible="sgi_validated_by_id or not sgi_proposed_by_id"
                                confirm="Firma la validación de la ficha con su usuario y la fecha de hoy. ¿Continuar?"/>
                    </div>
                    <field name="sgi_reading_ids">
                        <list editable="bottom" create="0" delete="0"
                              decoration-danger="result == 'fuera'" decoration-success="result == 'ok'">
                            <field name="captured" column_invisible="1"/>
                            <field name="section" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="nominal"/>
                            <field name="tolerance"/>
                            <field name="unit"/>
                            <field name="real"/>
                            <field name="result"/>
                            <field name="adjustment"/>
                            <field name="reason_id" options="{'no_create': True}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="ficha_tecnica_acabado_view_form_sgi_dev" model="ir.ui.view">
        <field name="name">ficha.tecnica.acabado.form.sgi.dev</field>
        <field name="model">ficha.tecnica.acabado</field>
        <field name="inherit_id" ref="quimibond_ficha_tecnica_tela.view_ficha_tecnica_acabado_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Control del desarrollo" name="sgi_dev_control">
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="production_id" options="{'no_create': True}"
                                   domain="[('sgi_dev_project_id', '=', project_id)]"/>
                        </group>
                        <group>
                            <field name="sgi_proposed_by_id"/>
                            <field name="sgi_proposed_date"/>
                            <field name="sgi_measured_by_id"/>
                            <field name="sgi_measured_date"/>
                            <field name="sgi_validated_by_id"/>
                            <field name="sgi_validated_date"/>
                        </group>
                    </group>
                    <div class="d-flex gap-2 mb-2">
                        <button name="action_sgi_load_readings" type="object" string="Cargar parámetros" class="btn-secondary" icon="fa-list"/>
                        <button name="action_sgi_propose" type="object" string="Proponer" class="btn-secondary" icon="fa-pencil"
                                invisible="sgi_validated_by_id"/>
                        <button name="action_sgi_measure" type="object" string="Medido por Laboratorio" class="btn-secondary" icon="fa-flask"/>
                        <button name="action_sgi_validate" type="object" string="Validar" class="btn-primary" icon="fa-check"
                                invisible="sgi_validated_by_id or not sgi_proposed_by_id"
                                confirm="Firma la validación de la ficha con su usuario y la fecha de hoy. ¿Continuar?"/>
                    </div>
                    <field name="sgi_reading_ids">
                        <list editable="bottom" create="0" delete="0"
                              decoration-danger="result == 'fuera'" decoration-success="result == 'ok'">
                            <field name="captured" column_invisible="1"/>
                            <field name="section" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="nominal"/>
                            <field name="tolerance"/>
                            <field name="unit"/>
                            <field name="real"/>
                            <field name="result"/>
                            <field name="adjustment"/>
                            <field name="reason_id" options="{'no_create': True}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sgi_dev_process_sheets_wizard_view_form" model="ir.ui.view">
        <field name="name">sgi.dev.process.sheets.wizard.form</field>
        <field name="model">sgi.dev.process.sheets.wizard</field>
        <field name="arch" type="xml">
            <form string="Fichas de proceso">
                <field name="project_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0">
                        <field name="has_sheet" column_invisible="1"/>
                        <field name="can_create" column_invisible="1"/>
                        <field name="stage" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="tejido_id" readonly="1" optional="show"/>
                        <field name="acabado_id" readonly="1" optional="show"/>
                        <field name="status"/>
                        <button name="action_open" type="object" string="Abrir" icon="fa-external-link" invisible="not has_sheet"/>
                        <button name="action_open" type="object" string="Crear" icon="fa-plus" invisible="not can_create"/>
                    </list>
                </field>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
