<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= INDICADOR ================= -->
    <record id="sgi_indicator_view_list" model="ir.ui.view">
        <field name="name">sgi.indicator.list</field>
        <field name="model">sgi.indicator</field>
        <field name="arch" type="xml">
            <!-- 57.170.0: sin el «Nuevo» nativo (ficha cruda); se crea con «Nuevo indicador». -->
            <list string="Indicadores" create="0">
                <!-- D-12 (57.5.0): solo el Administrador SGI; el método lo
                     vuelve a revisar en el servidor. -->
                <header>
                    <!-- 57.167.0: antes era menú. -->
                    <button name="action_sgi_new_indicator" type="object" string="Nuevo indicador"
                            class="btn-primary" display="always" groups="quimibond_sgi.group_sgi_manager"/>
                    <button name="action_sgi_recompute_pending_measures" type="object"
                            string="Recalcular mediciones" display="always"
                            groups="quimibond_sgi.group_sgi_admin"/>
                </header>
                <field name="code"/>
                <field name="name"/>
                <field name="sgi_area_id"/>
                <field name="process_id" optional="show"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="uom" optional="hide"/>
                <field name="target_objective"/>
                <field name="target_acceptable"/>
                <field name="status" widget="badge" optional="show"
                       decoration-success="status == 'oficial'"
                       decoration-muted="status == 'prueba'"/>
                <!-- 57.104.0 (B1): «Sin dato» si ninguna medición tiene dato;
                     el número queda para ordenar. -->
                <field name="sgi_last_value_label" string="Último valor"/>
                <field name="last_value" string="Último valor (número)" optional="hide"/>
                <field name="last_semaphore" widget="badge"
                       decoration-success="last_semaphore == 'verde'"
                       decoration-warning="last_semaphore == 'amarillo'"
                       decoration-danger="last_semaphore == 'rojo'"/>
                <field name="source_type" widget="badge" optional="hide"
                       decoration-success="source_type == 'auto'"
                       decoration-warning="source_type == 'manual'"/>
                <field name="source_info" optional="hide"/>
                <field name="calc_mode" optional="hide"/>
                <field name="calc_status" widget="badge" optional="show"
                       decoration-success="calc_status == 'ok'"
                       decoration-danger="calc_status in ('error', 'sin_formula', 'sin_datos')"
                       decoration-muted="calc_status in ('manual', 'antes')"/>
                <field name="nc_on_red" readonly="1"/>
                <field name="critical" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sgi_indicator_view_form" model="ir.ui.view">
        <field name="name">sgi.indicator.form</field>
        <field name="model">sgi.indicator</field>
        <field name="arch" type="xml">
            <form string="Indicador">
                <header>
                    <!-- 57.178.0: lo pasa su responsable o el dueño del proceso (antes
                         solo MAST); la lista de lo que falta está en la ficha. -->
                    <field name="can_set_official" invisible="1"/>
                    <button name="action_set_official" type="object" string="Pasar a oficial"
                            class="btn-primary" invisible="status == 'oficial' or not can_set_official"
                            confirm="Revisó los registros de una medición contra la realidad y el dato es confiable. Desde ahora sus mediciones se validan solas y un rojo le pide causa y plan (y puede abrir NC). ¿Continuar?"/>
                    <button name="action_set_trial" confirm="El indicador regresa a «prueba». ¿Desea continuar?" type="object" string="Regresar a prueba"
                            invisible="status == 'prueba'"
                            groups="quimibond_sgi.group_sgi_manager"/>
                    <!-- 57.170.0: «Tendencia» es un botón inteligente y la ficha en PDF
                         está en el menú Imprimir (ya no se repite aquí). -->
                    <button name="action_recalculate_now" type="object"
                            string="Recalcular ahora" icon="fa-refresh"
                            invisible="calc_mode == 'manual'"
                            groups="quimibond_sgi.group_sgi_manager"
                            help="Mide el último periodo cerrado con el modo actual, sin esperar al cron. No toca mediciones validadas."/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- 57.150.0 (auditoría UX, fase 3): las NC que levantaron sus rojos. -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trend" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_stat_info"><span class="o_stat_text">Tendencia</span></div>
                        </button>
                        <button name="action_sgi_open_generated_ncs" type="object" class="oe_stat_button"
                                icon="fa-exclamation-triangle" invisible="nc_generated_count == 0">
                            <field name="nc_generated_count" widget="statinfo" string="NC generadas"/>
                        </button>
                    </div>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="responsible_id and process_id">
                        <b>Configuración incompleta:</b> falta el responsable o el proceso; sin
                        proceso, sus rojos no cuentan en la salud del Panel.
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del indicador"/></h1>
                        <h3><field name="code" placeholder="VE-01"/></h3>
                    </div>
                    <!-- 57.178.0: cómo va, en una línea. -->
                    <div class="mb-3" invisible="not id">
                        <span class="text-muted">Último valor: </span>
                        <strong><field name="sgi_last_value_label" class="oe_inline" readonly="1"/></strong>
                        <field name="last_semaphore" widget="badge" class="ms-1" readonly="1"
                               invisible="not last_semaphore"
                               decoration-success="last_semaphore == 'verde'"
                               decoration-warning="last_semaphore == 'amarillo'"
                               decoration-danger="last_semaphore == 'rojo'"/>
                        <span class="text-muted ms-2">· <field name="target_label" class="oe_inline" readonly="1"/></span>
                    </div>
                    <!-- 57.178.0: qué falta para pasarlo a oficial. -->
                    <div class="alert alert-info mb-3" role="status" invisible="status != 'prueba' or not id">
                        <field name="official_ready" invisible="1"/>
                        <field name="last_detail_count" invisible="1"/>
                        <b>En prueba.</b> Sus rojos no piden plan ni abren NC hasta que su responsable
                        o el dueño del proceso lo pase a oficial. Para eso:
                        <ul class="mb-1 mt-1">
                            <li>
                                <i class="fa fa-check text-success me-1" title="Listo" invisible="not official_ok_owner"/>
                                <i class="fa fa-times text-danger me-1" title="Falta" invisible="official_ok_owner"/>
                                Tiene responsable y proceso.
                                <field name="official_ok_owner" invisible="1"/>
                            </li>
                            <li>
                                <i class="fa fa-check text-success me-1" title="Listo" invisible="not official_ok_target"/>
                                <i class="fa fa-times text-danger me-1" title="Falta" invisible="official_ok_target"/>
                                Tiene meta.
                                <field name="official_ok_target" invisible="1"/>
                            </li>
                            <li>
                                <i class="fa fa-check text-success me-1" title="Listo" invisible="not official_ok_value"/>
                                <i class="fa fa-times text-danger me-1" title="Falta" invisible="official_ok_value"/>
                                El cálculo da valor (hay una medición con dato).
                                <field name="official_ok_value" invisible="1"/>
                            </li>
                            <li>
                                <i class="fa fa-eye me-1" title="Revisar"/>
                                Revise los registros de la última medición contra la realidad.
                                <button name="action_view_last_records" type="object" string="Ver registros"
                                        icon="fa-list" class="btn-link p-0 ms-1" invisible="not last_detail_count"/>
                            </li>
                        </ul>
                        <span invisible="not official_ready or not can_set_official">Todo listo: pulse
                            <b>Pasar a oficial</b> arriba.</span>
                    </div>
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="calc_status not in ('error', 'sin_formula', 'sin_datos')">
                        <b>El último cálculo no dio valor:</b>
                        <field name="calc_status" class="d-inline" readonly="1"/> —
                        <field name="calc_message" class="d-inline" readonly="1"/>
                        (<field name="calc_checked" class="d-inline" readonly="1"/>).
                        Corríjalo y pulse «Recalcular ahora».
                        <!-- 57.169.0: lo que falta configurar, a un botón. -->
                        <field name="calc_fix_menu_id" invisible="1"/>
                        <button name="action_open_calc_fix" type="object" string="Dónde se arregla"
                                icon="fa-external-link" class="btn-link" invisible="not calc_fix_menu_id"/>
                    </div>
                    <group>
                        <group string="Clasificación">
                            <field name="objective_id"/>
                            <field name="process_id"/>
                            <field name="sgi_area_id"/>
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="level"/>
                            <field name="frequency"/>
                            <field name="measure_from"/>
                            <field name="snapshot" invisible="calc_mode == 'manual'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Meta">
                            <field name="uom"/>
                            <field name="direction"/>
                            <field name="target_objective" invisible="direction == 'range'" string="Meta final"/>
                            <field name="target_acceptable" invisible="direction == 'range'"
                                   string="Aceptable (meta final)"/>
                            <field name="range_min" invisible="direction != 'range'"
                                   required="direction == 'range'"/>
                            <field name="range_max" invisible="direction != 'range'"
                                   required="direction == 'range'"/>
                            <field name="range_tolerance" invisible="direction != 'range'"/>
                            <field name="nc_on_red"/>
                            <field name="critical" invisible="not nc_on_red"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- 57.178.0: las mediciones primero. -->
                        <page string="Mediciones" name="measures">
                            <!-- V-B11 (57.80.0): de 12 en 12, la más reciente arriba. -->
                            <!-- 57.169.0: sin las de foto de meses pasados. -->
                            <field name="measure_shown_ids" context="{'default_indicator_id': id}">
                                <list editable="bottom" limit="12" default_order="period_date desc"
                                      decoration-success="semaphore == 'verde'"
                                      decoration-warning="semaphore == 'amarillo'"
                                      decoration-danger="semaphore == 'rojo'"
                                      decoration-muted="state == 'sin_dato'">
                                    <field name="period_date"/>
                                    <!-- 57.104.0 (B1): el 0 guardado de una sin dato no se muestra. -->
                                    <field name="value" invisible="state == 'sin_dato'"/>
                                    <field name="numerator" optional="show"/>
                                    <field name="denominator" optional="show"/>
                                    <field name="sample_size" optional="show"/>
                                    <field name="small_sample" optional="hide"/>
                                    <field name="detail_count" column_invisible="1"/>
                                    <button name="action_view_records" type="object"
                                            icon="fa-list" title="Ver registros"
                                            invisible="not detail_count"/>
                                    <field name="uom" column_invisible="1"/>
                                    <field name="semaphore" widget="badge"
                                           decoration-success="semaphore == 'verde'"
                                           decoration-warning="semaphore == 'amarillo'"
                                           decoration-danger="semaphore == 'rojo'"/>
                                    <field name="state"/>
                                    <field name="no_data_reason" widget="badge" optional="show"/>
                                    <field name="note" optional="hide"/>
                                    <field name="alert_id" optional="hide" readonly="1"/>
                                    <button name="action_validate" type="object"
                                            string="Validar" icon="fa-check"
                                            invisible="state == 'validado'"/>
                                </list>
                            </field>
                        </page>
                        <!-- 57.178.0: el cálculo en su pestaña (antes, arriba junto con la meta). -->
                        <page string="Cálculo" name="calculo">
                            <div class="alert alert-warning mb-2" role="alert" invisible="not spec_missing">
                                <b>Le falta para publicar el proceso:</b> <field name="spec_missing" nolabel="1" readonly="1"/>
                            </div>
                            <group string="Cómo se calcula">
                                <field name="calc_mode"/>
                                <field name="window_label"/>
                                <field name="monthly_budget"
                                       invisible="calc_mode != 'presupuesto_ventas'"/>
                                <field name="activity_id"
                                       invisible="calc_mode not in ('actividad_a_tiempo', 'entregable_completo')"
                                       required="calc_mode == 'actividad_a_tiempo'"/>
                                <field name="deliverable_id"
                                       invisible="calc_mode != 'entregable_completo'"/>
                                <field name="measure_split" invisible="calc_mode != 'configurable'"/>
                                <field name="measure_team_ids" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       placeholder="Los equipos de venta de la compañía"
                                       invisible="measure_split != 'team'"/>
                                <field name="split_support" invisible="calc_mode != 'configurable'"
                                       class="text-muted"/>
                                <field name="formula" placeholder="Qué se divide entre qué, en palabras"/>
                                <field name="source" placeholder="De qué registros o documentos sale"/>
                                <field name="baseline_date"/>
                                <field name="baseline_value"/>
                                <field name="target_date"/>
                            </group>
                            <field name="source_type" invisible="1"/>
                            <div class="alert alert-success mb-0" role="alert"
                                 invisible="source_type != 'auto'">
                                <i class="fa fa-cogs" title="Automático"/> <b>Automático</b> — <field name="source_info" readonly="1" nolabel="1"/>
                            </div>
                            <div class="alert alert-warning mb-0" role="alert"
                                 invisible="source_type != 'manual'">
                                <i class="fa fa-pencil" title="Captura manual"/> <b>Captura manual</b> — <field name="source_info" readonly="1" nolabel="1"/>
                            </div>
                        </page>
                        <!-- Trayectoria (antes herencia propia en
                             sgi_indicator_trajectory_views.xml; A-008, 57.24.0). -->
                        <page string="Trayectoria" name="trajectory" invisible="direction == 'range'">
                            <div class="text-muted mb-2">Cada medición se evalúa contra el escalón de su trimestre.</div>
                            <button name="action_generate_trajectory" type="object"
                                    string="Generar trayectoria" class="btn-primary mb-2"
                                    groups="quimibond_sgi.group_sgi_manager"/>
                            <field name="has_trajectory" invisible="1"/>
                            <field name="step_ids" context="{'default_indicator_id': id}">
                                <list editable="bottom" decoration-info="manual">
                                    <field name="name"/>
                                    <field name="date_from" column_invisible="1"/>
                                    <field name="objective"/>
                                    <field name="acceptable"/>
                                    <field name="manual"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <!-- Modo «fórmula configurable» (antes herencia propia en
                             sgi_indicator_formula_views.xml; A-008, 57.23.0). -->
                        <!-- 57.170.0: solo en el modo «fórmula configurable». -->
                        <page string="Fórmula" name="formula" invisible="calc_mode != 'configurable' and not term_ids">
                            <div class="text-muted mb-2">Numerador ÷ denominador; un cambio regresa el indicador a «prueba».</div>
                            <field name="has_formula" invisible="1"/>
                            <field name="can_edit_formula" invisible="1"/>
                            <field name="term_ids" context="{'default_indicator_id': id}"
                                   readonly="not can_edit_formula"/>
                            <field name="formula_text" readonly="1" nolabel="1" invisible="not term_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_indicator_view_search" model="ir.ui.view">
        <field name="name">sgi.indicator.search</field>
        <field name="model">sgi.indicator</field>
        <field name="arch" type="xml">
            <search string="Indicadores">
                <field name="code"/>
                <field name="name"/>
                <field name="sgi_area_id"/>
                <field name="responsible_id"/>
                <filter name="mine" string="Míos"
                        domain="[('responsible_id', '=', uid)]"/>
                <filter name="red" string="En rojo" domain="[('last_semaphore', '=', 'rojo')]"/>
                <filter name="no_calc" string="No calcula" domain="[('calc_status', 'in', ('error', 'sin_formula', 'sin_datos'))]"/>
                <separator/>
                <filter name="vigentes" string="De procesos vigentes"
                        domain="[('sgi_process_active', '=', True)]"/>
                <filter name="pendientes" string="Pendientes de proceso nuevo"
                        domain="[('sgi_process_active', '=', False)]"
                        help="Sin proceso, o su proceso está archivado: esperan al proceso nuevo que los adopte."/>
                <separator/>
                <filter name="oficiales" string="Oficiales"
                        domain="[('status', '=', 'oficial')]"/>
                <filter name="en_prueba" string="En prueba"
                        domain="[('status', '=', 'prueba')]"/>
                <separator/>
                <filter name="automatic" string="Cálculo automático"
                        domain="[('calc_mode','!=','manual')]"/>
                <filter name="nc_active" string="NC automática activa"
                        domain="[('nc_on_red','=',True)]"/>
                <separator/>
                <filter name="inactive" string="Archivados" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_area" string="Área" context="{'group_by': 'sgi_area_id'}"/>
                    <filter name="group_responsible" string="Responsable" context="{'group_by': 'responsible_id'}"/>
                    <filter name="group_process" string="Proceso" context="{'group_by': 'process_id'}"/>
                    <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                    <filter name="group_objective" string="Objetivo" context="{'group_by': 'objective_id'}"/>
                    <filter name="group_calc" string="Modo de cálculo" context="{'group_by': 'calc_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_indicator_action" model="ir.actions.act_window">
        <field name="name">Todos los indicadores</field>
        <field name="res_model">sgi.indicator</field>
        <field name="view_mode">list,sgi_diagram,form,activity</field>
        <field name="search_view_id" ref="sgi_indicator_view_search"/>
        <field name="context">{'search_default_vigentes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Dé de alta un indicador</p>
            <p>Los automáticos se calculan solos de los datos reales de Odoo; capture responsable, objetivo y aceptable, y el semáforo sale solo.</p>
        </field>
    </record>

    <!-- ================= MEDICIONES ================= -->
    <record id="sgi_measure_view_list" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.list</field>
        <field name="model">sgi.indicator.measure</field>
        <field name="arch" type="xml">
            <!-- 57.98.0 (I-06): pendiente en amarillo y capturada en azul (tabla
                 de colores del README); una medición pendiente aún no tiene
                 semáforo, así que no se pisan. -->
            <list string="Mediciones"
                  decoration-success="semaphore == 'verde'"
                  decoration-warning="semaphore == 'amarillo' or state == 'pendiente'"
                  decoration-danger="semaphore == 'rojo'"
                  decoration-info="state == 'capturado'"
                  decoration-muted="state == 'sin_dato'">
                <field name="period_date"/>
                <field name="indicator_id"/>
                <field name="indicator_status" optional="hide"/>
                <!-- 57.104.0 (B1): pendiente y sin dato no tienen valor que mostrar. -->
                <field name="value" invisible="state in ('pendiente', 'sin_dato')"/>
                <!-- 57.169.0: por qué no hay dato (antes solo «Sin dato»). -->
                <field name="no_data_reason" widget="badge" optional="show"
                       decoration-muted="no_data_reason in ('foto', 'antes', 'sin_casos')"
                       decoration-danger="no_data_reason in ('falta_config', 'fuente_vacia')"/>
                <field name="window_label" optional="show"/>
                <field name="numerator" optional="hide"/>
                <field name="denominator" optional="hide"/>
                <field name="sample_size" optional="show"/>
                <field name="small_sample" optional="show"/>
                <field name="detail_count" column_invisible="1"/>
                <button name="action_view_records" type="object" icon="fa-list"
                        title="Ver registros" invisible="not detail_count"/>
                <field name="target_objective"/>
                <!-- 57.101.0 (A1): las dos metas del periodo (respetan las
                     guardadas al validar y los escalones). -->
                <field name="target_acceptable" optional="show"/>
                <field name="source_type" widget="badge"
                       decoration-success="source_type == 'auto'"
                       decoration-warning="source_type == 'manual'"/>
                <field name="semaphore" widget="badge"
                       decoration-success="semaphore == 'verde'"
                       decoration-warning="semaphore == 'amarillo'"
                       decoration-danger="semaphore == 'rojo'"/>
                <field name="plan_required" column_invisible="1"/>
                <field name="plan_done" optional="show" string="Plan"
                       invisible="not plan_required"/>
                <!-- V-M05 (57.80.0): estado como pastilla. -->
                <field name="state" widget="badge"
                       decoration-warning="state == 'pendiente'"
                       decoration-info="state == 'capturado'"
                       decoration-success="state == 'validado'"
                       decoration-muted="state == 'sin_dato'"/>
                <button name="action_view_evidence" type="object" icon="fa-search-plus"
                        title="Ver evidencia" invisible="source_type == 'manual'"/>
                <field name="alert_id" readonly="1"/>
                <button name="action_validate" type="object" string="Validar"
                        icon="fa-check" invisible="state == 'validado'"/>
            </list>
        </field>
    </record>

    <record id="sgi_measure_view_form" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.form</field>
        <field name="model">sgi.indicator.measure</field>
        <field name="arch" type="xml">
            <form string="Medición">
                <header>
                    <!-- V-A06 (57.43.0): un solo primario por estado, en el orden del
                         statusbar (capturar → validar). Valida el responsable del
                         indicador o el Jefe MAST (I-006; el servidor lo revisa). -->
                    <button name="action_capture" type="object" string="Marcar capturado"
                            class="btn-primary" invisible="state != 'pendiente'"/>
                    <button name="action_validate" type="object" string="Validar"
                            class="btn-primary" invisible="state != 'capturado' or not sgi_can_validate"/>
                    <button name="action_recompute_value" type="object"
                            string="Recalcular valor" icon="fa-refresh"
                            invisible="source_type == 'manual' or state == 'validado'"
                            confirm="Se recalcula el valor del periodo con el modo de cálculo ACTUAL del indicador. ¿Continuar?"/>
                    <button name="action_reset" type="object"
                            string="Regresar a pendiente"
                            groups="quimibond_sgi.group_sgi_manager"
                            invisible="state == 'pendiente'"
                            confirm="La medición volverá a Pendiente y dejará de contar como evidencia validada. ¿Continuar?"/>
                    <!-- 57.170.0: «Sin dato» no es un paso del flujo (va como cinta). -->
                    <field name="state" widget="statusbar" statusbar_visible="pendiente,capturado,validado"/>
                </header>
                <sheet>
                    <!-- 57.170.0: ir a los registros y a la evidencia, como botones
                         inteligentes (antes en el encabezado). -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object" class="oe_stat_button" icon="fa-list"
                                invisible="not detail_count">
                            <field name="detail_count" widget="statinfo" string="Registros"/>
                        </button>
                        <button name="action_view_evidence" type="object" class="oe_stat_button" icon="fa-search-plus"
                                invisible="source_type == 'manual'">
                            <div class="o_stat_info"><span class="o_stat_text">Evidencia</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Sin dato" bg_color="text-bg-secondary"
                            invisible="state != 'sin_dato'"/>
                    <div class="oe_title">
                        <label for="indicator_id" string="Indicador"/>
                        <h1><field name="indicator_id"/></h1>
                    </div>
                    <!-- 57.170.0: los cinco avisos (automático, manual, sin dato, muestra
                         chica, congelada) pasan a campos con su ayuda. -->
                    <field name="sgi_targets_frozen" invisible="1"/>
                    <field name="sgi_frozen_direction" invisible="1"/>
                    <group>
                        <group>
                            <field name="source_type" widget="badge"
                                   decoration-success="source_type == 'auto'"
                                   decoration-warning="source_type == 'manual'"/>
                            <field name="source_info" readonly="1"/>
                            <field name="no_data_reason" widget="badge" invisible="state != 'sin_dato'"/>
                            <field name="period_date"/>
                            <field name="value" invisible="state == 'sin_dato'"/>
                            <field name="window_label"/>
                            <field name="uom"/>
                            <field name="numerator"/>
                            <field name="denominator"/>
                            <field name="sample_size"/>
                        </group>
                        <group>
                            <field name="indicator_status" widget="badge"
                                   decoration-success="indicator_status == 'oficial'"
                                   decoration-muted="indicator_status == 'prueba'"/>
                            <!-- 57.100.0 (K-04, I-10): congelada, manda el sentido con el que se validó. -->
                            <field name="target_objective"
                                   invisible="(sgi_targets_frozen and sgi_frozen_direction == 'range') or (not sgi_targets_frozen and direction == 'range')"/>
                            <field name="target_acceptable"
                                   invisible="(sgi_targets_frozen and sgi_frozen_direction == 'range') or (not sgi_targets_frozen and direction == 'range')"/>
                            <field name="direction" invisible="1"/>
                            <field name="range_min" invisible="sgi_targets_frozen or direction != 'range'"/>
                            <field name="range_max" invisible="sgi_targets_frozen or direction != 'range'"/>
                            <field name="sgi_frozen_range_min"
                                   invisible="not sgi_targets_frozen or sgi_frozen_direction != 'range'"/>
                            <field name="sgi_frozen_range_max"
                                   invisible="not sgi_targets_frozen or sgi_frozen_direction != 'range'"/>
                            <field name="sgi_frozen_range_tolerance"
                                   invisible="not sgi_targets_frozen or sgi_frozen_direction != 'range'"/>
                            <field name="semaphore" widget="badge"/>
                            <field name="sgi_frozen_date" invisible="not sgi_targets_frozen"/>
                            <field name="small_sample" invisible="not small_sample"/>
                            <field name="sgi_value_by_hand" invisible="not sgi_value_by_hand"/>
                            <field name="alert_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Desglose (equipo de ventas o mercado)" name="split" invisible="not split_ids">
                        <field name="split_ids" nolabel="1" colspan="2" readonly="1">
                            <list create="0" delete="0"
                                  decoration-danger="semaphore == 'rojo'"
                                  decoration-warning="semaphore == 'amarillo'"
                                  decoration-muted="state == 'sin_dato'">
                                <field name="label"/>
                                <field name="value" invisible="state == 'sin_dato'"/>
                                <field name="uom"/>
                                <field name="numerator" optional="show"/>
                                <field name="denominator" optional="show"/>
                                <field name="sample_size" optional="show"/>
                                <field name="state" optional="hide" widget="badge"
                                       decoration-muted="state == 'sin_dato'"/>
                                <field name="semaphore" widget="badge"
                                       decoration-success="semaphore == 'verde'"
                                       decoration-warning="semaphore == 'amarillo'"
                                       decoration-danger="semaphore == 'rojo'"/>
                                <button name="action_view_evidence" type="object" string="Registros"
                                        icon="fa-list" invisible="not detail_ids"/>
                                <field name="detail_ids" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                    <group string="Fórmula en paralelo" invisible="not parallel_denominator">
                        <field name="parallel_value"/>
                        <field name="parallel_numerator"/>
                        <field name="parallel_denominator"/>
                    </group>
                    <!-- Plan de acción de la medición roja (antes herencia propia en
                         sgi_indicator_plan_views.xml; A-008, 57.25.0). -->
                    <field name="plan_required" invisible="1"/>
                    <field name="plan_done" invisible="1"/>
                    <group string="Plan de acción (medición roja)" invisible="not plan_required">
                        <div class="alert alert-danger mb-2" role="alert" colspan="2"
                             invisible="plan_done">
                            <b>Falta el plan:</b> causa y al menos una acción con responsable y
                            fecha, antes del <field name="plan_due" readonly="1" nolabel="1" class="oe_inline"/>.
                            Después de esa fecha se escala a Dirección.
                        </div>
                        <field name="cause" placeholder="Por qué salió en rojo"/>
                        <field name="action_line_ids" context="{'default_measure_id': id}" nolabel="1" colspan="2">
                            <!-- V-M04 (57.42.0): la misma lista de acciones en las 7 fichas. -->
                            <list editable="bottom" decoration-danger="state == 'vencida'"
                                  decoration-muted="state == 'terminada'">
                                <field name="name"/>
                                <field name="evidence_note" optional="show"/>
                                <field name="responsible_id" widget="many2one_avatar_user"/>
                                <field name="date_commit" widget="remaining_days" invisible="date_done"/>
                                <field name="date_done"/>
                                <field name="progress"/>
                                <field name="state" widget="badge" decoration-success="state == 'terminada'"
                                       decoration-danger="state == 'vencida'" decoration-info="state == 'abierta'"/>
                                <field name="action_type" column_invisible="1"/>
                                <field name="measure_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                    <group string="Nota" name="note">
                        <field name="note" nolabel="1"
                               placeholder="Para un 0 capturado a mano, diga por qué es cero (sin nota no se captura)."/>
                    </group>
                </sheet>
                <!-- V-M16 (57.80.0): quién capturó, corrigió o validó. -->
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_measure_view_graph" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.graph</field>
        <field name="model">sgi.indicator.measure</field>
        <field name="arch" type="xml">
            <graph string="Mediciones" type="line">
                <field name="period_date" interval="month"/>
                <field name="indicator_id"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 57.101.0 (A1): tendencia de los indicadores semanales (una medición
         por semana; el lunes es el periodo). Prioridad 20: la gráfica por
         omisión del modelo sigue siendo la mensual. -->
    <record id="sgi_measure_view_graph_weekly" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.graph.weekly</field>
        <field name="model">sgi.indicator.measure</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <graph string="Mediciones por semana" type="line">
                <field name="period_date" interval="week"/>
                <field name="indicator_id"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sgi_measure_view_pivot" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.pivot</field>
        <field name="model">sgi.indicator.measure</field>
        <field name="arch" type="xml">
            <pivot string="Mediciones">
                <field name="indicator_id" type="row"/>
                <field name="period_date" interval="month" type="col"/>
                <field name="value" type="measure"/>
                <field name="numerator" type="measure"/>
                <field name="denominator" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_measure_view_search" model="ir.ui.view">
        <field name="name">sgi.indicator.measure.search</field>
        <field name="model">sgi.indicator.measure</field>
        <field name="arch" type="xml">
            <search string="Mediciones">
                <field name="indicator_id"/>
                <filter name="mine" string="Míos"
                        domain="[('indicator_id.responsible_id', '=', uid)]"/>
                <filter name="red" string="En rojo" domain="[('semaphore','=','rojo')]"/>
                <filter name="pending" string="Pendientes" domain="[('state','=','pendiente')]"/>
                <filter name="sin_dato" string="Sin dato" domain="[('state','=','sin_dato')]"/>
                <!-- 57.169.0: lo que sí hay que arreglar. -->
                <filter name="no_data_fix" string="Sin dato por arreglar"
                        domain="[('no_data_reason', 'in', ('falta_config', 'fuente_vacia'))]"/>
                <filter name="small" string="Muestra chica" domain="[('small_sample','=',True)]"/>
                <filter name="oficiales" string="De indicadores oficiales"
                        domain="[('indicator_id.status','=','oficial')]"/>
                <filter name="to_validate" string="Por validar"
                        domain="[('state','=','capturado')]"/>
                <!-- 57.101.0 (A1): la tendencia abre con este filtro; un «sin
                     dato» o un pendiente valen 0 y bajaban la línea. Aparte
                     (separador): se combina con Y con los de arriba. -->
                <separator/>
                <filter name="con_dato" string="Con dato"
                        domain="[('state', 'in', ('capturado', 'validado'))]"/>
                <!-- V-M03 (57.43.0): Filtro de fecha nativo. -->
                <separator/>
                <filter name="filter_period" string="Periodo" date="period_date"/>
                <group>
                    <filter name="group_indicator" string="Indicador" context="{'group_by': 'indicator_id'}"/>
                    <filter name="group_period" string="Periodo" context="{'group_by': 'period_date:month'}"/>
                    <filter name="group_semaphore" string="Semáforo" context="{'group_by': 'semaphore'}"/>
                    <filter name="group_no_data" string="Por qué no hay dato" context="{'group_by': 'no_data_reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_measure_action" model="ir.actions.act_window">
        <field name="name">Mediciones</field>
        <field name="res_model">sgi.indicator.measure</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <!-- 57.104.0 (B2): abre con «Con dato» (la gráfica no promedia ceros
             falsos). «Pendientes» y «Con dato» juntos dan una lista vacía. -->
        <field name="context">{'search_default_con_dato': 1, 'search_default_mine': 1}</field>
        <field name="search_view_id" ref="sgi_measure_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay mediciones</p>
            <p>El cron mensual las crea automáticamente; las manuales llegan como actividad a su responsable antes del día 5.</p>
            <p>Abre con las mediciones con dato; quite el filtro para ver las pendientes y las sin dato.</p>
        </field>
    </record>

    <!-- Vista de actividades: el motor del SGI corre sobre actividades y esta
         vista nativa permite gestionarlas por registro y responsable. -->
    <record id="sgi_indicator_view_activity" model="ir.ui.view">
        <field name="name">sgi.indicator.activity</field>
        <field name="model">sgi.indicator</field>
        <field name="arch" type="xml">
            <activity string="Indicadores">
                <templates>
                    <div t-name="activity-box">
                        <div><field name="display_name" display="full"/></div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>
</odoo>
