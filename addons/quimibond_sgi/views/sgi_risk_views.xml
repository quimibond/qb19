<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= CATEGORÍAS ================= -->
    <record id="sgi_risk_category_view_list" model="ir.ui.view">
        <field name="name">sgi.risk.category.list</field>
        <field name="model">sgi.risk.category</field>
        <field name="arch" type="xml">
            <list string="Categorías de riesgo" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- D-014 (57.21.0): búsqueda con filtros y archivados. -->
    <record id="sgi_risk_category_view_search" model="ir.ui.view">
        <field name="name">sgi.risk.category.search</field>
        <field name="model">sgi.risk.category</field>
        <field name="arch" type="xml">
            <search string="Categorías de riesgo">
                <field name="name"/>
                <filter name="inactive" string="Archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="sgi_risk_category_action" model="ir.actions.act_window">
        <field name="name">Categorías de riesgo</field>
        <field name="res_model">sgi.risk.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Catálogo de categorías de riesgo</p>
            <p>Agrupan los riesgos y oportunidades de los procesos (p. ej. operativo, legal, ambiental). Cree la primera con «Nuevo».</p>
        </field>
    </record>

    <!-- ================= RIESGO — FORM ================= -->
    <record id="sgi_risk_view_form" model="ir.ui.view">
        <field name="name">sgi.risk.form</field>
        <field name="model">sgi.risk</field>
        <field name="arch" type="xml">
            <form string="Riesgo / Oportunidad">
                <header>
                    <button name="action_set_en_tratamiento" type="object"
                            string="Iniciar tratamiento" class="btn-primary"
                            invisible="state != 'identificado'"/>
                    <button name="action_set_controlado" type="object"
                            string="Marcar controlado" class="btn-primary"
                            invisible="state != 'en_tratamiento'"/>
                    <!-- D-009 (57.41.0): cerrar y reabrir son del Jefe MAST y del
                         dueño del proceso (el write() lo exige también por RPC). -->
                    <button name="action_set_cerrado" confirm="Se cerrará el riesgo y dejará de revisarse. ¿Desea continuar?" type="object"
                            string="Cerrar" class="btn-primary"
                            invisible="state != 'controlado'"
                            groups="quimibond_sgi.group_sgi_manager,quimibond_sgi.group_sgi_process_owner"/>
                    <button name="action_evaluate" type="object"
                            string="Registrar evaluación" icon="fa-check-square-o"
                            invisible="state == 'cerrado'"
                            help="Sella la evaluación de hoy (probabilidad × impacto) y programa la siguiente en enero o julio."/>
                    <button name="action_set_identificado" confirm="El riesgo se reabre y regresa a «identificado». ¿Desea continuar?" type="object"
                            string="Reabrir"
                            invisible="state != 'cerrado'"
                            groups="quimibond_sgi.group_sgi_manager,quimibond_sgi.group_sgi_process_owner"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="identificado,en_tratamiento,controlado,cerrado"/>
                </header>
                <sheet>
                    <!-- V-A03 (57.41.0): cerrado es evidencia; solo el Jefe MAST lo edita. -->
                    <widget name="web_ribbon" title="Cerrado" bg_color="text-bg-secondary"
                            invisible="state != 'cerrado'"/>
                    <field name="sgi_is_locked" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sgi_ncs" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="sgi_nc_count == 0">
                            <field name="sgi_nc_count" widget="statinfo"
                                   string="NC ligadas"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="sgi_is_locked" placeholder="Aspecto / peligro / situación"/></h1>
                        <h3><field name="folio" readonly="1"/></h3>
                    </div>
                    <!-- 57.96.0 (N-07): el aspecto ambiental vive en la matriz. -->
                    <div class="alert alert-info mb-2" role="status" invisible="instrument != 'ambiental'">
                        La evaluación de este aspecto vive en SGI → Planeación → Aspectos
                        ambientales. Este riesgo guarda sus acciones de tratamiento. Los aspectos nuevos
                        se registran en la matriz, no aquí.
                    </div>
                    <group>
                        <group string="Clasificación">
                            <field name="instrument" readonly="sgi_is_locked"/>
                            <field name="kind" readonly="sgi_is_locked"/>
                            <field name="category_id" readonly="sgi_is_locked"/>
                            <field name="source" readonly="sgi_is_locked"/>
                            <field name="foda_type" readonly="sgi_is_locked" invisible="instrument != 'foda'"
                                   required="instrument == 'foda'"/>
                            <field name="condition" readonly="sgi_is_locked" invisible="instrument != 'iper'"/>
                            <field name="active" invisible="1"/>
                            <field name="has_finished_actions" invisible="1"/>
                        </group>
                        <group string="Ubicación">
                            <field name="process_id" readonly="sgi_is_locked"/>
                            <field name="sgi_area_id" readonly="sgi_is_locked"/>
                            <field name="job_id" readonly="sgi_is_locked"/>
                            <field name="next_review_date" readonly="sgi_is_locked"/>
                            <field name="operational_control_id" readonly="sgi_is_locked"
                                   invisible="instrument != 'ambiental'"/>
                            <field name="sgi_env_aspect_ids" widget="many2many_tags" readonly="1"
                                   invisible="instrument != 'ambiental'"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="consequence" readonly="sgi_is_locked" placeholder="Consecuencia..."/>
                        <field name="existing_controls" readonly="sgi_is_locked" placeholder="Controles existentes..."/>
                        <field name="control_hierarchy" readonly="sgi_is_locked"
                               invisible="instrument == 'foda'"/>
                    </group>
                    <div class="text-muted mb-2" invisible="instrument not in ('ryo', 'ambiental')">
                        Escala 1–5 × 1–5. Nivel de atención: ≥16 Inmediata ·
                        ≥9 Media · ≥4 Intermedia · resto Baja. Un riesgo de
                        atención Inmediata solo se controla/cierra con una
                        acción TERMINADA y el residual a la baja (o justificado).
                    </div>
                    <div class="text-muted mb-2" invisible="instrument != 'iper'">
                        IPER usa escala 1–3 × 1–3 (valores mayores se rechazan).
                        Nivel: ≥6 Alto · ≥3 Medio · resto Bajo. Los riesgos Alto
                        exigen acción terminada y residual a la baja para cerrar.
                        Un IPER Alto tampoco se controla con EPP como único control:
                        declare la jerarquía (eliminación, sustitución, ingeniería,
                        administrativo) en el riesgo o en sus acciones.
                    </div>
                    <div class="text-muted mb-2" invisible="instrument != 'patrimonial'">
                        Escala 1–5 × 1–5. Nivel: ≥15 Alto · ≥6 Medio · resto Bajo.
                    </div>
                    <div class="text-muted mb-2" invisible="not next_review_date">
                        Se avisará al dueño del proceso cuando venza
                        la próxima revisión.
                    </div>
                    <div class="alert alert-info mb-2" role="status"
                         invisible="next_review_date or instrument == 'foda'">
                        <i class="fa fa-lightbulb-o" title="Sugerencia"/> Capture la <b>Próxima revisión</b>: sin ella nadie
                        recibirá el recordatorio de revalorar este riesgo.
                    </div>
                    <group string="Evaluación" invisible="instrument == 'foda'">
                        <group string="Inicial">
                            <field name="last_eval_date" readonly="sgi_is_locked"/>
                            <field name="semaphore" readonly="sgi_is_locked" widget="badge"
                                   decoration-success="semaphore == 'verde'"
                                   decoration-warning="semaphore == 'amarillo'"
                                   decoration-danger="semaphore == 'rojo'"/>
                            <field name="high_without_action" readonly="sgi_is_locked" invisible="not high_without_action"
                                   decoration-danger="high_without_action"/>
                            <field name="eval_probability" readonly="sgi_is_locked"/>
                            <field name="eval_impact" readonly="sgi_is_locked"/>
                            <field name="score" readonly="sgi_is_locked"/>
                            <field name="attention_level" readonly="sgi_is_locked" widget="badge"
                                   decoration-danger="attention_level in ('inmediata','alto')"
                                   decoration-warning="attention_level in ('media','medio')"
                                   decoration-info="attention_level in ('intermedia','bajo','baja')"/>
                        </group>
                        <group string="Residual" invisible="not has_finished_actions">
                            <field name="residual_probability" readonly="sgi_is_locked"/>
                            <field name="residual_impact" readonly="sgi_is_locked"/>
                            <field name="residual_score" readonly="sgi_is_locked"/>
                            <field name="residual_level" readonly="sgi_is_locked" widget="badge"/>
                            <field name="residual_note" readonly="sgi_is_locked"
                                   placeholder="Justificación cuando el riesgo residual no baja (obligatoria para cerrar un riesgo de atención máxima)."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Acciones">
                            <field name="action_line_ids" readonly="sgi_is_locked" context="{'default_risk_id': id}">
                                <!-- V-M04 (57.42.0): la misma lista de acciones en las 7 fichas. -->
                                <list editable="bottom" decoration-danger="state == 'vencida'"
                                      decoration-muted="state == 'terminada'">
                                    <field name="action_type"/>
                                    <field name="name"/>
                                    <field name="control_hierarchy" optional="show"/>
                                    <field name="evidence_note" optional="show"/>
                                    <field name="responsible_id" widget="many2one_avatar_user"/>
                                    <field name="date_commit" widget="remaining_days" invisible="date_done"/>
                                    <field name="date_done"/>
                                    <field name="progress"/>
                                    <field name="state" widget="badge" decoration-success="state == 'terminada'"
                                           decoration-danger="state == 'vencida'" decoration-info="state == 'abierta'"/>
                                    <field name="alert_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= RIESGO — KANBAN por nivel ================= -->
    <record id="sgi_risk_view_kanban" model="ir.ui.view">
        <field name="name">sgi.risk.kanban</field>
        <field name="model">sgi.risk</field>
        <field name="arch" type="xml">
            <kanban default_group_by="attention_level" class="o_kanban_small_column">
                <field name="folio"/>
                <field name="attention_level"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title">
                                <strong><field name="folio"/></strong>
                            </div>
                            <div><field name="name"/></div>
                            <div class="text-muted">
                                <field name="instrument"/> — <field name="process_id"/>
                            </div>
                            <div>Puntaje: <field name="score"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================= RIESGO — LIST ================= -->
    <record id="sgi_risk_view_list" model="ir.ui.view">
        <field name="name">sgi.risk.list</field>
        <field name="model">sgi.risk</field>
        <field name="arch" type="xml">
            <!-- V-B13 (57.80.0): multi_edit para reasignar o mover la próxima revisión de varios. -->
            <list string="Riesgos y oportunidades" multi_edit="1"
                  decoration-danger="attention_level in ('inmediata','alto')"
                  decoration-warning="attention_level in ('media','medio')">
                <field name="folio"/>
                <field name="name"/>
                <field name="instrument"/>
                <field name="kind"/>
                <field name="process_id"/>
                <field name="score"/>
                <field name="attention_level" widget="badge"/>
                <field name="next_review_date" widget="remaining_days" invisible="state == 'cerrado'"/>
                <!-- V-M05 (57.80.0): estado como pastilla. -->
                <field name="state" widget="badge"
                       decoration-warning="state == 'identificado'"
                       decoration-info="state == 'en_tratamiento'"
                       decoration-success="state in ('controlado', 'cerrado')"/>
            </list>
        </field>
    </record>

    <!-- ========= RIESGO — PIVOT instrumento → proceso × nivel ========= -->
    <record id="sgi_risk_view_pivot" model="ir.ui.view">
        <field name="name">sgi.risk.pivot</field>
        <field name="model">sgi.risk</field>
        <field name="arch" type="xml">
            <!-- 57.101.0 (A2): cada instrumento en su bloque de filas; la escala
                 de nivel es distinta por instrumento (R&amp;O y ambiental: baja a
                 inmediata; IPER y patrimonial: bajo a alto). -->
            <pivot string="Mapa de calor">
                <field name="instrument" type="row"/>
                <field name="process_id" type="row"/>
                <field name="attention_level" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_risk_view_search" model="ir.ui.view">
        <field name="name">sgi.risk.search</field>
        <field name="model">sgi.risk</field>
        <field name="arch" type="xml">
            <search string="Riesgos">
                <field name="folio"/>
                <field name="name"/>
                <field name="process_id"/>
                <field name="category_id"/>
                <filter name="vigentes" string="De procesos vigentes"
                        domain="[('sgi_process_active', '=', True)]"/>
                <filter name="pendientes" string="Pendientes de proceso nuevo"
                        domain="[('sgi_process_active', '=', False)]"
                        help="Sin proceso, o su proceso está archivado: esperan al proceso nuevo que los adopte."/>
                <separator/>
                <filter name="ryo" string="R&amp;O" domain="[('instrument','=','ryo')]"/>
                <filter name="iper" string="IPER" domain="[('instrument','=','iper')]"/>
                <filter name="ambiental" string="Ambiental" domain="[('instrument','=','ambiental')]"/>
                <filter name="patrimonial" string="Patrimonial" domain="[('instrument','=','patrimonial')]"/>
                <filter name="foda" string="FODA" domain="[('instrument','=','foda')]"/>
                <separator/>
                <filter name="high" string="Atención alta/inmediata"
                        domain="[('attention_level','in',('inmediata','alto'))]"/>
                <!-- V-M03 (57.43.0): «Míos». -->
                <separator/>
                <filter name="my_processes" string="De mis procesos" domain="['|', ('process_id.owner_id.user_id', '=', uid), ('create_uid', '=', uid)]"/>
                <group>
                    <filter name="group_instrument" string="Instrumento" context="{'group_by': 'instrument'}"/>
                    <filter name="group_process" string="Proceso" context="{'group_by': 'process_id'}"/>
                    <filter name="group_level" string="Nivel" context="{'group_by': 'attention_level'}"/>
                    <filter name="group_category" string="Categoría" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_risk_action" model="ir.actions.act_window">
        <field name="name">Riesgos y oportunidades</field>
        <field name="res_model">sgi.risk</field>
        <field name="view_mode">list,kanban,sgi_diagram,pivot,form,activity</field>
        <field name="search_view_id" ref="sgi_risk_view_search"/>
        <field name="context">{'search_default_vigentes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Capture el primer riesgo u oportunidad</p>
            <p>Los 5 instrumentos en un solo lugar: RyO 5×5, IPER de SST, aspectos ambientales, patrimonial y FODA — con revisión programada.</p>
        </field>
    </record>

    <!-- Vista de actividades: el motor del SGI corre sobre actividades y esta
         vista nativa permite gestionarlas por registro y responsable. -->
    <record id="sgi_risk_view_activity" model="ir.ui.view">
        <field name="name">sgi.risk.activity</field>
        <field name="model">sgi.risk</field>
        <field name="arch" type="xml">
            <activity string="Riesgos">
                <templates>
                    <div t-name="activity-box">
                        <div><field name="display_name" display="full"/></div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>
</odoo>
