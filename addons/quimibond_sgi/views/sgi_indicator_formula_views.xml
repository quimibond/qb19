<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modo «fórmula configurable»: términos en la ficha del indicador -->
    <record id="sgi_indicator_term_view_list" model="ir.ui.view">
        <field name="name">sgi.indicator.term.list</field>
        <field name="model">sgi.indicator.term</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="role"/>
                <field name="model_id" options="{'no_create': True}"/>
                <field name="domain"/>
                <field name="date_field"/>
                <field name="window"/>
                <field name="aggregation"/>
                <field name="field_name"
                       required="aggregation != 'count'"
                       readonly="aggregation == 'count'"/>
                <field name="field_name_2" optional="show"
                       required="aggregation in ('count_delta', 'avg_delta')"
                       readonly="aggregation not in ('count_delta', 'avg_delta')"/>
                <field name="delta_unit" optional="show"
                       readonly="aggregation not in ('count_delta', 'avg_delta')"/>
                <field name="delta_op" optional="show"
                       readonly="aggregation != 'count_delta' or delta_unit in ('next_month_day', 'same_month')"/>
                <field name="delta_value" optional="show"
                       readonly="aggregation != 'count_delta' or delta_unit == 'same_month'"/>
                <field name="factor"/>
            </list>
        </field>
    </record>

</odoo>
