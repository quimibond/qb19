<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 57.125.0 (C1, bloque F): la corrida de muestra se pide desde el proyecto. -->
    <record id="sgi_dev_sample_wizard_view_form" model="ir.ui.view">
        <field name="name">sgi.dev.sample.wizard.form</field>
        <field name="model">sgi.dev.sample.wizard</field>
        <field name="arch" type="xml">
            <!-- 57.154.0: la corrida es la cadena del desarrollo (crudo → teñido → acabado), una orden por
                 artículo; cantidades de atrás hacia adelante con la lista de materiales. -->
            <form string="Pedir corrida de muestra">
                <div class="alert alert-danger" role="alert" invisible="not warning">
                    <strong>No se puede pedir todavía:</strong>
                    <field name="warning" readonly="1" nolabel="1" class="d-block" style="white-space:pre-wrap;"/>
                </div>
                <!-- 57.158.0: avisos de la ficha de la máquina (galga de la circular, carga del jet) sobre la
                     ruta de cada lista; no impiden pedir la corrida. -->
                <div class="alert alert-warning" role="alert" invisible="not machine_warning">
                    <strong>Revise la máquina:</strong>
                    <field name="machine_warning" readonly="1" nolabel="1" class="d-block" style="white-space:pre-wrap;"/>
                </div>
                <group>
                    <group>
                        <field name="project_id" readonly="1"/>
                        <field name="date_planned"/>
                        <field name="suggested_qty"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0"
                          decoration-danger="not bom_id or operation_count == 0 or product_qty &lt;= 0">
                        <field name="sequence" column_invisible="1"/>
                        <field name="product_tmpl_id" column_invisible="1"/>
                        <field name="stage" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="bom_id" options="{'no_create': True}"/>
                        <field name="operation_count"/>
                        <field name="product_qty"/>
                        <field name="product_uom_id"/>
                        <field name="picking_type_id" options="{'no_create': True}"/>
                        <field name="location_dest_id" options="{'no_create': True}"/>
                        <field name="qty_note" optional="show"/>
                    </list>
                </field>
                <field name="suggestion_note" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Crear las órdenes de muestra" class="btn-primary"
                            invisible="warning"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mrp_production_form_view_sgi_dev" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.sgi.dev</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- 57.128.2: pestaña propia. El ancla «//field[@name='origin']» caía en la sub-vista de
                 stock.move de la orden («El campo sgi_dev_project_id no existe en el modelo stock.move»,
                 build de main 2026-10-08 06:08 UTC). El primer <notebook> del documento es el de la orden. -->
            <xpath expr="//notebook" position="inside">
                <page string="Desarrollo" name="sgi_dev" invisible="not sgi_dev_project_id">
                    <group>
                        <group>
                            <field name="sgi_dev_project_id" readonly="1"/>
                            <field name="sgi_dev_task_id" invisible="not sgi_dev_task_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="sgi_dev_issued_by_id" readonly="1"/>
                            <field name="sgi_dev_issued_date" readonly="1"/>
                            <field name="sgi_dev_run_validated_by_id" readonly="1"/>
                            <field name="sgi_dev_run_validated_date" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!-- 57.127.0: validación de la corrida (C1.10); enganche de las fichas de tintorería y acabado. -->
            <xpath expr="//header" position="inside">
                <button name="action_sgi_dev_validate_run" type="object" string="Validar corrida" class="btn-primary"
                        invisible="not sgi_dev_project_id or state != 'done' or sgi_dev_run_validated_by_id"
                        confirm="Firma la validación de la corrida de muestra con su usuario y la fecha de hoy. ¿Continuar?"/>
            </xpath>
        </field>
    </record>
</odoo>
