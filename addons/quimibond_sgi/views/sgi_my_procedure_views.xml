<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====== Pantalla «Mi procedimiento»: solo vistas nativas ======
         Kanban y listas dentro del formulario; los botones son acciones de
         objeto, así que las migas de pan regresan solas. -->
    <!-- ====== Vistas compartidas de sgi.activity.role para «Mi procedimiento» ======
         Las usan la pantalla de Inicio y las pestañas de la ficha del empleado,
         del empleado público y del puesto (kanban_view_ref / list_view_ref). -->
    <record id="sgi_activity_role_view_kanban_mp" model="ir.ui.view">
        <field name="name">sgi.activity.role.kanban.mp</field>
        <field name="model">sgi.activity.role</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- 54.1.0: tarjeta compacta agrupada por cadencia. Arriba lo que
                 se lee de un vistazo (estado, cuándo, qué, dónde en Odoo);
                 el «cómo» siempre visible; el resto del procedimiento se
                 despliega con «Más detalle» (Bootstrap collapse; el kanban
                 no abre la tarjeta al hacer clic en un data-bs-toggle). -->
            <kanban create="1" delete="0" quick_create="0" on_create="quimibond_sgi.sgi_activity_change_action_new"
                    default_group_by="cadence" group_create="0"
                    group_delete="0" group_edit="0" records_draggable="0" class="o_sgi_mp_kanban">
                <field name="mp_status"/>
                <field name="mp_can_go"/>
                <field name="mp_instruction_id"/>
                <field name="mp_external"/>
                <field name="cadence"/>
                <templates>
                    <t t-name="card" class="flex-column p-2">
                        <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                            <field name="mp_status" widget="badge"
                                   decoration-success="mp_status == 'al_dia'"
                                   decoration-danger="mp_status == 'atrasada'"
                                   decoration-muted="mp_status == 'sin_medir'"/>
                            <field name="role" widget="badge"
                                   decoration-success="role == 'ejecuta'"
                                   decoration-warning="role == 'aprueba'"/>
                            <span class="ms-auto text-muted small"><field name="mp_number"/></span>
                        </div>
                        <div class="fw-bold lh-sm"><field name="mp_name"/></div>
                        <div class="text-muted small mb-1">
                            <field name="process_id"/>
                            <t t-if="record.activity_when.raw_value"> · <field name="activity_when"/></t>
                            <t t-if="record.mp_status_detail.raw_value"> · <field name="mp_status_detail"/></t>
                        </div>
                        <div t-if="record.mp_how.raw_value" class="small"><field name="mp_how"/></div>
                        <div t-if="record.mp_where.raw_value" class="small text-muted mt-1">
                            <i class="fa fa-map-marker me-1" title="Dónde"/><field name="mp_where"/>
                        </div>
                        <t t-set="more" t-value="record.mp_check_against.raw_value or record.mp_done.raw_value or record.mp_on_fail.raw_value or record.mp_inputs.raw_value or record.mp_outputs.raw_value or record.mp_related.raw_value or record.mp_escalates.raw_value or record.mp_norms.raw_value"/>
                        <div t-if="more" class="mt-1">
                            <a role="button" class="small text-decoration-none" data-bs-toggle="collapse"
                               t-attf-href="#o_sgi_mp_more_{{record.id.raw_value}}" aria-expanded="false">
                                <i class="fa fa-caret-down me-1" title="Más detalle"/>Más detalle
                            </a>
                            <div class="collapse small mt-1 o_sgi_mp_more" t-attf-id="o_sgi_mp_more_{{record.id.raw_value}}">
                                <div t-if="record.mp_check_against.raw_value"><b>Contra qué se revisa:</b> <field name="mp_check_against"/></div>
                                <div t-if="record.mp_done.raw_value"><b>Terminada cuando:</b> <field name="mp_done"/></div>
                                <div t-if="record.mp_on_fail.raw_value"><b>Si no se puede:</b> <field name="mp_on_fail"/></div>
                                <div t-if="record.mp_inputs.raw_value"><b>Recibe:</b> <field name="mp_inputs"/></div>
                                <div t-if="record.mp_outputs.raw_value"><b>Entrega:</b> <field name="mp_outputs"/></div>
                                <div t-if="record.mp_related.raw_value"><b>Conforme a:</b> <field name="mp_related"/></div>
                                <div t-if="record.mp_norms.raw_value"><b>Cumple con:</b> <field name="mp_norms"/></div>
                                <div t-if="record.mp_escalates.raw_value"><b>Si se atora, escala a:</b> <field name="mp_escalates"/></div>
                            </div>
                        </div>
                        <div class="mt-2 d-flex gap-1 flex-wrap">
                            <button t-if="record.mp_can_go.raw_value" type="object" name="action_mp_go"
                                    class="btn btn-primary btn-sm">
                                <i class="fa fa-play me-1" title="Ir a hacerlo"/>Ir a hacerlo
                            </button>
                            <a t-elif="record.mp_external.raw_value" role="button" aria-disabled="true" class="btn btn-outline-secondary btn-sm disabled">
                                <i class="fa fa-external-link me-1" title="Sistema externo"/>Se hace en <field name="mp_external"/>
                            </a>
                            <button t-if="record.mp_instruction_id.raw_value" type="object" name="action_mp_instruction"
                                    class="btn btn-outline-secondary btn-sm" title="Ver instructivo">
                                <i class="fa fa-book me-1" title="Instructivo"/>Instructivo
                            </button>
                            <button type="object" name="action_mp_propose_change" class="btn btn-link btn-sm"
                                    title="Proponer cambio a esta actividad">
                                <i class="fa fa-lightbulb-o me-1" title="Proponer cambio"/>Proponer cambio
                            </button>
                            <button type="object" name="action_open_activity" class="btn btn-link btn-sm text-muted"
                                    title="Ver actividad">
                                <i class="fa fa-file-text-o" title="Actividad"/>
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 56.7.0: lista de actividades dentro de una ficha (pantalla Mi
         procedimiento y pestaña del empleado / puesto). Una sola definición. -->
    <record id="sgi_activity_role_view_list_mp_embedded" model="ir.ui.view">
        <field name="name">sgi.activity.role.list.mp.embedded</field>
        <field name="model">sgi.activity.role</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="cadence, process_id, activity_id">
                <field name="mp_status" widget="badge"
                       decoration-success="mp_status == 'al_dia'"
                       decoration-danger="mp_status == 'atrasada'"
                       decoration-muted="mp_status == 'sin_medir'"/>
                <field name="mp_number" string="Núm."/>
                <field name="mp_name" string="Actividad"/>
                <field name="process_id"/>
                <field name="cadence" optional="show"/>
                <field name="activity_when" string="Cuándo" optional="show"/>
                <field name="role" widget="badge" optional="show"
                       decoration-success="role == 'ejecuta'"
                       decoration-warning="role == 'aprueba'"/>
                <field name="mp_can_go" column_invisible="1"/>
                <field name="mp_instruction_id" column_invisible="1"/>
                <button name="action_mp_go" type="object" string="Ir a hacerlo"
                        icon="fa-play" class="btn-link" invisible="not mp_can_go"/>
                <button name="action_mp_instruction" type="object" string="Instructivo"
                        icon="fa-book" class="btn-link" invisible="not mp_instruction_id"/>
                <button name="action_mp_propose_change" type="object" string="Proponer cambio"
                        icon="fa-lightbulb-o" class="btn-link"/>
                <button name="action_open_activity" type="object" string="Ver actividad"
                        icon="fa-file-text-o" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="sgi_activity_role_view_list_mp_received" model="ir.ui.view">
        <field name="name">sgi.activity.role.list.mp.received</field>
        <field name="model">sgi.activity.role</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- 56.36.0 (I-012): el estado de la actividad que escala. -->
            <list create="0" delete="0" decoration-danger="mp_status == 'atrasada'">
                <field name="mp_status" widget="badge"
                       decoration-success="mp_status == 'al_dia'"
                       decoration-danger="mp_status == 'atrasada'"
                       decoration-muted="mp_status == 'sin_medir'"/>
                <field name="process_id"/>
                <field name="mp_number" string="Núm."/>
                <field name="mp_name" string="Actividad"/>
                <field name="mp_status_detail" string="Detalle" optional="show"/>
                <field name="after_days" string="Escala a los (días hábiles)"/>
                <button name="action_open_activity" type="object" string="Ver actividad" icon="fa-file-text-o"/>
            </list>
        </field>
    </record>

    <record id="sgi_activity_role_view_list_mp_short" model="ir.ui.view">
        <field name="name">sgi.activity.role.list.mp.short</field>
        <field name="model">sgi.activity.role</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="role" widget="badge"/>
                <field name="process_id"/>
                <field name="mp_number" string="Núm."/>
                <field name="mp_name" string="Actividad"/>
                <field name="condition" optional="show"/>
                <button name="action_open_activity" type="object" string="Ver actividad" icon="fa-file-text-o"/>
            </list>
        </field>
    </record>

    <record id="sgi_my_procedure_view_form" model="ir.ui.view">
        <field name="name">sgi.my.procedure.form</field>
        <field name="model">sgi.my.procedure</field>
        <field name="arch" type="xml">
            <!-- 56.7.0: ficha con pestañas, como la del empleado. Arriba solo
                 lo de la persona (firmar, proponer, imprimir); las
                 actividades se ven al abrir, en la primera pestaña; los
                 botones inteligentes quedan para lo que vive en otra app
                 (pendientes, firmas, indicadores, obligaciones). Publicar y
                 la revisión previa son de MAST: Administración SGI → Firmas
                 de lectura → Publicar Mi procedimiento y la ficha del puesto. -->
            <form string="Mi procedimiento" create="0" delete="0">
                <header>
                    <button name="action_sign" type="object" string="Firmar leído y entendido"
                            class="btn-primary" icon="fa-pencil"
                            invisible="not is_me or ack_state != 'pendiente'"
                            confirm="Confirmo que leí y entendí la revisión vigente de «Mi procedimiento». La firma queda registrada con fecha y hora."/>
                    <button name="action_propose_new_activity" type="object" string="Proponer actividad"
                            icon="fa-lightbulb-o" invisible="not job_id"/>
                    <button name="action_print" type="object" string="Imprimir" icon="fa-print"
                            invisible="not job_id"/>
                    <field name="ack_state" widget="statusbar" statusbar_visible="pendiente,leido"
                           invisible="ack_state in ('sin_publicar', 'no_aplica')"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not no_employee">
                        <i class="fa fa-user-times me-1" title="Sin empleado"/>
                        <strong>Tu usuario no está ligado a un empleado.</strong>
                        Pide a RH que te ligue en tu ficha de empleado para ver tu procedimiento.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <!-- 56.3.0: un solo botón para todos los pendientes,
                             con las atrasadas en rojo. -->
                        <button name="action_show_pending" type="object" class="oe_stat_button"
                                icon="fa-tasks" invisible="pending_total == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="pending_total"/>
                                    <span class="text-danger" invisible="pending_late == 0">
                                        · <field name="pending_late"/> atrasadas</span>
                                </span>
                                <span class="o_stat_text">Pendientes</span>
                            </div>
                        </button>
                        <button name="action_show_acks" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="pending_ack_count == 0">
                            <field name="pending_ack_count" widget="statinfo" string="Firmas pendientes"/>
                        </button>
                        <button name="action_show_indicators" type="object" class="oe_stat_button"
                                icon="fa-tachometer" invisible="indicator_count == 0">
                            <field name="indicator_count" widget="statinfo" string="Indicadores"/>
                        </button>
                        <button name="action_open_obligations" type="object" class="oe_stat_button"
                                icon="fa-list-ul" invisible="not has_obligations">
                            <div class="o_stat_info"><span class="o_stat_text">Obligaciones</span></div>
                        </button>
                        <button name="action_open_doc" type="object" class="oe_stat_button"
                                icon="fa-file-pdf-o" invisible="not doc_id">
                            <div class="o_stat_info"><span class="o_stat_text">Revisión vigente</span></div>
                        </button>
                    </div>
                    <field name="employee_avatar" widget="image" class="oe_avatar" readonly="1"
                           invisible="not employee_id"/>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" readonly="not can_pick" placeholder="Empleado"
                                   domain="[('id', 'in', allowed_employee_ids)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </h1>
                        <h2>
                            <field name="job_id" readonly="not can_pick" placeholder="Puesto"
                                   domain="[('id', 'in', allowed_job_ids)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </h2>
                    </div>
                    <group invisible="not job_id">
                        <group>
                            <field name="boss_id" string="Jefe" options="{'no_open': True}" invisible="not boss_id"/>
                            <field name="department_id" options="{'no_open': True}" invisible="not department_id"/>
                            <field name="family_id" options="{'no_open': True}" invisible="not family_id"/>
                        </group>
                        <group>
                            <field name="process_ids" widget="many2many_tags" options="{'no_create': True}" string="Procesos"/>
                            <field name="ack_label" string="Firma" invisible="not ack_label"/>
                            <field name="epp_label" string="EPP" invisible="not epp_label"/>
                        </group>
                    </group>
                    <notebook invisible="not job_id">
                        <page string="Actividades" name="actividades">
                            <div class="d-flex justify-content-end">
                                <button name="action_show_all" type="object" string="Abrir en pantalla completa"
                                        icon="fa-expand" class="btn-link"/>
                            </div>
                            <field name="role_ids" nolabel="1" readonly="1"
                                   context="{'list_view_ref': 'quimibond_sgi.sgi_activity_role_view_list_mp_embedded'}"/>
                        </page>
                        <page string="Indicadores" name="indicadores" invisible="not indicator_ids">
                            <field name="indicator_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="code" string="Clave"/>
                                    <field name="name"/>
                                    <field name="status" widget="badge" optional="show"
                                           decoration-success="status == 'oficial'"/>
                                    <field name="frequency" optional="show"/>
                                    <field name="target_objective" string="Meta"/>
                                    <field name="last_value"/>
                                    <field name="uom" optional="show"/>
                                    <field name="last_semaphore" widget="badge"
                                           decoration-success="last_semaphore == 'verde'"
                                           decoration-warning="last_semaphore == 'amarillo'"
                                           decoration-danger="last_semaphore == 'rojo'"/>
                                    <button name="action_sgi_measures" type="object" string="Mediciones"
                                            icon="fa-pencil-square-o" class="btn-link"/>
                                    <button name="action_view_trend" type="object" string="Tendencia"
                                            icon="fa-line-chart" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Escalamientos" name="escalamientos" invisible="not received_role_ids">
                            <p class="text-muted">Actividades de otros puestos que escalan a este puesto si se atoran.
                                Las atrasadas van primero; cuando el atraso pasa de sus días hábiles, llegan a Mis pendientes.</p>
                            <div class="d-flex justify-content-end align-items-center gap-2" invisible="received_late_count == 0">
                                <span class="text-danger"><field name="received_late_count" class="oe_inline"/> atrasados</span>
                                <button name="action_show_received" type="object" string="Ver atrasados"
                                        icon="fa-exclamation-triangle" class="btn-link text-danger"/>
                            </div>
                            <field name="received_role_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" decoration-danger="mp_status == 'atrasada'">
                                    <field name="mp_status" widget="badge"
                                           decoration-success="mp_status == 'al_dia'"
                                           decoration-danger="mp_status == 'atrasada'"
                                           decoration-muted="mp_status == 'sin_medir'"/>
                                    <field name="process_id"/>
                                    <field name="mp_number" string="Núm."/>
                                    <field name="mp_name" string="Actividad"/>
                                    <field name="after_days" string="Escala a los (días hábiles)"/>
                                    <button name="action_open_activity" type="object" string="Ver actividad"
                                            icon="fa-file-text-o" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Participa o se entera" name="participa" invisible="not short_role_ids">
                            <field name="short_role_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="role" widget="badge" decoration-info="role == 'participa'"/>
                                    <field name="process_id"/>
                                    <field name="mp_number" string="Núm."/>
                                    <field name="mp_name" string="Actividad"/>
                                    <field name="condition" optional="show"/>
                                    <button name="action_open_activity" type="object" string="Ver actividad"
                                            icon="fa-file-text-o" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentos" name="documentos">
                            <field name="document_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="sgi_title" string="Documento"/>
                                    <field name="sgi_code" string="Clave" optional="show"/>
                                    <field name="sgi_doc_type" string="Tipo"/>
                                    <field name="sgi_revision_label" string="Rev."/>
                                    <button name="action_sgi_view_file" type="object" string="Ver archivo"
                                            icon="fa-file-o" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="EPP" name="epp" invisible="not epp_required and not epp_delivery_ids">
                            <group string="EPP requerido por el puesto" invisible="not epp_required">
                                <field name="epp_required" nolabel="1" readonly="1" colspan="2"/>
                            </group>
                            <field name="epp_delivery_ids" nolabel="1" readonly="1" invisible="not epp_delivery_ids">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="items"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'firmada'"
                                           decoration-warning="state == 'entregada'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Firmas de lectura" name="firmas" invisible="not ack_ids">
                            <field name="ack_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="sgi_code"/>
                                    <field name="document_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'leido'"
                                           decoration-warning="state == 'pendiente'"/>
                                    <field name="ack_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Personas en el puesto" name="personas" invisible="employee_id">
                            <field name="job_employee_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="parent_id" string="Jefe"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sgi_my_procedure_check_view_form" model="ir.ui.view">
        <field name="name">sgi.my.procedure.check.form</field>
        <field name="model">sgi.my.procedure.check</field>
        <field name="arch" type="xml">
            <form string="Revisión previa a publicar" create="0" delete="0">
                <header>
                    <button name="action_publish_all" type="object" string="Publicar todos los puestos"
                            class="btn-primary" icon="fa-users"
                            confirm="Se publica «Mi procedimiento» de TODOS los puestos con roles y personas: revisión nueva solo donde cambió el contenido, y cada revisión nueva deja pendiente el acuse de sus empleados. ¿Continuar?"/>
                </header>
                <sheet>
                    <p class="text-muted">Lo que conviene limpiar antes de publicar «Mi procedimiento» para toda la planta. Un empleado en un puesto duplicado sin roles abre su procedimiento y lo ve vacío.</p>
                    <group>
                        <field name="ready_count"/>
                    </group>
                    <notebook>
                        <page string="Puestos duplicados" name="duplicados">
                            <field name="duplicate_job_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" default_order="name">
                                    <field name="name"/>
                                    <field name="no_of_employee" string="Personas"/>
                                    <field name="sgi_role_count" string="Roles"/>
                                </list>
                            </field>
                        </page>
                        <page string="Empleados sin puesto" name="sin_puesto">
                            <field name="no_job_employee_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="parent_id" string="Jefe"/>
                                </list>
                            </field>
                        </page>
                        <page string="Empleados en un puesto sin roles" name="sin_roles">
                            <field name="job_without_roles_employee_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" default_order="job_id, name">
                                    <field name="name"/>
                                    <field name="job_id"/>
                                    <field name="department_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Puestos con roles pero sin personas" name="sin_personas">
                            <field name="roles_without_people_job_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" default_order="name">
                                    <field name="name"/>
                                    <field name="sgi_role_count" string="Roles"/>
                                    <field name="sgi_family_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ====== Lista de roles del puesto agrupados por cadencia (vista secundaria) ====== -->
    <record id="sgi_activity_role_view_list_my_procedure" model="ir.ui.view">
        <field name="name">sgi.activity.role.list.my.procedure</field>
        <field name="model">sgi.activity.role</field>
        <field name="arch" type="xml">
            <!-- 56.6.2: «Nuevo» abre la propuesta de actividad nueva, igual
                 que el kanban (js_class sgi_my_activities_list). -->
            <list string="Mis actividades" create="1" edit="0" delete="0" js_class="sgi_my_activities_list"
                  default_order="cadence, process_id, activity_id">
                <field name="mp_status" widget="badge"
                       decoration-success="mp_status == 'al_dia'"
                       decoration-danger="mp_status == 'atrasada'"
                       decoration-muted="mp_status == 'sin_medir'"/>
                <field name="mp_number" string="Núm."/>
                <field name="mp_name" string="Actividad"/>
                <field name="process_id"/>
                <field name="cadence"/>
                <field name="activity_when" string="Cuándo" optional="show"/>
                <field name="role" widget="badge" optional="show"
                       decoration-success="role == 'ejecuta'"
                       decoration-warning="role == 'aprueba'"
                       decoration-info="role == 'participa'"/>
                <field name="activity_menu_id" string="Dónde en Odoo" optional="hide"/>
                <field name="condition" optional="hide"/>
                <field name="mp_can_go" column_invisible="1"/>
                <field name="mp_instruction_id" column_invisible="1"/>
                <button name="action_mp_go" type="object" string="Ir a hacerlo"
                        icon="fa-play" class="btn-link" invisible="not mp_can_go"/>
                <button name="action_mp_instruction" type="object" string="Instructivo"
                        icon="fa-book" class="btn-link" invisible="not mp_instruction_id"/>
                <button name="action_mp_propose_change" type="object" string="Proponer cambio"
                        icon="fa-lightbulb-o" class="btn-link"/>
                <button name="action_open_activity" type="object" string="Ver actividad"
                        icon="fa-file-text-o" class="btn-link"/>
            </list>
        </field>
    </record>

    <!-- ====== Mi equipo: lista nativa sobre hr.employee.public ====== -->
    <record id="sgi_my_team_view_list" model="ir.ui.view">
        <field name="name">sgi.my.team.list</field>
        <field name="model">hr.employee.public</field>
        <field name="arch" type="xml">
            <list string="Mi equipo" create="0" delete="0" default_order="name"
                  decoration-danger="sgi_mp_pending_state == 'atrasada'"
                  decoration-warning="sgi_mp_pending_state == 'por_vencer'">
                <header>
                    <button name="action_sgi_team_pending" type="object" string="Pendientes del equipo"
                            icon="fa-tasks" display="always"/>
                </header>
                <field name="name"/>
                <field name="job_id"/>
                <field name="department_id" optional="show"/>
                <field name="parent_id" string="Jefe" optional="show"/>
                <field name="sgi_mp_pending_state" widget="badge"
                       decoration-danger="sgi_mp_pending_state == 'atrasada'"
                       decoration-warning="sgi_mp_pending_state == 'por_vencer'"
                       decoration-success="sgi_mp_pending_state == 'al_dia'"/>
                <field name="sgi_mp_pending_total" sum="Pendientes"/>
                <field name="sgi_mp_pending_late" sum="Atrasados" optional="hide"/>
                <field name="sgi_mp_total" optional="hide"/>
                <field name="sgi_mp_acks_pending" sum="Firmas pendientes" optional="hide"/>
                <field name="sgi_mp_ack_state" widget="badge"
                       decoration-success="sgi_mp_ack_state == 'leido'"
                       decoration-warning="sgi_mp_ack_state == 'pendiente'"/>
                <button name="action_sgi_open_pending" type="object"
                        string="Ver pendientes" icon="fa-tasks"/>
                <button name="action_sgi_open_my_procedure" type="object"
                        string="Ver su procedimiento" icon="fa-eye"/>
            </list>
        </field>
    </record>

    <!-- 54.4.0: Mi equipo abre en organigrama (vista nativa hierarchy, la
         misma del organigrama de Empleados): quién reporta a quién, con el
         estado SGI de cada persona en su tarjeta. -->
    <record id="sgi_my_team_view_hierarchy" model="ir.ui.view">
        <field name="name">sgi.my.team.hierarchy</field>
        <field name="model">hr.employee.public</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids" parent_field="parent_id" icon="fa-users" draggable="0">
                <field name="name"/>
                <field name="job_id"/>
                <field name="avatar_128"/>
                <field name="sgi_mp_pending_total"/>
                <field name="sgi_mp_pending_late"/>
                <field name="sgi_mp_pending_state"/>
                <field name="sgi_mp_acks_pending"/>
                <field name="sgi_mp_ack_state"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div class="d-flex align-items-center gap-2 pb-1">
                            <field name="avatar_128" widget="image" class="o_hierarchy_avatar" options="{'size': [40, 40]}"/>
                            <div class="min-w-0">
                                <div class="fw-bold text-truncate"><field name="name"/></div>
                                <div class="text-muted small text-truncate"><field name="job_id"/></div>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-1 small">
                            <span t-if="record.sgi_mp_pending_state.raw_value == 'atrasada'" class="badge text-bg-danger"
                                  title="Pendientes atrasados">
                                <i class="fa fa-exclamation-circle me-1"/><field name="sgi_mp_pending_total"/> · <field name="sgi_mp_pending_late"/> atrasadas
                            </span>
                            <span t-elif="record.sgi_mp_pending_state.raw_value == 'por_vencer'" class="badge text-bg-warning"
                                  title="Pendientes por vencer">
                                <i class="fa fa-clock-o me-1"/><field name="sgi_mp_pending_total"/> por vencer
                            </span>
                            <span t-elif="record.sgi_mp_pending_total.raw_value" class="badge text-bg-success" title="Pendientes al día">
                                <i class="fa fa-check-circle me-1"/><field name="sgi_mp_pending_total"/> al día
                            </span>
                            <span t-if="record.sgi_mp_acks_pending.raw_value" class="badge text-bg-warning"
                                  title="Firmas de lectura pendientes">
                                <i class="fa fa-pencil me-1"/><field name="sgi_mp_acks_pending"/> firmas
                            </span>
                            <span t-if="record.sgi_mp_ack_state.raw_value == 'pendiente'" class="badge text-bg-light"
                                  title="Mi procedimiento sin firmar">sin firmar</span>
                            <span t-if="record.sgi_mp_ack_state.raw_value == 'sin_publicar'" class="badge text-bg-light"
                                  title="Mi procedimiento sin publicar">sin publicar</span>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <record id="sgi_my_team_view_search" model="ir.ui.view">
        <field name="name">sgi.my.team.search</field>
        <field name="model">hr.employee.public</field>
        <field name="arch" type="xml">
            <search string="Mi equipo">
                <field name="name"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="parent_id" string="Jefe"/>
                <filter name="with_late" string="Con atrasadas" domain="[('sgi_mp_pending_late', '>', 0)]"/>
                <filter name="with_soon" string="Con pendientes por vencer" domain="[('sgi_mp_pending_state', '=', 'por_vencer')]"/>
                <filter name="all_ok" string="Al día" domain="[('sgi_mp_pending_state', '=', 'al_dia')]"/>
                <filter name="with_acks" string="Con firmas pendientes" domain="[('sgi_mp_acks_pending', '>', 0)]"/>
                <filter name="mp_pending" string="Mi procedimiento sin firmar" domain="[('sgi_mp_ack_state', '=', 'pendiente')]"/>
                <filter name="mp_unpublished" string="Mi procedimiento sin publicar" domain="[('sgi_mp_ack_state', '=', 'sin_publicar')]"/>
                <separator/>
                <filter name="my_department" string="Mi departamento"
                        domain="[('department_id.member_ids.user_id', '=', uid)]"/>
                <group>
                    <filter name="group_job" string="Puesto" context="{'group_by': 'job_id'}"/>
                    <filter name="group_department" string="Departamento" context="{'group_by': 'department_id'}"/>
                    <filter name="group_parent" string="Jefe" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <!-- 56.7.0: Inicio → Mis indicadores. Antes el Usuario SGI no tenía
         menú para ver ni capturar sus indicadores (Indicadores y Mediciones
         viven en Administración SGI, solo MAST) y «Ir a hacerlo» de las
         actividades de captura lo mandaba a un menú que no ve. -->
    <!-- 57.43.0 (V-A07): lista propia de «Mis indicadores» (antes la de
         administración: metas, cálculo, fuente), con «Capturar» por renglón. -->
    <record id="sgi_indicator_view_list_mine" model="ir.ui.view">
        <field name="name">sgi.indicator.list.mine</field>
        <field name="model">sgi.indicator</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Mis indicadores" create="0" delete="0"
                  decoration-danger="last_semaphore == 'rojo'">
                <field name="code" string="Clave"/>
                <field name="name"/>
                <field name="uom" optional="show"/>
                <field name="last_value"/>
                <field name="last_semaphore" widget="badge"
                       decoration-success="last_semaphore == 'verde'"
                       decoration-warning="last_semaphore == 'amarillo'"
                       decoration-danger="last_semaphore == 'rojo'"/>
                <field name="sgi_next_pending_date" widget="remaining_days"/>
                <field name="sgi_next_pending_id" column_invisible="1"/>
                <button name="action_sgi_capture" type="object" string="Capturar"
                        icon="fa-pencil-square-o" class="btn-primary"
                        invisible="not sgi_next_pending_id"/>
                <button name="action_sgi_measures" type="object" string="Mediciones"
                        icon="fa-list" class="btn-link"/>
                <button name="action_view_trend" type="object" string="Tendencia"
                        icon="fa-line-chart" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="sgi_indicator_action_mine" model="ir.actions.act_window">
        <field name="name">Mis indicadores</field>
        <field name="res_model">sgi.indicator</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('responsible_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_indicator_view_list_mine')}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tiene indicadores a su cargo</p>
            <p>Los indicadores del SGI los asigna MAST; cuando tenga uno, aquí ve su último valor y con «Capturar» abre la medición que falta.</p>
        </field>
    </record>
</odoo>
