<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sgi_interested_party_view_list" model="ir.ui.view">
        <field name="name">sgi.interested.party.list</field>
        <field name="model">sgi.interested.party</field>
        <field name="arch" type="xml">
            <list string="Partes interesadas">
                <field name="name"/>
                <field name="party_type"/>
                <field name="category"/>
                <field name="needs"/>
                <field name="becomes_requirement" optional="show"/>
                <field name="next_review_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="sgi_interested_party_view_form" model="ir.ui.view">
        <field name="name">sgi.interested.party.form</field>
        <field name="model">sgi.interested.party</field>
        <field name="arch" type="xml">
            <form string="Parte interesada">
                <header>
                    <button name="action_mark_reviewed" type="object"
                            string="Marcar revisada" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Parte interesada…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="party_type"/>
                            <field name="category"/>
                            <field name="becomes_requirement"/>
                        </group>
                        <group string="Revisión periódica (4.1)">
                            <field name="review_frequency_months"/>
                            <field name="last_review_date" readonly="1"/>
                            <field name="next_review_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="needs" placeholder="Qué espera del SGI…"/>
                        <field name="requirement_note" invisible="not becomes_requirement"
                               placeholder="Con qué proceso, documento o control se atiende…"/>
                    </group>
                    <group>
                        <group>
                            <field name="process_ids" widget="many2many_tags"/>
                            <field name="risk_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="legal_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_interested_party_view_search" model="ir.ui.view">
        <field name="name">sgi.interested.party.search</field>
        <field name="model">sgi.interested.party</field>
        <field name="arch" type="xml">
            <search string="Partes interesadas">
                <field name="name"/>
                <filter name="requisito" string="Adoptadas como requisito"
                        domain="[('becomes_requirement', '=', True)]"/>
                <filter name="revision_vencida" string="Revisión vencida"
                        domain="[('next_review_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'party_type'}"/>
                    <filter name="group_category" string="Categoría" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_interested_party_action" model="ir.actions.act_window">
        <field name="name">Partes interesadas</field>
        <field name="res_model">sgi.interested.party</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra el contexto de la organización</p>
            <p>Partes interesadas y sus necesidades y expectativas (ISO §4.2):
            clientes, trabajadores, autoridades, corporativo, comunidad. Marca
            cuáles se adoptan como requisito del SGI y liga sus riesgos y
            requisitos legales. El FODA (§4.1) vive en Riesgos como
            instrumento.</p>
        </field>
    </record>

    <menuitem id="menu_sgi_interested_parties" name="Partes interesadas"
              parent="menu_sgi_panel" action="sgi_interested_party_action"
              sequence="8"/>
</odoo>
