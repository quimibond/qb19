<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 56.5.0: el rol «Aprueba» ligado a la aprobación nativa de Odoo. Una
         sola lista para configurar las aprobaciones de todos los procesos. -->
    <record id="sgi_activity_role_view_list_approval" model="ir.ui.view">
        <field name="name">sgi.activity.role.list.approval</field>
        <field name="model">sgi.activity.role</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <list string="Aprobaciones del SGI" editable="bottom" create="0" delete="0"
                  default_order="process_id, activity_id"
                  decoration-muted="approval_state == 'sin_configurar'"
                  decoration-warning="approval_state in ('sin_aprobadores', 'por_sincronizar')">
                <header>
                    <button name="action_sgi_sync_approval" type="object" string="Sincronizar"
                            icon="fa-refresh"/>
                </header>
                <field name="process_id" readonly="1"/>
                <field name="activity_id" readonly="1"/>
                <field name="target_type" column_invisible="1"/>
                <field name="job_id" readonly="1" string="Puesto que aprueba"/>
                <field name="family_id" readonly="1" optional="hide"/>
                <field name="relative_role" readonly="1" optional="hide"/>
                <field name="condition" readonly="1" string="Condición (texto)" optional="show"/>
                <field name="approval_model_id" options="{'no_create': True}"/>
                <field name="approval_method"/>
                <field name="condition_field_id" options="{'no_create': True}"
                       readonly="not approval_model_id"/>
                <field name="condition_operator" readonly="not condition_field_id"/>
                <field name="condition_value" readonly="not condition_field_id"/>
                <field name="approval_user_ids" widget="many2many_tags" optional="show"/>
                <field name="approval_state" widget="badge"
                       decoration-success="approval_state == 'activa'"
                       decoration-warning="approval_state in ('sin_aprobadores', 'por_sincronizar')"/>
                <field name="approval_entry_count" optional="show"/>
                <field name="approval_last_date" optional="hide"/>
                <field name="approval_rule_id" column_invisible="1"/>
                <button name="action_sgi_sync_approval" type="object" string="Sincronizar" icon="fa-refresh"
                        invisible="approval_state not in ('por_sincronizar', 'activa')"/>
                <button name="action_sgi_open_approval_entries" type="object" string="Ver aprobaciones"
                        icon="fa-check-square-o" invisible="not approval_rule_id"/>
            </list>
        </field>
    </record>

    <record id="sgi_activity_role_view_search_approval" model="ir.ui.view">
        <field name="name">sgi.activity.role.search.approval</field>
        <field name="model">sgi.activity.role</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <search string="Aprobaciones del SGI">
                <field name="activity_id"/>
                <field name="process_id"/>
                <field name="job_id"/>
                <filter name="no_rule" string="Sin regla en Odoo" domain="[('approval_rule_id', '=', False)]"/>
                <filter name="with_rule" string="Con regla en Odoo" domain="[('approval_rule_id', '!=', False)]"/>
                <group>
                    <filter name="group_process" string="Proceso" context="{'group_by': 'process_id'}"/>
                    <filter name="group_job" string="Puesto" context="{'group_by': 'job_id'}"/>
                    <filter name="group_model" string="Documento" context="{'group_by': 'approval_model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_activity_role_action_approval" model="ir.actions.act_window">
        <field name="name">Aprobaciones del SGI</field>
        <field name="res_model">sgi.activity.role</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sgi_activity_role_view_list_approval"/>
        <field name="search_view_id" ref="sgi_activity_role_view_search_approval"/>
        <field name="domain">[('role', '=', 'aprueba'), ('activity_id.active', '=', True)]</field>
        <field name="context">{'search_default_group_process': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin aprobaciones en los procedimientos</p>
            <p>Cada renglón «Aprueba» de una actividad se liga aquí al documento y al botón de
               Odoo que se aprueban; «Sincronizar» crea la regla de aprobación nativa.</p>
        </field>
    </record>
</odoo>
