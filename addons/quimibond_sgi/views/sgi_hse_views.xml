<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 56.21.0: lo que seguía en papel. Estudios de higiene y exámenes
         médicos (E2.31, E2.32), recorrido de la Comisión de Seguridad e
         Higiene (E2.29) y checklists de planta y unidades (S5.15, S5.16,
         S5.20). -->

    <!-- ====== Estudios de higiene y exámenes médicos ====== -->
    <record id="sgi_health_record_view_list" model="ir.ui.view">
        <field name="name">sgi.health.record.list</field>
        <field name="model">sgi.health.record</field>
        <field name="arch" type="xml">
            <list string="Estudios y exámenes" default_order="next_date"
                  decoration-danger="state == 'vencido'" decoration-warning="state == 'por_vencer'">
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="date"/>
                <field name="next_date"/>
                <field name="result" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'vigente'"
                       decoration-warning="state == 'por_vencer'"
                       decoration-danger="state == 'vencido'"/>
            </list>
        </field>
    </record>

    <record id="sgi_health_record_view_form" model="ir.ui.view">
        <field name="name">sgi.health.record.form</field>
        <field name="model">sgi.health.record</field>
        <field name="arch" type="xml">
            <form string="Estudio o examen">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="kind"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="validity_months"/>
                            <field name="next_date"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'vigente'"
                                   decoration-warning="state == 'por_vencer'"
                                   decoration-danger="state == 'vencido'"/>
                            <field name="result"/>
                            <field name="provider_id"/>
                        </group>
                    </group>
                    <group string="Observaciones y restricciones">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <group string="Resultados">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_health_record_view_search" model="ir.ui.view">
        <field name="name">sgi.health.record.search</field>
        <field name="model">sgi.health.record</field>
        <field name="arch" type="xml">
            <search string="Estudios y exámenes">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="department_id"/>
                <filter name="por_vencer" string="Por vencer o vencidos"
                        domain="[('state', 'in', ('por_vencer', 'vencido'))]"/>
                <separator/>
                <filter name="examenes" string="Exámenes médicos" domain="[('kind', '=', 'examen_medico')]"/>
                <filter name="estudios" string="Estudios de higiene" domain="[('kind', '=', 'estudio_higiene')]"/>
                <group>
                    <filter name="group_employee" string="Trabajador" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="Departamento" context="{'group_by': 'department_id'}"/>
                    <filter name="group_name" string="Estudio o examen" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sgi_health_record_action" model="ir.actions.act_window">
        <field name="name">Estudios de higiene y exámenes médicos</field>
        <field name="res_model">sgi.health.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sgi_health_record_view_search"/>
        <field name="context">{'search_default_por_vencer': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra el primer estudio o examen</p>
            <p>Por trabajador: qué se le hizo, cuándo, el resultado y cuándo vence. RH recibe el aviso 30 días antes (E2.31, E2.32).</p>
        </field>
    </record>

    <record id="sgi_hr_employee_view_form_health" model="ir.ui.view">
        <field name="name">hr.employee.form.sgi.health</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Salud ocupacional" name="sgi_health"
                      groups="hr.group_hr_user,quimibond_sgi.group_sgi_manager">
                    <field name="sgi_health_record_ids" context="{'default_employee_id': id}">
                        <list decoration-danger="state == 'vencido'" decoration-warning="state == 'por_vencer'">
                            <field name="kind"/>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="next_date"/>
                            <field name="result"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ====== Recorrido de la Comisión de Seguridad e Higiene ====== -->
    <record id="sgi_csh_inspection_view_list" model="ir.ui.view">
        <field name="name">sgi.csh.inspection.list</field>
        <field name="model">sgi.csh.inspection</field>
        <field name="arch" type="xml">
            <list string="Recorridos de la Comisión">
                <field name="name"/>
                <field name="date"/>
                <field name="area"/>
                <field name="finding_count"/>
                <field name="nc_count"/>
                <field name="state" widget="badge" decoration-success="state == 'cerrado'"/>
            </list>
        </field>
    </record>

    <record id="sgi_csh_inspection_view_form" model="ir.ui.view">
        <field name="name">sgi.csh.inspection.form</field>
        <field name="model">sgi.csh.inspection</field>
        <field name="arch" type="xml">
            <form string="Recorrido de la Comisión de Seguridad e Higiene">
                <header>
                    <button name="action_close" type="object" string="Cerrar recorrido" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_reopen" type="object" string="Reabrir" invisible="state != 'cerrado'"
                            groups="quimibond_sgi.group_sgi_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_ncs" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="not nc_count">
                            <field name="nc_count" widget="statinfo" string="NC"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date" readonly="state == 'cerrado'"/>
                            <field name="area" readonly="state == 'cerrado'"/>
                            <field name="department_ids" widget="many2many_tags" readonly="state == 'cerrado'"/>
                        </group>
                        <group>
                            <field name="participant_ids" widget="many2many_tags" readonly="state == 'cerrado'"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </group>
                    </group>
                    <group string="Hallazgos">
                        <field name="finding_ids" nolabel="1" colspan="2" readonly="state == 'cerrado'">
                            <list editable="bottom" decoration-danger="severity == 'alta'">
                                <field name="sequence" widget="handle"/>
                                <field name="description"/>
                                <field name="location"/>
                                <field name="severity"/>
                                <field name="responsible_id"/>
                                <field name="disposition"/>
                                <field name="justification" invisible="disposition != 'sin_accion'"
                                       required="disposition == 'sin_accion'"/>
                                <field name="alert_id" readonly="1"/>
                                <button name="action_generate_nc" type="object" string="Generar NC"
                                        icon="fa-exclamation-triangle" invisible="alert_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="Acta / observaciones generales">
                        <field name="notes" nolabel="1" readonly="state == 'cerrado'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_csh_inspection_action" model="ir.actions.act_window">
        <field name="name">Recorridos de la Comisión de Seguridad e Higiene</field>
        <field name="res_model">sgi.csh.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra el primer recorrido</p>
            <p>El acta del recorrido con sus integrantes y hallazgos; cada hallazgo se corrige en el momento, se justifica o genera su no conformidad (E2.29).</p>
        </field>
    </record>

    <!-- ====== Checklists de planta y unidades ====== -->
    <record id="sgi_checklist_template_view_list" model="ir.ui.view">
        <field name="name">sgi.checklist.template.list</field>
        <field name="model">sgi.checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklists de mantenimiento">
                <field name="code"/>
                <field name="name"/>
                <field name="frequency"/>
                <field name="equipment_ids" widget="many2many_tags"/>
                <field name="user_id"/>
                <field name="last_run"/>
            </list>
        </field>
    </record>

    <record id="sgi_checklist_template_view_form" model="ir.ui.view">
        <field name="name">sgi.checklist.template.form</field>
        <field name="model">sgi.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist de mantenimiento">
                <header>
                    <button name="action_generate_today" type="object" string="Generar las de hoy"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="frequency"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="maintenance_team_id"/>
                            <field name="user_id"/>
                            <field name="last_run"/>
                        </group>
                    </group>
                    <group string="Quién lo llena (firma con su PIN de empleado)">
                        <field name="employee_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group string="Equipos o unidades">
                        <field name="equipment_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group string="Puntos a revisar">
                        <field name="item_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="hint"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sgi_checklist_template_action" model="ir.actions.act_window">
        <field name="name">Checklists de planta y unidades</field>
        <field name="res_model">sgi.checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define el primer checklist</p>
            <p>Qué se revisa y en qué equipos o unidades. Cada día (o cada lunes) se crea una solicitud de mantenimiento preventivo por equipo con la hoja de puntos (S5.15, S5.16, S5.20).</p>
        </field>
    </record>

    <!-- 56.22.0: lista propia de hojas (quién la llenó, para medir por persona). -->
    <record id="sgi_checklist_request_view_list" model="ir.ui.view">
        <field name="name">maintenance.request.list.sgi.checklist</field>
        <field name="model">maintenance.request</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Hojas de checklist" decoration-danger="sgi_checklist_state == 'con_fallas'"
                  decoration-muted="sgi_checklist_employee_id">
                <field name="sgi_checklist_date"/>
                <field name="sgi_checklist_template_id"/>
                <field name="equipment_id"/>
                <field name="sgi_checklist_state" widget="badge"
                       decoration-success="sgi_checklist_state == 'completo'"
                       decoration-danger="sgi_checklist_state == 'con_fallas'"/>
                <field name="sgi_checklist_employee_id"/>
                <field name="sgi_checklist_done_at" optional="show"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sgi_checklist_request_view_pivot" model="ir.ui.view">
        <field name="name">maintenance.request.pivot.sgi.checklist</field>
        <field name="model">maintenance.request</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Checklists por persona">
                <field name="sgi_checklist_employee_id" type="row"/>
                <field name="sgi_checklist_state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_checklist_request_action" model="ir.actions.act_window">
        <field name="name">Hojas de checklist</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('sgi_checklist_template_id', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_checklist_request_view_list')}),
            (0, 0, {'view_mode': 'form'}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('sgi_checklist_request_view_pivot')})]"/>
    </record>

    <!-- Tableta compartida: solo las hojas de hoy que faltan de firmar. -->
    <record id="sgi_checklist_today_action" model="ir.actions.act_window">
        <field name="name">Checklists de hoy</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sgi_checklist_template_id', '!=', False), ('sgi_checklist_employee_id', '=', False), ('sgi_checklist_date', '=', context_today().strftime('%Y-%m-%d'))]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_checklist_request_view_list')}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay checklists pendientes hoy</p>
            <p>Abre la hoja de tu equipo o unidad, marca cada punto y al final «Terminar checklist» con tu nombre y tu PIN.</p>
        </field>
    </record>

    <record id="sgi_maintenance_request_view_form_checklist" model="ir.ui.view">
        <field name="name">maintenance.request.form.sgi.checklist</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="sgi_checklist_template_id" invisible="1"/>
                <group string="Hoja de checklist" invisible="not sgi_checklist_template_id">
                    <group>
                        <field name="sgi_checklist_date"/>
                        <field name="sgi_checklist_state" widget="badge"
                               decoration-success="sgi_checklist_state == 'completo'"
                               decoration-danger="sgi_checklist_state == 'con_fallas'"/>
                    </group>
                    <group>
                        <field name="sgi_checklist_employee_id" invisible="not sgi_checklist_employee_id"/>
                        <field name="sgi_checklist_done_at" invisible="not sgi_checklist_done_at"/>
                        <button name="action_sgi_checklist_finish" type="object"
                                string="Terminar checklist" class="btn-primary"
                                invisible="sgi_checklist_employee_id"/>
                        <button name="action_sgi_create_correctives" type="object"
                                string="Crear correctivos de las fallas" class="btn-secondary"
                                invisible="sgi_checklist_state != 'con_fallas'"/>
                    </group>
                    <field name="sgi_checklist_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom" create="0" delete="0"
                              decoration-danger="answer == 'falla'">
                            <field name="sequence" column_invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="hint" readonly="1"/>
                            <field name="answer" readonly="parent.sgi_checklist_employee_id"/>
                            <field name="note" readonly="parent.sgi_checklist_employee_id"/>
                            <field name="corrective_request_id" readonly="1"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="sgi_checklist_finish_view_form" model="ir.ui.view">
        <field name="name">sgi.checklist.finish.form</field>
        <field name="model">sgi.checklist.finish</field>
        <field name="arch" type="xml">
            <form string="Terminar checklist">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="allowed_employee_ids" invisible="1"/>
                    <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="pin" password="True"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Terminar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_sgi_health_records" name="Estudios de higiene y exámenes médicos"
              parent="menu_sgi_safety" action="sgi_health_record_action" sequence="40"
              groups="hr.group_hr_user,quimibond_sgi.group_sgi_manager"/>
    <menuitem id="menu_sgi_csh_inspections" name="Recorridos de la Comisión de Seguridad e Higiene"
              parent="menu_sgi_safety" action="sgi_csh_inspection_action" sequence="45"/>
    <menuitem id="menu_sgi_checklist_requests" name="Hojas de checklist (planta y unidades)"
              parent="menu_sgi_safety" action="sgi_checklist_request_action" sequence="50"/>
    <menuitem id="menu_sgi_checklist_today" name="Checklists de hoy"
              parent="maintenance.menu_maintenance_title" action="sgi_checklist_today_action" sequence="1"/>
    <menuitem id="menu_sgi_checklist_templates" name="Checklists de planta y unidades"
              parent="menu_sgi_config" action="sgi_checklist_template_action" sequence="60"/>
</odoo>
