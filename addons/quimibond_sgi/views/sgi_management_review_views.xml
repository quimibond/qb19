<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sgi_management_review_view_form" model="ir.ui.view">
        <field name="name">sgi.management.review.form</field>
        <field name="model">sgi.management.review</field>
        <field name="arch" type="xml">
            <form string="Revisión por la Dirección">
                <header>
                    <button name="action_load_inputs" type="object" string="Cargar entradas"
                            invisible="state != 'borrador'"/>
                    <button name="action_mark_done" type="object" string="Marcar realizada"
                            class="btn-primary" invisible="state != 'borrador'"/>
                    <button name="action_close" type="object" string="Cerrar"
                            invisible="state != 'realizada'"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state == 'borrador'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="folio" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="period_from"/>
                            <field name="period_to"/>
                        </group>
                        <group>
                            <field name="attendee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Entradas (9.3.2)">
                            <group>
                                <field name="prev_agreements_summary"/>
                                <field name="nc_summary"/>
                                <field name="complaints_summary"/>
                                <field name="audit_summary"/>
                                <field name="supplier_summary"/>
                                <field name="env_summary"/>
                                <field name="doc_changes_summary"/>
                                <field name="resources_note"/>
                            </group>
                            <separator string="5. Indicadores en rojo"/>
                            <field name="kpi_red_measure_ids">
                                <list>
                                    <field name="indicator_id"/>
                                    <field name="period_date"/>
                                    <field name="value"/>
                                    <field name="semaphore" widget="badge"/>
                                </list>
                            </field>
                            <separator string="7. Riesgos de atención inmediata/alta"/>
                            <field name="risk_high_ids">
                                <list>
                                    <field name="folio"/>
                                    <field name="name"/>
                                    <field name="instrument"/>
                                    <field name="attention_level" widget="badge"/>
                                    <field name="process_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Acuerdos (salidas)">
                            <field name="agreement_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="responsible_id"/>
                                    <field name="deadline"/>
                                    <field name="task_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_management_review_view_list" model="ir.ui.view">
        <field name="name">sgi.management.review.list</field>
        <field name="model">sgi.management.review</field>
        <field name="arch" type="xml">
            <list string="Revisiones por la Dirección"
                  decoration-muted="state == 'borrador'"
                  decoration-success="state == 'cerrada'">
                <field name="folio"/>
                <field name="date"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'cerrada'"
                       decoration-info="state == 'realizada'"/>
            </list>
        </field>
    </record>

    <record id="sgi_management_review_action" model="ir.actions.act_window">
        <field name="name">Revisión por la Dirección</field>
        <field name="res_model">sgi.management.review</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la Revisión por la Dirección</p>
            <p>El botón Cargar entradas llena las 10 entradas de la norma con los datos reales del periodo. Los acuerdos se vuelven tareas rastreables.</p>
        </field>
    </record>
</odoo>
