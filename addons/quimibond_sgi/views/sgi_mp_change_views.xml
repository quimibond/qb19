<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 56.4.0: la propuesta edita la actividad de verdad (mismos campos que
         la ficha y quién la hace); al aprobarse se aplica sola. -->
    <record id="sgi_activity_change_view_form" model="ir.ui.view">
        <field name="name">sgi.activity.change.form</field>
        <field name="model">sgi.activity.change</field>
        <field name="arch" type="xml">
            <form string="Proponer cambio a mi procedimiento">
                <field name="allowed_process_ids" invisible="1"/>
                <field name="state" invisible="1"/>
                <p class="text-muted">
                    Cambia directamente los campos de la actividad. Tu propuesta va a Aprobaciones
                    («Proponer cambio a mi procedimiento»): la aprueban tu jefe directo y el Jefe MAST
                    y SGI. Al aprobarse, el cambio se aplica solo a la actividad y MAST vuelve a
                    publicar el procedimiento.
                </p>
                <group>
                    <group>
                        <field name="change_type" widget="radio" readonly="not activity_id"/>
                        <field name="activity_id" invisible="not activity_id" options="{'no_open': True}"/>
                        <field name="process_id" readonly="activity_id"
                               required="change_type == 'agregar'"
                               domain="[('id', 'in', allowed_process_ids)] if allowed_process_ids else []"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="job_id" invisible="not job_id" options="{'no_open': True}"/>
                    </group>
                </group>
                <notebook invisible="change_type == 'quitar'">
                    <page string="Qué y cómo" name="que">
                        <group>
                            <field name="name" required="change_type == 'agregar'"/>
                            <field name="description"/>
                            <field name="how_steps" placeholder="1 a 5 pasos cortos"/>
                            <field name="instruction_id" options="{'no_create': True}"/>
                            <field name="format_document_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="related_procedure_id" options="{'no_create': True}"/>
                        </group>
                    </page>
                    <page string="Cuándo y dónde" name="cuando">
                        <group>
                            <group string="Cuándo">
                                <field name="measure_cadence"/>
                                <field name="due_weekday" invisible="measure_cadence != 'semanal'"/>
                                <field name="due_business_day" invisible="measure_cadence != 'mensual'"/>
                            </group>
                            <group string="Dónde">
                                <field name="exec_channel"/>
                                <field name="odoo_menu_id" options="{'no_create': True}"/>
                                <field name="external_system"/>
                                <field name="place_note"/>
                            </group>
                        </group>
                    </page>
                    <page string="Terminado" name="terminado">
                        <group>
                            <field name="check_against"/>
                            <field name="done_criteria"/>
                            <field name="on_fail"/>
                        </group>
                    </page>
                    <page string="Quién la hace" name="quien">
                        <field name="role_line_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="role"/>
                                <field name="target_type"/>
                                <field name="job_id" invisible="target_type != 'job'" options="{'no_create': True}"/>
                                <field name="family_id" invisible="target_type != 'family'" options="{'no_create': True}"/>
                                <field name="relative_role" invisible="target_type != 'relative'"/>
                                <field name="after_days" invisible="role != 'escala'"/>
                                <field name="condition" optional="show"/>
                            </list>
                        </field>
                    </page>
                    <page string="Qué cambia" name="diff">
                        <field name="diff_html" nolabel="1"/>
                    </page>
                </notebook>
                <group>
                    <field name="reason" required="1" placeholder="¿Qué problema resuelve? ¿Qué pasa hoy?"/>
                    <field name="attachment" filename="attachment_name"/>
                    <field name="attachment_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Enviar propuesta" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sgi_approval_request_view_form_mp_change" model="ir.ui.view">
        <field name="name">approval.request.form.sgi.mp.change</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Mi procedimiento" invisible="not sgi_mp_change_type">
                    <field name="sgi_mp_change_type" readonly="1"/>
                    <field name="sgi_activity_id" readonly="1"/>
                    <field name="sgi_mp_apply_scheduled" readonly="1"/>
                </group>
                <field name="sgi_mp_diff_html" nolabel="1" invisible="not sgi_mp_proposal_id" readonly="1"/>
                <field name="sgi_mp_proposal_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
