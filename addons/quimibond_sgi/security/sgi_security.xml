    <!-- ================================================================
         Incidentes y accidentes (D-06 y D-009, entrega 4): todos reportan;
         el reportante edita su incidente mientras siga «Reportado» y después
         lo consulta (causas y acciones) sin editarlo; Jefe MAST y Salud
         ocupacional investigan, cierran y reabren (ver write() de
         sgi.incident); Auditor y Dirección leen todos.
         ================================================================ -->
    <record id="rule_sgi_incident_user_read_own" model="ir.rule">
        <field name="name">SGI: el usuario consulta los incidentes que reportó o donde tiene una acción</field>
        <field name="model_id" ref="model_sgi_incident"/>
