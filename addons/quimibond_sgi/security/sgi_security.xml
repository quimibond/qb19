        <!-- 57.94.0 (U-01): «lo creé yo» no cuenta para lo reportado en SGI en
             planta (lo crea la cuenta compartida de la tableta). -->
        <field name="domain_force">['|', '|', ('reporter_id', '=', user.id), '&amp;', ('create_uid', '=', user.id), ('sgi_pin_tablet_id', '=', False), ('action_line_ids.responsible_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
