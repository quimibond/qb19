    </record>
    <record id="rule_sgi_activity_change_user_write" model="ir.rule">
        <field name="name">SGI: el Usuario SGI escribe cambios a actividades (sin cambio)</field>
        <field name="model_id" ref="model_sgi_activity_change"/>
        <field name="groups" eval="[(4, ref('group_sgi_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_activity_change_role_auditor_no_write" model="ir.rule">
