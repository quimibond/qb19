<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sgi" model="ir.module.category">
        <field name="name">SGI</field>
        <field name="description">Sistema de Gestión Integral</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_sgi" model="res.groups.privilege">
        <field name="name">SGI</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_sgi"/>
    </record>

    <record id="group_sgi_user" model="res.groups">
        <field name="name">Usuario SGI</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),
            (4, ref('quality.group_quality_user')),
            (4, ref('documents.group_documents_user')),
            (4, ref('helpdesk.group_helpdesk_user')),
            (4, ref('project.group_project_user')),
            (3, ref('approvals.group_approval_user'))]"/>
    </record>
    <!-- 56.7.0: Usuario SGI ya NO implica «Aprobaciones / Encargado: aprobar
         todas las solicitudes» (los 30 usuarios veían y gestionaban todas las
         solicitudes de la empresa, compras incluidas). El usuario interno ya
         crea y sigue las suyas y aprueba las que le tocan. (3, …) quita la
         implicación que ya está en la base. -->

    <!-- Auditor SGI (PERM-1, 19.0.48.0.0): SOLO LECTURA. Lee todo el SGI y
         los registros de los procesos auditados (NC, inspecciones,
         documentos, tickets, compras, entregas, órdenes de producción,
         mantenimiento, ventas, encuestas, firmas) y solo escribe hallazgos
         (y la auditoría misma: programa, minutas, checklist). Ya no implica
         Usuario SGI: un auditor que además opera su puesto lleva los dos
         grupos, y lo que escribe lo escribe como usuario, no como auditor. -->
    <record id="group_sgi_auditor" model="res.groups">
        <field name="name">Auditor SGI</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(3, ref('group_sgi_user')), (4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sgi_manager" model="res.groups">
        <field name="name">Jefe MAST y SGI</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(4, ref('group_sgi_user')),
            (4, ref('group_sgi_auditor')),
            (4, ref('quality.group_quality_manager')),
            (4, ref('documents.group_documents_manager')),
            (4, ref('helpdesk.group_helpdesk_manager')),
            (4, ref('project.group_project_manager')),
            (4, ref('approvals.group_approval_manager'))]"/>
    </record>

    <!-- Administrador SGI (fase 1 del catálogo): carga el catálogo por API
         (sgi.process.load_payload), fusiona puestos duplicados y administra
         los tipos de documento. Se asigna a mano. -->
    <record id="group_sgi_admin" model="res.groups">
        <field name="name">Administrador SGI</field>
        <field name="sequence">35</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(4, ref('group_sgi_manager'))]"/>
    </record>

    <record id="group_sgi_director" model="res.groups">
        <field name="name">Dirección de Operaciones (SGI)</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(4, ref('group_sgi_manager'))]"/>
    </record>
    <!-- Multiempresa (fase 1): el grupo tiene 8 empresas en la misma base.
         Vacío = compartido. -->
    <record id="rule_sgi_process_company" model="ir.rule">
        <field name="name">SGI: Procesos por empresa</field>
        <field name="model_id" ref="model_sgi_process"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_process_activity_company" model="ir.rule">
        <field name="name">SGI: Actividades por empresa</field>
        <field name="model_id" ref="model_sgi_process_activity"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_activity_role_company" model="ir.rule">
        <field name="name">SGI: Roles de actividad por empresa</field>
        <field name="model_id" ref="model_sgi_activity_role"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_activity_link_company" model="ir.rule">
        <field name="name">SGI: Ligas entre actividades por empresa</field>
        <field name="model_id" ref="model_sgi_activity_link"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_process_flow_company" model="ir.rule">
        <field name="name">SGI: Flujos entre procesos por empresa</field>
        <field name="model_id" ref="model_sgi_process_flow"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_process_responsibility_company" model="ir.rule">
        <field name="name">SGI: Responsabilidades por empresa</field>
        <field name="model_id" ref="model_sgi_process_responsibility"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_job_family_company" model="ir.rule">
        <field name="name">SGI: Familias de puestos por empresa</field>
        <field name="model_id" ref="model_sgi_job_family"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_activity_exec_stat_company" model="ir.rule">
        <field name="name">SGI: Ejecuciones por empresa</field>
        <field name="model_id" ref="model_sgi_activity_exec_stat"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_deliverable_company" model="ir.rule">
        <field name="name">SGI: Entregables por empresa</field>
        <field name="model_id" ref="model_sgi_deliverable"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_activity_input_company" model="ir.rule">
        <field name="name">SGI: Lo que recibe cada actividad, por empresa</field>
        <field name="model_id" ref="model_sgi_activity_input"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_activity_spec_gap_company" model="ir.rule">
        <field name="name">SGI: Faltantes de especificación por empresa</field>
        <field name="model_id" ref="model_sgi_activity_spec_gap"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_activity_week_stat_company" model="ir.rule">
        <field name="name">SGI: Cumplimiento semanal por empresa</field>
        <field name="model_id" ref="model_sgi_activity_week_stat"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_process_stage_company" model="ir.rule">
        <field name="name">SGI: Etapas por empresa</field>
        <field name="model_id" ref="model_sgi_process_stage"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_document_type_company" model="ir.rule">
        <field name="name">SGI: Tipos de documento por empresa</field>
        <field name="model_id" ref="model_sgi_document_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!-- F-014 / C-012 (auditoría 2026-09, D-03): los 10 modelos del SGI que
         ya tenían empresa y no tenían regla. Globales, como las de arriba:
         vacío = compartido. Los crons corren como superusuario y no las ven.
         Los ~50 modelos sin empresa (indicadores, riesgos, NC, auditorías,
         normas, áreas…) son compartidos a propósito: el SGI es de una sola
         empresa (sgi.config._sgi_company) y no se crean procesos en otra. -->
    <record id="rule_sgi_health_record_company" model="ir.rule">
        <field name="name">SGI: Expedientes de salud por empresa</field>
        <field name="model_id" ref="model_sgi_health_record"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_staff_efficiency_company" model="ir.rule">
        <field name="name">SGI: Eficiencia de personal por empresa</field>
        <field name="model_id" ref="model_sgi_staff_efficiency"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_checklist_template_company" model="ir.rule">
        <field name="name">SGI: Plantillas de checklist por empresa</field>
        <field name="model_id" ref="model_sgi_checklist_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_coa_inbox_company" model="ir.rule">
        <field name="name">SGI: Bandeja de certificados de análisis por empresa</field>
        <field name="model_id" ref="model_sgi_coa_inbox"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_csh_inspection_company" model="ir.rule">
        <field name="name">SGI: Inspecciones de la comisión de seguridad e higiene por empresa</field>
        <field name="model_id" ref="model_sgi_csh_inspection"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_inventory_value_company" model="ir.rule">
        <field name="name">SGI: Valor del inventario por empresa</field>
        <field name="model_id" ref="model_sgi_inventory_value"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_lock_date_log_company" model="ir.rule">
        <field name="name">SGI: Bitácora de fechas de bloqueo por empresa</field>
        <field name="model_id" ref="model_sgi_lock_date_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_machine_sheet_company" model="ir.rule">
        <field name="name">SGI: Hojas de máquina por empresa</field>
        <field name="model_id" ref="model_sgi_machine_sheet"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_sales_budget_company" model="ir.rule">
        <field name="name">SGI: Presupuestos de ventas por empresa</field>
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_sales_budget_line_company" model="ir.rule">
        <field name="name">SGI: Líneas de presupuesto de ventas por empresa</field>
        <field name="model_id" ref="model_sgi_sales_budget_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- 56.7.0 (auditoría funcional 28-sep-2026): el Usuario SGI lee todo el
         SGI pero solo ESCRIBE lo suyo. Las reglas son de escritura/creación
         (perm_read = False) y por grupo: el Jefe MAST tiene su regla abierta,
         y como las reglas de grupo se suman (OR), MAST sigue con todo. -->
    <record id="rule_sgi_measure_user_own" model="ir.rule">
        <field name="name">SGI: el usuario captura solo sus indicadores</field>
        <field name="model_id" ref="model_sgi_indicator_measure"/>
        <field name="groups" eval="[(4, ref('group_sgi_user'))]"/>
        <field name="domain_force">['|', ('indicator_id.responsible_id', '=', user.id), ('indicator_id.process_id.owner_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_sgi_measure_manager_all" model="ir.rule">
        <field name="name">SGI: MAST captura cualquier indicador</field>
        <field name="model_id" ref="model_sgi_indicator_measure"/>
        <field name="groups" eval="[(4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <!-- 56.16.0: el desglose (equipo o mercado) sigue la regla de su medición. -->
    <record id="rule_sgi_measure_split_user_own" model="ir.rule">
        <field name="name">SGI: el usuario recalcula el desglose de solo sus indicadores</field>
        <field name="model_id" ref="model_sgi_indicator_measure_split"/>
        <field name="groups" eval="[(4, ref('group_sgi_user'))]"/>
        <field name="domain_force">['|', ('measure_id.indicator_id.responsible_id', '=', user.id), ('measure_id.indicator_id.process_id.owner_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_sgi_measure_split_manager_all" model="ir.rule">
        <field name="name">SGI: MAST recalcula el desglose de cualquier indicador</field>
        <field name="model_id" ref="model_sgi_indicator_measure_split"/>
        <field name="groups" eval="[(4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_action_line_user_own" model="ir.rule">
        <field name="name">SGI: el usuario edita solo sus acciones</field>
        <field name="model_id" ref="model_sgi_action_line"/>
        <field name="groups" eval="[(4, ref('group_sgi_user'))]"/>
        <field name="domain_force">['|', ('responsible_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_action_line_manager_all" model="ir.rule">
        <field name="name">SGI: MAST edita cualquier acción</field>
        <field name="model_id" ref="model_sgi_action_line"/>
        <field name="groups" eval="[(4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_risk_user_own" model="ir.rule">
        <field name="name">SGI: el usuario edita los riesgos de sus procesos</field>
        <field name="model_id" ref="model_sgi_risk"/>
        <field name="groups" eval="[(4, ref('group_sgi_user'))]"/>
        <field name="domain_force">['|', ('process_id.owner_id.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_risk_manager_all" model="ir.rule">
        <field name="name">SGI: MAST edita cualquier riesgo</field>
        <field name="model_id" ref="model_sgi_risk"/>
        <field name="groups" eval="[(4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_legal_user_own" model="ir.rule">
        <field name="name">SGI: el usuario evalúa solo sus requisitos legales</field>
        <field name="model_id" ref="model_sgi_legal_requirement"/>
        <field name="groups" eval="[(4, ref('group_sgi_user'))]"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_legal_manager_all" model="ir.rule">
        <field name="name">SGI: MAST evalúa cualquier requisito legal</field>
        <field name="model_id" ref="model_sgi_legal_requirement"/>
        <field name="groups" eval="[(4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_legal_eval_user_own" model="ir.rule">
        <field name="name">SGI: el usuario registra evaluaciones de sus requisitos</field>
        <field name="model_id" ref="model_sgi_legal_evaluation"/>
        <field name="groups" eval="[(4, ref('group_sgi_user'))]"/>
        <field name="domain_force">[('requirement_id.responsible_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_legal_eval_manager_all" model="ir.rule">
        <field name="name">SGI: MAST registra cualquier evaluación legal</field>
        <field name="model_id" ref="model_sgi_legal_evaluation"/>
        <field name="groups" eval="[(4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>

    <!-- 56.22.0 · Eficiencias de personal (C4.25 → S4.35). El jefe o
         supervisor de área captura y cierra SOLO la hoja de su departamento
         (el suyo y los que dependen de él, o el que encabeza como jefe); RH la
         recibe. Grupo aparte porque no es un nivel del SGI: se suma al que
         la persona ya tenga. Las reglas van por operación: lee su área, y
         solo edita la hoja mientras está en borrador. RH y MAST tienen su
         regla abierta porque las reglas de grupo se suman (OR). -->
    <record id="res_groups_privilege_sgi_efficiency" model="res.groups.privilege">
        <field name="name">Eficiencias de personal</field>
        <field name="sequence">21</field>
        <field name="category_id" ref="module_category_sgi"/>
    </record>
    <record id="group_sgi_efficiency_capture" model="res.groups">
        <field name="name">Captura de eficiencias (jefe o supervisor de área)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi_efficiency"/>
        <field name="implied_ids" eval="[(4, ref('group_sgi_user'))]"/>
    </record>
    <record id="rule_sgi_staff_eff_capture_read" model="ir.rule">
        <field name="name">SGI: el jefe de área ve las eficiencias de su departamento</field>
        <field name="model_id" ref="model_sgi_staff_efficiency"/>
        <field name="groups" eval="[(4, ref('group_sgi_efficiency_capture'))]"/>
        <field name="domain_force">['|', ('department_id', 'child_of', user.employee_ids.department_id.ids), ('department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_sgi_staff_eff_capture_edit" model="ir.rule">
        <field name="name">SGI: el jefe de área captura la hoja de su departamento en borrador</field>
        <field name="model_id" ref="model_sgi_staff_efficiency"/>
        <field name="groups" eval="[(4, ref('group_sgi_efficiency_capture'))]"/>
        <field name="domain_force">[('state', '=', 'borrador'), '|', ('department_id', 'child_of', user.employee_ids.department_id.ids), ('department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_staff_eff_hr_all" model="ir.rule">
        <field name="name">SGI: RH ve y recibe todas las eficiencias</field>
        <field name="model_id" ref="model_sgi_staff_efficiency"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_sgi_staff_eff_line_capture_read" model="ir.rule">
        <field name="name">SGI: el jefe de área ve los renglones de su departamento</field>
        <field name="model_id" ref="model_sgi_staff_efficiency_line"/>
        <field name="groups" eval="[(4, ref('group_sgi_efficiency_capture'))]"/>
        <field name="domain_force">['|', ('sheet_id.department_id', 'child_of', user.employee_ids.department_id.ids), ('sheet_id.department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_sgi_staff_eff_line_capture_edit" model="ir.rule">
        <field name="name">SGI: el jefe de área captura renglones de su hoja en borrador</field>
        <field name="model_id" ref="model_sgi_staff_efficiency_line"/>
        <field name="groups" eval="[(4, ref('group_sgi_efficiency_capture'))]"/>
        <field name="domain_force">[('sheet_id.state', '=', 'borrador'), '|', ('sheet_id.department_id', 'child_of', user.employee_ids.department_id.ids), ('sheet_id.department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_sgi_staff_eff_line_hr_all" model="ir.rule">
        <field name="name">SGI: RH ve todos los renglones de eficiencias</field>
        <field name="model_id" ref="model_sgi_staff_efficiency_line"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- F-004 (auditoría 2026-09): exámenes médicos y estudios de salud. Antes
         los veía «Empleados / Encargado» (hr.group_hr_user), que en producción
         tiene 20 usuarios de ventas, cobranza, almacén y planta. Grupo propio,
         sin usuarios por default: Dirección decide quién entra (médico de
         planta, coordinación de RH). Implica Usuario SGI para que llegue al
         menú (el raíz del SGI es de Usuario o Auditor); ningún grupo lo
         implica a él, así que nadie entra sin que lo pongan a mano. El Jefe
         MAST conserva su acceso aparte. -->
    <record id="res_groups_privilege_sgi_health" model="res.groups.privilege">
        <field name="name">Salud ocupacional</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="module_category_sgi"/>
    </record>
    <record id="group_sgi_health" model="res.groups">
        <field name="name">Salud ocupacional (SGI)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi_health"/>
        <field name="implied_ids" eval="[(4, ref('group_sgi_user'))]"/>
    </record>
</odoo>
