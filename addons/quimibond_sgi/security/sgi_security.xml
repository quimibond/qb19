        <field name="domain_force">[('state', '=', 'reportado'), '|', ('reporter_id', '=', user.id), '&amp;', ('create_uid', '=', user.id), ('sgi_pin_tablet_id', '=', False)]</field>
        <field name="perm_read" eval="False"/>
