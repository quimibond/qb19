        <field name="model_id" ref="model_sgi_floor_tablet"/>
        <field name="groups" eval="[(4, ref('group_sgi_floor_tablet'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_sgi_floor_tablet_manager" model="ir.rule">
        <field name="name">SGI: MAST y Auditor ven todas las tabletas</field>
        <field name="model_id" ref="model_sgi_floor_tablet"/>
        <field name="groups" eval="[(4, ref('group_sgi_manager')), (4, ref('group_sgi_auditor'))]"/>
