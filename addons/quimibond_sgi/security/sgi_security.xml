    <record id="rule_sgi_activity_link_company" model="ir.rule">
        <field name="name">SGI: Ligas entre actividades por empresa</field>
        <field name="model_id" ref="model_sgi_activity_link"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_process_flow_company" model="ir.rule">
        <field name="name">SGI: Flujos entre procesos por empresa</field>
        <field name="model_id" ref="model_sgi_process_flow"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_process_responsibility_company" model="ir.rule">
        <field name="name">SGI: Responsabilidades por empresa</field>
        <field name="model_id" ref="model_sgi_process_responsibility"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_job_family_company" model="ir.rule">
        <field name="name">SGI: Familias de puestos por empresa</field>
        <field name="model_id" ref="model_sgi_job_family"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_activity_exec_stat_company" model="ir.rule">
        <field name="name">SGI: Ejecuciones por empresa</field>
        <field name="model_id" ref="model_sgi_activity_exec_stat"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_deliverable_company" model="ir.rule">
        <field name="name">SGI: Entregables por empresa</field>
