        <field name="model_id" ref="model_sgi_indicator_measure_split"/>
        <field name="groups" eval="[(4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>
