    <!-- 57.11.0 (A-016): las reglas por empresa de sgi.sales.budget y
         sgi.sales.budget.line las declara quimibond_ventas_presupuesto. -->

    <!-- 56.7.0 (auditoría funcional 28-sep-2026): el Usuario SGI lee todo el
         SGI pero solo ESCRIBE lo suyo. Las reglas son de escritura/creación
         (perm_read = False) y por grupo: el Jefe MAST tiene su regla abierta,
         y como las reglas de grupo se suman (OR), MAST sigue con todo. -->
    <record id="rule_sgi_measure_user_own" model="ir.rule">
        <field name="name">SGI: el usuario captura solo sus indicadores</field>
        <field name="model_id" ref="model_sgi_indicator_measure"/>
        <field name="groups" eval="[(4, ref('group_sgi_user'))]"/>
        <field name="domain_force">['|', ('indicator_id.responsible_id', '=', user.id), ('indicator_id.process_id.owner_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_sgi_measure_manager_all" model="ir.rule">
        <field name="name">SGI: MAST captura cualquier indicador</field>
        <field name="model_id" ref="model_sgi_indicator_measure"/>
        <field name="groups" eval="[(4, ref('group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <!-- 56.16.0: el desglose (equipo o mercado) sigue la regla de su medición. -->
    <record id="rule_sgi_measure_split_user_own" model="ir.rule">
        <field name="name">SGI: el usuario recalcula el desglose de solo sus indicadores</field>
        <field name="model_id" ref="model_sgi_indicator_measure_split"/>
        <field name="groups" eval="[(4, ref('group_sgi_user'))]"/>
        <field name="domain_force">['|', ('measure_id.indicator_id.responsible_id', '=', user.id), ('measure_id.indicator_id.process_id.owner_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_sgi_measure_split_manager_all" model="ir.rule">
