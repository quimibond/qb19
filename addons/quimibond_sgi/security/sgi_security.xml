<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sgi" model="ir.module.category">
        <field name="name">SGI</field>
        <field name="description">Sistema de Gestión Integral</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_sgi" model="res.groups.privilege">
        <field name="name">SGI</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_sgi"/>
    </record>

    <record id="group_sgi_user" model="res.groups">
        <field name="name">Usuario SGI</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),
            (4, ref('quality.group_quality_user')),
            (4, ref('documents.group_documents_user')),
            (4, ref('helpdesk.group_helpdesk_user')),
            (4, ref('project.group_project_user')),
            (3, ref('approvals.group_approval_user'))]"/>
    </record>
    <!-- 56.7.0: Usuario SGI ya NO implica «Aprobaciones / Encargado: aprobar
         todas las solicitudes» (los 30 usuarios veían y gestionaban todas las
         solicitudes de la empresa, compras incluidas). El usuario interno ya
         crea y sigue las suyas y aprueba las que le tocan. (3, …) quita la
         implicación que ya está en la base. -->

    <!-- Auditor SGI (PERM-1, 19.0.48.0.0): SOLO LECTURA. Entrega 4 (decisión
         3 y F-012): lee todo el SGI MENOS salud (sgi.health.record) y salarios
         (sgi.staff.efficiency*, campos de hr.version): no tiene ACL de esos
         modelos. Lo que base.group_user le daba de escritura en el SGI se le
         quita con reglas (ver «Auditor: no escribe» al final). Lee todo el SGI y
         los registros de los procesos auditados (NC, inspecciones,
         documentos, tickets, compras, entregas, órdenes de producción,
         mantenimiento, ventas, encuestas, firmas) y solo escribe hallazgos
         (y la auditoría misma: programa, minutas, checklist). Ya no implica
         Usuario SGI: un auditor que además opera su puesto lleva los dos
         grupos, y lo que escribe lo escribe como usuario, no como auditor. -->
    <record id="group_sgi_auditor" model="res.groups">
        <field name="name">Auditor SGI</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(3, ref('group_sgi_user')), (4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sgi_manager" model="res.groups">
        <field name="name">Jefe MAST y SGI</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(4, ref('group_sgi_user')),
            (4, ref('group_sgi_auditor')),
            (4, ref('quality.group_quality_manager')),
            (4, ref('documents.group_documents_manager')),
            (4, ref('helpdesk.group_helpdesk_manager')),
            (4, ref('project.group_project_manager')),
            (4, ref('approvals.group_approval_manager'))]"/>
    </record>

    <!-- Administrador SGI (fase 1 del catálogo): carga el catálogo por API
         (sgi.process.load_payload), fusiona puestos duplicados y administra
         los tipos de documento. Se asigna a mano. -->
    <record id="group_sgi_admin" model="res.groups">
        <field name="name">Administrador SGI</field>
        <field name="sequence">35</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(4, ref('group_sgi_manager'))]"/>
    </record>

    <!-- F-013 (decisión 3 de la tanda 1, entrega 4): Dirección de Operaciones
         CONSULTA Y APRUEBA, sin permisos de Jefe MAST. Deja de implicar al
         Jefe MAST (el (3, …) quita la implicación que ya está en la base) e
         implica Usuario SGI (su propio trabajo y aprobaciones) y Auditor
         (lectura de todo el SGI menos salud y salarios). Conserva sus ACL
         propias: tablero y revisión por la dirección. -->
    <record id="group_sgi_director" model="res.groups">
        <field name="name">Dirección de Operaciones (SGI)</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_sgi"/>
        <field name="implied_ids" eval="[(3, ref('group_sgi_manager')),
            (4, ref('group_sgi_user')),
            (4, ref('group_sgi_auditor'))]"/>
    </record>
    <!-- Entrega 6 (57.0.0, decisión de Jose): «Dueño de proceso (SGI)». Ve,
         con Auditor, Jefe MAST y Dirección, «Rutina por rutina»,
         «Procedimientos anteriores» y «Avance de la transición» (solo
         lectura). La membresía NO se asigna a mano: la sincroniza
         sgi.process._sgi_sync_process_owner_group() desde el dueño de cada
         proceso activo (al crear o cambiar el dueño, en el post-migrate de
         19.0.57.0.0 y en un cron diario), y quita a quien ya no es dueño.
         Sin privilegio: no sale como nivel en la ficha del usuario. -->
    <record id="group_sgi_process_owner" model="res.groups">
        <field name="name">Dueño de proceso (SGI)</field>
        <field name="implied_ids" eval="[(4, ref('group_sgi_user'))]"/>
    </record>
    <!-- Multiempresa (fase 1): el grupo tiene 8 empresas en la misma base.
