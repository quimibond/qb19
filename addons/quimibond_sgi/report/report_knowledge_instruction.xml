<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DOC-5: PDF del artículo de Knowledge que se congela como instructivo. -->
    <record id="action_report_knowledge_instruction" model="ir.actions.report">
        <field name="name">Instructivo (artículo de Knowledge)</field>
        <field name="model">knowledge.article</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">quimibond_sgi.report_knowledge_instruction_document</field>
        <field name="report_file">quimibond_sgi.report_knowledge_instruction_document</field>
    </record>

    <template id="report_knowledge_instruction_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><span t-out="doc.name"/></h2>
                        <div t-out="doc.body"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
