<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tabla de retención de registros (ISO 7.5.3): se imprime desde la
         lista de documentos (selección múltiple → Imprimir). -->
    <record id="action_report_retention" model="ir.actions.report">
        <field name="name">Tabla de retención de registros</field>
        <field name="model">documents.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">quimibond_sgi.report_retention_document</field>
        <field name="report_file">quimibond_sgi.report_retention_document</field>
        <field name="binding_model_id" ref="documents.model_documents_document"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_retention_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Tabla de retención de registros (ISO 7.5.3)</h2>
                    <table class="table table-sm table-bordered mt-3">
                        <thead>
                            <tr>
                                <th>Clave</th>
                                <th>Documento / registro</th>
                                <th>Tipo</th>
                                <th>Responsable</th>
                                <th class="text-end">Retención (años)</th>
                                <th>Disposición final</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs.sorted(key=lambda d: (d.sgi_code or '~', d.name or ''))" t-as="doc">
                                <td t-out="doc.sgi_code or ''"/>
                                <td t-out="doc.name or ''"/>
                                <td><span t-field="doc.sgi_doc_type"/></td>
                                <td t-out="doc.sgi_owner_id.name or ''"/>
                                <td class="text-end">
                                    <span t-if="doc.sgi_retention_years" t-out="doc.sgi_retention_years"/>
                                    <span t-else="" class="text-danger">SIN DEFINIR</span>
                                </td>
                                <td><span t-field="doc.sgi_disposition"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-muted">Un registro «SIN DEFINIR» no tiene
                    retención capturada: defínala en la ficha SGI del documento
                    (campo «Retención (años)»).</p>
                    <!-- V-M08 (57.44.0): pie «formato controlado» en vivo (se perdió en 57.20.0). -->
                    <t t-call="quimibond_sgi.sgi_format_footer">
                        <t t-set="sgi_rec" t-value="docs[:1]"/>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
