<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_mgmt_review" model="ir.actions.report">
        <field name="name">Acta de revisión por la dirección</field>
        <field name="model">sgi.management.review</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">quimibond_sgi.report_mgmt_review_document</field>
        <field name="report_file">quimibond_sgi.report_mgmt_review_document</field>
        <field name="binding_model_id" ref="model_sgi_management_review"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mgmt_review_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="quimibond_sgi.sgi_report_layout">
                    <!-- 57.98.0 (I-01): layout propio, pie controlado en cada hoja. -->
                    <t t-set="sgi_rec" t-value="doc"/>
                    <t t-set="sgi_fmt_ref" t-value="False"/>
                    <div class="page">
                        <h2 class="text-center">Acta de revisión por la dirección</h2>
                        <table class="table table-sm table-bordered mt-3">
                            <tr>
                                <td><strong>Folio:</strong> <span t-field="doc.folio"/></td>
                                <td><strong>Fecha:</strong> <span t-field="doc.date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Periodo:</strong>
                                    <span t-field="doc.period_from"/> — <span t-field="doc.period_to"/></td>
                                <td><strong>Estado:</strong> <span t-field="doc.state"/></td>
                            </tr>
                        </table>

                        <h4>Asistentes</h4>
                        <p t-out="', '.join(doc.attendee_ids.mapped('name'))"/>

                        <h4>Entradas (9.3.2)</h4>
                        <p><strong>1. Acuerdos previos:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.prev_agreements_summary"/></p>
                        <p><strong>2. No conformidades:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.nc_summary"/></p>
                        <p><strong>3. Reclamaciones:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.complaints_summary"/></p>
                        <p><strong>4. Auditorías:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.audit_summary"/></p>
                        <p><strong>5. Indicadores en rojo:</strong></p>
                        <ul>
                            <li t-foreach="doc.kpi_red_measure_ids" t-as="m">
                                <span t-field="m.indicator_id"/> — <span t-field="m.period_date"/>:
                                <span t-field="m.value"/>
                            </li>
                        </ul>
                        <p><strong>6. Proveedores:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.supplier_summary"/></p>
                        <p><strong>7. Riesgos de atención inmediata/alta:</strong></p>
                        <ul>
                            <li t-foreach="doc.risk_high_ids" t-as="r">
                                <span t-field="r.folio"/> — <span t-field="r.name"/>
                                (<span t-field="r.attention_level"/>)
                            </li>
                        </ul>
                        <p><strong>8. Desempeño ambiental:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.env_summary"/></p>
                        <p><strong>9. Recursos:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.resources_note"/></p>
                        <p><strong>10. Cambios documentales:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.doc_changes_summary"/></p>
                        <p><strong>11. Cumplimiento legal (14001/45001 9.3):</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.legal_summary"/></p>
                        <p><strong>12. Consulta y participación de trabajadores (45001 5.4):</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.participation_summary"/></p>
                        <p><strong>13. Objetivos e indicadores (9.3.2 c):</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.objectives_summary"/></p>
                        <p><strong>14. Satisfacción del cliente:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.satisfaction_summary"/></p>
                        <p><strong>15. Incidentes y desempeño de SST (45001 9.3):</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.incidents_summary"/></p>
                        <p><strong>16. Cambios en el contexto y las partes interesadas (9.3.2 b):</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.context_summary"/></p>
                        <p><strong>17. Aspectos ambientales significativos (14001 9.3):</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.env_aspects_summary"/></p>
                        <p><strong>18. Oportunidades de mejora (9.3.2 f):</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.improvement_summary"/></p>

                        <h4>Conclusiones (9.3.3)</h4>
                        <p><strong>Conveniencia:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.conclusion_suitability"/></p>
                        <p><strong>Adecuación:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.conclusion_adequacy"/></p>
                        <p><strong>Eficacia:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.conclusion_effectiveness"/></p>
                        <p><strong>Mejora, cambios y recursos:</strong><br/>
                            <span style="white-space: pre-line;" t-field="doc.output_needs"/></p>

                        <h4>Acuerdos (salidas)</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr><th>Acuerdo</th><th>Responsable</th><th>Fecha límite</th><th>Estado</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.agreement_ids" t-as="agr">
                                    <td><span t-field="agr.name"/></td>
                                    <td><span t-field="agr.responsible_id"/></td>
                                    <td><span t-field="agr.deadline"/></td>
                                    <td><span t-out="agr.status_label"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h4>Acuerdos abiertos de revisiones anteriores</h4>
                        <p t-if="not doc.carried_agreement_ids">Ninguno.</p>
                        <table t-else="" class="table table-sm table-bordered">
                            <thead>
                                <tr><th>Revisión</th><th>Acuerdo</th><th>Responsable</th><th>Fecha límite</th><th>Estado</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.carried_agreement_ids" t-as="agr">
                                    <td><span t-field="agr.review_id.folio"/></td>
                                    <td><span t-field="agr.name"/></td>
                                    <td><span t-field="agr.responsible_id"/></td>
                                    <td><span t-field="agr.deadline"/></td>
                                    <td><span t-out="agr.status_label"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
