<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DOC-3 (51.0.0): lista maestra de documentos por proceso. -->
    <record id="action_report_master_list" model="ir.actions.report">
        <field name="name">Lista maestra de documentos</field>
        <field name="model">sgi.process</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">quimibond_sgi.report_master_list_document</field>
        <field name="report_file">quimibond_sgi.report_master_list_document</field>
        <field name="print_report_name">'Lista maestra - %s' % (object.code or object.name)</field>
        <field name="binding_model_id" ref="model_sgi_process"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_master_list_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Lista maestra de documentos</h2>
                        <h4 class="text-center">
                            <span t-out="doc.code"/> · <span t-out="doc.name"/>
                        </h4>
                        <p class="text-muted">
                            Dueño del proceso: <span t-out="doc.owner_id.name or '—'"/> ·
                            Impresa el <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                        </p>
                        <t t-set="documents" t-value="doc._sgi_master_list_documents()"/>
                        <p t-if="not documents" class="text-muted">Sin documentos vigentes ligados a este proceso.</p>
                        <table t-if="documents" class="table table-sm table-bordered" style="font-size:10px;">
                            <thead>
                                <tr>
                                    <th>Clave</th><th>Título</th><th>Tipo</th><th>Rev.</th>
                                    <th>Estado</th><th>Vigente desde</th><th>Próxima revisión</th><th>Dueño</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="documents" t-as="d">
                                    <td><span t-out="d.sgi_code"/></td>
                                    <td><span t-out="d.name"/></td>
                                    <td><span t-out="d.sgi_doc_type_id.name or dict(d._fields['sgi_doc_type'].selection).get(d.sgi_doc_type, '')"/></td>
                                    <td><span t-out="d.sgi_revision_label"/></td>
                                    <td><span t-field="d.sgi_state"/></td>
                                    <td><span t-field="d.sgi_issue_date"/></td>
                                    <td><span t-field="d.sgi_next_review_date"/></td>
                                    <td><span t-out="d.sgi_owner_id.name or ''"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-muted" style="font-size:9px;">
                            <span t-out="len(documents)"/> documento(s). Los obsoletos no se listan; se conservan en Documentos con su historial.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- DIR-1 (51.0.0): matriz legal en PDF. -->
    <record id="action_report_legal_matrix" model="ir.actions.report">
        <field name="name">Matriz de requisitos legales</field>
        <field name="model">sgi.legal.requirement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">quimibond_sgi.report_legal_matrix_document</field>
        <field name="report_file">quimibond_sgi.report_legal_matrix_document</field>
        <field name="print_report_name">'Matriz legal'</field>
        <field name="binding_model_id" ref="model_sgi_legal_requirement"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_legal_matrix_document">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[:1]"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Matriz de requisitos legales y otros requisitos</h2>
                    <p class="text-muted text-center">ISO 14001 / 45001 6.1.3 y 9.1.2 · <span t-out="len(docs)"/> requisito(s)</p>
                    <table class="table table-sm table-bordered" style="font-size:9px;">
                        <thead>
                            <tr>
                                <th>Referencia</th><th>Requisito</th><th>Sistema</th><th>Autoridad</th>
                                <th>Responsable</th><th>Cumplimiento</th><th>Última eval.</th>
                                <th>Próxima eval.</th><th>Vence permiso</th><th>Evidencia</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="r">
                                <td><span t-out="r.reference or ''"/></td>
                                <td><span t-out="r.name"/></td>
                                <td><span t-field="r.system"/></td>
                                <td><span t-out="r.authority or ''"/></td>
                                <td><span t-out="r.responsible_id.name or ''"/></td>
                                <td><span t-field="r.compliance_state"/></td>
                                <td><span t-field="r.last_eval_date"/></td>
                                <td><span t-field="r.next_eval_date"/></td>
                                <td><span t-field="r.expiry_date"/></td>
                                <td><span t-out="r.evidence or ''"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
