<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 57.118.0: etiqueta de la muestra física del cliente (cliente, proyecto,
         fecha) para la carpeta de muestras. -->
    <record id="action_report_dev_sample_label" model="ir.actions.report">
        <field name="name">Etiqueta de la muestra</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">quimibond_sgi.report_dev_sample_label_document</field>
        <field name="report_file">quimibond_sgi.report_dev_sample_label_document</field>
        <field name="print_report_name">'Etiqueta muestra - %s' % (object.name or '')</field>
    </record>

    <template id="report_dev_sample_label_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <div style="border:2px solid #000; padding:10px; width:100mm; font-size:12px;">
                            <div style="font-size:16px; font-weight:bold;"><span t-out="doc.partner_id.commercial_partner_id.name or doc.partner_id.name or 'Interno'"/></div>
                            <div><strong>Proyecto:</strong> <span t-out="doc.name"/></div>
                            <div t-if="doc.sgi_ft_folio"><strong>Folio FT:</strong> <span t-out="doc.sgi_ft_folio"/></div>
                            <div><strong>Producto pedido:</strong> <span t-out="doc.sgi_dev_product_name or ''"/></div>
                            <div><strong>Recibida:</strong> <span t-field="doc.sgi_dev_sample_received"/>
                                 <span t-if="doc.sgi_dev_sample_handed"> · <strong>A Diseño:</strong> <span t-field="doc.sgi_dev_sample_handed"/></span></div>
                            <div t-if="doc.sgi_dev_sample_folder"><strong>Carpeta:</strong> <span t-out="doc.sgi_dev_sample_folder"/></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
