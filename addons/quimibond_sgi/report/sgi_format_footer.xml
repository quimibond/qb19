<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pie "formato controlado" para PDFs. Recibe sgi_rec (el registro) y,
         opcional, sgi_fmt_ref (el mapeo por referencia, format_ref_*, cuando el
         modelo imprime más de un formato); la clave y revisión salen del mapeo
         sgi.format.map + Documentos, en vivo. Sin mapeo no pinta nada.
         57.44.0 (V-M08): sirve también para modelos sin el mixin de formato. -->
    <template id="sgi_format_footer">
        <t t-set="sgi_fmt" t-value="sgi_rec and sgi_rec.env['sgi.format.map'].sgi_footer_label(sgi_rec, sgi_fmt_ref or False)"/>
        <div t-if="sgi_fmt" class="text-muted mt-3"
             style="font-size:9px; border-top:1px solid #ddd; padding-top:2px;">
            Formato controlado del SGI: <span class="fw-bold" t-out="sgi_fmt"/> · PNTQ
        </div>
    </template>

    <!-- Reportes nativos -->
    <template id="report_saleorder_document_sgi" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="quimibond_sgi.sgi_format_footer">
                <t t-set="sgi_rec" t-value="doc"/>
            </t>
        </xpath>
    </template>

    <template id="report_purchaseorder_document_sgi" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="quimibond_sgi.sgi_format_footer">
                <t t-set="sgi_rec" t-value="o"/>
            </t>
        </xpath>
    </template>

    <template id="report_delivery_document_sgi" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <p t-if="o.sgi_seal_number" style="margin-top:8px">
                <strong>Sello de embarque:</strong> <span t-field="o.sgi_seal_number"/>
            </p>
            <t t-call="quimibond_sgi.sgi_format_footer">
                <t t-set="sgi_rec" t-value="o"/>
            </t>
        </xpath>
    </template>
</odoo>
