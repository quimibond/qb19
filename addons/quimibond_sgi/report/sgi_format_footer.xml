<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pie "formato controlado" para PDFs. Recibe sgi_rec (el registro); la
         clave y revisión salen del mapeo sgi.format.map + Documentos, en vivo. -->
    <template id="sgi_format_footer">
        <t t-set="sgi_fmt" t-value="sgi_rec and sgi_rec.sudo().sgi_format_info()"/>
        <div t-if="sgi_fmt" class="text-muted mt-3"
             style="font-size:9px; border-top:1px solid #ddd; padding-top:2px;">
            Formato controlado del SGI: <span class="fw-bold" t-out="sgi_fmt"/> · PNTQ
        </div>
    </template>

    <!-- Reportes nativos -->
    <template id="report_saleorder_document_sgi" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="quimibond_sgi.sgi_format_footer">
                <t t-set="sgi_rec" t-value="doc"/>
            </t>
        </xpath>
    </template>

    <template id="report_purchaseorder_document_sgi" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="quimibond_sgi.sgi_format_footer">
                <t t-set="sgi_rec" t-value="o"/>
            </t>
        </xpath>
    </template>

    <template id="report_delivery_document_sgi" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="quimibond_sgi.sgi_format_footer">
                <t t-set="sgi_rec" t-value="o"/>
            </t>
        </xpath>
    </template>

    <!-- Reportes propios del SGI -->
    <template id="report_nc_document_sgi" inherit_id="quimibond_sgi.report_nc_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="quimibond_sgi.sgi_format_footer">
                <t t-set="sgi_rec" t-value="doc"/>
            </t>
        </xpath>
    </template>

    <template id="report_coa_document_sgi" inherit_id="quimibond_sgi.report_coa_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="quimibond_sgi.sgi_format_footer">
                <t t-set="sgi_rec" t-value="doc"/>
            </t>
        </xpath>
    </template>

    <template id="report_mgmt_review_document_sgi" inherit_id="quimibond_sgi.report_mgmt_review_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="quimibond_sgi.sgi_format_footer">
                <t t-set="sgi_rec" t-value="doc"/>
            </t>
        </xpath>
    </template>
</odoo>
