<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qb_obligation_list" model="ir.ui.view">
        <field name="name">qb.obligation.list</field>
        <field name="model">qb.obligation</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'confirmed' and days_overdue > 0"
                  decoration-info="state == 'candidate'"
                  decoration-muted="state in ('done', 'discarded', 'cancelled')">
                <field name="date_deadline"/>
                <field name="days_overdue"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="obligation_type"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="amount_residual" sum="Saldo"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_residual_company" sum="Saldo (MXN)" optional="hide"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'" decoration-warning="state == 'candidate'"
                       decoration-danger="state == 'confirmed'"/>
                <field name="escalated_at" optional="hide"/>
                <field name="source" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_confirm" type="object" string="Confirmar" icon="fa-check" invisible="state != 'candidate'"/>
                <button name="action_open_anchor" type="object" string="Documento" icon="fa-external-link" invisible="not res_id"/>
                <field name="res_id" column_invisible="1"/>
                <field name="res_model" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_qb_obligation_form" model="ir.ui.view">
        <field name="name">qb.obligation.form</field>
        <field name="model">qb.obligation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Sí, es mía" class="btn-primary" invisible="state != 'candidate'"/>
                    <button name="action_ack_done" type="object" string="Ya se cumplió" class="btn-primary" invisible="state not in ('candidate', 'confirmed')"/>
                    <button name="action_discard" type="object" string="Descartar" invisible="state not in ('candidate', 'confirmed')"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state not in ('candidate', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="candidate,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_anchor" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not res_id">
                            <span>Documento</span>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Qué hay que hacer, en corto"/></h1></div>
                    <group>
                        <group string="Los cinco datos">
                            <field name="description"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="evidence_rule_key"/>
                            <field name="date_deadline"/>
                            <field name="weak_key" invisible="not weak_key"/>
                        </group>
                        <group string="Contexto">
                            <field name="obligation_type"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="amount_at_creation"/>
                            <field name="amount_residual"/>
                            <field name="amount_residual_company"/>
                            <field name="days_overdue"/>
                            <field name="source"/>
                            <field name="source_ref"/>
                            <field name="source_thread_key" invisible="not source_thread_key"/>
                        </group>
                    </group>
                    <group>
                        <group string="Confirmación" invisible="state == 'candidate'">
                            <field name="confirmed_by"/>
                            <field name="confirmed_at"/>
                            <field name="discarded_by" invisible="state != 'discarded'"/>
                            <field name="discarded_at" invisible="state != 'discarded'"/>
                            <field name="discard_reason"/>
                        </group>
                        <group string="Cierre" invisible="state != 'done'">
                            <field name="completed_at"/>
                            <field name="close_method"/>
                            <field name="evidence_model"/>
                            <field name="evidence_res_id"/>
                            <field name="evidence_summary"/>
                            <field name="amount_collected"/>
                            <field name="days_to_close"/>
                            <field name="closed_by_cron"/>
                        </group>
                        <group string="Escalación">
                            <field name="escalate_after_days"/>
                            <field name="escalated_at"/>
                            <field name="escalated_to"/>
                            <field name="times_notified"/>
                            <field name="last_notified_at"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qb_obligation_search" model="ir.ui.view">
        <field name="name">qb.obligation.search</field>
        <field name="model">qb.obligation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="source_ref"/>
                <filter name="mine" string="Mis obligaciones" domain="[('user_id', '=', uid)]"/>
                <filter name="open" string="Abiertas" domain="[('state', 'in', ('candidate', 'confirmed'))]"/>
                <filter name="candidate" string="Por confirmar" domain="[('state', '=', 'candidate')]"/>
                <filter name="overdue" string="Vencidas" domain="[('state', '=', 'confirmed'), ('days_overdue', '>', 0)]"/>
                <filter name="escalated" string="Escaladas" domain="[('escalated_at', '!=', False), ('state', 'in', ('candidate', 'confirmed'))]"/>
                <filter name="done" string="Cumplidas" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="collection" string="Cobranza" domain="[('obligation_type', 'like', 'collection.')]"/>
                <separator/>
                <filter name="created" string="Fecha de creación" date="create_date"/>
                <separator/>
                <filter name="group_partner" string="Agrupar por cliente" context="{'group_by': 'partner_id'}"/>
                <filter name="group_user" string="Agrupar por dueño" context="{'group_by': 'user_id'}"/>
                <filter name="group_state" string="Agrupar por estado" context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Agrupar por tipo" context="{'group_by': 'obligation_type'}"/>
                <filter name="group_week" string="Agrupar por semana de creación" context="{'group_by': 'create_date:week'}"/>
            </search>
        </field>
    </record>

    <record id="view_qb_obligation_pivot" model="ir.ui.view">
        <field name="name">qb.obligation.pivot</field>
        <field name="model">qb.obligation</field>
        <field name="arch" type="xml">
            <pivot string="Métricas">
                <field name="create_date" interval="week" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_collected" type="measure"/>
                <field name="days_to_close" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_qb_obligation" model="ir.actions.act_window">
        <field name="name">Obligaciones</field>
        <field name="res_model">qb.obligation</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'search_default_open': 1, 'search_default_group_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin obligaciones abiertas</p>
            <p>Las de cobranza nacen solas de las facturas vencidas cuando la compañía tiene dueño de cobranza configurado.</p>
        </field>
    </record>

    <record id="action_qb_obligation_mine" model="ir.actions.act_window">
        <field name="name">Mis obligaciones</field>
        <field name="res_model">qb.obligation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_mine': 1, 'search_default_open': 1, 'search_default_group_partner': 1}</field>
    </record>

    <record id="action_qb_obligation_metrics" model="ir.actions.act_window">
        <field name="name">Métricas de obligaciones</field>
        <field name="res_model">qb.obligation</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_collection': 1}</field>
    </record>

    <!-- App propia en el menú principal: la obligación es de toda la empresa
         (cobranza hoy; compras, operaciones, SGI y RH después), no solo de Contabilidad. -->
    <menuitem id="menu_qb_obligation_root" name="Obligaciones" sequence="35" web_icon="qb_obligation,static/description/icon.png"/>
    <menuitem id="menu_qb_obligation_mine" name="Mis obligaciones" parent="menu_qb_obligation_root" action="action_qb_obligation_mine" sequence="10"/>
    <menuitem id="menu_qb_obligation_all" name="Todas" parent="menu_qb_obligation_root" action="action_qb_obligation" sequence="20"/>
    <menuitem id="menu_qb_obligation_metrics" name="Métricas" parent="menu_qb_obligation_root" action="action_qb_obligation_metrics" sequence="30" groups="account.group_account_manager"/>

</odoo>
