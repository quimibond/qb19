<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Genera obligaciones de cobranza desde Odoo, cierra por evidencia,
             reasigna las que el SAT ya ve pagadas y escala. Idempotente. -->
        <record id="cron_qb_obligation_collection" model="ir.cron">
            <field name="name">Obligaciones - Cobranza (generar, cerrar, escalar)</field>
            <field name="model_id" ref="model_qb_obligation"/>
            <field name="state">code</field>
            <field name="code">model._cron_collection()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=20)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Recordatorio diario al dueño (agrupado por cliente) y a Dirección (escaladas).
             13:30 UTC = 7:30 en Ciudad de México. -->
        <record id="cron_qb_obligation_digest" model="ir.cron">
            <field name="name">Obligaciones - Recordatorio diario</field>
            <field name="model_id" ref="model_qb_obligation"/>
            <field name="state">code</field>
            <field name="code">model._cron_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=13, minute=30, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
