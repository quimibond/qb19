<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reglas por empresa (F-014, J-013); vivían en quimibond_sgi/security/sgi_security.xml. -->
    <record id="rule_sgi_sales_budget_company" model="ir.rule">
        <field name="name">SGI: Presupuestos de ventas por empresa</field>
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sgi_sales_budget_line_company" model="ir.rule">
        <field name="name">SGI: Líneas de presupuesto de ventas por empresa</field>
        <field name="model_id" ref="model_sgi_sales_budget_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_sales_budget_rate_company" model="ir.rule">
        <field name="name">Tipo de cambio del presupuesto de ventas por empresa</field>
        <field name="model_id" ref="model_qb_sales_budget_rate"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_customer_part_company" model="ir.rule">
        <field name="name">Partes del cliente por empresa</field>
        <field name="model_id" ref="model_qb_customer_part"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_release_profile_company" model="ir.rule">
        <field name="name">Perfiles de release por empresa</field>
        <field name="model_id" ref="model_qb_release_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_sales_project_company" model="ir.rule">
        <field name="name">Proyectos comerciales por empresa</field>
        <field name="model_id" ref="model_qb_sales_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_sales_actual_company" model="ir.rule">
        <field name="name">Venta real por empresa</field>
        <field name="model_id" ref="model_qb_sales_actual"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_sales_compare_company" model="ir.rule">
        <field name="name">Comparativo de ventas por empresa</field>
        <field name="model_id" ref="model_qb_sales_compare"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_sales_missing_company" model="ir.rule">
        <field name="name">Faltantes de ventas por empresa</field>
        <field name="model_id" ref="model_qb_sales_missing"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_sales_month_plan_company" model="ir.rule">
        <field name="name">Presupuesto del mes por empresa</field>
        <field name="model_id" ref="model_qb_sales_month_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_sales_month_plan_line_company" model="ir.rule">
        <field name="name">Renglones del presupuesto del mes por empresa</field>
        <field name="model_id" ref="model_qb_sales_month_plan_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- 3.14.0 (diseño v3, 2.5): los vendedores capturan solo su parte de Confección. Las reglas de
         grupos distintos se suman: el administrador de ventas y el del SGI tocan todo. -->
    <record id="rule_qb_month_plan_line_salesman_confeccion" model="ir.rule">
        <field name="name">Presupuesto del mes: vendedores solo en Confección</field>
        <field name="model_id" ref="model_qb_sales_month_plan_line"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('mercado', 'in', ('confeccion', 'proyectos_confeccion'))]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_qb_month_plan_line_manager_all" model="ir.rule">
        <field name="name">Presupuesto del mes: administradores en todos los mercados</field>
        <field name="model_id" ref="model_qb_sales_month_plan_line"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('quimibond_sgi.group_sgi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_qb_release_company" model="ir.rule">
        <field name="name">Releases por empresa</field>
        <field name="model_id" ref="model_qb_release"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
