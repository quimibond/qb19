<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- E1 (diseño v3, sección 3.3): Planeación consulta el pronóstico y la demanda por cliente sin
         poder editarlos. Ventas (jefe de ventas) y el administrador del SGI los escriben. -->
    <record id="module_category_qb_planeacion_ventas" model="ir.module.category">
        <field name="name">Pronóstico de ventas</field>
        <field name="description">Consulta del pronóstico vigente y de la demanda por cliente</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_qb_planeacion_ventas" model="res.groups.privilege">
        <field name="name">Pronóstico de ventas</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_qb_planeacion_ventas"/>
    </record>

    <record id="group_qb_planeacion" model="res.groups">
        <field name="name">Planeación (consulta)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_qb_planeacion_ventas"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Ve el pronóstico vigente, sus cambios y la Demanda por cliente. No edita.</field>
    </record>

    <record id="rule_qb_forecast_line_company" model="ir.rule">
        <field name="name">Pronóstico vigente por empresa</field>
        <field name="model_id" ref="model_qb_forecast_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_forecast_change_company" model="ir.rule">
        <field name="name">Cambios del pronóstico por empresa</field>
        <field name="model_id" ref="model_qb_forecast_change"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_forecast_sheet_company" model="ir.rule">
        <field name="name">Hojas del forecast por empresa</field>
        <field name="model_id" ref="model_qb_forecast_sheet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_qb_demand_line_company" model="ir.rule">
        <field name="name">Demanda por cliente por empresa</field>
        <field name="model_id" ref="model_qb_demand_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
