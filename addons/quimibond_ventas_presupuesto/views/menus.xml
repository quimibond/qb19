<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ventas → Presupuesto y pronóstico. Vivían en quimibond_sgi/views/sgi_menus.xml;
         mismos XML IDs, así que en producción conservan su id (E-002: documentos y
         actividades apuntan a ellos). «menu_sale_sgi_sales_forecast» abre el pronóstico
         vigente: el documento F-P-A28-13 del SGI apunta a ese XML ID.

         3.20.0 (Jose, 2026-11-19: «hay muchísimos menús… quitar lo que no sirve»): revisión de
         cada menú contra su uso en producción. De 36 entradas a 20. Se quitaron (solo el menú;
         modelos, acciones y datos se quedan):
         - Comparación de precios, Hojas del forecast, Cargar forecast de Excel: dependen del
           forecast.xlsx, que ya no se mantiene (la comparación corrió una vez, el 4-nov).
         - Pronósticos anteriores (grupo Histórico): 21 documentos obsoletos.
         - Releases por revisar: misma lista que Releases con otro filtro (Releases abre en lo pendiente).
         - Anual, Cliente y artículo, Análisis: la misma tabla que «Presupuesto contra real»
           agrupada distinto; quedan como favoritos (Análisis además es botón de la ficha).
         - Venta real: líneas de factura en bruto; el comparativo trae lo real en $, m y kg.
         - Cierre de ventas (PDF): botón de la ficha del presupuesto.
         - Capacidad semanal y Demanda por cliente en Ventas: son de Planeación (Fabricación).
         - Pegar semanas, Imprimir o descargar, Armar presupuesto del mes: botones arriba de su lista.
         3.35.0 (Jose, 24-nov: «eso debería ser un botón»): Armar propuesta del año y Proponer pedidos
         son asistentes, no listas: pasan a botón arriba de la lista de presupuestos y del pronóstico
         vigente (y Armar propuesta también en la ficha de un presupuesto en borrador sin renglones). -->
    <menuitem id="menu_sale_sgi_planning" name="Presupuesto y pronóstico"
              parent="sale.sale_menu_root" sequence="6"
              groups="quimibond_sgi.group_sgi_user"/>

    <!-- Pronóstico -->
    <menuitem id="menu_sale_qb_grupo_pronostico" name="Pronóstico"
              parent="menu_sale_sgi_planning" sequence="10"/>
    <menuitem id="menu_sale_sgi_sales_forecast" name="Pronóstico vigente"
              parent="menu_sale_qb_grupo_pronostico" action="qb_forecast_line_action" sequence="10"/>
    <menuitem id="menu_sale_qb_forecast_grid" name="Captura semanal"
              parent="menu_sale_qb_grupo_pronostico" action="qb_forecast_line_grid_action" sequence="20"
              groups="sales_team.group_sale_manager,quimibond_sgi.group_sgi_manager"/>
    <menuitem id="menu_sale_qb_release" name="Releases"
              parent="menu_sale_qb_grupo_pronostico" action="qb_release_action" sequence="30"/>

    <!-- Presupuesto -->
    <menuitem id="menu_sale_qb_grupo_presupuesto" name="Presupuesto"
              parent="menu_sale_sgi_planning" sequence="20"/>
    <menuitem id="menu_sale_sgi_sales_budget" name="Presupuesto anual"
              parent="menu_sale_qb_grupo_presupuesto" action="sgi_sales_budget_action" sequence="10"/>
    <menuitem id="menu_sale_qb_month_plan" name="Presupuesto del mes"
              parent="menu_sale_qb_grupo_presupuesto" action="qb_sales_month_plan_action" sequence="20"/>
    <menuitem id="menu_sale_qb_sales_project" name="Proyectos comerciales"
              parent="menu_sale_qb_grupo_presupuesto" action="qb_sales_project_action" sequence="30"/>

    <!-- Reportes -->
    <menuitem id="menu_sale_qb_grupo_reportes" name="Reportes"
              parent="menu_sale_sgi_planning" sequence="25"/>
    <menuitem id="menu_sale_qb_compare_monthly" name="Presupuesto contra real"
              parent="menu_sale_qb_grupo_reportes" action="qb_sales_compare_monthly_server" sequence="10"/>
    <menuitem id="menu_sale_qb_forecast_change" name="Cambios del pronóstico"
              parent="menu_sale_qb_grupo_reportes" action="qb_forecast_change_action" sequence="20"/>
    <menuitem id="menu_sale_qb_sales_missing" name="Faltantes"
              parent="menu_sale_qb_grupo_reportes" action="qb_sales_missing_action" sequence="30"/>

    <!-- Configuración -->
    <menuitem id="menu_sale_qb_grupo_config" name="Configuración"
              parent="menu_sale_sgi_planning" sequence="90"/>
    <menuitem id="menu_sale_qb_order_rule" name="Cómo pide cada cliente"
              parent="menu_sale_qb_grupo_config" action="qb_order_rule_action" sequence="10"/>
    <menuitem id="menu_sale_qb_delivery_terms" name="Condiciones de entrega"
              parent="menu_sale_qb_grupo_config" action="qb_delivery_terms_action" sequence="20"/>
    <menuitem id="menu_sale_qb_customer_part" name="Partes del cliente"
              parent="menu_sale_qb_grupo_config" action="qb_customer_part_action" sequence="30"/>
    <menuitem id="menu_sale_qb_release_profile" name="Perfiles de release"
              parent="menu_sale_qb_grupo_config" action="qb_release_profile_action" sequence="40"/>

    <!-- Planeación lo consulta desde Fabricación, sin entrar a Ventas. Imprimir o descargar
         es botón de la lista del pronóstico vigente desde 3.20.0. -->
    <menuitem id="menu_mrp_qb_planeacion_ventas" name="Pronóstico de ventas"
              parent="mrp.menu_mrp_root" sequence="35"
              groups="group_qb_planeacion,mrp.group_mrp_user"/>
    <menuitem id="menu_mrp_qb_demand_line" name="Demanda por cliente"
              parent="menu_mrp_qb_planeacion_ventas" action="qb_demand_line_action" sequence="10"/>
    <menuitem id="menu_mrp_qb_forecast_line" name="Pronóstico vigente"
              parent="menu_mrp_qb_planeacion_ventas" action="qb_forecast_line_action" sequence="20"/>
    <menuitem id="menu_mrp_qb_forecast_capacity" name="Capacidad semanal"
              parent="menu_mrp_qb_planeacion_ventas" action="qb_forecast_week_capacity_action" sequence="25"/>
    <menuitem id="menu_mrp_qb_forecast_change" name="Cambios del pronóstico"
              parent="menu_mrp_qb_planeacion_ventas" action="qb_forecast_change_action" sequence="30"/>
</odoo>
