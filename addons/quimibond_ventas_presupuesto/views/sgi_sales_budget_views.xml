<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ LÍNEA: LISTA / FICHA / GRID / PIVOT / GRAPH ============ -->
    <record id="sgi_sales_budget_line_view_list" model="ir.ui.view">
        <field name="name">sgi.sales.budget.line.list</field>
        <field name="model">sgi.sales.budget.line</field>
        <field name="arch" type="xml">
            <list string="Líneas de presupuesto" editable="bottom"
                  decoration-muted="not price_problem and qty_budget == 0"
                  decoration-danger="price_problem">
                <field name="budget_id" column_invisible="context.get('default_budget_id')"/>
                <field name="kind" column_invisible="1"/>
                <field name="mercado"/>
                <field name="partner_id" optional="show"/>
                <field name="product_id"/>
                <field name="proyecto_descripcion" optional="show"/>
                <field name="date"/>
                <field name="uom_id"/>
                <!-- 1.2.0 (V-M10): totales al pie de cantidad e importe. -->
                <field name="qty_budget" sum="Total"/>
                <field name="qty_m" readonly="1" optional="hide" sum="Total"/>
                <field name="qty_kg" readonly="1" optional="hide" sum="Total"/>
                <field name="qty_forecast" readonly="1" optional="hide"/>
                <field name="price_input"/>
                <field name="price_currency_id" options="{'no_create': True}"/>
                <field name="price_basis"/>
                <field name="price_origen" readonly="1" optional="hide"/>
                <field name="rate" readonly="1" optional="hide"/>
                <field name="amount_currency" readonly="1" optional="hide"/>
                <field name="amount_budget" readonly="1" sum="Total"/>
                <field name="price_problem" readonly="1" optional="show"/>
                <field name="price_unit_currency" readonly="1" optional="hide"/>
                <field name="list_currency_id" optional="hide"/>
                <field name="price_source" readonly="1" optional="hide"/>
                <field name="price_real_unit_currency" readonly="1" optional="hide"/>
                <field name="price_gap_pct" readonly="1" optional="hide"/>
                <field name="qty_real" readonly="1" optional="show" sum="Total"/>
                <field name="amount_real" readonly="1" optional="show" sum="Total"/>
                <field name="effect_volume" readonly="1" optional="hide" sum="Total"/>
                <field name="effect_price" readonly="1" optional="show" sum="Total"/>
                <field name="effect_fx" readonly="1" optional="hide" sum="Total"/>
                <field name="qty_ordered" readonly="1" optional="hide"/>
                <field name="amount_ordered" readonly="1" optional="hide" sum="Total"/>
                <field name="unconverted_count" readonly="1" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_view_month_invoices" type="object" icon="fa-file-text-o"
                        string="Ver facturas del mes" title="Ver facturas del mes"
                        invisible="not product_id"/>
            </list>
        </field>
    </record>

    <record id="sgi_sales_budget_line_view_form" model="ir.ui.view">
        <field name="name">sgi.sales.budget.line.form</field>
        <field name="model">sgi.sales.budget.line</field>
        <field name="arch" type="xml">
            <form string="Línea de presupuesto">
                <header>
                    <field name="kind" invisible="1"/>
                    <button name="action_view_month_invoices" type="object"
                            string="Ver facturas del mes" icon="fa-file-text-o"
                            invisible="not product_id"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not price_problem">
                        Este renglón cuenta 0 en el importe: <field name="price_problem" readonly="1" class="oe_inline"/>.
                    </div>
                    <group>
                        <group string="Qué se presupuesta">
                            <field name="budget_id"/>
                            <field name="mercado"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="proyecto_descripcion" invisible="product_id"/>
                            <field name="proyecto_gramaje" invisible="product_id"/>
                            <field name="proyecto_ancho_cm" invisible="product_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Cantidad y precio">
                            <field name="uom_id"/>
                            <field name="qty_budget"/>
                            <field name="qty_m" readonly="1"/>
                            <field name="qty_kg" readonly="1"/>
                            <field name="conv_origen" readonly="1"/>
                            <field name="price_input"/>
                            <field name="price_currency_id" options="{'no_create': True}"/>
                            <field name="price_basis"/>
                            <field name="price_origen" readonly="1"/>
                            <field name="rate" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_currency" readonly="1"/>
                            <field name="amount_budget" readonly="1"/>
                        </group>
                    </group>
                    <group string="Precio de lista (referencia)">
                        <group>
                            <field name="list_currency_id" invisible="1"/>
                            <field name="price_unit_currency" readonly="1"/>
                            <field name="has_list_price" readonly="1"/>
                        </group>
                        <group>
                            <field name="price_source" readonly="1"/>
                        </group>
                    </group>
                    <group string="Real (facturado) y pedido — automático">
                        <group>
                            <field name="qty_real" readonly="1"/>
                            <field name="qty_forecast" readonly="1"/>
                            <field name="amount_real" readonly="1"/>
                            <field name="unconverted_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="qty_ordered" readonly="1"/>
                            <field name="amount_ordered" readonly="1"/>
                            <field name="avg_price_budget" readonly="1"/>
                            <field name="avg_price_real" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sgi_sales_budget_line_grid_qty" model="ir.ui.view">
        <field name="name">sgi.sales.budget.line.grid.qty</field>
        <field name="model">sgi.sales.budget.line</field>
        <field name="arch" type="xml">
            <grid string="Matriz de cantidades" editable="1" create_inline="1"
                  display_empty="1">
                <!-- 3.5.0: fila = mercado, cliente y producto (los proyectos sin código se
                     capturan en la lista). -->
                <field name="mercado" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="product_id" type="row"/>
                <!-- 3.2.1: sin <range>. Odoo 19 rechaza el elemento (rangos fijos: se elige semana, mes o
                     año en pantalla; año da columnas por mes). -->
                <field name="date" type="col"/>
                <field name="qty_budget" type="measure"/>
            </grid>
        </field>
    </record>

    <!-- La grid de importes se eliminó: se capturan cantidades (y el precio en la
         lista); el importe es cantidad × precio × tipo de cambio del mes. -->

    <record id="sgi_sales_budget_line_view_pivot" model="ir.ui.view">
        <field name="name">sgi.sales.budget.line.pivot</field>
        <field name="model">sgi.sales.budget.line</field>
        <field name="arch" type="xml">
            <pivot string="Ppto vs facturado vs pedido">
                <field name="mercado" type="row"/>
                <field name="uom_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount_budget" type="measure"/>
                <field name="amount_real" type="measure"/>
                <field name="amount_ordered" type="measure"/>
                <field name="qty_budget" type="measure"/>
                <field name="qty_real" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_sales_budget_line_view_graph" model="ir.ui.view">
        <field name="name">sgi.sales.budget.line.graph</field>
        <field name="model">sgi.sales.budget.line</field>
        <field name="arch" type="xml">
            <graph string="Ppto vs facturado vs pedido" type="bar">
                <field name="date" interval="month"/>
                <field name="amount_budget" type="measure"/>
                <field name="amount_real" type="measure"/>
                <field name="amount_ordered" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sgi_sales_budget_line_view_search" model="ir.ui.view">
        <field name="name">sgi.sales.budget.line.search</field>
        <field name="model">sgi.sales.budget.line</field>
        <field name="arch" type="xml">
            <search string="Líneas de presupuesto">
                <field name="product_id"/>
                <field name="proyecto_descripcion"/>
                <field name="budget_id"/>
                <field name="mercado"/>
                <field name="partner_id"/>
                <filter name="vigente" string="Vigente"
                        domain="[('budget_id.state', '=', 'aprobado')]"/>
                <separator/>
                <filter name="presupuesto" string="Presupuesto"
                        domain="[('kind', '=', 'presupuesto')]"/>
                <separator/>
                <filter name="year_current" string="Año actual"
                        domain="[('date', '&gt;=', (context_today().replace(month=1, day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today().replace(month=1, day=1) + relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="year_next" string="Año siguiente"
                        domain="[('date', '&gt;=', (context_today().replace(month=1, day=1) + relativedelta(years=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today().replace(month=1, day=1) + relativedelta(years=2)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="con_facturacion" string="Con facturación"
                        domain="[('amount_real', '!=', 0)]"/>
                <filter name="sin_precio_lista" string="Sin precio de lista"
                        domain="[('has_list_price', '=', False)]"/>
                <filter name="con_problema" string="Cuentan 0 (sin precio, tipo de cambio o conversión)"
                        domain="[('price_problem', '!=', False)]"/>
                <filter name="proyectos" string="Proyectos"
                        domain="[('mercado', 'in', ('proyectos_industrial', 'proyectos_confeccion'))]"/>
                <group>
                    <filter name="group_mercado" string="Mercado" context="{'group_by': 'mercado'}"/>
                    <filter name="group_team" string="Equipo" context="{'group_by': 'team_id'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'date:month'}"/>
                    <filter name="group_budget" string="Presupuesto" context="{'group_by': 'budget_id'}"/>
                    <filter name="group_uom" string="Unidad" context="{'group_by': 'uom_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ PRESUPUESTO: FICHA / LISTA / SEARCH ============ -->
    <record id="sgi_sales_budget_view_form" model="ir.ui.view">
        <field name="name">sgi.sales.budget.form</field>
        <field name="model">sgi.sales.budget</field>
        <field name="arch" type="xml">
            <form string="Presupuesto de ventas">
                <header>
                    <!-- Flujo (P-A28 Rev.15): captura → revisado (Admin ventas) →
                         aprobado (alta dirección). 3.5.0: un documento por año y revisión
                         con los cinco mercados; al aprobar una revisión nueva, la anterior
                         queda reemplazada. 1.2.0 (V-M10): en el encabezado solo el flujo;
                         las cargas y la conciliación, en el engrane (Acción). -->
                    <button name="action_send_to_review" type="object"
                            string="Enviar a revisión" class="btn-primary"
                            invisible="kind != 'presupuesto' or state != 'borrador'"
                            groups="sales_team.group_sale_manager,quimibond_sgi.group_sgi_manager"/>
                    <button name="action_approve" type="object" string="Aprobar (Dirección)"
                            class="btn-primary"
                            invisible="kind != 'presupuesto' or state != 'revisado'"
                            groups="quimibond_sgi.group_sgi_director,quimibond_sgi.group_sgi_manager"/>
                    <button name="action_revise" type="object" string="Nueva revisión"
                            invisible="kind != 'presupuesto' or state != 'aprobado'"
                            groups="quimibond_sgi.group_sgi_manager"/>
                    <button name="action_set_borrador" type="object" string="Regresar a borrador"
                            invisible="state != 'revisado'"
                            groups="sales_team.group_sale_manager,quimibond_sgi.group_sgi_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,revisado,aprobado"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_analysis" type="object"
                                class="oe_stat_button" icon="fa-table"
                                string="Análisis" invisible="kind != 'presupuesto'"/>
                    </div>
                    <widget name="web_ribbon" title="Obsoleto" bg_color="text-bg-secondary"
                            invisible="state != 'obsoleto'"/>
                    <widget name="web_ribbon" title="Reemplazado" bg_color="text-bg-secondary"
                            invisible="state != 'reemplazado'"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="unconverted_count == 0">
                        <field name="unconverted_count" class="oe_inline"/> línea(s) de factura
                        del periodo vienen en una unidad de otra categoría: cuentan en importe
                        pero no en cantidad. Corrija la unidad en la factura o en la línea.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="no_price_count == 0 and no_rate_count == 0 and no_conversion_count == 0">
                        Renglones que cuentan 0 en el importe:
                        <field name="no_price_count" class="oe_inline"/> sin precio,
                        <field name="no_rate_count" class="oe_inline"/> sin tipo de cambio y
                        <field name="no_conversion_count" class="oe_inline"/> sin conversión a
                        metros o kilos. Capture el precio (o use «Sugerir precios de la lista»
                        en el engrane), el tipo de cambio del mes o el rendimiento.
                        <button name="action_view_no_price" type="object"
                                string="Ver renglones" class="btn-link"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="no_client_count == 0">
                        <field name="no_client_count" class="oe_inline"/> renglón(es) de
                        Industrial o Especiales sin cliente: no se puede aprobar así.
                        <button name="action_qb_open_set_partner" type="object"
                                string="Poner cliente" class="btn-link"/>
                    </div>
                    <field name="needs_justification" invisible="1"/>
                    <div class="alert alert-danger" role="alert"
                         invisible="not needs_justification">
                        Este presupuesto aprobado va por <b>debajo del umbral de
                        cumplimiento</b> (Ajustes → «Cumplimiento mínimo del
                        presupuesto»). Capture la <b>justificación del incumplimiento</b>
                        (P-A28 4.3.6.1) abajo. No bloquea nada: es evidencia del
                        análisis, no un candado.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted">
                            <field name="sgi_format_banner" readonly="1"/> ·
                            Folio <field name="folio" readonly="1" class="oe_inline"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="kind" invisible="1"/>
                            <field name="year"/>
                            <field name="revision"/>
                            <field name="revision_label" invisible="1"/>
                            <field name="revision_date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <group string="Contra el año anterior">
                        <group>
                            <label for="base_anio_anterior"/>
                            <div class="o_row">
                                <field name="base_anio_anterior"/>
                                <button name="action_qb_update_base" type="object" string="Actualizar base"
                                        class="btn-link" invisible="state not in ('borrador', 'revisado')"/>
                            </div>
                            <field name="objetivo_pct"/>
                            <field name="objetivo_amount"/>
                            <field name="minimo_pct"/>
                            <field name="minimo_amount"/>
                        </group>
                        <group>
                            <field name="amount_budget_total"/>
                            <field name="growth_pct"/>
                            <field name="amount_by_mercado_text"/>
                            <field name="amount_currency_text"/>
                        </group>
                    </group>
                    <group string="Cumplimiento (importe en moneda de la compañía)">
                        <group>
                            <field name="cutoff_date"/>
                            <field name="amount_budget_to_date"/>
                            <field name="amount_sales_to_date"/>
                            <field name="fulfillment_pct"/>
                            <field name="fulfillment_by_mercado_text"/>
                            <field name="amount_sales_budget_rate"/>
                            <field name="fulfillment_budget_rate_pct"/>
                            <field name="fx_effect"/>
                        </group>
                        <group>
                            <field name="amount_real_total"/>
                            <field name="amount_real_unbudgeted"/>
                            <field name="amount_ordered_total"/>
                        </group>
                    </group>
                    <!-- 3.6.2: por qué la venta no da el presupuesto (al corte), la práctica de análisis de
                         variaciones: volumen, precio (en la moneda de venta), tipo de cambio y venta sin
                         presupuesto. Suman la diferencia venta − presupuesto. -->
                    <group string="Diferencia contra el presupuesto al corte">
                        <group>
                            <field name="amount_difference"/>
                            <field name="effect_volume"/>
                            <field name="effect_price"/>
                            <field name="fx_effect"/>
                            <field name="effect_unbudgeted"/>
                        </group>
                        <group>
                            <field name="effects_by_mercado_text"/>
                        </group>
                    </group>
                    <group string="Cantidades">
                        <group>
                            <field name="qty_budget_text"/>
                            <field name="qty_real_text"/>
                        </group>
                    </group>
                    <group string="Justificación de incumplimiento (P-A28 4.3.6.1)"
                           invisible="state not in ('aprobado', 'reemplazado')">
                        <field name="nonfulfillment_note" nolabel="1"
                               placeholder="Análisis del porqué del incumplimiento del presupuesto (contexto de mercado, causas, acciones). No es candado: es evidencia."/>
                    </group>
                    <notebook>
                        <page string="Renglones" name="lineas">
                            <field name="line_ids" context="{'default_budget_id': id}">
                                <list string="Renglones" editable="bottom"
                                      decoration-danger="price_problem">
                                    <field name="mercado"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="product_id"/>
                                    <field name="proyecto_descripcion" optional="show"/>
                                    <field name="date"/>
                                    <field name="uom_id"/>
                                    <field name="qty_budget" sum="Total"/>
                                    <field name="qty_forecast" readonly="1" optional="hide"/>
                                    <field name="price_input"/>
                                    <field name="price_currency_id" options="{'no_create': True}"/>
                                    <field name="price_basis" optional="show"/>
                                    <field name="price_problem" readonly="1" optional="show"/>
                                    <field name="amount_budget" readonly="1" sum="Total"/>
                                    <field name="qty_real" readonly="1" sum="Total" optional="show"/>
                                    <field name="amount_real" readonly="1" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tipo de cambio" name="tipo_cambio">
                            <p class="text-muted">
                                Pesos por dólar de cada mes. Un mes sin tipo de cambio usa el
                                presupuestal de Ajustes, que se guarda aquí al aprobar.
                            </p>
                            <div class="o_row" invisible="state not in ('borrador', 'revisado')">
                                <field name="rate_default"/>
                                <button name="action_qb_apply_rate_all" type="object"
                                        string="Aplicar a los 12 meses" class="btn-secondary"/>
                                <button name="action_qb_prices_to_list_currency" type="object"
                                        string="Pasar precios a la moneda de la lista" class="btn-secondary"
                                        confirm="Los renglones con lista en dólares y precio en pesos pasan a dólares con este tipo de cambio, que queda en los 12 meses. ¿Continuar?"/>
                            </div>
                            <field name="rate_ids" context="{'default_budget_id': id}">
                                <list string="Tipo de cambio" editable="bottom">
                                    <field name="month"/>
                                    <field name="month_name" readonly="1"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sgi_sales_budget_view_list" model="ir.ui.view">
        <field name="name">sgi.sales.budget.list</field>
        <field name="model">sgi.sales.budget</field>
        <field name="arch" type="xml">
            <list string="Presupuestos"
                  decoration-muted="state in ('obsoleto', 'reemplazado')"
                  decoration-success="state == 'aprobado'">
                <field name="folio"/>
                <field name="year"/>
                <field name="revision_label" string="Revisión"/>
                <field name="revision_date" optional="show"/>
                <field name="amount_budget_total" optional="show"/>
                <field name="amount_real_total" optional="show"/>
                <field name="fulfillment_pct" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'aprobado'"
                       decoration-warning="state == 'revisado'"
                       decoration-info="state == 'borrador'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sgi_sales_budget_view_search" model="ir.ui.view">
        <field name="name">sgi.sales.budget.search</field>
        <field name="model">sgi.sales.budget</field>
        <field name="arch" type="xml">
            <search string="Presupuestos">
                <field name="year"/>
                <field name="partner_id"/>
                <filter name="mensual" string="Presupuesto anual" domain="[('kind', '=', 'presupuesto')]"/>
                <separator/>
                <filter name="approved" string="Aprobados" domain="[('state', '=', 'aprobado')]"/>
                <filter name="revised" string="Revisados" domain="[('state', '=', 'revisado')]"/>
                <filter name="draft" string="Borradores" domain="[('state', '=', 'borrador')]"/>
                <filter name="not_obsolete" string="Vigentes (sin obsoletos)"
                        domain="[('state', '!=', 'obsoleto')]"/>
                <group>
                    <filter name="group_year" string="Año" context="{'group_by': 'year'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ ASISTENTE DE IMPORTACIÓN DESDE EXCEL ============ -->
    <record id="sgi_sales_budget_import_view_form" model="ir.ui.view">
        <field name="name">sgi.sales.budget.import.form</field>
        <field name="model">sgi.sales.budget.import</field>
        <field name="arch" type="xml">
            <form string="Importar presupuesto desde Excel">
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="result">
                        Sube el Excel. En un <b>presupuesto</b> se lee el F-P-A28-18
                        (producto × pares «&lt;mes&gt; m»/«&lt;mes&gt; $»); en un
                        <b>pronóstico</b>, el forecast F-P-A28-13 (fila «SEMANA» con
                        números 1–52, producto en col A y código de cliente en col B;
                        bloques repetidos se suman, filas PO/TOTAL/FECHA se ignoran).
                        Los productos sin match se reportan; ninguno se crea solo.
                    </div>
                    <group invisible="result">
                        <field name="budget_id" readonly="1"/>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="available_sheets" invisible="not available_sheets"/>
                        <field name="sheet_name"/>
                        <field name="conflict_mode"/>
                    </group>
                    <group invisible="not result">
                        <field name="result" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Importar"
                            class="btn-primary" invisible="result"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 1.2.0 (V-M10): las cargas y la conciliación, en el engrane (Acción) de
         la ficha junto a «Importar desde Excel», fuera del encabezado. -->
    <record id="sgi_sales_budget_refresh_actuals_server" model="ir.actions.server">
        <field name="name">Actualizar real</field>
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">records.action_refresh_actuals()</field>
    </record>

    <!-- 3.5.3: traer renglones de otro presupuesto del mismo año. -->
    <record id="qb_sales_budget_copy_view_form" model="ir.ui.view">
        <field name="name">qb.sales.budget.copy.form</field>
        <field name="model">qb.sales.budget.copy</field>
        <field name="arch" type="xml">
            <form string="Traer renglones de otro presupuesto">
                <sheet>
                    <div class="alert alert-info" role="status" invisible="result">
                        Copia al presupuesto en borrador los renglones de otros presupuestos del
                        mismo año, con su mercado, cliente, producto, mes, cantidad y precio. Lo que
                        ya existe o no cabe (anti-doble-conteo, unidad) no se copia y queda anotado.
                    </div>
                    <group invisible="result">
                        <field name="budget_id" readonly="1"/>
                        <field name="year" invisible="1"/>
                        <field name="source_ids" widget="many2many_tags"/>
                    </group>
                    <group invisible="not result">
                        <field name="result" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_copy" type="object" string="Traer renglones"
                            class="btn-primary" invisible="result"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sgi_sales_budget_copy_server" model="ir.actions.server">
        <field name="name">Traer renglones de otro presupuesto</field>
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_qb_open_copy()</field>
    </record>

    <!-- 3.6.4: poner cliente a varios renglones en una sola escritura. -->
    <record id="qb_sales_budget_set_partner_view_form" model="ir.ui.view">
        <field name="name">qb.sales.budget.set.partner.form</field>
        <field name="model">qb.sales.budget.set.partner</field>
        <field name="arch" type="xml">
            <form string="Poner cliente">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Pone el mismo cliente a todos los renglones elegidos de una vez. Un
                        producto no puede quedar con renglones con cliente y sin cliente en el
                        mismo mercado: elija todos los de ese producto. Sin cliente, los
                        renglones quedan para todo el mercado.
                    </div>
                    <group>
                        <field name="budget_id" readonly="1"/>
                        <field name="partner_id"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="mercado"/>
                            <field name="product_id"/>
                            <field name="proyecto_descripcion" optional="hide"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="qty_budget"/>
                            <field name="uom_id"/>
                            <field name="amount_budget" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Poner cliente"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sgi_sales_budget_set_partner_server" model="ir.actions.server">
        <field name="name">Poner cliente a renglones</field>
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_qb_open_set_partner()</field>
    </record>

    <record id="qb_sales_budget_set_partner_lines_action" model="ir.actions.act_window">
        <field name="name">Poner cliente</field>
        <field name="res_model">qb.sales.budget.set.partner</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_sgi_sales_budget_line"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- 3.6.0 -->
    <record id="sgi_sales_budget_xlsx_server" model="ir.actions.server">
        <field name="name">Descargar Excel</field>
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_qb_download_xlsx()</field>
    </record>

    <!-- 3.5.0 -->
    <record id="sgi_sales_budget_suggest_prices_server" model="ir.actions.server">
        <field name="name">Sugerir precios de la lista</field>
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_qb_suggest_prices()</field>
    </record>

    <record id="sgi_sales_budget_reconcile_server" model="ir.actions.server">
        <field name="name">Conciliar facturado</field>
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">records.action_reconcile_invoiced()</field>
    </record>

    <record id="sgi_sales_budget_import_action" model="ir.actions.act_window">
        <field name="name">Importar desde Excel</field>
        <field name="res_model">sgi.sales.budget.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_sgi_sales_budget"/>
        <field name="binding_view_types">form</field>
    </record>


    <!-- 3.0.0: pronósticos como documento (antes de Pronóstico vigente), solo consulta. -->
    <record id="sgi_sales_forecast_view_list" model="ir.ui.view">
        <field name="name">sgi.sales.forecast.list</field>
        <field name="model">sgi.sales.budget</field>
        <field name="arch" type="xml">
            <list string="Pronósticos anteriores" create="0" edit="0" delete="0">
                <field name="folio"/>
                <field name="year"/>
                <field name="partner_id"/>
                <field name="line_count"/>
                <field name="write_date" string="Última modificación" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="sgi_sales_forecast_view_form" model="ir.ui.view">
        <field name="name">sgi.sales.forecast.form</field>
        <field name="model">sgi.sales.budget</field>
        <field name="arch" type="xml">
            <form string="Pronóstico anterior" create="0" edit="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Pronóstico de antes del pronóstico vigente (3.0.0), solo de consulta.
                        El pronóstico de hoy está en Presupuesto y pronóstico → Pronóstico vigente.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="year" readonly="1"/>
                        </group>
                        <group>
                            <field name="folio" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list string="Semanas">
                            <field name="date" string="Semana"/>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="qty_budget" string="Cantidad" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <!-- ============ KANBAN de presupuestos ============ -->
    <record id="sgi_sales_budget_view_kanban" model="ir.ui.view">
        <field name="name">sgi.sales.budget.kanban</field>
        <field name="model">sgi.sales.budget</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="fulfillment_pct"/>
                <field name="kind"/>
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <strong><field name="year"/></strong> ·
                                <field name="revision_label"/>
                            </div>
                            <div class="col-4 text-end">
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'borrador': 'info', 'revisado': 'warning', 'aprobado': 'success', 'reemplazado': 'muted', 'obsoleto': 'muted'}}"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6 text-muted">
                                <field name="amount_budget_total" widget="monetary"/>
                            </div>
                            <div class="col-6 text-end">
                                <span t-attf-class="badge #{record.fulfillment_pct.raw_value >= 90 ? 'text-bg-success' : (record.fulfillment_pct.raw_value >= 80 ? 'text-bg-warning' : 'text-bg-danger')}">
                                    <field name="fulfillment_pct"/>%
                                </span>
                            </div>
                        </div>
                        <field name="currency_id" invisible="1"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============ ANÁLISIS (4 vistas preconfiguradas) ============ -->
    <!-- Anti-doble conteo: el default es 'Vigente' (aprobado) + 'Presupuesto' vía
         search_default (NO domain duro), para poder quitar el filtro y comparar
         revisiones si hace falta. -->
    <record id="sgi_sales_analysis_pivot_mercado" model="ir.ui.view">
        <field name="name">sgi.sales.analysis.pivot.mercado</field>
        <field name="model">sgi.sales.budget.line</field>
        <field name="arch" type="xml">
            <pivot string="Análisis">
                <field name="mercado" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount_budget" type="measure"/>
                <field name="amount_real" type="measure"/>
                <field name="amount_ordered" type="measure"/>
                <!-- 3.6.2 -->
                <field name="effect_volume" type="measure"/>
                <field name="effect_price" type="measure"/>
                <field name="effect_fx" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sgi_sales_analysis_graph_global" model="ir.ui.view">
        <field name="name">sgi.sales.analysis.graph.global</field>
        <field name="model">sgi.sales.budget.line</field>
        <field name="arch" type="xml">
            <graph string="Global (Dirección)" type="bar" stacked="1">
                <field name="date" interval="month"/>
                <field name="mercado"/>
                <field name="amount_budget" type="measure"/>
                <field name="amount_real" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sgi_sales_analysis_mercado_action" model="ir.actions.act_window">
        <field name="name">Análisis</field>
        <field name="res_model">sgi.sales.budget.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="sgi_sales_budget_line_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('sgi_sales_analysis_pivot_mercado')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('sgi_sales_analysis_graph_global')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_sales_budget_line_view_list')})]"/>
        <field name="context">{'search_default_vigente': 1, 'search_default_presupuesto': 1,
            'search_default_year_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Presupuesto contra facturado</p>
            <p>Por mercado y mes; agrupe por cliente o producto desde la búsqueda. La
            gráfica es la de Dirección (importes por mercado; nunca mezcla m y kg).</p>
        </field>
    </record>

    <!-- Acciones de presupuesto/pronóstico: van después del kanban porque lo
         nombran en view_ids (B-015: antes se definían dos veces). -->

    <record id="sgi_sales_budget_action" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">sgi.sales.budget</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('sgi_sales_budget_view_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_sales_budget_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sgi_sales_budget_view_form')})]"/>
        <field name="search_view_id" ref="sgi_sales_budget_view_search"/>
        <field name="domain">[('kind', '=', 'presupuesto')]</field>
        <field name="context">{'search_default_not_obsolete': 1, 'default_kind': 'presupuesto'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree el presupuesto anual de ventas</p>
            <p>Un documento por año y revisión (REV0, REV1) con los cinco mercados
            (F-P-A28-18): renglones por mercado, cliente, producto (o proyecto) y mes, con
            su precio y el tipo de cambio de cada mes. El real se calcula solo desde lo
            facturado. Una vez aprobado no se modifica: los cambios van en una revisión nueva.</p>
        </field>
    </record>

    <record id="sgi_sales_forecast_action" model="ir.actions.act_window">
        <field name="name">Pronósticos anteriores</field>
        <field name="res_model">sgi.sales.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sgi_sales_budget_view_search"/>
        <field name="domain">[('kind', '=', 'pronostico')]</field>
        <field name="context">{'create': 0, 'edit': 0, 'delete': 0}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('sgi_sales_forecast_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sgi_sales_forecast_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin pronósticos anteriores</p>
            <p>Los pronósticos por cliente y año de antes del pronóstico vigente, solo de consulta.
               El pronóstico de hoy está en Pronóstico vigente.</p>
        </field>
    </record>
</odoo>
