<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pronóstico vigente (E1, diseño v3 sección 2.3). -->
    <record id="qb_forecast_line_view_list" model="ir.ui.view">
        <field name="name">qb.forecast.line.list</field>
        <field name="model">qb.forecast.line</field>
        <field name="arch" type="xml">
            <list string="Pronóstico vigente" multi_edit="1" default_order="week, partner_id, product_id"
                  decoration-muted="zona == 'pasado'" decoration-info="zona == 'firme'"
                  decoration-danger="not conv_ok">
                <field name="week"/>
                <field name="partner_id"/>
                <field name="plant" optional="show"/>
                <field name="product_id"/>
                <field name="articulo_id" optional="hide"/>
                <field name="customer_part" optional="show"/>
                <field name="qty_origen"/>
                <field name="uom_origen"/>
                <field name="qty_venta" readonly="1"/>
                <field name="uom_venta" optional="show"/>
                <field name="qty_m" readonly="1" sum="Total" optional="show"/>
                <field name="qty_kg" readonly="1" sum="Total" optional="show"/>
                <field name="qty_pedido" optional="show"/>
                <field name="qty_neta" optional="hide"/>
                <field name="zona" optional="show"/>
                <field name="origen" optional="show"/>
                <field name="mercado" optional="hide"/>
                <field name="customer_po" optional="hide"/>
                <field name="tag" optional="hide"/>
                <field name="conv_ok" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="qb_forecast_line_view_form" model="ir.ui.view">
        <field name="name">qb.forecast.line.form</field>
        <field name="model">qb.forecast.line</field>
        <field name="arch" type="xml">
            <form string="Semana del pronóstico">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="conv_ok or not product_id">
                        Falta el rendimiento o el ancho para pasar esta cantidad a la unidad de venta del
                        producto. Revise la ficha técnica del artículo.
                    </div>
                    <group>
                        <group string="Quién y qué">
                            <field name="partner_id"/>
                            <field name="ship_to_id"/>
                            <field name="plant"/>
                            <field name="product_id"/>
                            <field name="articulo_id"/>
                            <field name="customer_part"/>
                            <field name="customer_part_id"/>
                            <field name="mercado"/>
                        </group>
                        <group string="Cuándo y cuánto">
                            <field name="week"/>
                            <field name="delivery_date"/>
                            <field name="qty_origen"/>
                            <field name="uom_origen"/>
                            <field name="qty_venta"/>
                            <field name="uom_venta"/>
                            <field name="qty_m"/>
                            <field name="qty_kg"/>
                            <field name="conv_origen"/>
                            <field name="conv_ok" invisible="1"/>
                        </group>
                        <group string="Pedidos">
                            <field name="zona"/>
                            <field name="qty_pedido"/>
                            <field name="qty_neta"/>
                        </group>
                        <group string="De dónde salió">
                            <field name="origen"/>
                            <field name="release_id"/>
                            <field name="customer_po"/>
                            <field name="tag"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="qb_forecast_line_view_pivot" model="ir.ui.view">
        <field name="name">qb.forecast.line.pivot</field>
        <field name="model">qb.forecast.line</field>
        <field name="arch" type="xml">
            <pivot string="Pronóstico vigente">
                <field name="articulo_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="week" interval="week" type="col"/>
                <field name="qty_m" type="measure"/>
                <field name="qty_kg" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="qb_forecast_line_view_graph" model="ir.ui.view">
        <field name="name">qb.forecast.line.graph</field>
        <field name="model">qb.forecast.line</field>
        <field name="arch" type="xml">
            <graph string="Pronóstico vigente" type="bar" stacked="1">
                <field name="week" interval="week"/>
                <field name="partner_id"/>
                <field name="qty_m" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="qb_forecast_line_view_search" model="ir.ui.view">
        <field name="name">qb.forecast.line.search</field>
        <field name="model">qb.forecast.line</field>
        <field name="arch" type="xml">
            <search string="Pronóstico vigente">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="articulo_id"/>
                <field name="customer_part"/>
                <field name="customer_po"/>
                <field name="release_id"/>
                <filter name="vigente" string="Desde esta semana" domain="[('zona', '!=', 'pasado')]"/>
                <!-- 3.3.0: periodo de la matriz y de la lista. Uno a la vez; las columnas de la matriz siguen
                     al periodo (la semana es la de su lunes). -->
                <separator/>
                <filter name="esta_semana" string="Esta semana"
                        domain="[('week', '&gt;', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d')), ('week', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="proximas_4" string="Próximas 4 semanas"
                        domain="[('week', '&gt;', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d')), ('week', '&lt;', (context_today() + relativedelta(weeks=4)).strftime('%Y-%m-%d'))]"/>
                <filter name="proximas_13" string="Próximas 13 semanas"
                        domain="[('week', '&gt;', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d')), ('week', '&lt;', (context_today() + relativedelta(weeks=13)).strftime('%Y-%m-%d'))]"/>
                <filter name="este_mes" string="Este mes"
                        domain="[('week', '&gt;=', context_today().strftime('%Y-%m-01')), ('week', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="proximo_mes" string="Próximo mes"
                        domain="[('week', '&gt;=', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d')), ('week', '&lt;', (context_today() + relativedelta(months=2, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="este_anio" string="Este año"
                        domain="[('week', '&gt;=', context_today().strftime('%Y-01-01')), ('week', '&lt;=', context_today().strftime('%Y-12-31'))]"/>
                <filter name="filtro_semana" string="Semana (periodo)" date="week"/>
                <separator/>
                <filter name="firme" string="Zona firme" domain="[('zona', '=', 'firme')]"/>
                <filter name="planeado" string="Planeado" domain="[('zona', '=', 'planeado')]"/>
                <separator/>
                <filter name="sin_pedido" string="Sin pedido" domain="[('qty_neta', '&gt;', 0)]"/>
                <filter name="sin_conversion" string="Sin conversión" domain="[('conv_ok', '=', False)]"/>
                <filter name="muestras" string="Muestras" domain="[('tag', 'ilike', 'muestra')]"/>
                <separator/>
                <filter name="origen_excel" string="Del forecast de Excel" domain="[('origen', '=', 'excel')]"/>
                <filter name="origen_release" string="De release" domain="[('origen', '=', 'release')]"/>
                <filter name="origen_captura" string="Capturado" domain="[('origen', '=', 'captura')]"/>
                <separator/>
                <filter name="archivadas" string="Archivadas" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_articulo" string="Artículo" context="{'group_by': 'articulo_id'}"/>
                    <filter name="group_week" string="Semana" context="{'group_by': 'week:week'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'month:month'}"/>
                    <filter name="group_mercado" string="Mercado" context="{'group_by': 'mercado'}"/>
                    <filter name="group_origen" string="Origen" context="{'group_by': 'origen'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 3.2.0: captura semanal en matriz. La columna es el catálogo de semanas (week_id): en Odoo 19 el
         grid sobre una fecha no da columnas por semana (3.1.1). Siempre muestra las próximas 13 semanas. -->
    <record id="qb_forecast_line_view_grid" model="ir.ui.view">
        <field name="name">qb.forecast.line.grid</field>
        <field name="model">qb.forecast.line</field>
        <field name="arch" type="xml">
            <grid string="Captura semanal" editable="1">
                <field name="partner_id" type="row"/>
                <field name="plant" type="row"/>
                <field name="product_id" type="row"/>
                <field name="uom_origen" type="row"/>
                <field name="week_id" type="col"/>
                <field name="qty_origen" type="measure"/>
            </grid>
        </field>
    </record>

    <record id="qb_forecast_line_grid_action" model="ir.actions.act_window">
        <field name="name">Captura semanal</field>
        <field name="res_model">qb.forecast.line</field>
        <field name="view_mode">grid,list,form</field>
        <field name="view_id" ref="qb_forecast_line_view_grid"/>
        <field name="context">{'search_default_proximas_13': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin pronóstico en las próximas semanas</p>
            <p>Escriba la cantidad en la unidad del cliente: la semana se crea, cambia o se quita (en cero) y
               queda en Cambios del pronóstico. Para un producto nuevo use «Pegar semanas desde Excel».</p>
        </field>
    </record>

    <record id="qb_forecast_line_action" model="ir.actions.act_window">
        <field name="name">Pronóstico vigente</field>
        <field name="res_model">qb.forecast.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_vigente': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay pronóstico cargado</p>
            <p>Cada renglón es una semana de un cliente y un producto, en la unidad del cliente, en la de
               venta y en metros y kilos. Cárguelo desde los releases o con «Pegar semanas desde Excel».</p>
        </field>
    </record>

    <!-- Cambios del pronóstico (bitácora). -->
    <record id="qb_forecast_change_view_list" model="ir.ui.view">
        <field name="name">qb.forecast.change.list</field>
        <field name="model">qb.forecast.change</field>
        <field name="arch" type="xml">
            <list string="Cambios del pronóstico" create="0" edit="0" delete="0"
                  decoration-success="qty_delta &gt; 0" decoration-danger="qty_delta &lt; 0">
                <field name="create_date" string="Cuándo"/>
                <field name="create_uid" string="Quién" optional="show"/>
                <field name="partner_id"/>
                <field name="plant" optional="show"/>
                <field name="product_id"/>
                <field name="week"/>
                <field name="qty_before"/>
                <field name="qty_after"/>
                <field name="qty_delta" sum="Total"/>
                <field name="origen" optional="show"/>
                <field name="release_id" optional="hide"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="qb_forecast_change_view_search" model="ir.ui.view">
        <field name="name">qb.forecast.change.search</field>
        <field name="model">qb.forecast.change</field>
        <field name="arch" type="xml">
            <search string="Cambios del pronóstico">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="release_id"/>
                <filter name="ultimos_7" string="Últimos 7 días"
                        domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="subio" string="Subió" domain="[('qty_delta', '&gt;', 0)]"/>
                <filter name="bajo" string="Bajó" domain="[('qty_delta', '&lt;', 0)]"/>
                <group>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_release" string="Release" context="{'group_by': 'release_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="qb_forecast_change_action" model="ir.actions.act_window">
        <field name="name">Cambios del pronóstico</field>
        <field name="res_model">qb.forecast.change</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_ultimos_7': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin cambios en el periodo</p>
            <p>Cada vez que una semana del pronóstico cambia (release, Excel o captura) queda aquí: antes,
               después, quién y de dónde.</p>
        </field>
    </record>

    <!-- Hojas del forecast → cliente. -->
    <record id="qb_forecast_sheet_view_list" model="ir.ui.view">
        <field name="name">qb.forecast.sheet.list</field>
        <field name="model">qb.forecast.sheet</field>
        <field name="arch" type="xml">
            <list string="Hojas del forecast" editable="bottom" decoration-danger="not partner_id">
                <field name="name"/>
                <field name="plant"/>
                <field name="partner_id"/>
                <field name="ship_to_id" optional="show"/>
                <field name="default_uom" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="qb_forecast_sheet_action" model="ir.actions.act_window">
        <field name="name">Hojas del forecast</field>
        <field name="res_model">qb.forecast.sheet</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Se llenan solas con la primera carga</p>
            <p>Cada hoja de forecast.xlsx (y cada planta dentro de ella) se liga a su cliente. La primera
               carga las sugiere por nombre; corrija aquí las que salgan en rojo y vuelva a cargar.</p>
        </field>
    </record>

    <!-- 3.1.0: pegar semanas copiadas de Excel. -->
    <record id="qb_forecast_paste_view_form" model="ir.ui.view">
        <field name="name">qb.forecast.paste.form</field>
        <field name="model">qb.forecast.paste</field>
        <field name="arch" type="xml">
            <form string="Pegar semanas desde Excel">
                <div class="alert alert-info" role="status" invisible="state == 'done'">
                    En la hoja del cliente seleccione el código, la parte y las semanas. Si puede, incluya el
                    renglón con los números de semana. Copie con Ctrl+C y pegue abajo con Ctrl+V. Lo anterior a
                    esta semana y lo que escribió un release no se tocan.
                </div>
                <group invisible="state == 'done'">
                    <group>
                        <field name="partner_id"/>
                        <field name="ship_to_id"/>
                        <field name="plant" invisible="ship_to_id"/>
                        <field name="uom_origen"/>
                    </group>
                    <group>
                        <field name="year"/>
                        <field name="first_week"/>
                        <field name="replace_blanks"/>
                    </group>
                </group>
                <field name="text" invisible="state == 'done'" nolabel="1"
                       placeholder="Pegue aquí el bloque copiado de Excel"/>
                <field name="state" invisible="1"/>
                <field name="result" invisible="state != 'done'" nolabel="1"/>
                <footer>
                    <button name="action_apply" type="object" string="Pegar" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="qb_forecast_paste_action" model="ir.actions.act_window">
        <field name="name">Pegar semanas desde Excel</field>
        <field name="res_model">qb.forecast.paste</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Cargar el forecast de Excel. -->
    <record id="qb_forecast_import_view_form" model="ir.ui.view">
        <field name="name">qb.forecast.import.form</field>
        <field name="model">qb.forecast.import</field>
        <field name="arch" type="xml">
            <form string="Cargar forecast de Excel">
                <group invisible="state == 'done'">
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="years"/>
                        <field name="replace"/>
                    </group>
                </group>
                <field name="state" invisible="1"/>
                <field name="result" invisible="state != 'done'" nolabel="1"/>
                <footer>
                    <button name="action_import" type="object" string="Cargar" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="qb_forecast_import_action" model="ir.actions.act_window">
        <field name="name">Cargar forecast de Excel</field>
        <field name="res_model">qb.forecast.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
