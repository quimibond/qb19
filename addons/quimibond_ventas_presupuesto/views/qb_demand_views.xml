<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demanda por cliente para Planeación (E1, diseño v3 sección 2.4). Solo lectura. -->
    <record id="qb_demand_line_view_list" model="ir.ui.view">
        <field name="name">qb.demand.line.list</field>
        <field name="model">qb.demand.line</field>
        <field name="arch" type="xml">
            <list string="Demanda por cliente" create="0" edit="0" delete="0"
                  default_order="week, articulo_id, partner_id"
                  decoration-danger="atrasado" decoration-muted="not conv_ok" decoration-bf="tipo == 'pedido'"
                  decoration-warning="dev_state in ('desarrollo', 'pilotaje', 'archivado')">
                <header>
                    <button name="action_qb_rebuild" type="object" string="Actualizar" display="always"/>
                </header>
                <field name="week"/>
                <field name="tipo"/>
                <field name="articulo_id"/>
                <field name="product_id" optional="show"/>
                <field name="dev_state" optional="show" widget="badge"
                       decoration-warning="dev_state == 'pilotaje'"
                       decoration-danger="dev_state in ('desarrollo', 'archivado')"
                       invisible="dev_state not in ('desarrollo', 'pilotaje', 'archivado')"/>
                <field name="partner_id"/>
                <field name="plant" optional="show"/>
                <field name="qty_venta"/>
                <field name="uom_venta"/>
                <field name="qty_m" sum="Total"/>
                <field name="qty_kg" sum="Total" optional="show"/>
                <field name="qty_kg_producir" sum="Total"/>
                <field name="zona" optional="show"/>
                <field name="mercado" optional="hide"/>
                <field name="customer_po" optional="hide"/>
                <field name="order_id" optional="hide" groups="sales_team.group_sale_salesman"/>
                <field name="en_mps" optional="hide"/>
                <field name="atrasado" column_invisible="1"/>
                <field name="conv_ok" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="qb_demand_line_view_pivot" model="ir.ui.view">
        <field name="name">qb.demand.line.pivot</field>
        <field name="model">qb.demand.line</field>
        <field name="arch" type="xml">
            <pivot string="Demanda por cliente">
                <field name="articulo_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="week" interval="week" type="col"/>
                <field name="qty_m" type="measure"/>
                <field name="qty_kg_producir" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="qb_demand_line_view_graph" model="ir.ui.view">
        <field name="name">qb.demand.line.graph</field>
        <field name="model">qb.demand.line</field>
        <field name="arch" type="xml">
            <graph string="Demanda por cliente" type="bar" stacked="1">
                <field name="week" interval="week"/>
                <field name="tipo"/>
                <field name="qty_m" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="qb_demand_line_view_search" model="ir.ui.view">
        <field name="name">qb.demand.line.search</field>
        <field name="model">qb.demand.line</field>
        <field name="arch" type="xml">
            <search string="Demanda por cliente">
                <field name="articulo_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="customer_po"/>
                <filter name="corte_acabado" string="Acabado: 3 semanas" domain="[('corte_acabado', '=', True)]"/>
                <filter name="corte_tejido" string="Tejido: próximo mes" domain="[('corte_tejido', '=', True)]"/>
                <separator/>
                <filter name="pedidos" string="Pedidos" domain="[('tipo', '=', 'pedido')]"/>
                <filter name="pronostico" string="Pronóstico sin pedido" domain="[('tipo', '=', 'pronostico')]"/>
                <separator/>
                <filter name="firme" string="Zona firme" domain="[('zona', '=', 'firme')]"/>
                <filter name="planeado" string="Planeado" domain="[('zona', '=', 'planeado')]"/>
                <filter name="atrasados" string="Pedidos atrasados" domain="[('atrasado', '=', True)]"/>
                <separator/>
                <filter name="sin_conversion" string="Sin conversión" domain="[('conv_ok', '=', False)]"/>
                <filter name="sin_mps" string="Sin programa en el MPS" domain="[('en_mps', '=', False)]"/>
                <separator/>
                <filter name="en_desarrollo" string="Artículo en desarrollo"
                        domain="[('dev_state', 'in', ('desarrollo', 'archivado'))]"/>
                <filter name="en_pilotaje" string="Artículo en pilotaje"
                        domain="[('dev_state', '=', 'pilotaje')]"/>
                <group>
                    <filter name="group_articulo" string="Artículo" context="{'group_by': 'articulo_id'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_week" string="Semana" context="{'group_by': 'week:week'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'month:month'}"/>
                    <filter name="group_tipo" string="Tipo" context="{'group_by': 'tipo'}"/>
                    <filter name="group_mercado" string="Mercado" context="{'group_by': 'mercado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="qb_demand_line_action" model="ir.actions.act_window">
        <field name="name">Demanda por cliente</field>
        <field name="res_model">qb.demand.line</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin demanda calculada</p>
            <p>Pedidos confirmados pendientes de entregar y pronóstico sin pedido, por artículo, cliente y
               semana, en metros, kilos de venta y kilos a producir. Use los filtros «Acabado: 3 semanas» y
               «Tejido: próximo mes». Se actualiza cada noche y con el botón «Actualizar» de la lista.</p>
        </field>
    </record>
</odoo>
