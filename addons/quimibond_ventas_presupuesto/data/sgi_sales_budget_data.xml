<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- P-A28 Nota 1: revaluación del S2 (el método se protege con guarda de mes
         == junio, así que correr mensual es idempotente y robusto ante el drift
         de nextcall). -->
    <record id="sgi_cron_budget_revaluation" model="ir.cron">
        <field name="name">SGI: Revaluación del S2 del presupuesto (junio, P-A28 Nota 1)</field>
        <field name="model_id" ref="quimibond_sgi.model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_budget_revaluation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
    </record>

    <!-- P-A28 4.2.2.7: cobertura del pronóstico (semanas descubiertas y pedidos
         fuera de pronóstico). Semanal; idempotente por resumen de actividad. -->
    <record id="sgi_cron_forecast_coverage" model="ir.cron">
        <field name="name">SGI: Cobertura del pronóstico (semanal, P-A28 4.2.2.7)</field>
        <field name="model_id" ref="quimibond_sgi.model_sgi_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_forecast_coverage()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>

    <record id="sgi_seq_sales_budget" model="ir.sequence">
        <field name="name">Presupuesto de ventas SGI</field>
        <field name="code">sgi.sales.budget</field>
        <field name="prefix">PPV-%(range_year)s-</field>
        <field name="padding">3</field>
        <field name="use_date_range" eval="True"/>
        <field name="number_increment">1</field>
    </record>

    <record id="format_map_sales_budget" model="sgi.format.map">
        <field name="model_id" ref="model_sgi_sales_budget"/>
        <field name="sgi_code">F-P-A28-18</field>
        <field name="sgi_code_alt">F-P-A28-13</field>
        <field name="note">Presupuesto de Ventas General F-P-A28-18 (mensual) / Pronóstico F-P-A28-13 (semanal por cliente); F-P-A28-17 es el comparativo ppto vs real</field>
    </record>
</odoo>
