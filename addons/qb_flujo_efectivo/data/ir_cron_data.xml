<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Diario: foto de la semana (si aún no hay) y lo real de las semanas cerradas. -->
        <record id="cron_qb_flujo_foto" model="ir.cron">
            <field name="name">Flujo a 13 semanas: foto semanal y real</field>
            <field name="model_id" ref="model_qb_flujo_foto"/>
            <field name="state">code</field>
            <field name="code">model._cron_foto_semanal()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
