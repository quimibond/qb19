<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_qb_mi_cuenta" model="ir.ui.view">
        <field name="name">res.partner.form.quimibond.mi.cuenta</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <field name="qb_mi_cuenta" invisible="parent_id"/>
            </xpath>
        </field>
    </record>
</odoo>
