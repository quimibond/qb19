<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- REGISTRO RAMA junto a PESAR ROLLO / PESAR DESPERDICIO (Rama sigue en la lista de operaciones). -->
    <record id="mrp_workorder_view_tree_hojas_calidad" model="ir.ui.view">
        <field name="name">mrp.workorder.view.list.hojas.calidad</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="quimibond_rollos_bitacora.mrp_workorder_view_tree_pesar_rama"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_pesar_desperdicio_rama']" position="after">
                <button name="action_registro_rama" type="object" string="REGISTRO RAMA"
                        class="btn-info" icon="fa-table"
                        invisible="not es_rama or state not in ('ready', 'progress')"/>
            </xpath>
        </field>
    </record>
</odoo>
